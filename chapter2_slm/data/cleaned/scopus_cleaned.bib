	title = {An Embedded Tinyml Framework for Real-Time Anomaly Detection in Bluetooth Low Energy Wearable Devices},
	year = {2026},
	journal = {Proceedings of the 4th International Conference on Intelligent Data Communication Technologies and Internet of Things, IDCioT 2026},
	pages = {753 - 758},
	doi = {10.1109/IDCIoT67589.2026.11455827},
	url = {https://www.scopus.com/pages/publications/105036976045?origin=resultslist},
	affiliations = {Kalasalingam Academy of Research and Education, Department of Computer Science and Engineering, Krishankoil, India},
	abstract = {The behavioral properties have been found to be more efficient in detecting Bluetooth intrusion compared to the traditional protocol-signature-based approaches. To record such behaviors, controlled Bluetooth Low Energy (BLE) attack scenarios such as advertisement flooding, repeated connections, GATT write abuse, and pairing request flooding were systematically generated and a dataset of about 29,000 BLE communication samples was obtained under both benign and adversarial conditions. An efficient machine-learning model was then trained using this data and tailored to be used on resource-limited hardware. Due to the constraints of the IoT devices, TensorFlow Lite on Microcontrollers was used and INT8 post-training quantization was implemented to decrease the size of the model without affecting real-time performance. The model was applied to ESP32-class microcontrollers and evaluated for the accuracy of detection, inference latency, memory footprint, and power usage. To increase the reliability and security of the systems further, firmware signing was introduced to eliminate any unauthorized changes and encrypted logging was also implemented to protect sensitive information. © 2026 IEEE.},
