@ARTICLE{Peng2026,
	author = {Peng, Tsui and Lin, Ching-Huang and Wei, Yu-Chih and Chen, Bo-Chang and Yeh, Jen-Yu},
	title = {Low-Overhead Passive Resilience Monitoring for AIoT Gateways: End-to-End Anomaly Detection via eBPF Timing Traces and Autoencoders},
	year = {2026},
	journal = {IEEE Access},
	pages = {},
	doi = {10.1109/ACCESS.2026.3685156},
	url = {https://www.scopus.com/pages/publications/105036683199?origin=resultslist},
	affiliations = {National Taipei University of Technology, Department of Information and Finance Management, Taipei, 10608, Taiwan; National Taipei University of Technology, Information Security Program, Taipei, 10608, Taiwan},
	abstract = {Modern AIoT services are vulnerable to complex, cross-domain failures spanning wireless sensor networks, edge AI inference, and cloud reporting. Conventional monitoring typically relies on isolated single-node metrics that lack an integrated end-to-end perspective, or on exhaustive active probing that incurs prohibitive resource overhead. To address this gap, this paper presents a lightweight, gateway-centric resilience-monitoring framework that provides comprehensive end-to-end observability purely at the edge. By hooking into kernel-level TCP state transitions via Linux eBPF, the proposed system decouples network-induced delays from application computational bottlenecks. We reconstruct fine-grained discrete latency segments—including device-to-gateway transmission (T<sub>de</sub>), IoT service execution (T<sub>is</sub>), AI inference (T<sub>ai</sub>), and cloud reporting (T<sub>ec</sub>)—completely eliminating injected measurement traffic. Based on these non-intrusive metrics, we design a hybrid detection architecture: (i) protocol-oriented static thresholds for immediate, interpretable localization of hard outages, and (ii) a window-based behavioral layer integrating Autoencoders (AE) and Cumulative Sum (CUSUM) to handle subtle concept drifts and coupled performance degradations. Extensive evaluations on a physical AIoT testbed demonstrate that the framework localizes failures with minimal CPU overhead (less than 1%). Furthermore, the learning-based layer successfully captures the elusive performance fluctuations arising from the dynamic interplay between network conditions and edge computing workloads. Ultimately, this approach facilitates a paradigm shift from reactive failure handling to proactive early warning and autonomous anomaly detection, offering a highly deployable foundation for robust AIoT operations. © 2013 IEEE.},
	author_keywords = {AIoT gateway; Anomaly detection; Autoencoder; eBPF (extended Berkeley Packet Filter); Operational resilience; Passive monitoring},
	keywords = {Edge computing; Gateways (computer networks); Internet of things; Linux; Machine learning; Mobile telecommunication systems; Network architecture; Wireless sensor networks; AIoT gateway; Anomaly detection; Auto encoders; Berkeley packet filters; End to end; Extended berkeley packet filter; Low overhead; Network edges; Operational resilience; Passive monitoring; Anomaly detection},
	issn = {21693536},
	language = {English},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

