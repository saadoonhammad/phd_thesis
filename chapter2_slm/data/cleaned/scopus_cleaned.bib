@CONFERENCE{Albaiz2026a,
	author = {Albaiz, Abdulrahman and Amsaad, Fathi},
	title = {Fully Autonomous Z-Score-Based TinyML Anomaly Detection on Resource-Constrained MCUs using Power Side-Channel Data},
	year = {2026},
	journal = {2026 IEEE 2nd Secure and Trustworthy Cyberinfrastructure for IoT and Microelectronics, SATC 2026 - Conference Proceedings},
	pages = {},
	doi = {10.1109/SATC69565.2026.11542250},
