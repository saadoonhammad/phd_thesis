@CONFERENCE{Putra202479,
	author = {Putra, Pristian Dwi},
	title = {Implementation of Audio Classification Using Tiny Machine Learning for Predictive Maintenance in Muara Karang Power Plant},
	year = {2024},
	journal = {ICT-PEP 2024 - International Conference on Technology and Policy in Energy and Electric Power: Resilient Power Systems: Navigating the Clean Energy Transition, Proceedings},
	pages = {79 - 84},
	doi = {10.1109/ICT-PEP63827.2024.10733513},
	url = {https://www.scopus.com/pages/publications/85210876737?origin=resultslist},
	affiliations = {UP Muara Karang, PLN Nusantara Power, Jakarta, Indonesia},
	abstract = {The Muara Karang Power Plant Block 1 in Jakarta, owned by PLN Nusantara Power, is encountering increasing operational complexity, necessitating an efficient monitoring system. In response to PLN Nusantara Power's digitalization program, this research explores the implementation of Tiny Machine Learning (TinyML) and Edge-AI technologies to enhance operational efficiency and reliability. These technologies utilize audio sensors for real-time anomaly detection and predictive maintenance of power generation equipment. The system is implemented at Muara Karang Power Plant Block 1 in H2 Plant, using the Wio Terminal hardware platform connected to an audio sensor. Data is processed through the Edge-Impulse platform to train machine learning models at the edge, then transmitted via MQTT to Node-RED for further processing. The processed data is stored in MySQL for long-term analysis and displayed on a Grafana dashboard. TinyML technology is anticipated to improve equipment management and maintenance, boost operational efficiency, and mitigate downtime risks. This research employs the Mel-Filterbank Energy (MFE) method and a Neural Network Classifier, achieving 100% accuracy and low RAM consumption (19.7 KB). Data from the Wio Terminal can be stored in MySQL via Node-RED, displayed in the Grafana Dashboard, and sent to WhatsApp for alarms and notifications. This study underscores the potential of TinyML in enhancing power plant monitoring systems and suggests further exploration into its broader applications. © 2024 IEEE.},
