	title = {AIoT platform integrated with smart breeding and omics cloud database for Taiwan tilapia},
	year = {2025},
	journal = {Journal of Agriculture and Food Research},
	volume = {24},
	pages = {},
	doi = {10.1016/j.jafr.2025.102490},
	url = {https://www.scopus.com/pages/publications/105020921204?origin=resultslist},
	affiliations = {Dept. of Electrical Engineering, National Taiwan Ocean Univ., Keelung City, 20224, Taiwan; Industrial Technology Research Institute (ITRI), Hsinchu, 310401, Taiwan; Dept. of Aquaculture, National Taiwan Ocean Univ., Keelung City, 20224, Taiwan; Center of Excellence for the Oceans, National Taiwan Ocean University, Keelung City, 20224, Taiwan; AI Research Center, National Taiwan Ocean Univ., Keelung City, 20224, Taiwan},
	abstract = {The ongoing depletion of marine fishery products has heightened the importance of aquaculture, with farming tilapia emerging as a key substitute for protein sources. Conventional breeding approaches for Taiwan tilapia are often protracted in duration and susceptible to genetic deterioration. To address these challenges, we propose a multi-year research project that aims to build a platform integrated with a smart breeding system and an omics cloud. State-of-the-art artificial intelligence (AI) models and high-throughput IoT are employed to offer promising solutions. Global advancements in selective breeding further highlight the significance of this work in sustaining Taiwan's tilapia industry. Funded by Taiwan's Ministry of Agriculture, the research focuses on exploring genotype-phenotype relationships to pave the way for more efficient breeding procedures and, ultimately, optimal breeding strategies. This paper reports the first-year results of phenotype work. Novel algorithms are developed to integrate with the AI models, enabling real-time monitoring of fish behavior and environmental parameters, thereby facilitating selective breeding procedures. Key findings include: (1) for fish aged 1–3 months, YOLO11s achieved 0.802 of mAP<sup>@50</sup> and 0.9316 of mAP<sup>@50</sup> for body detection; (2) for 3–5 months fish, YOLOv12n outperformed others with 0.767 of mAP<sup>@50</sup>; (3) for anomaly behavior recognition, F1-score and precision rate reached 97 % and 99 %, respectively; and (4) size measurement using stereo vision yielded an error rate of 3.42 %. All computing tasks, including object detection, behavior recognition, and size measurement, can be performed on the Jetson Xavier series, enabling cost-effective edge computing for on-site aquaculture applications. © 2025 The Author(s).},
	author_keywords = {Abnormal behavior recognition; Artificial intelligence; Breeding; Fish size measurement; Genotype; Phenotypic trait; Taiwan tilapia},
	issn = {26661543},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@CONFERENCE{Lima202531,
