@BOOK{Imoize20261,
	author = {Imoize, Agbotiname Lucky and Do, Dinh-Thuan and Song, Houbing Herbert},
	title = {Tiny Machine Learning: Design Principles and Applications},
	year = {2026},
	journal = {Tiny Machine Learning: Design Principles and Applications},
