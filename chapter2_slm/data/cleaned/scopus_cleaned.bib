	url = {https://www.scopus.com/pages/publications/105017602123?origin=resultslist},
	affiliations = {Department of Electrical and Computer Engineering, University of Texas at Dallas, Richardson, United States},
	abstract = {Distributed bearing faults, unlike localized defects, produce irregular and non-stationary vibration patterns that challenge conventional diagnostic methods. This work presents a lightweight, edge-deployable TinyML framework for real-time classification of such faults using raw x, y, z-axis vibration signals collected at 3000 RPM under five load conditions (0%-100%). Both feature-engineered and raw-signal approaches were evaluated. A 1D Convolutional Neural Network (1D-CNN) trained on raw signals achieved 99.36% accuracy, significantly outperforming a Deep Neural Network (DNN) trained on time-domain and spectral features. The system classifies six fault conditions - healthy, lubrication failure, contamination, flaking, electrical erosion, and composite faults - demonstrating robustness even across varying fault severities. Deployment on microcontrollers using Edge Impulse into Microcontrollers resulted in low-latency (30 ms) and low-memory (29.3 KB RAM, 69.7 KB flash) inference, confirming its suitability for Industrial IoT (IIoT) environments. This research validates the strength of raw signal-based learning and highlights the potential of TinyML for scalable, real-time, and autonomous diagnostics in embedded motor health monitoring systems.Figure 1:Experimental test setup implemented in the laboratory. For data collection using (ADXL354C) [1] © 2025 Copyright held by the owner/author(s).},
	author_keywords = {1D Convolutional Neural Network (1D-CNN); Deep Learning; Distributed Bearing Faults; Embedded Systems; Fault Diagnosis; Industrial IoT (IIoT); Low-Power Edge Deployment; motor health monitoring.; TinyML; Triaxial Vibration},
