	year = {2026},
	journal = {IEEE Internet of Things Journal},
	volume = {13},
	number = {5},
	pages = {8348 - 8358},
	doi = {10.1109/JIOT.2025.3642146},
	url = {https://www.scopus.com/pages/publications/105024466313?origin=resultslist},
	affiliations = {Department of Computer Science, College of Science, Mathematics and Technology, Wenzhou-Kean University, Wenzhou, 325060, China; Department of Mathematics and Computer Science, Brandon University, Brandon, R7A 6A9, MB, Canada; Research Centre for Interneural Computing, China Medical University, Taichung, 40402, Taiwan; Centre for Research Impact and Outcome, Institute of Engineering and Technology, Chitkara University, Punjab, Rajpura, 140401, India; Cybersecurity Center, Prince Mohammad Bin Fahd University, Khobar, 31952, Saudi Arabia},
	abstract = {Mobile edge computing (MEC) security and performance may be threatened by network traffic anomalies such as illegal data transfers or access. Traditional detection methods, such as machine learning, statistical models, and signature-based methods, are ineffective for real-time monitoring in resource-constrained devices. TinyML deploys lightweight models on resource-limited devices for rapid, localized, low-power threat detection without cloud access, improving MEC real-time security. This article introduces HoloTiny-AD, a real-time anomaly detection technique in MEC using the holographic counterpart (HC) architecture, TinyML, and deep particle swarm optimization (DPSO). The proposed approach effectively monitors and detects anomalies while using minimum computing resources, making it suitable for MEC. HC uses TinyML models trained with lightweight classifiers to mimic device state transitions and analyze anomalies to identify potential risks. DPSO optimizes parameters and task scheduling to increase detection accuracy and predict overload or busy state device failures. The proposed methodology is evaluated on two benchmark datasets: CIC-BCCC-NRC-ACI-IOT-2023 and CIC-IDS2017. Results show that HoloTiny-AD is a robust, scalable solution for securing edge devices against evolving network threats under resource constraints. © 2025 IEEE. All rights reserved.},
	author_keywords = {Cybersecurity; holographic analysis; meta-heuristic algorithms; mobile edge computing (MEC); TinyML; trustworthy anomaly detection},
	keywords = {Anomaly detection; Edge detection; Mobile edge computing; Network security; Scheduling algorithms; Trusted computing; Anomaly detection; Cyber security; Edge computing; Holographic analysis; Meta-heuristics algorithms; Metaheuristic; Particle swarm; Swarm optimization; Tinyml; Trustworthy anomaly detection; Particle swarm optimization (PSO)},
	issn = {23274662},
	language = {English},
	type = {Article},
