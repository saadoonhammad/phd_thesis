@ARTICLE{Abid2025,
	author = {Abid, Umair and Aslam, Naeem and Naeem, Ahmed and Fuzail, Muhammad and Imran, Muhammad},
	title = {Enhancing Intrusion Detection in AIOT using Intelligent Feature Selection and Deep Learning Fusion},
	year = {2025},
	journal = {Journal of Computing and Biomedical Informatics},
	volume = {9},
