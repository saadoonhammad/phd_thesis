@ARTICLE{Chen2026,
	author = {Chen, Yueyuan and Xu, Ziheng and Pan, Huiming and Lin, Jianping and Zhu, Kezhe and Shull, Peter B.},
	title = {Fast, optimized human activity recognition via wrist accelerometry that excludes anomalous activities},
	year = {2026},
	journal = {Biomedical Signal Processing and Control},
	volume = {123},
	pages = {},
	doi = {10.1016/j.bspc.2026.110629},
	url = {https://www.scopus.com/pages/publications/105039088462?origin=resultslist},
	affiliations = {State Key Laboratory of Mechanical System and Vibration, School of Mechanical Engineering, Shanghai Jiao Tong University, Shanghai, 200240, China},
	abstract = {Human Activity Recognition (HAR) is crucial to assess and promote exercise to improve human health. However, approaches that rely on a single classifier are often inaccurate in real-life situations because of unexpected anomalous movements and activities, which are often misclassified into predefined activity categories. In addition, commercial wearable devices often have far less memory and processing power than lab-based desktop computers, making accurate real-time HAR challenging in practice. We thus propose a fast, optimized Tiny Machine Learning approach for HAR based on a novel Quadratic Discriminant Analysis model that employs score confidence interval-based automated anomaly exclusion for wrist-worn accelerometry. Fifty-four subjects performed five primary movement activities (cycling, elliptical training, running, walking, and playing basketball) and a subset of 30 subjects performed an additional 10 anomalous movements (eating with a fork, eating with chopsticks, grabbing objects, typing, moving a mouse, drinking water, brushing teeth, rolling on a bed, wrist rotations, and random hand movements). The proposed model showed 89.8% primary activity classification accuracy and 89.1% anomaly detection accuracy. It also showed 82.3% primary activity classification accuracy and 85.3% anomaly detection accuracy on the public mHealth dataset. To the best of our knowledge, this is the first study to integrate primary activity classification and anomaly detection into a single model based on wrist-worn accelerometry. It supports fast, real-time, and accurate HAR, while minimizing memory consumption and computational demands. This approach provides robust, evidence-based insights into exercise duration, frequency, and composition, potentially enhancing health and fitness monitoring and facilitating chronic disease prevention. © 2026 Elsevier Ltd},
	author_keywords = {Accelerometry; Anomaly detection; Human activity recognition (HAR); Quadratic discriminant analysis (QDA); Wristband},
	keywords = {Accelerometers; Diseases; Learning systems; mHealth; Pattern recognition; Sports; Wearable computers; drinking water; Accelerometry; Activity classifications; Anomaly detection; Classification accuracy; Human activity recognition; Quadratic discriminant analysis; Quadratic discriminant analyze; Real- time; Wristband; accelerometry; adult; Article; basketball; comparative study; confidence interval; discriminant analysis; eating; evidence based practice; exercise; female; hand movement; human; human experiment; machine learning; male; memory; outlier detection; recognition; running; training; walking; Anomaly detection; Discriminant analysis},
	issn = {17468094},
	language = {English},
