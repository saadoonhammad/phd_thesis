@CONFERENCE{Martinez-Rau2025b,
	author = {Martinez-Rau, Luciano Sebastian and Zhang, Yuxuan and Phuong Vu, Quynh Nguyen and Oelmann, Bengt and Bader, Sebastian},
	title = {An On-Device Hybrid Machine Learning Approach for Anomaly Detection in Conveyor Belt Operations},
	year = {2025},
	journal = {Conference Record - IEEE Instrumentation and Measurement Technology Conference},
	pages = {},
	doi = {10.1109/I2MTC62753.2025.11079096},
	url = {https://www.scopus.com/pages/publications/105012166769?origin=resultslist},
	affiliations = {Mid Sweden University, Department of Computer and Electrical Engineering, Sundsvall, Sweden},
	abstract = {The mining sector harnesses advancements in automation, digitalization, and interconnected technologies from Industry 4.0 to enhance efficiency, safety, and sustainability. Conveyor belts play a critical role in mining operations, facilitating the continuous and efficient transport of bulk materials over long distances, directly impacting productivity. While anomaly detection in specific conveyor belt components has been extensively studied, continuous monitoring to identify root causes of failures remains in its early stages. Existing methods for anomaly detection in mining conveyor belt duty cycles rely on supervised machine learning (ML) to classify internal machine modes as an intermediate step. While these approaches offer high explainability, they are constrained by the need for extensive labeled data for internal machine modes. This study proposes a novel pattern recognition approach combining unsupervised and supervised ML models for real-time anomaly detection in conveyor belt operational cycles. By evaluating combinations of TinyML models, the approach achieved average F1-scores of 83.2% for abnormal cycles and 97.0% for normal cycles, surpassing the state-of-the-art by 11.4% and 3.3%, respectively. Deployed on low-power microcontrollers, the proposed methods demonstrated efficient, real-time operation, reducing energy consumption by up to 84.5% (4.1 μJ per inference) and program memory usage by up to 72.1%. These results provide valuable insights for detecting early mechanical failures and enabling targeted preventive maintenance. © 2025 IEEE.},
	author_keywords = {anomaly detection; conveyor belt; industry 4.0; low-power microcontroller; TinyML; unsupervised learning},
	keywords = {Data mining; Digital storage; Failure (mechanical); Industry 4.0; Labeled data; Learning systems; Microcontrollers; Pattern recognition; Preventive maintenance; Supervised learning; Unsupervised learning; Anomaly detection; Bulk materials; Conveyor belts; Hybrid machine learning; Low-power microcontrollers; Machine learning approaches; Mining operations; Mining sector; Supervised machine learning; Tinyml; Anomaly detection; Belt conveyors},
	issn = {10915281},
	isbn = {979-833150500-4},
	coden = {CRIIE},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Asutkar2023,
	author = {Asutkar, Supriya and Chalke, Chaitravi and Shivgan, Kajal and Tallur, Siddharth},
	title = {TinyML-enabled edge implementation of transfer learning framework for domain generalization in machine fault diagnosis},
	year = {2023},
	journal = {Expert Systems with Applications},
	volume = {213},
	pages = {},
	doi = {10.1016/j.eswa.2022.119016},
	url = {https://www.scopus.com/pages/publications/85140881675?origin=resultslist},
	affiliations = {Centre for Research in Nanotechnology & Science (CRNTS), IIT Bombay, Powai, Maharashtra, Mumbai, 400076, India; Department of Electrical Engineering (EE), IIT Bombay, Powai, Maharashtra, Mumbai, 400076, India},
	abstract = {TinyML has the potential to be a huge enabler of smart sensor nodes for fault diagnosis of machines by embedding powerful machine learning algorithms in low-cost edge devices. Static models trained with pre-collected data may not perform satisfactorily when deployed in use cases that present data with a significantly different distribution, due to changes in machine instances, installation, and environment and operating conditions. In this work, we present a transfer learning framework in conjunction with TinyML-powered convolutional neural network (CNN) architecture for vibration-based fault diagnosis of vastly different machines. We report that fine-tuning (retraining) of parameters (weights and biases) in convolutional layers and transfer of parameters in dense layers of CNNs results in higher accuracy for domain generalization than the conventional approach of transferring parameters for convolutional layers and fine-tuning dense layers. Using transfer learning also results in high accuracy when the total number of training samples used for fine-tuning on the target domain data sets are as low as 25 i.e. less than 5 % of the size of the data set, which makes the proposed architecture viable for scenarios with a limited number of data points available for training the model. Furthermore, we have also demonstrated memory-efficient retraining at the edge by fine-tuning only the biases of hidden layers. © 2022 Elsevier Ltd},
	author_keywords = {Convolutional neural network; Domain generalization; Machine fault diagnosis; TinyML; Transfer learning},
	keywords = {Convolution; Failure analysis; Fault detection; Learning algorithms; Learning systems; Network architecture; Sensor nodes; Transfer learning; Convolutional neural network; Dense layer; Domain generalization; Faults diagnosis; Fine tuning; Generalisation; Learning frameworks; Machine fault diagnosis; Tinyml; Transfer learning; Convolutional neural networks},
	issn = {09574174},
	coden = {ESAPE},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 67}
}

@ARTICLE{Khan2026b,
	author = {Khan, Umar Hayat and Khan, Rahim and Chelloug, Samia Allaoua and Alturise, Fahad and Khan, Shahbaz and Alkhalaf, Salem},
	title = {HybridTrust: on-device federated learning with crypto-agile security for legacy and quantum-safe medical devices},
	year = {2026},
	journal = {Scientific Reports},
	volume = {16},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-026-52891-z},
	url = {https://www.scopus.com/pages/publications/105042596744?origin=resultslist},
	affiliations = {Department of Computer Science, Abdul Wali Khan University Mardan, Mardan, Pakistan; Department of Cybersecurity, College of Computer, Qassim University, Buraydah, Saudi Arabia; Renewable Energy and Environmental Technology Center, University of Tabuk, Tabuk, Saudi Arabia; Department of Information Technology, College of Computer and Information Sciences, Princess Nourah bint Abdulrahman University, P. O. Box 84428, Riyadh, 11671, Saudi Arabia; Department of Computer Engineering, College of Computer, Qassim University, Buraydah, Saudi Arabia},
	abstract = {The process of migration of IoMT systems in healthcare into post-quantum cryptographic systems is expected to be a gradual one. Here, existing ECC-based devices alongside newly developed quantum-resistant devices will be operating within the same healthcare ecosystem. However, there exists an important interoperability challenge posed by the need for collaboration within the domain of edge intelligence in critical life situations like ICU monitoring. This paper presents HybridTrust, an on-device federated TinyML framework designed to enable secure collaboration among legacy, post-quantum, and hybrid IoMT devices during the post-quantum cryptography migration period. Unlike wearable IoMT systems, HybridTrust targets mains-powered ICU monitoring devices, where cryptographic flexibility, clinical fidelity, and security can be prioritized without strict battery constraints. The novelty of HybridTrust lies in its crypto-agile and deployment-oriented design rather than in proposing a new machine-learning algorithm. The framework integrates a dynamic crypto-negotiation protocol that selects the strongest mutually supported scheme among ECC, ML-KEM-512, and hybrid ECC–ML-KEM operation; a compact 931-byte hybrid certificate format suitable for ESP32-class microcontrollers; a regulatory compliance scorecard mapping cryptographic choices to HIPAA, GDPR, FDA, and NIST expectations; and a tree-concatenation-based model fusion strategy for maintaining clinical utility under non-IID hospital data distributions. HybridTrust is evaluated using a clinician-validated synthetic ICU dataset distributed across five simulated hospitals in an OMNeT++ environment. The framework achieves an average anomaly detection accuracy of 90.5% while introducing only 0.09–0.43 ms quantum-safe cryptographic overhead per operation. These results indicate that secure post-quantum transition, legacy interoperability, and real-time ICU monitoring can be jointly supported without imposing prohibitive latency or deployment overhead. HybridTrust therefore provides a practical pathway for backward-compatible, crypto-agile, and quantum-resilient IoMT deployment in critical-care environments. © The Author(s) 2026.},
	author_keywords = {Crypto-agile security; Edge learning; Federated learning; Internet of Medical Things (IoMT); Non-IID data; Post-quantum transition; Real-time ICU monitoring; TinyML},
	keywords = {Algorithms; Computer Security; Equipment and Supplies; Federated Learning; Humans; Intensive Care Units; algorithm; computer security; devices; federated learning; human; intensive care unit},
	issn = {20452322},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Tran2026144,
	author = {Tran, Ba Vu and Youssef, Mohamed Z.},
	title = {Multi-Model Embedded ML for Real-Time Fault Detection in Industrial Power Supplies},
	year = {2026},
	journal = {Conference Proceedings - IEEE Applied Power Electronics Conference and Exposition - APEC},
	volume = {2026-March},
	pages = {144 - 149},
	doi = {10.1109/APEC51134.2026.11517063},
	url = {https://www.scopus.com/pages/publications/105040977964?origin=resultslist},
	affiliations = {Ontario Tech University, Department of Electrical, Computer and Software Engineering, Oshawa, Canada},
	abstract = {Conventional threshold-based fault detection in industrial AC-DC power supplies often fails to identify soft faults, such as those induced by environmental stress and gradual sensor degradation. While machine learning can resolve these complex nonlinear signatures, existing approaches typically rely on desktop-class computing resources or cloud-based processing, leading to constraints in cost, size, and latency. This paper bridges this gap by introducing a multi-model embedded ML framework that executes five distinct classifiers directly on an STM32H7 microcontroller. These classifiers include Decision Tree, Gaussian Naive Bayes, Support Vector Machine, Extreme Learning Machine, and a Quantized Neural Network. To manage computational resources, a runtime scheduler utilizes confidence-based early-exit logic to invoke complex models only when necessary. The system supports dual-path integration via encrypted HTTPS/TLS for remote dashboard telemetry and legacy Modbus RTU for local monitoring and control. Experimental validation on a ruggedized IP68-rated prototype shows that all classifiers achieve strong performance, with the Quantized Neural Network attaining the highest accuracy at 97.47% and a macro F1-score of 0.96 across seven fault categories. All inference operations complete within a millisecond while requiring less than 50 kB of Flash memory. These results confirm that advanced fault diagnosis can be performed entirely on-device, eliminating dependence on external gateways or cloud connectivity. © 2026 IEEE.},
	author_keywords = {edge computing; Embedded machine learning; fault detection; industrial power supplies; microcontroller; multi-model inference; real-time classification; TinyML},
	keywords = {Classification (of information); Classifiers; Complex networks; Decision trees; Edge computing; Electric fault currents; Embedded systems; Failure analysis; Flash memory; Gateways (computer networks); Intelligent systems; Learning systems; Support vector machines; Edge computing; Embedded machine learning; Embedded machines; Faults detection; Industrial power supplies; Machine-learning; Multi-model inference; Real- time; Real-time classification; Tinyml; Fault detection; Microcontrollers},
	issn = {10482334},
	isbn = {979-833157544-1},
	coden = {CPAEE},
	language = {English},
