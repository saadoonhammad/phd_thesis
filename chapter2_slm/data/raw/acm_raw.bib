@inproceedings{10.1145/3630138.3630531,
author = {Liu, Huizhong and Ren, Yaheng and Zhao, Hang and Kang, Yaoxing and Wu, Lilong},
title = {Application research of digital Twin Technology based on Data assimilation method},
year = {2024},
isbn = {9781450399951},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3630138.3630531},
doi = {10.1145/3630138.3630531},
abstract = {With the rapid development of information technologies such as 5G, big data, cloud computing, AIoT, and Geographic Information Systems (GIS), digital twin technology has received unprecedented attention and application as an effective approach to connect the physical and virtual worlds. Digital twin is essentially a digital model of a physical entity that maintains consistency with the physical counterpart. In order to achieve a precise mapping of the physical entity, a series of measures and algorithm models need to be adopted, and data assimilation provides an effective solution by integrating the observable states of the real-world object with the digital twin model to enhance the reliability of the twin model's output states. This article introduces the application methods and research status of data assimilation in digital twin, and makes preliminary discussions on the pressing issues that need to be addressed in the application of data assimilation methods in digital twin.},
