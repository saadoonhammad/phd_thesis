@inproceedings{10.1145/3795154.3795310,
author = {Wang, Dong and Zhang, Rongbing and Chai, Yuan},
title = {Review of the Application of Artificial Intelligence Technology in the Intelligent Management of the Entire Production Line: Systematic Evolution from Perception to Decision-making},
year = {2026},
isbn = {9798400719981},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3795154.3795310},
doi = {10.1145/3795154.3795310},
abstract = {With the promotion of Industry 4.0 and dual-carbon goals, traditional production line management faces bottlenecks in efficiency, quality control, and energy optimization. This paper systematically reviews artificial intelligence applications in intelligent whole-line management, proposing a three-layer technical architecture (perception-execution, transmission-integration, and intelligent decision-making). It analyzes eight core technical elements (machine vision, predictive maintenance, digital twins, reinforcement learning scheduling, edge computing, generative AI, collaborative robotics, and intelligent supply chains) and explores four key application scenarios (full-process quality inspection, flexible production, supply chain collaboration, and process innovation). Furthermore, it summarizes challenges such as data quality and system integration complexity along with countermeasures. This work provides theoretical references and practical guidance for high-quality development in intelligent manufacturing.},
booktitle = {Proceedings of the 2025 6th International Conference on Computer Science and Management Technology},
pages = {956–961},
numpages = {6},
keywords = {Artificial Intelligence, Energy consumption monitoring, Energy optimization, Full production line management},
location = {
},
series = {ICCSMT '25}
}

