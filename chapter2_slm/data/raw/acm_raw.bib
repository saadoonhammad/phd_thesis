@inproceedings{10.1145/3803291.3803295,
author = {Shah, Syed Tahir Ali and Santos, Jos\'{e} Paulo Oliveira and Constantinescu, Gabriel and Fernandes, Jos\'{e} Maria Amaral and Pereira, Antonio Manuel de Bastos},
title = {Physio-Digital Twin for Human-Centered IoT Mobility: A Proof-of-Concept Implementation on the E-Bike Platform},
year = {2026},
isbn = {9798400722523},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803291.3803295},
doi = {10.1145/3803291.3803295},
abstract = {Human-centered Internet of Things (IoT) technologies are becoming increasingly critical for sustainable mobility and health monitoring. This paper presents the design and proof of concept of a Physio-Digital Twin (PDT) integrated into the E-Bike platform, combining physiological sensing (heart rate (HR) and heart rate variability (HRV)), embedded artificial intelligence, and adaptive mobility control. The PDT models a rider’s physiological and behavioral state in real time to dynamically adjust electric-assist torque and lighting conditions. Building upon recent advancements in Human Digital Twins (HDTs) for rehabilitation and generative-AI-enabled IoT-healthcare frameworks, this study demonstrates how physiological feedback can enhance both user well-being and system sustainability. A single-participant proof of concept demonstrates the feasibility of the approach; preliminary trends suggest lower HRV-derived stress and higher perceived comfort under adaptive operation. These qualitative findings highlight the potential of embedding human physiological intelligence directly into IoT-based mobility systems and motivate broader, multi-participant validation.},
booktitle = {Proceedings of the 2026 9th International Conference on Information and Computer Technologies},
pages = {494–500},
numpages = {7},
keywords = {Physio-Digital Twin, Human-Centered IoT, Sustainable Mobility, Embedded AI, Wearable Sensors, Proof of Concept},
location = {
