@inproceedings{10.1145/3789418.3789452,
author = {Torres Medina, Karen T. and S\'{a}nchez Orozco, Daniela E. and Mera Collantes, Mar\'{\i}a I.},
title = {It's a Big Tiny(ML) World in Industry 4.0 and 5.0},
year = {2026},
isbn = {9798400719615},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3789418.3789452},
doi = {10.1145/3789418.3789452},
abstract = {As machine learning becomes more prevalent, edge computing has become more important towards the goal of ubiquitous AI. In order to understand the landscape, we propose a new taxonomy for studying current technologies that can be optimized for resource-constrained devices, specifically deploying TinyML. Through an organized investigation, we aim to introduce new insights into the panorama of current research TinyML implementations and applications in Industry 4.0 and 5.0. This work identifies the most common techniques and tools, along with challenges and opportunities for future developments and proposes a taxonomy where the main axis is in field model adaptability, which serves the shift to ubiquitous computing in Industry 4.0/5.0.},
booktitle = {Proceedings of the 9th International Conference on Algorithms, Computing and Systems},
pages = {276–283},
numpages = {8},
keywords = {Edge AI, Edge Computing, Industry 4.0, Industry 5.0, TinyML, Ubiquitous Computing},
location = {
