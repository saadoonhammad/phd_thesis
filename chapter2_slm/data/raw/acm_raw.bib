@inproceedings{10.1145/3628797.3628930,
author = {Nguyen, Thanh Binh and Nguyen, Duc Dang Khoi and Le Nguyen, Binh Nguyen and Le, Tan},
title = {A Machine Learning-Based Anomaly Packets Detection for Smart Home},
year = {2023},
isbn = {9798400708916},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3628797.3628930},
doi = {10.1145/3628797.3628930},
abstract = {The advent of smart homes has revolutionized residential living, integrating advanced technologies and intelligent devices to create secure, comfortable, and efficient environments. However, this integration of diverse smart devices has brought significant cybersecurity challenges. Detecting and analyzing abnormal network packets have become paramount, signifying potential intrusions, malicious activities, or system errors and ensuring the security and stability of smart home systems. Machine learning techniques, such as Decision Trees, Support Vector Machines (SVM), Convolutional Neural Networks (CNN), K-Nearest Neighbors (KNN), Recurrent Neural Networks (RNN), and Random Forests, have shown promise in addressing these challenges. However, most research has concentrated on anomaly detection rather than malicious activity in smart homes. The vast datasets collected from various scenarios pose methodological and algorithmic challenges for applying machine learning techniques. To fill these research gaps, our study introduces traditional machine-learning methods for detecting abnormal network packets in smart homes using the IoT-23 dataset. It involves preprocessing the dataset, extracting relevant features, and training various machine learning models. The correlation matrix helps validate the feature selection of the best models based on performance metrics like precision, F1-score, recall, accuracy ratio, training score, and training time cost. Additionally, the study classifies 12 types of malicious malware across different machine learning models, considering performance within the context of smart home devices. This study implements real-time anomaly detection on the Raspberry Pi using packet captures and Zeek flowmeter methods. The findings contribute insights into models suitable for smart home security. In addition, our research enhances the understanding and application of machine learning methods for bolstering security in smart homes.},
booktitle = {Proceedings of the 12th International Symposium on Information and Communication Technology},
pages = {816–823},
numpages = {8},
keywords = {Anomaly Detection, Cybersecurity, IoT-23 Dataset, Machine Learning, Smart Homes},
location = {Ho Chi Minh, Vietnam},
series = {SOICT '23}
}

@inproceedings{10.1145/3620666.3651328,
author = {Giordano, Massimo and Doshi, Rohan and Lu, Qianyun and Murmann, Boris},
title = {TinyForge: A Design Space Exploration to Advance Energy and Silicon Area Trade-offs in tinyML Compute Architectures with Custom Latch Arrays},
year = {2024},
isbn = {9798400703867},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3620666.3651328},
doi = {10.1145/3620666.3651328},
abstract = {The proliferation of smart IoT devices has given rise to tinyML, which deploys deep neural networks on resource-constrained systems, benefitting from custom hardware that optimizes for low silicon area and high energy efficiency amidst tinyML's characteristic small model sizes (50-500 KB) and low target frequencies (1-100 MHz). We introduce a novel custom latch array integrated with a compute memory fabric, achieving 8 μm2/B density and 11 fJ/B read energy, surpassing synthesized implementations by 7x in density and 5x in read energy. This advancement enables dataflows that do not require activation buffers, reducing memory overheads. By optimizing systolic vs. combinational scaling in a 2D compute array and using bit-serial instead of bit-parallel compute, we achieve a reduction of 4.8x in area and 2.3x in multiply-accumulate energy. To study the advantages of the proposed architecture and its performance at the system level, we architect tinyForge, a design space exploration to obtain Pareto-optimal architectures and compare the trade-offs with respect to traditional approaches. tinyForge comprises (1) a parameterized template for memory hierarchies and compute fabric, (2) estimations of power, area, and latency for hardware components, (3) a dataflow optimizer for efficient workload scheduling, (4) a genetic algorithm performing multi-objective optimization to find Pareto-optimal architectures. We evaluate the performance of our proposed architecture on all of the MLPerf Tiny Inference Benchmark workloads, and the BERT-Tiny transformer model, demonstrating its effectiveness in lowering the energy per inference while addressing the introduced area overheads. We show the importance of storing all the weights on-chip, reducing the energy per inference by 7.5x vs. utilizing off-chip memories. Finally, we demonstrate the potential of the custom latch arrays and bit-serial digital compute arrays to reduce by up to 1.8x the energy per inference, 2.2x the latency per inference, and 3.7x the silicon area.},
booktitle = {Proceedings of the 29th ACM International Conference on Architectural Support for Programming Languages and Operating Systems, Volume 3},
pages = {1033–1047},
numpages = {15},
keywords = {tinyML, on-device inference, design space exploration, memory hierarchy, custom latch arrays, energy latency and area optimization},
location = {La Jolla, CA, USA},
series = {ASPLOS '24}
}

@inproceedings{10.1145/3762329.3762346,
author = {Li, Xiuyi},
title = {Machine Learning-Driven Predictive Maintenance for China's Large Aircraft: Theories, Challenges, and Strategic Applications},
year = {2025},
isbn = {9798400718625},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3762329.3762346},
doi = {10.1145/3762329.3762346},
abstract = {With the rapid development of China's aviation industry, domestically produced large aircraft are gradually emerging in the passenger market. In the context of increasingly complex aircraft systems and heightened operational requirements, traditional scheduled maintenance methods can no longer deliver the safety, reliability, and cost-effectiveness needed. Predictive maintenance, which is driven by data analysis and intelligent algorithms offers a forward-looking approach to ensuring safe operation, reducing unplanned downtime, and lowering maintenance costs. This paper explores the theoretical foundations and practical applications of predictive maintenance for China's large aircraft. Through the analysis of selected case studies, we summarize the strengths and limitations of current practices and propose a feasible strategy centered on data fusion, intelligent monitoring, and collaborative decision-making. Our findings provide timely insights into further upgrading maintenance technology and strengthening overall operational assurance in the domestic aviation sector.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence of Things and Computing},
pages = {90–94},
numpages = {5},
keywords = {China's large aircraft, Deep Neural Networks, Support Vector Machine, intelligent monitoring, predictive maintenance},
location = {
},
series = {AITC '25}
}

@inproceedings{10.1145/3708282.3708298,
author = {Li, Hua and Wu, Zhengrong and Yang, Chen and Yang, Xianzhi and Yang, Yuxuan},
title = {Research on Security Protection of Electric Power IoT Terminals Based on Cloud-edge-end Collaboration},
year = {2025},
isbn = {9798400709869},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3708282.3708298},
doi = {10.1145/3708282.3708298},
abstract = {Conventional electric power Internet of Things terminal security protection monitoring point deployment a choice of fixed-point protection or regional protection processing, the scope of protection is restricted, resulting in low protection efficiency, so the design and practice of the electric power Internet of Things terminal security protection method based on the cloud-side-end collaboration is proposed. According to the current security protection needs, the combination monitoring method is adopted to break the limitations of traditional security protection processing, deploy the combination of security protection monitoring points, and carry out the pre-processing of real-time data. On this basis, a cloud-side-end cooperative power IoT terminal security protection model is designed, and adaptive enhancement processing is used to realize security protection. The test results show that compared with the traveling wave protection method of phase characteristic high-voltage direct current transmission system and the protection method of ground fault identification and localization of multi-terminal synchronous measurement traction network, the safety protection method of cloud-side-terminal cooperative electric power Internet of things terminal finally achieves a relatively high frequency of protection, which indicates that with the assistance and support of the cloud-side-terminal cooperative technology, the safety protection method of the current design is more targeted, and the coverage of protection is increased, which has the advantage of being more effective and efficient. This indicates that with the assistance and support of cloud-side-end collaboration technology, the designed security protection method is more targeted and the coverage of protection is increased, which has practical application value.},
booktitle = {Proceedings of the 2024 International Conference on Artificial Intelligence of Things and Computing},
pages = {86–91},
numpages = {6},
keywords = {Cloud-side-end collaboration, Network scheduling, Power internet of things, Real-time monitoring, Security protection, Terminal security},
location = {
},
series = {AITC '24}
}

@inproceedings{10.1145/3803291.3803381,
author = {Schr\"{o}der, Jan and Schmidt-Colberg, Amelie and Breu, Sebastian and Schiller, Jochen},
title = {Machine Learning in Botnet Intrusion Detection for IoT Botnets: A Literature Review in Context of the Evaluation},
year = {2026},
isbn = {9798400722523},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803291.3803381},
doi = {10.1145/3803291.3803381},
abstract = {In intrusion detection research, a popular approach is the detection of botnets using machine learning. This method of anomaly detection aims to differentiate between benign and malicious traffic based on behavioral patterns. We analyze this process by examining the machine learning models, datasets, and evaluation techniques used, and by comparing them to the challenges of real-world applications. Our findings reveal that it is not feasible to directly compare signature-based intrusion detection systems with anomaly-based systems in a research context. Additionally, we highlight that only 3 out of the 300 analyzed publications adopt different approaches for training, testing, and evaluating machine learning models. Our primary focus is on the evaluation methods employed in these publications, how the evaluations are explained, and whether they are comprehensible. Furthermore, we identify key challenges and propose ways to improve the evaluation process.},
booktitle = {Proceedings of the 2026 9th International Conference on Information and Computer Technologies},
pages = {468–475},
numpages = {8},
keywords = {machine learning, intrusion detection, systematic literature review, botnet},
location = {
},
series = {ICICT 2026}
}

