@inproceedings{10.1145/3812836.3814786,
author = {Huynh, Cong Bang and Martins Gomes, Damien and Lampe, Rodolphe and De Closets, Martin and Sausset, Fran\c{c}ois and Lorin, St\'{e}phane},
title = {Design and Deployment of Lightweight Neural Speech Enhancement and AI Codecs on GAP9 for Ultra-Low-Bitrate Edge Communication},
year = {2026},
isbn = {9798400727122},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3812836.3814786},
doi = {10.1145/3812836.3814786},
abstract = {Reliable voice communication on ultra-low-power edge devices remains challenging due to extremely constrained bandwidth and limited computational resources. Traditional low-bitrate vocoders such as MELP introduce perceptible artifacts, while modern neural codecs achieve high quality but are too computationally intensive for embedded platforms. In this work, we present two complementary AI-based solutions targeting real-time execution on the GAP9 processor. First, MELoP\'{e}e is a lightweight neural post-processing module that takes as input the speech signal synthesized by the MELP vocoder and learns to correct its characteristic coding artifacts, improving perceptual quality with fewer than 1M parameters and 0.13 GMAC/s.. Second, Sisyphe is a full AI-based codec integrating a recurrent bitrate reduction module, operating at 600 bits/s while maintaining audio quality. We detail architectural choices, quantization strategies, and porting challenges on GAP9, and show that MELoP\'{e}e achieves real-time processing with 32 ms latency and minimal degradation compared to the original model. Objective metrics (PESQ) and informal listening tests confirm significant improvements over MELP, demonstrating the feasibility of deploying advanced neural audio models on sub-50 mW edge processors.},
booktitle = {Proceedings of the 24th Annual International Conference on Mobile Systems, Applications and Services Workshops},
pages = {355–360},
numpages = {6},
keywords = {embedded speech processing, real-time audio, low-power edge devices, neural speech enhancement, AI audio codec, ultra-low-bitrate, edge AI, GAP9},
location = {University of Cambridge, Cambridge, United Kingdom},
series = {MobiSys Workshop '26}
