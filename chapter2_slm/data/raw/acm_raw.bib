@inproceedings{10.1145/3779208.3785270,
author = {Saka, Suleiman and Das, Sanchari},
title = {SoK: Reviewing Two Decades of Security, Privacy, Accessibility, and Usability Studies on Internet of Things for Older Adults},
year = {2026},
isbn = {9798400723568},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3779208.3785270},
doi = {10.1145/3779208.3785270},
abstract = {The Internet of Things (IoT) has the potential to enhance older adults' independence and quality of life, but it also exposes them to security, privacy, accessibility, and usability (SPAU) risks. We conducted a systematic review of 44 peer-reviewed studies published between 2004 and 2024 using a five-phase screening pipeline. From each study, we extracted data on study design, IoT type, SPAU measures, and identified research gaps. We introduce the SPAU-IoT Framework, which comprises 27 criteria across four dimensions: security (e.g., resilience to cyber threats, secure authentication, encrypted communication, secure-by-default settings, and guardianship features), privacy (e.g., data minimization, explicit consent, and privacy-preserving analytics), accessibility (e.g., compliance with ADA/WCAG standards and assistive-technology compatibility), and usability (e.g., guided interaction, integrated assistance, and progressive learning). Applying this framework revealed that more than 70% of studies implemented authentication and encryption mechanisms, whereas fewer than 50% addressed accessibility or usability concerns. We further developed a threat model that maps IoT assets, networks, and backend servers to exploit vectors such as phishing, caregiver exploitation, and weak-password attacks, explicitly accounting for age-related vulnerabilities including cognitive decline and sensory impairment. Our results expose a systemic lack of integrated SPAU approaches in existing IoT research and translate these gaps into actionable, standards-aligned design guidelines for IoT systems designed for older adults.},
booktitle = {Proceedings of the ACM Asia Conference on Computer and Communications Security},
pages = {98–115},
numpages = {18},
keywords = {IoT, Older Adults, Security, Privacy, Accessibility, Usability},
location = {Bangalore, India},
series = {ASIA CCS '26}
}

@inproceedings{10.1145/3812836.3815166,
author = {Behera, Adarsh Prasad and Champati, Jaya Prakash Varma and Gross, James},
title = {A Simulation Driven Evaluation of Three-tier Hierarchical Inference Learning Framework},
year = {2026},
isbn = {9798400727122},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3812836.3815166},
doi = {10.1145/3812836.3815166},
abstract = {Distributed inference systems leverage hierarchical architectures spanning device, edge, and cloud to balance accuracy, latency, and resource cost. While prior work on Hierarchical Inference (HI) has primarily focused on two-tier designs, practical deployments often involve multiple models with varying capabilities. In this paper, we present a simulation-based study of a three-tier HI framework comprising two on-device models and a high-accuracy cloud model, enabling finer-grained inference decisions. We formulate the problem as an online threshold-based HI framework, where confidence scores from each model determine whether inputs are processed locally or escalated to the upper tier. An exponential weighted forecaster (EWF) strategy is used to adapt thresholds over time. We evaluate the proposed framework on CIFAR-10 and ImageNet-1K datasets under varying cost regimes. Results show that the threetier system consistently achieves near-oracle performance and outperforms all two-tier baselines by effectively handling moderate-difficulty samples at the intermediate tier. Furthermore, we observe that different feedback mechanisms yield similar average costs despite producing distinct inference acceptance patterns, indicating the presence of multiple cost-equivalent operating points. These findings demonstrate the practical advantages of three-tier HI and provide insights for designing efficient distributed ML systems.},
booktitle = {Proceedings of the 24th Annual International Conference on Mobile Systems, Applications and Services Workshops},
pages = {249–255},
numpages = {7},
keywords = {hierarchical inference, online learning, threshold selection},
location = {University of Cambridge, Cambridge, United Kingdom},
series = {MobiSys Workshop '26}
}

