abstract = {Under the “Dual Carbon” goals, public buildings represent a major sector for energy consumption and carbon emissions in the construction industry, making energy-efficient and low-carbon development of public buildings a critical priority for China's low-carbon urban development objectives. To address challenges such as the lack of real-time user behavior interaction, prolonged operation of HVAC and lighting systems in unoccupied spaces, and inappropriate temperature settings in public buildings. This study proposes an&nbsp;AI-based intelligent edge autonomous control system for smart public buildings. This system, designed around user behavior, integrates&nbsp;artificial intelligence, machine learning, the Internet of Things (IoT), big data, cloud computing, and digital twin technologies&nbsp;to establish a&nbsp;real-time, self-updating building model with automated control. It could&nbsp;ensure compatibility between public building environments and user scenarios while delivering an effective solution for energy conservation and carbon reduction. The system employs&nbsp;millimeter-wave radar sensors&nbsp;to &nbsp;autonomously&nbsp; detect and assess&nbsp; occupancy, temperature, humidity, illuminance, and&nbsp;air quality within public building spaces. Additionally, it utilizes&nbsp;AI-powered edge computing&nbsp;to perform 24/7 automated decision-making for offices, meeting rooms, and open areas based on zonal management objectives and user behavior patterns, issuing real-time control commands to terminal devices to achieve energy and emission reductions. A pilot implementation in an office building validated the system's feasibility, with energy performance data demonstrating that the&nbsp;intelligent edge autonomous control system&nbsp;enables&nbsp;zonal management, effectively resolving delays in environmental energy management and minimizing energy waste. The system&nbsp;reduces operational energy consumption and carbon emissions by over 25%, confirming its significant impact on public building sustainability.},
booktitle = {Proceedings of the 2025 8th International Conference on Computer Information Science and Artificial Intelligence},
pages = {784–790},
numpages = {7},
keywords = {AI technology, Carbon reduction, Edge automatic control, Energy conservation, Smart public buildings},
location = {
},
series = {CISAI '25}
}

