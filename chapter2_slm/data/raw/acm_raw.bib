@article{10.1145/3801741,
author = {Alamir, Roba and Noor, Ayman and Almukhalfi, Hanan and Almukhlifi, Reham and Noor, Talal H.},
title = {AI-Enhanced Cybersecurity in Edge Computing: Threats, Solutions, and Future Directions},
year = {2026},
issue_date = {August 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {58},
number = {11},
issn = {0360-0300},
url = {https://doi.org/10.1145/3801741},
doi = {10.1145/3801741},
abstract = {Edge Computing (EC) is revolutionizing applications ranging from smart cities to autonomous vehicles by enabling real-time data processing at the network edge. However, as EC continues to expand, it introduces significant cybersecurity challenges due to its decentralized architecture and resource constraints. This survey examines the primary security threats to EC systems and reviews defense frameworks proposed to mitigate these risks. In this article, we present a generic EC security architecture that evaluates 21 recently proposed research prototypes using multiple assessment criteria (i.e., those we have identified) across perception/monitoring, detection/protection, and defense functional layers. We analyze cybersecurity prototypes for EC through a structured qualitative and quantitative comparative analysis to highlight patterns using frequency distributions. Additionally, we identify key gaps in the current research, such as the need for scalable, efficient solutions and improved integration of heterogeneous devices. Finally, the survey provides insights into future research directions to strengthen edge computing security, offering valuable perspectives for researchers.},
journal = {ACM Comput. Surv.},
month = apr,
articleno = {274},
numpages = {48},
keywords = {Cyberattacks, edge computing, internet of things, machine learning, deep learning, federated learning, intrusion, detection, protection}
}

