  author={Huang, Xiang-Rui and Chen, Liang-Bi},
  journal={IEEE Access}, 
  title={FA-FENet: A Feature Attention Front-End Network Based on a Lightweight CNN Architecture for Recognizing Abnormal Underwater Illegal Fishing Behavior}, 
  year={2025},
