@INPROCEEDINGS{10696520,
  author={Ru, Hongyuan and Chen, Jiaxiang and Sun, Zexu and Tai, Shuo and Zhao, Wei and Kumar, Roshan},
  booktitle={2024 Control Instrumentation System Conference (CISCON)}, 
  title={A Wood Anomaly Detection System Based on Electrical Resistivity Tomography and Tiny Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper aims to investigate the detection of internal voids or decay anomalies in wood using Electrical Resistivity Tomography (ERT) and Tiny Machine Learning (TinyML). It proposes an anomaly detection method suitable for large-scale target detection, aiming to achieve multi-tree detection and automated detection of targets. The ERT tree detection model is simulated using COMSOL and MATLAB software. Based on the obtained boundary voltage data, a machine learning model is generated using NanoEdge AI Studio to simulate the detection of internal anomalies in trees. Finally, control circuits and control programs are designed, and the machine learning model is deployed on STM32G4 series microcontrollers. In the simulation detection using NanoEdge AI, 15 sets of anomalies are detected out of 16 sets of data for the multi-cavity model. The tree anomaly detection method based on Electrical Resistivity Tomography and Tiny Machine Learning can effectively detect anomalies in trees. TinyML conserves embedded system resources during multi-target detection, enabling low power consumption and real-time processing.},
  keywords={Resistance;Tiny machine learning;Vegetation;Forestry;Tomography;Mathematical models;Real-time systems;Data models;Integrated circuit modeling;Anomaly detection;electric resistivity tomography;tiny machine learning;anomaly detection;embedded systems;wood nondestructive testing},
  doi={10.1109/CISCON62171.2024.10696520},
  ISSN={},
  month={Aug},}@ARTICLE{10591982,
  author={Awaisi, Kamran Sattar and Ye, Qiang and Sampalli, Srinivas},
  journal={IEEE Access}, 
  title={A Survey of Industrial AIoT: Opportunities, Challenges, and Directions}, 
  year={2024},
  volume={12},
  number={},
  pages={96946-96996},
  abstract={Internet of Things (IoT) is an important technology employed in a variety of different applications, such as transportation, healthcare, and manufacturing. In recent years, the number of IoT devices deployed globally has been increasing at a rapid pace and is estimated to reach 20 billion by the end of 2025. In modern industry, IoT plays a pivotal role by monitoring the condition of industrial machines and, consequently, improving the efficiency of industrial processes. To optimize the efficiency of industrial IoT applications, various Artificial Intelligence (AI) techniques have been adopted, leading to a new computing paradigm, namely, Industrial Artificial Intelligence of Things (i.e. Industrial AIoT). In this paper, we describe the challenges to tackle and the opportunities to explore in Industrial AIoT. Specifically, we first review the use of state-of-the-art AI methods in Industrial AIoT applications, with a focus on Deep Learning (DL) and Machine Learning (ML) techniques. Thereafter, we present a series of important applications of Industrial AIoT. The key challenges associated with the implementation of Industrial AIoT applications are also discussed. In addition, the societal and economic impacts of Industrial AIoT are briefly described. Finally, we outline the future research directions in Industrial AIoT, which should be further investigated to fully utilize the potential of this innovative technology.},
  keywords={Artificial intelligence;Industrial Internet of Things;Sensors;Industries;Monitoring;Logic gates;Internet of Things;Machine learning;Deep learning;Internet of Things (IoT);industrial internet of things (IIoT);artificial intelligence (AI);artificial intelligence of things (AIoT);industrial AIoT;machine learning (ML);deep learning (DL)},
  doi={10.1109/ACCESS.2024.3426279},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11416230,
  author={Khadam, Umair and Davidsson, Paul and Spalazzese, Romina},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Towards a Framework for Assessing the Intelligence Level of IoT Systems}, 
  year={2025},
  volume={},
  number={},
  pages={788-793},
  abstract={While the integration of Artificial Intelligence (AI) and Internet of Things (IoT) is rapidly increasing, there is no general framework for assessing the intelligence level of AI-enabled IoT systems. However, assessing the intelligence level of Artificial Intelligence of Things (AIoT) systems, e.g., their ability to make predictions, take autonomous decisions or to provide decision support, is crucial for making informed design choices or comparing different AIoT systems. In this study we propose AIoT-SIA, a novel capability-based framework for assessing the intelligence level of AIoT systems. It is based on 13 AI tasks identified in a previous study where we analyzed 93 research articles. For each AI task we have extracted the metrics used in the articles for assessing the AIoT systems’ capability to perform the task. For AI tasks where no metrics were reported, we conducted a new search to identify widely accepted assessment metrics. Our AIoT-SIA framework is (i) a structured capability-and metric-based way to assess the intelligence of AIoT systems and (ii) a useful tool enabling comparison. The framework is beneficial for different stakeholders, such as AIoT (hardware and software) systems engineers and managers across various application domains.},
  keywords={Measurement;Refining;Radar;Software systems;Performance metrics;Robustness;Internet of Things;Stakeholders;Artificial intelligence;Systematic literature review;Artificial Intelligence;Internet of Things;Framework;Assessing intelligence;Artificial Intelligence of Things (AIoT) systems},
  doi={10.1109/AIoT66900.2025.00123},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11091675,
  author={Fernandez, Sheena and Vallejo, Marta and Lim, Theodore},
  booktitle={2025 10th International Conference on Smart and Sustainable Technologies (SpliTech)}, 
  title={Exploring the Boundaries of Resource-Constrained AIoT: Tiny Machine Learning for Condition Monitoring using 8-bit and 32-bit Microcontrollers}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Tiny machine learning (TinyML) emerges as an innovation that gives more autonomy to edge devices, which are typically low-powered and low-memory. With most developments focused on 32-bit devices, this work queries the performance and effectiveness of 8-bit devices to provide equal, if not more, benefit in terms of cost and power consumption, in exploiting all available resources in a small device. The research interest was deploying a multilayer perceptron model for multivariate time series prediction in 8-bit and 32-bit devices with evaluation of the limitations of neural network modelling in 8-bit microcontrollers. A gas-based early fire detection TinyML device was designed as a use case, to monitor the condition of an indoor environment. With only 32 kilobytes flash memory, the findings suggest that artificial intelligence (AI) tasks generally requiring a larger power source and network endpoints bridge could now be realized on-device at a fraction of computing resource utilization. Given the challenges of sustainability in electronics, this study hopes to contribute to reconcile reducing energy-hungry AI models that would otherwise be difficult to run. A proving ground is the smallest off-the-shelf microcontroller available capable of TinyML applications, and that crucial consideration of each factor in the implementation can help optimize costs and materials.},
  keywords={Performance evaluation;Costs;Power demand;Microcontrollers;Smart cities;Tiny machine learning;Data models;Internet of Things;Artificial intelligence;Monitoring;artificial intelligence;artificial intelligence of things;anomaly detection;condition monitoring;microcontrollers;tiny machine learning},
  doi={10.23919/SpliTech65624.2025.11091675},
  ISSN={},
  month={June},}@INPROCEEDINGS{10733513,
  author={Putra, Pristian Dwi},
  booktitle={2024 International Conference on Technology and Policy in Energy and Electric Power (ICTPEP)}, 
  title={Implementation of Audio Classification Using Tiny Machine Learning for Predictive Maintenance in Muara Karang Power Plant}, 
  year={2024},
  volume={},
  number={},
  pages={79-84},
  abstract={The Muara Karang Power Plant Block 1 in Jakarta, owned by PLN Nusantara Power, is encountering increasing operational complexity, necessitating an efficient monitoring system. In response to PLN Nusantara Power's digitalization program, this research explores the implementation of Tiny Machine Learning (TinyML) and Edge-AI technologies to enhance operational efficiency and reliability. These technologies utilize audio sensors for real-time anomaly detection and predictive maintenance of power generation equipment. The system is implemented at Muara Karang Power Plant Block 1 in H2 Plant, using the Wio Terminal hardware platform connected to an audio sensor. Data is processed through the Edge-Impulse platform to train machine learning models at the edge, then transmitted via MQTT to Node-RED for further processing. The processed data is stored in MySQL for long-term analysis and displayed on a Grafana dashboard. TinyML technology is anticipated to improve equipment management and maintenance, boost operational efficiency, and mitigate downtime risks. This research employs the Mel-Filterbank Energy (MFE) method and a Neural Network Classifier, achieving 100% accuracy and low RAM consumption (19.7 KB). Data from the Wio Terminal can be stored in MySQL via Node-RED, displayed in the Grafana Dashboard, and sent to WhatsApp for alarms and notifications. This study underscores the potential of TinyML in enhancing power plant monitoring systems and suggests further exploration into its broader applications.},
  keywords={Tiny machine learning;Image edge detection;Neural networks;Random access memory;Sensor systems;Real-time systems;Sensors;Power generation;Monitoring;Predictive maintenance;tiny machine learning;edge-AI;predictive maintenance;mel-filterbank energy;neural network classifier},
  doi={10.1109/ICT-PEP63827.2024.10733513},
  ISSN={},
  month={Sep.},}@ARTICLE{10105989,
  author={Shen, Meng and Gu, Aijing and Kang, Jiawen and Tang, Xiangyun and Lin, Xiaodong and Zhu, Liehuang and Niyato, Dusit},
  journal={IEEE Internet of Things Journal}, 
  title={Blockchains for Artificial Intelligence of Things: A Comprehensive Survey}, 
  year={2023},
  volume={10},
  number={16},
  pages={14483-14506},
  abstract={With the rapid advances in information and communication technologies, the Internet of Things (IoT) has become large and complex, bearing tremendous amounts of data and running devices in various scenarios. Leveraging artificial intelligence (AI) technologies, IoT can achieve superior information extraction, data analytics, and decision making, which has resulted in the revolutionized AI of Things (AIoT). AIoT can alleviate the pressure of storage, computation, and communication. Despite the promising features brought by combining AI technologies into IoT infrastructure, AIoT systems still face some serious challenges including inadequate efficiency, violation of security and privacy, lack of trust, and insufficient incentive. Blockchain featured by its distributed consensus and incentive mechanisms can be a promising technology for addressing the challenges in AIoT. AIoT employing blockchain is evolving with expectations of achieving efficient, secure, and trusted network activities. In this article, we first introduce the background of AIoT and blockchain. Then, we discuss the motivations for employing blockchain with its characteristics in AIoT. Furthermore, we comprehensively review existing solutions on blockchain for AIoT systems from the aspects of efficiency, security, privacy, trust, and incentive. Finally, we discuss the challenges and future research directions on blockchain for AIoT.},
  keywords={Internet of Things;Artificial intelligence;Blockchains;Security;Data privacy;Cloud computing;Servers;Artificial Intelligence of Things (AIoT);blockchain;deep learning (DL);machine learning (ML)},
  doi={10.1109/JIOT.2023.3268705},
  ISSN={2327-4662},
  month={Aug},}@INPROCEEDINGS{11205746,
  author={Medeiros, Morsinaldo and Medeiros, Thaís and Silva, Marianne and Silva, Ivanovitch and Gaffurini, Massimiliano and Brandão, Dennis and Ferrari, Paolo},
  booktitle={2025 IEEE 30th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={MST and MPT: Lightweight Incremental Algorithms for Multivariate Anomaly Detection and Correction on TinyML Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The Internet of Things (IoT) generates massive multivariate time series data requiring real-time anomaly detection and correction for reliable monitoring. This challenges resource-constrained embedded devices due to conventional offline training and batch processing. To address this, we propose two algorithms derived from the TEDARLS framework: Multivariate Sequential TEDA (MST) and Multivariate Parallel TEDA (MPT). Derived from the TEDARLS framework, both enable on-device detection and correction of multivariate anomalies within TinyML constraints. A case study with real vehicular sensor data demonstrated low inference times and consistent embedded behavior. Supervised metrics were only assessed on synthetic data. MPT, though more sensitive, introduced greater signal distortions and required significantly longer processing times. Overall, MST demonstrated superior stability and suitability for real-time anomaly correction in resource-constrained IoT environments. This approach addresses an important gap in embedded analytics for IoT by enabling lightweight, accurate, and autonomous anomaly detection and correction at the edge.},
  keywords={Measurement;Tiny machine learning;Image edge detection;Time series analysis;Real-time systems;Stability analysis;Inference algorithms;Internet of Things;Vehicle dynamics;Anomaly detection;IoT;TinyML;Multivariate Time Series;Anomaly Detection;Embedded Systems},
  doi={10.1109/ETFA65518.2025.11205746},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{11542487,
  author={Albaiz, Abdulrahman and Amsaad, Fathi},
  booktitle={2026 IEEE 2nd International Conference on Secure IoT, Assured and Trusted Computing (SATC)}, 
  title={K-Means Based Tinyml Anomaly Detection and Distributed Model Reuse via the Distributed Internet of Learning (DIoL)}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents a lightweight K-Means anomaly detection model and a distributed model-sharing workflow designed for resource-constrained microcontrollers (MCUs). Using real power measurements from a mini-fridge appliance, the system performs on-device feature extraction, clustering, and threshold estimation to identify abnormal appliance behavior. To avoid retraining models on every device, we introduce the Distributed Internet of Learning (DIoL), which enables a model trained on one MCU to be exported as a portable, text-based representation and reused directly on other devices. A two-device prototype demonstrates the feasibility of the “Train Once, Share Everywhere” (TOSE) approach using a real-world appliance case study, where Device A trains the model and Device B performs inference without retraining. Experimental results show consistent anomaly detection behavior, negligible parsing overhead, and identical inference runtimes between standalone and DIoL-based operation. The proposed framework enables scalable, low-cost TinyML deployment across fleets of embedded devices.},
  keywords={Modeling;Training;Anomaly detection;Home appliances;Memory;Tiny machine learning;Learning (artificial intelligence);Printing;Loading;Internet of Things;TinyML;anomaly detection;microcontroller;KMeans clustering;embedded machine learning;DIoL;distributed learning},
  doi={10.1109/SATC69565.2026.11542487},
  ISSN={},
  month={March},}@ARTICLE{10684143,
  author={Yap, Yan Siang and Ahmad, Mohd Ridzuan},
  journal={IEEE Sensors Letters}, 
  title={Modified Overcomplete Autoencoder for Anomaly Detection Based on TinyML}, 
  year={2024},
  volume={8},
  number={10},
  pages={1-4},
  abstract={This letter explores the architecture of tiny machine learning (TinyML). Deploying machine learning into embedded devices is challenging due to the limited computation power and memory space. An experimental setup has been designed for the anomaly detection of a USB fan. We collect the normal data from a USB fan, and abnormal data are simulated using a broken fan blade. Two different speeds, namely, speed 1 and speed 2, have been used to collect the normal data and abnormal data. The normal data collected are used to train the standard autoencoder model and our proposed model modified overcomplete asymmetric autoencoder (MOA), respectively. The trained model is then deployed into a microcontroller, i.e., Arduino Nano 33 BLE Sense. The proposed MOA can achieve 99.23% accuracy, recall of 99.70%, precision of 98.77%, F1 score of 99.23%, and false positive rate of 1.222%. Besides that, our MOA model only occupies 17 kB. Therefore, it can be fitted into most microcontrollers for embedded applications.},
  keywords={Training;Decoding;Microcontrollers;Tiny machine learning;Accuracy;Computer architecture;Autoencoders;Mechanical systems;Sensors;Mechanical sensors;anomaly detection;autoencoder (AE);embedded system;tiny machine learning (TinyML)},
  doi={10.1109/LSENS.2024.3463977},
  ISSN={2475-1472},
  month={Oct},}@INPROCEEDINGS{11277514,
  author={Almaini, Amar and Folz, Jakob and Ashour, Ghadeer},
  booktitle={2025 5th International Conference on Electrical, Computer, Communications and Mechatronics Engineering (ICECCME)}, 
  title={TinyML for Acoustic Anomaly Detection in IoT Sensor Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Tiny Machine Learning enables real-time, energyefficient data processing directly on microcontrollers, making it ideal for Internet of Things sensor networks. This paper presents a compact TinyML pipeline for detecting anomalies in environmental sound within IoT sensor networks. Acoustic monitoring in IoT systems can enhance safety and context awareness, yet cloud-based processing introduces challenges related to latency, power usage, and privacy. Our pipeline addresses these issues by extracting Mel Frequency Cepstral Coefficients from sound signals and training a lightweight neural network classifier optimized for deployment on edge devices. The model was trained and evaluated using the UrbanSound8K dataset, achieving a test accuracy of 91% and balanced F1-scores of 0.91 across both normal and anomalous sound classes. These results demonstrate the feasibility and reliability of embedded acoustic anomaly detection for scalable and responsive IoT deployments.},
  keywords={Training;Privacy;Tiny machine learning;Pipelines;Acoustics;Real-time systems;Safety;Internet of Things;Reliability;Anomaly detection;Tiny Machine Learning;Internet of Things;Sensor Networks;Edge Computing;Acoustic Anomaly Detection},
  doi={10.1109/ICECCME64568.2025.11277514},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11416368,
  author={Najafiragheb, Noushin and Jaziri, Mohamed Ali and Pandurino, Andrea and Bucciero, Alberto},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Clustering-Aided Classification and Anomaly Detection of Smart Office Patterns Using Environmental Sensor Data}, 
  year={2025},
  volume={},
  number={},
  pages={690-694},
  abstract={This paper proposes a multi-stage AIoT pipeline for identifying working and non-working conditions indoors from indoor environment sensor readings. The approach combines unsupervised K-Means clustering pattern identification, supervised learning models such as XGBoost and SVM for prediction, and anomaly detection by Isolation Forest and rule-based filters. A nine-month data set captured from an office in ISPC-CNR Lecce, including temperature, humidity, sound, and light (Lux) measurements, was analyzed at six sampling rates and diverse feature configurations. Classification accuracy values higher than 99%, even without Lux, are reported; anomalies lower cluster consistency and model performance; and the presented pipeline demonstrates that clustering, classification, and anomaly detection can work together to enable robust, label-efficient, and adaptive edge environmental monitoring.},
  keywords={Temperature measurement;Accuracy;Image edge detection;Pipelines;Supervised learning;Forestry;Predictive models;Internet of Things;Artificial intelligence;Anomaly detection;AIoT;KMeans clustering;anomaly detection;smart office monitoring;supervised learning;environmental sensing},
  doi={10.1109/AIoT66900.2025.00106},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9428792,
  author={Ogu, Reginald E. and Ikerionwu, Charles I. and Ayogu, Ikechukwu I.},
  booktitle={2020 IEEE 2nd International Conference on Cyberspac (CYBER NIGERIA)}, 
  title={Leveraging Artificial Intelligence of Things for Anomaly Detection in Advanced Metering Infrastructures}, 
  year={2021},
  volume={},
  number={},
  pages={16-20},
  abstract={The integration of more sensory and actuation components to the Smart Grid produces high volume of data. Consequently, this big data stretches the transmission, processing, and storage capabilities of the Smart Grid infrastructures. The vulnerability of advanced metering infrastructures (AMIs) is on the rise, as more devices are connected to the Internet these days. The aforementioned realities have continued to necessitate a debate on the future of cloud-centered artificial intelligence (AI) services for latency-sensitive user-centric IoT applications. It is rapidly becoming necessary to leverage on the applicability of EdgeAI directly on IoT sensory nodes involved in energy metering. This paper proposes the applicability of Artificial Intelligence situated on smart meter, to perform micro analytics at the edge of AMI networks: Artificial Intelligence of Things. Therefore, a functional AMI model based on IoT and EdgeAI is presented herein. Additionally, an integration architecture for the anticipated Smart Grid based on IoT and EdgeAI is presented. On implementation, the proposed model would provide high performance analytics and Edge computing capabilities to enable AMIs initiate instant data check at the source and relay relevant real-time data to the Utility through the Internet.},
  keywords={Image edge detection;Computational modeling;Computer architecture;Smart meters;Real-time systems;Smart grids;Internet of Things;Edge computing;Energy Consumption;Intelligent systems;Internet of Things;Smart Grids},
  doi={10.1109/CYBERNIGERIA51635.2021.9428792},
  ISSN={},
  month={Feb},}@ARTICLE{10261398,
  author={Pereira, Eduardo S. and Marcondes, Leonardo S. and Silva, Josemar M.},
  journal={IEEE Micro}, 
  title={On-Device Tiny Machine Learning for Anomaly Detection Based on the Extreme Values Theory}, 
  year={2023},
  volume={43},
  number={6},
  pages={58-65},
  abstract={The significance of anomaly detection is particularly pronounced in Industry 4.0 applications. For instance, in manufacturing, the timely detection of equipment malfunctions can prevent costly downtime and maintain production efficiency. In energy systems, spotting anomalies in power consumption patterns can enhance resource allocation and optimize energy usage. Equally noteworthy is the ascendancy of tiny machine learning (TinyML), emerging as a potent tool for real-time anomaly detection, exemplifying its versatile utility. This work presents an unsupervised on-device learning TinyML algorithm, drawing inspiration from the extreme value theory. The algorithm leverages the two-parameter Weibull distribution function to efficiently identify anomalies within discrete time series data. Optimal hyperparameters are ascertained via grid search methodology. Notably, employing synthetic data with randomized anomalies elucidates the algorithm’s proficiency in binary classification within time series, highlighting an accuracy of 99.80%, recall of 93.10%, and F1 score of 96.43%. The amalgamation of theoretical foundations from the extreme value theory and practical capabilities of TinyML accentuates its pertinence across a broad spectrum of domains.},
  keywords={Anomaly detection;Classification algorithms;Real-time systems;Training;Machine learning algorithms;Time series analysis;Special issues and sections;Fourth Industrial Revolution;Machine learning;Microcontrollers;Tiny machine learning},
  doi={10.1109/MM.2023.3316918},
  ISSN={1937-4143},
  month={Nov},}@ARTICLE{11251009,
  author={Toe, Elisée and Jaafar, Fehmi and Charles André Ferrier, Laurent},
  journal={IEEE Internet of Things Journal}, 
  title={Securing LoRaWAN in the AIoT Era: A Systematic Mapping Study and an MITRE-Based Threat Matrix}, 
  year={2026},
  volume={13},
  number={3},
  pages={3827-3849},
  abstract={The rapid expansion of the Internet of Things (IoT) has established long-range wide-area network (LoRaWAN) as a leading low-power, long-range communication protocol across critical domains such as smart cities, agriculture, and healthcare. However, its minimalist design and reliance on unlicensed spectrum expose vulnerabilities across the entire protocol stack from physical-layer jamming to medium access control (MAC)-layer spoofing and application-layer firmware attacks. Concurrently, the rise of the Artificial Intelligence of Things (AIoT) introduces opportunities to reinforce LoRaWAN security via decentralized, intelligent, and adaptive mechanisms. This article presents a systematic mapping study of 81 peer-reviewed publications (2020–2025), conducted using a Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA)-based methodology. Our objectives are to: 1) identify key trends and research directions in LoRaWAN security; 2) propose an MITRE ATT&CK-inspired taxonomy tailored to the LoRaWAN stack; 3) analyze AIoT-based security contributions; and 4) highlight unresolved challenges and future perspectives. Our findings indicate that 62% of documented cyberattacks target the MAC layer, exploiting vulnerabilities such as static keys and weak integrity checks. AI-driven techniques, including radio frequency fingerprinting (RFF) [97% accuracy using convolutional neural networks (CNNs)], federated learning for anomaly detection, and blockchain-based key management—show promise but raise concerns about scalability and deployment on constrained devices. We introduce the first MITRE ATT&CK-LoRaWAN matrix, detailing 18 attack techniques [e.g., energy depletion and rogue gateways (GWs)] and associated countermeasures, including postquantum Kyber-1024 encryption. Finally, we discuss major technical, methodological, and interoperability challenges and suggest actionable research directions toward secure, AI-native, and resilient LoRaWAN infrastructures.},
  keywords={Internet of Things;LoRaWAN;Artificial intelligence;Security;Network servers;Servers;Logic gates;Cloud computing;Taxonomy;Systematics;Artificial Intelligence of Things (AIoT);Internet of Things (IoT) security;long-range wide-area network (LoRaWAN);MITRE ATT&CK;postquantum cryptography;Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA)},
  doi={10.1109/JIOT.2025.3633940},
  ISSN={2327-4662},
  month={Feb},}@INPROCEEDINGS{11484235,
  author={Linda, C. Harriet and Dalton Griffin, S. and Sam Emmanuel, W. R.},
  booktitle={2026 Innovations in Machine, Engineering, and Digital Conference (IMED)}, 
  title={LC-PGI: A Generative AI Framework for Low-Carbon Optimization in Artificial Intelligence of Things (AIoT) Environments}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The concept of carbon neutrality is gaining more and more attention globally, and this is one of the reasons for the need for an intelligent energy optimization framework to be created within the Artificial Intelligence of Things (IoT). Presently, the low-carbon management practices are often associated with limited adaptability, shallow temporal reasoning, and insufficient generative insight, which in turn slow down the process of effective decision-making. To address these drawbacks, an advanced framework for Generative AI—LC-PGI, has been suggested as a way to conduct low-carbon optimization comprehensively in the AIoT environments. The integration of multi-source datasets like industrial energy consumption and vehicle emission data is done via a unified data fusion process. A mixed model development stage which includes Reliability Classification and Generative Insight Modeling (LLM-based reasoning) is used for enhancing both the predictive accuracy and interpretability. The experimental results demonstrate the excellent performance of LC-PGI with Accuracy=99.17%, precision=97.94%, and Score=97.73%, which also shows its potential for providing reliable, adaptive, and carbon-efficient AIoT decision-making. The framework offers actionable insights and scenario-based recommendations for low-carbon operations.},
  keywords={Adaptation models;Smoothing methods;Generative AI;Decision making;Predictive models;Cognition;Internet of Things;Reliability;Optimization;Principal component analysis;Low-Carbon AIoT;Generative AI;Predictive Modeling;LC-PGI;Generative Insight},
  doi={10.1109/IMED68921.2026.11484235},
  ISSN={},
  month={March},}@INPROCEEDINGS{11118459,
  author={Lima, João Pedro B},
  booktitle={2025 IEEE Latin Conference on IoT (LCIoT)}, 
  title={Real-Time Fault Detection in Induction Motors Using TinyML: An Evaluation of the Edge Impulse Platform}, 
  year={2025},
  volume={},
  number={},
  pages={31-34},
  abstract={This article evaluates the Edge Impulse platform for developing TinyML-based fault detection models in induction motors, focusing on identifying broken rotor bars using vibration data collected from the motor casing. The study aims to assess the platform’s capabilities in creating non-intrusive, real-time detection systems implemented on low-power microcontrollers, such as the Arduino Nano 33 BLE, for resource-constrained industrial environments. Using the platform’s tools, an artificial neural network model was trained with real vibration data and optimized for embedded implementation. The model achieved 98.6% accuracy for detecting four broken bars and 95.8% accuracy for the more complex case of detecting a single broken bar, operating within the memory limits of the device and maintaining low detection latencies. Quantization, applied through Edge Impulse’s workflow, successfully reduced latency to 1 ms for the four-bar fault without significantly compromising accuracy, but it caused a substantial accuracy drop for the single-bar fault, highlighting limitations in handling more complex scenarios. This evaluation demonstrates the practicality and constraints of using the Edge Impulse platform for industrial IoT applications, particularly in designing TinyML solutions for fault detection.},
  keywords={Vibrations;Accuracy;Quantization (signal);Induction motors;Image edge detection;Fault detection;Tiny machine learning;Real-time systems;Data models;Bars;edge Impulse;fault detection;induction motors;IoT platforms;low-power devices;machine learning;real-time monitoring;TinyML;vibration data},
  doi={10.1109/LCIoT64881.2025.11118459},
  ISSN={},
  month={April},}@ARTICLE{10193761,
  author={Wang, Bo and Li, Hongtao and Liu, Ximeng and Guo, Yina},
  journal={IEEE Internet of Things Journal}, 
  title={FRAD: Free-Rider Attacks Detection Mechanism for Federated Learning in AIoT}, 
  year={2024},
  volume={11},
  number={3},
  pages={4377-4388},
  abstract={The rapid development of the Artificial Intelligence of Things (AIoT) opens up a new perspective for emerging service-based applications and becomes a major driver of diverse federated learning (FL) applications. However, due to the heterogeneity of nodes and the existence of free-rider attacks, some device nodes may launch free-rider attacks to obtain the global model without any contribution, which not only dampens the enthusiasm of legitimate participants but also undermines the fairness of node contributions. In this article, we propose a free-rider attack detection (FRAD) mechanism for FL with deep autoencoding Gaussian mixture model (DAGMM) based on contribution and reputation. Specifically, we first model the contribution values based on the computing resource, communication cost, and data quality of each device node. Then, based on PageRank algorithms, we design an optimal reputation-based model to fairly and precisely choose benign nodes to participate in federated training under information asymmetry. Furthermore, we develop the FRAD mechanism via DAGMM that combines historical contribution with reputation scores. Simulation results validate that the proposed mechanism in this article outperforms the state-of-the-art baselines  $(\sim \!\! 2.14\times $  and  $\sim \!\! 1.1\times $  on MNIST and CIFAR, respectively) in defending against free-rider attacks, and when the main clients are free-riders, i.e., 50% or even up to 80% of the free-riders, FRAD can still maintain a high defense performance against free-rider attacks.},
  keywords={Computational modeling;Servers;Data models;Training;Anomaly detection;Internet of Things;Federated learning;Anomaly detection;Artificial Intelligence of Things (AIoT);federated learning (FL);free-rider attacks},
  doi={10.1109/JIOT.2023.3298606},
  ISSN={2327-4662},
  month={Feb},}@INPROCEEDINGS{9906504,
  author={Chang, Kai-Jie and Chuang, Chung-Wei and Chiu, Jun-Tung and Chen, Jen-Yeu},
  booktitle={2022 IEEE VTS Asia Pacific Wireless Communications Symposium (APWCS)}, 
  title={Flying Watchdog: A Drone with Edge AIoT for Residential Safety and Fall Detection by Face and Posture Recognition}, 
  year={2022},
  volume={},
  number={},
  pages={181-185},
  abstract={The high accuracy of applying deep learning on image recognition induces a variety of useful applications amid which incorporating the maneuverability and mobility of drones or UAVs for real-time monitoring can further extend the coverage of surveillance into some areas that fixed cameras cannot be installed or high resolution image cannot be obtained. Therefore, this paper proposes a system named Flying Watchdog which applying deep learning to online recognition on the images extracted from the video recorded by a drone, the flying watchdog, which can recognize a target of interest and then automatically flies toward it for further inspection. The functions of our system, like a real watchdog, consists of two major themes: home security and autonomous company. The drone with a camera on board to record the real-time surveillance video is the terminal device in an Artificial Intelligence of Things (AIoT) system. Due to the limited computing capability of a drone, through a wireless network, the video then streaming back to a mobile phone or a laptop that acting as an Edge AI computing server to execute the required procedures such as target recognition, decision, adequate alarms as well as user notifications and the drone’s maneuver control for tracking targets. By the mature deep learning model, FaceNet, friends or family members can be accurately distinguished from strangers or intruders and by the model of OpenPose, falling down of people under guard will be immediately detected. Whenever such abnormalities are found, the Edge AI computing server will immediately send notification messages to the mobile App. on corresponding users’ (masters’) mobile phone. Furthermore, the drone, the flying watchdog, can autonomously track the people of interest such as a stranger for further inspection or warning or a person under guard for detecting the possible fall. The proposed system, Flying Watchdog, is well implemented and tested and is proved to be helpful to home security and a loyal, selfless, trustworthy companion to its human masters.},
  keywords={Deep learning;Target recognition;Computational modeling;Surveillance;Streaming media;Real-time systems;Security;Edge AI;Edge AIoT;AIoT;drone;UAV;smart home;smart healthcare;elder care;computer vision;deep learning;Internet of Things;mobile App},
  doi={10.1109/APWCS55727.2022.9906504},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11590210,
  author={Arora, Siddharth and Gagana, B R and Khan, Fahim and Srivastava, Harshit and Pattankar, Veena V and Goswami, Neelam},
  booktitle={2026 International Conference on Next Generation Electronics (NELEX)}, 
  title={Energy-Efficient TinyML Framework for Real-Time Anomaly Detection in Embedded Electronic Devices}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The increasing deployment of Internet of Things (IoT) and embedded electronic systems has created a growing need for efficient and reliable anomaly detection mechanisms capable of operating under strict computational and energy constraints. Traditional cloud-based monitoring approaches often introduce latency, communication overhead, and energy inefficiencies, limiting their suitability for real-time embedded applications. To address these challenges, this paper proposes an energy-efficient Tiny Machine Learning (TinyML) framework for real-time anomaly detection in embedded electronic devices. The proposed system integrates a lightweight convolutional neural network architecture with model optimization techniques, including pruning and quantization, enabling efficient deployment on microcontroller-class hardware. The framework processes sensor data locally through a pipeline consisting of data acquisition, preprocessing, feature extraction, and TinyML-based inference, thereby reducing dependency on remote cloud infrastructure. Experimental evaluation using NASA C-MAPSS turbofan engine degradation dataset demonstrates that the proposed approach achieves 95% detection accuracy, outperforming conventional machine learning models such as Support Vector Machines, Random Forest, and standard Convolutional Neural Network (CNN) architectures. Furthermore, the optimized TinyML implementation significantly reduces inference latency and energy consumption, making it suitable for low-power embedded environments. The results highlight the potential of TinyML-enabled intelligent monitoring systems to enhance the reliability and efficiency of next-generation embedded electronics and IoT devices.},
  keywords={Modeling;Tiny machine learning;Internet of Things;Anomaly detection;Optimization;Machine learning;Timing;Machining;Convolutional neural networks;Printing;TinyML;Embedded Anomaly Detection;Edge Intelligence;Energy-Efficient Deep Learning;IoT Monitoring Systems},
  doi={10.1109/NELeX69209.2026.11590210},
  ISSN={},
  month={May},}@INPROCEEDINGS{11379483,
  author={Chaitanya, D and Odeh, Mahmoud and Babu, T Ashok and Harshini, M and V, Asha and Kavuri, Venkata Ramaiah},
  booktitle={2025 2nd International Conference on Artificial Intelligence and Knowledge Discovery in Concurrent Engineering (ICECONF)}, 
  title={An Enhanced Tiny ML Framework with Deep FL Supported Real-Time Anomaly Detection in an IoT Environment}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={TinyML, FL, and cutting-edge deep learning for resource-efficient anomaly identification in agriculture and industry which combines and we created the an Enhanced TinyML Framework with Deep FL Supported Real- Time Anomaly Detection in an IoT Environment (ETDFAD) model. Starting with the preparation of datasets, images of chicken eggs were standardized to enhance robustness for practical use. U sing the lightweight ‘TensorFlores' framework, the model maximizes deployment on resource-limited hardware such the Arduino Nano 33 BLE Sense focusing on training and optimized power consumption, ensuring long runtime in remote environments. A customized Federated Averaging (F edA vg) algorithm accounts for device diversity and minimizes slower node impact, ensuring project scalability. The ETDFAD also allows for specific anomaly detection in metallurgical facilities using a GLMS and Bidirectional LSTM integration, effectively capturing dependencies in vibration data. The following parameters are used such as training and validation accuracy and loss, precision-recall curve, ROC Curve and its performance is calculated.},
  keywords={Training;Vibrations;Accuracy;Runtime;Tiny machine learning;Scalability;Bidirectional long short term memory;Agriculture;Security;Anomaly detection;TinyML;FL;Federated Averaging (FedAvg);GLMS and Bidirectional LSTM},
  doi={10.1109/ICECONF65644.2025.11379483},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9613450,
  author={Yauri, Ricardo and Acosta, Rubén and Jurado, Marco and Rios, Milton},
  booktitle={2021 IEEE Engineering International Research Conference (EIRCON)}, 
  title={Evaluation of Principal Component Analysis Algorithm for Locomotion Activities Detection in a Tiny Machine Learning Device}, 
  year={2021},
  volume={},
  number={},
  pages={1-4},
  abstract={Data generated by human locomotion activities is a process that involves the analysis of hundreds or thousands of data in a reduced time, due to the very nature of the signals generated and the techniques for implementing classification models and event detection. It is advisable to try to reduce the number of characteristics or select the most important elements of the captured signals showing, in this paper, the use of principal component analysis (PCA) techniques. The use of machine learning techniques for reduced hardware devices in intelligent environments, allows generating a solution for the non-invasive supervision of activities, complementing the use of PCA with other classification algorithms suitable for the treatment of data with a high number of characteristics such as support vector machines (SVM). Therefore, the evaluation of PCA processes and SVM algorithms is shown, selecting the one that has the best performance during its implementation in IoT devices with low hardware resources. Finally, it is considered that the memory space consumed in the IoT device and the execution time of the processes are critical elements to make the comparison and contrast of the PCA models, allowing to select and develop a reliable and efficient model in small devices of IoT.},
  keywords={Support vector machines;Training;Machine learning algorithms;Memory management;Random access memory;Machine learning;Predictive models;Embedded System;Edge computing;Internet of Thing;Principal Component Analysis;Tiny Machine Learning;Support Vector Machine},
  doi={10.1109/EIRCON52903.2021.9613450},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11416455,
  author={Padder, Shahid Gulzar and Modem, Sudhakar},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Building Intelligence: Smart Anomaly Detection in HVAC Systems for Fault Prevention}, 
  year={2025},
  volume={},
  number={},
  pages={866-870},
  abstract={Building Management Systems (BMS) necessitate transformation into smart, self-regulating platforms due to the growing demand for sustainable infrastructure. In this paper, the primary objective of the intelligent Building Management System (BMS) framework for a 20-ton refrigeration (20 TR) system at IIT Jammu is to detect anomalies and prevent system faults through the integration of Internet of Things (IoT) and machine learning (ML) technologies. Traditional BMS implementations are typically governed by rule-based logic, which lacks the adaptability needed to handle dynamic environmental and operational conditions. The proposed approach employs multi-modal sensing, edge processing, and cloud-based analytics to enable real-time anomaly detection, fault diagnosis, and predictive maintenance across HVAC (heating, ventilation, and air conditioning) systems using data from Temperature and Relative Humidity (T & RH) sensors, British Thermal Unit (BTU) meters, and energy meters. A specialized in-house dashboard and digital twin are developed to monitor the operation, diagnostics, and performance of the 20 TR system. Among the tested algorithms—Z-score, Isolation Forest, Local Outlier Factor (LOF), and One-Class Support Vector Machine (SVM)—the Z-score method demonstrated the best performance for the BTU meters data, the One-Class SVM showed superior results for the T & RH data, and the hybrid SVM–Z-score approach delivered the most robust and accurate detection for the energy meters data.},
  keywords={Meters;Temperature sensors;Support vector machines;HVAC;Machine learning algorithms;Machine learning;Internet of Things;Jamming;Anomaly detection;Building management systems;Building Management System;IoT;HVAC;Anomaly Detection;Energy Management;Machine Learning},
  doi={10.1109/AIoT66900.2025.00140},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11098440,
  author={Ćojbašić, Emilija Ž. and Jovanović, Andela M. and Sibinović, Vladimir D. and Ćojbašić, Žarko M.},
  booktitle={2025 60th International Scientific Conference on Information, Communication and Energy Systems and Technologies (ICEST)}, 
  title={TinyML and IIoT Based Product Quality Classification for Food Industry}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={An important problem that most industrial systems face is requirement for real-time processing of large amounts of data and a rapid inference response with minimal latency. Simultaneously, in widely adopted artificial intelligence/machine learning (AI/ML) implementation in industrial control and robotics, there is a clear recent shift from cloud computing to edge computing due to safety, reliability and other aspects. This is challenging, as small edge devices have limited hardware capabilities to process large amounts of data within limited timeframes and for deployment and execution of large machine learning models. The paper introduces an approach based on TinyML (Tiny Machine Learning), an emerging branch of machine learning that allows models to run on small, resource constrained devices, for a product classification problem in the food industry. The proposed solution also relies on IIoT (Industrial Internet of Things) for connecting industrial devices. Compared to our previously published results for similar problems which are based on powerful embedded platforms, the approach adopted here demonstrates an attempt to utilize affordable, lightweight hardware as an alternative, while still maintaining required performance. The proposed system is suitable for edge computing tasks in food industry applications due to its low power consumption, availability and cost effectiveness. The suggested approach allows for prompt anomaly detection and advances automation efforts in practical industrial settings.},
  keywords={Service robots;Tiny machine learning;Food industry;Hardware;Real-time systems;Safety;Reliability;Anomaly detection;Industrial Internet of Things;Edge computing;TinyML;Edge Computing;Industrial IoT;Object Recognition;Anomaly Detection;Food Industry},
  doi={10.1109/ICEST66328.2025.11098440},
  ISSN={2603-3267},
  month={June},}@INPROCEEDINGS{11014445,
  author={Amininasab, Mehdi and Fazeli, Mahdi and Patooghy, Ahmad},
  booktitle={2025 26th International Symposium on Quality Electronic Design (ISQED)}, 
  title={Sharp-Edge: A Robust Edge Computing Solution Through Performance Monitoring Using Tiny Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Conventional reliability improvement methods might not be efficient solutions for Edge systems where limited hardware and processing resources are available. To address this gap, this paper proposes the application of performance monitoring metrics of the central processing unit used in Edge devices for reliability improvement purposes. We have utilized the performance monitoring toolset, PERF, along with the LLFI fault injection tool to inject a variety of fault models into a prototypical Edge processor while running Mibench benchmark programs. The injected faults are used to collect a dataset showcasing the behavior of the system under various reliability conditions. The collected dataset is then used to train machine learning models that can help with runtime monitoring and detection of possible fault situations on the Edge system. Our experiments show that trained models can achieve a high fault detection accuracy of 91.5%. Implementations of the tiny machine-learning models showed that we can keep accuracy above 90% while model summarization methods helped save more than 80% of the model parameters.},
  keywords={Accuracy;Runtime;Image edge detection;Computational modeling;Fault detection;Tiny machine learning;Hardware;Reliability;Monitoring;Edge computing;Reliability;Fault Detection;Machine Learning;Edge Devices;Tiny ML},
  doi={10.1109/ISQED65160.2025.11014445},
  ISSN={1948-3295},
  month={April},}@INBOOK{11345323,
  author={Joshua, Richard Govada and Gbadega, Peter Anuoluwapo and Imoize, Agbotiname Lucky and Tofade, Samuel Oluwatobi},
  booktitle={Tiny Machine Learning: Design Principles and Applications}, 
  title={TinyML for Anomaly Detection}, 
  year={2026},
  volume={},
  number={},
  pages={85-162},
  abstract={Summary <p>Tiny machine learning (TinyML) is revolutionizing anomaly detection by enabling the deployment of intelligent models directly on edge devices, especially within Internet of Things (IoT) systems. This chapter explores the integration of TinyML in real&#x2010;time monitoring systems, where low&#x2010;latency responses and reduced communication overheads are crucial. TinyML offers key advantages, including energy efficiency, enhanced privacy, and the ability to operate with minimal reliance on cloud resources. It enables anomaly detection in time&#x2010;series and image data using machine learning models that can be adapted to constrained environments through techniques such as model quantization and one&#x2010;class learning. Despite its potential, TinyML faces several challenges, including limited memory and processing power, as well as data availability and preprocessing constraints on the edge. In the context of edge computing (EC), which allows for processing directly on IoT devices, TinyML plays a pivotal role in Artificial Intelligence of Things (AIoT). This field focuses on implementing machine and deep learning models on microcontroller units (MCUs), facilitating anomaly detection at the data source. A systematic literature review of 20 research papers from 2021 to 2024 sheds light on various anomaly detection techniques and their applications in EC. The review encompasses essential aspects, including the types of machine learning (ML) and deep learning (DL) models employed, data sources for model training, microcontroller hardware, power supply methods, and communication technologies. The study also develops a taxonomy of ML/DL algorithms used for anomaly detection in TinyML and examines the benefits and challenges faced in applying these techniques to constrained devices. This comprehensive analysis offers valuable insights into the expanding role of TinyML in deploying scalable, real&#x2010;time anomaly detection systems across various IoT applications.</p>},
  keywords={Tiny machine learning;Anomaly detection;Real-time systems;Security;Biomedical monitoring;Internet of Things;Medical services;Cloud computing;Industries;Image edge detection},
  doi={10.1002/9781394294572.ch3},
  ISSN={},
  publisher={IEEE},
  isbn={9781394294565},
  url={https://ieeexplore.ieee.org/document/11345323},}@ARTICLE{11483188,
  author={Peng, Tsui and Lin, Ching-Huang and Wei, Yu-Chih and Chen, Bo-Chang and Yeh, Jen-Yu},
  journal={IEEE Access}, 
  title={Low-Overhead Passive Resilience Monitoring for AIoT Gateways: End-to-End Anomaly Detection via eBPF Timing Traces and Autoencoders}, 
  year={2026},
  volume={14},
  number={},
  pages={61753-61771},
  abstract={Modern AIoT services are vulnerable to complex, cross-domain failures spanning wireless sensor networks, edge AI inference, and cloud reporting. Conventional monitoring typically relies on isolated single-node metrics that lack an integrated end-to-end perspective, or on exhaustive active probing that incurs prohibitive resource overhead. To address this gap, this paper presents a lightweight, gateway-centric resilience-monitoring framework that provides comprehensive end-to-end observability purely at the edge. By hooking into kernel-level TCP state transitions via Linux eBPF, the proposed system decouples network-induced delays from application computational bottlenecks. We reconstruct fine-grained discrete latency segments—including device-to-gateway transmission ( $T_{de}$ ), IoT service execution ( $T_{is}$ ), AI inference ( $T_{ai}$ ), and cloud reporting ( $T_{ec}$ )—completely eliminating injected measurement traffic. Based on these non-intrusive metrics, we design a hybrid detection architecture: i) protocol-oriented static thresholds for immediate, interpretable localization of hard outages, and ii) a window-based behavioral layer integrating Autoencoders (AE) and Cumulative Sum (CUSUM) to handle subtle concept drifts and coupled performance degradations. Extensive evaluations on a physical AIoT testbed demonstrate that the framework localizes failures with minimal CPU overhead (less than 1%). Furthermore, the learning-based layer successfully captures the elusive performance fluctuations arising from the dynamic interplay between network conditions and edge computing workloads. Ultimately, this approach facilitates a paradigm shift from reactive failure handling to proactive early warning and autonomous anomaly detection, offering a highly deployable foundation for robust AIoT operations.},
  keywords={Payloads;Telemetry;Aerospace and electronic systems;Military aircraft;Space technology;Feeds;Central Processing Unit;Filtering;Filters;Electronic circuits;AIoT gateway;anomaly detection;autoencoder;extended Berkeley packet filter (eBPF);operational resilience;passive monitoring},
  doi={10.1109/ACCESS.2026.3685156},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11335962,
  author={B, Sakthi Kumar and J, Logitha Luckshmi V and S, Nagalakshmi and C, Nandhakishore and R, Naveen P},
  booktitle={2025 Third International Conference on Emerging Applications of Material Science and Technology (ICEAMST)}, 
  title={Integrated Safety Helmet with TinyML for RealTime Anomaly Detection in Aviation Crew}, 
  year={2025},
  volume={},
  number={},
  pages={808-812},
  abstract={This paper describes a lightweight smart helmet system designed for aviation personnel to detect cognitive issues like drowsiness, fatigue, and stress in real time using electroencephalography (EEG) signals. The system continuously monitors brain activity through wearable IoTbased sensors and analyzes data onboard without needing cloud connectivity. A pre-trained TinyML model runs on an ESP32 microcontroller to process the EEG data, classifying the user’s mental state with low latency and energy use. When it detects drowsiness, an integrated buzzer in the cockpit alerts the pilot immediately to help regain their attention. The method includes EEG signal acquisition, noise filtering, feature extraction, and neural network-based classification optimized for embedded systems. This method removes reliance on GPS or wireless communication, improving operational reliability in low-connectivity aviation situations. The proposed model acts as a proactive safety measure that helps support crew performance, situational awareness, and adherence to aviation safety standards.},
  keywords={Wireless communication;Head;Microcontrollers;Tiny machine learning;Brain modeling;Electroencephalography;Real-time systems;Safety;Monitoring;Biological neural networks;Aviation safety;EEG;anomaly detection;wearable IoT;TinyML;brain- computer interface;real-time monitoring;and cockpit alert System;smart helmet},
  doi={10.1109/ICEAMST67459.2025.11335962},
  ISSN={},
  month={Nov},}@ARTICLE{10089871,
  author={Danesh Pazho, Armin and Neff, Christopher and Noghre, Ghazal Alinezhad and Ardabili, Babak Rahimi and Yao, Shanle and Baharani, Mohammadreza and Tabkhi, Hamed},
  journal={IEEE Internet of Things Journal}, 
  title={Ancilia: Scalable Intelligent Video Surveillance for the Artificial Intelligence of Things}, 
  year={2023},
  volume={10},
  number={17},
  pages={14940-14951},
  abstract={With the advancement of vision-based artificial intelligence, the proliferation of the Internet of Things connected cameras, and the increasing societal need for rapid and equitable security, the demand for accurate real-time intelligent surveillance has never been higher. This article presents Ancilia, an end-to-end scalable, intelligent video surveillance system for the Artificial Intelligence of Things. Ancilia brings state-of-the-art artificial intelligence to real-world surveillance applications while respecting ethical concerns and performing high-level cognitive tasks in real time. Ancilia aims to revolutionize the surveillance landscape, to bring more effective, intelligent, and equitable security to the field, resulting in safer and more secure communities without requiring people to compromise their right to privacy.},
  keywords={Video surveillance;Internet of Things;Real-time systems;Artificial intelligence;Task analysis;Security;Privacy;Anomaly;application;artificial intelligence;computer vision;edge;Internet of Things (IoT);real time;real world;surveillance},
  doi={10.1109/JIOT.2023.3263725},
  ISSN={2327-4662},
  month={Sep.},}@ARTICLE{10433185,
  author={Capogrosso, Luigi and Cunico, Federico and Cheng, Dong Seon and Fummi, Franco and Cristani, Marco},
  journal={IEEE Access}, 
  title={A Machine Learning-Oriented Survey on Tiny Machine Learning}, 
  year={2024},
  volume={12},
  number={},
  pages={23406-23426},
  abstract={The emergence of Tiny Machine Learning (TinyML) has positively revolutionized the field of Artificial Intelligence by promoting the joint design of resource-constrained IoT hardware devices and their learning-based software architectures. TinyML carries an essential role within the fourth and fifth industrial revolutions in helping societies, economies, and individuals employ effective AI-infused computing technologies (e.g., smart cities, automotive, and medical robotics). Given its multidisciplinary nature, the field of TinyML has been approached from many different angles: this comprehensive survey wishes to provide an up-to-date overview focused on all the learning algorithms within TinyML-based solutions. The survey is based on the Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) methodological flow, allowing for a systematic and complete literature survey. In particular, firstly, we will examine the three different workflows for implementing a TinyML-based system, i.e., ML-oriented, HW-oriented, and co-design. Secondly, we propose a taxonomy that covers the learning panorama under the TinyML lens, examining in detail the different families of model optimization and design, as well as the state-of-the-art learning techniques. Thirdly, this survey will present the distinct features of hardware devices and software tools that represent the current state-of-the-art for TinyML intelligent edge applications. Finally, we discuss the challenges and future directions.},
  keywords={Surveys;Hardware;Systematics;Benchmark testing;Computational modeling;Anomaly detection;Training;Deep learning;Embedded systems;Edge computing;Machine learning;Artificial intelligence;Internet of Things;Micromachining;TinyML;edge intelligence;efficient deep learning;embedded systems},
  doi={10.1109/ACCESS.2024.3365349},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11236910,
  author={Danane, Mouad and Rochdi, Youssef and El Ouadi, Abdelmajid},
  booktitle={2025 11th International Conference on Optimization and Applications (ICOA)}, 
  title={Tiny Machine Learning for Maintenance Applications: A Systematic Literature Review and Optimization Perspectives}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Industry 4.0 has revolutionized maintenance strategies and has brought predictive maintenance (PdM), powered by machine learning, into the limelight as a key technology for operational efficiency. However, the conventional cloud-based ML technology does not come without challenges such as communication delays, operational costs, and energy consumption. Tiny Machine Learning (TinyML) is an optimized implementation for machine learning computation on constrained devices distributed at the edge of the network. This paper contributes a full systematic literature review on TinyML applications in maintenance, with a focus on existing methods and potential optimizations. We reviewed 38 original articles from the Scopus, ScienceDirect, and Web of Science using the PRISMA technique. As a result, CNNs are the leader in this domain, with work largely focused on the vibrational and visual data to detect faults in rotation machineries, solar panels, and infrastructure systems. The optimal challenges are the model size, power efficiency, and environmental adaptability. We discuss the open research issues such as the online learning capability, automatic TinyML framework, multisensor integration, and distributed learning strategy. This comprehensive review offers researchers and industrial users an overview of TinyML to develop autonomous, robust, and energy-efficient maintenance systems.},
  keywords={Fault diagnosis;Adaptation models;Costs;Tiny machine learning;Energy efficiency;Maintenance;Machinery;Optimization;Systematic literature review;Predictive maintenance;TinyML;Predictive Maintenance;Edge Computing;Optimization;Fault Diagnosis;Systematic Literature Review},
  doi={10.1109/ICOA66896.2025.11236910},
  ISSN={2768-6388},
  month={Oct},}@INPROCEEDINGS{11544993,
  author={R, Chithra and R, Sandhiya and J, Sangamithra},
  booktitle={2026 International Conference on Artificial Intelligence and Data Engineering (AIDE)}, 
  title={AIoT-Based Anomaly Detection and Monitoring System for Smart Poultry Farms}, 
  year={2026},
  volume={},
  number={},
  pages={169-172},
  abstract={Poultry farming faces persistent challenges in maintaining optimal environmental conditions and ensuring bird health, often leading to productivity losses due to delayed detection of abnormal situations. This paper presents an AIoT-based Anomaly Detection and Monitoring System for Smart Poultry Farms that integrates Internet of Things sensing with artificial intelligence to enable real-time monitoring and automated control. Environmental parameters including temperature, humidity, and ammonia concentration are continuously collected using IoT sensors and transmitted to a cloud platform. A lightweight 1D-CNN Autoencoder model is employed to learn normal multivariate sensor patterns and identify anomalies based on reconstruction error without requiring labeled data. The proposed system also supports automated actuation of ventilation, water spraying, and heating mechanisms, along with mobile-based alerts and visualization. Experimental validation was conducted using 30 days of real sensor data, comprising approximately 18,000 sequences, collected from a prototype poultry setup. The system achieved over 96% anomaly detection accuracy and reduced average response time from 18.2 s to 5.5 s while improving energy utilization efficiency from 72.3% to 88.5%. These results demonstrate the effectiveness of integrating AI and IoT for early anomaly detection, reduced manual intervention, and improved environmental stability, contributing toward sustainable and intelligent poultry farm management.},
  keywords={Internet of Things;Anomaly detection;Modeling;Image sensors;Printing;Monitoring;Timing;Clouds;Artificial intelligence;Signal detection;AIoT;anomaly detection;smart poultry farming;1D-CNN autoencoder;IoT-based monitoring;cloud-enabled automation},
  doi={10.1109/AIDE69088.2026.11544993},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10744280,
  author={Neto, Almir and Gomes, Luis and Vale, Zita},
  booktitle={2024 22nd International Conference on Intelligent Systems Applications to Power Systems (ISAP)}, 
  title={Virtual Sensor for Door Opening Detection and Anomaly Detection Using Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Currently, several studies are being developed using machine Learning with the aim of replacing real sensors with virtual sensors. One of the biggest challenges is obtaining quality data to enable the system modeling. This article proposes the replacement of a light dependent resistor sensor, applied to a refrigerator, which detects whether the door is open or closed and an anomaly test when the door is forgotten open for too long. The use of tiny machine learning is applied to ESP32 to enable the use of regression and classification models to detect the door opening and anomaly. The tested metrics for the regression were the root mean squared error. The comparative results between the virtual and real sensors are satisfactory with an accuracy of 99.59% for classification and a root mean squared error value of 0.01 for regression. Furthermore, a prototype was developed, and the model was embedded in the ESP32 microcontroller.},
  keywords={Temperature sensors;Temperature measurement;Microcontrollers;Soft sensors;Tiny machine learning;Neural networks;Prototypes;Virtualization;Intelligent sensors;Anomaly detection;Tiny Machine Learning;virtual sensors;internet of things;intelligent devices},
  doi={10.1109/ISAP63260.2024.10744280},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10833526,
  author={Hsain, Achraf and Zaki, Yahya and Abaakil, Othman and Bekkar, Hibat-allah and Chtouki, Yousra},
  booktitle={2024 IEEE Global Conference on Artificial Intelligence and Internet of Things (GCAIoT)}, 
  title={Tiny Machine Learning for Real-Time Aquaculture Monitoring: A Case Study in Morocco}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Aquaculture, the farming of aquatic organisms, is a rapidly growing industry facing challenges such as water quality fluctuations, disease outbreaks, and inefficient feed management. Traditional monitoring methods often rely on manual labor and are time consuming, leading to potential delays in addressing issues. This paper proposes the integration of low-power edge devices using Tiny Machine Learning (TinyML) into aquaculture systems to enable real-time automated monitoring and control, such as collecting data and triggering alarms, and reducing labor requirements. The system provides real-time data on the required parameters such as pH levels, temperature, dissolved oxygen, and ammonia levels to control water quality, nutrient levels, and environmental conditions enabling better maintenance, efficient resource utilization, and optimal management of the enclosed aquaculture space. The system enables alerts in case of anomaly detection. The data collected by the sensors over time can serve for important decision-making regarding optimizing water treatment processes, feed distribution, feed pattern analysis and improve feed efficiency, reducing operational costs. This research explores the feasibility of developing TinyML-based solutions for aquaculture monitoring, considering factors such as sensor selection, algorithm design, hardware constraints, and ethical considerations. By demonstrating the potential benefits of TinyML in aquaculture, our aim is to contribute to the development of more sustainable and efficient farming practices.},
  keywords={Temperature sensors;Tiny machine learning;Water quality;Real-time systems;Sensors;Feeds;Monitoring;Water resources;Aquaculture;Farming;TinyML;Aquaculture;Ecosystem Management;Sustainable Food Production;Environmental Sustainability},
