  isbn={9781394294565},
  url={https://ieeexplore.ieee.org/document/11345355},}@ARTICLE{10525217,
  author={Zhang, Yuxin and Lin, Limei and Huang, Yanze and Wang, Xiaoding and Hsieh, Sun-Yuan and Gadekallu, Thippa Reddy and JalilPiran, Md.},
  journal={IEEE Internet of Things Journal}, 
  title={A Cooperative Vehicle-Road System for Anomaly Detection on Vehicle Tracks With Augmented Intelligence of Things}, 
  year={2024},
  volume={11},
  number={22},
  pages={35975-35988},
  abstract={The Augmented Intelligence of Things (AIoT) is an emerging technology that combines augmented intelligence with the Internet of Things (IoT) to facilitate advanced decision-making processes. In this article, we focus on the detection of vehicle trajectory anomalies in a vehicle-road collaboration system by AIoT, aiming to improve the traffic safety and road operation efficiency. We transmit collaboration data collected by sensors to an IoT server, which enables the effective data analysis for vehicle trajectory information. We propose a self-supervised learning augmented intelligence algorithm to achieve precise and efficient detection of trajectory anomalies. First, we models the traffic road network as a topology graph. Subsequently, we sample the relevant subgraph contexts for each target node through a random walk algorithm. And the subgraphs with higher intimacy scores are selected as the contextual background to be input along with the target node. After that, the anomaly score of each target node is computed through the generative learning module and the contrastive learning module. To evaluate the effectiveness of our anomaly detection approach, we initially conduct pretraining of the model using four widely utilized graph machine learning data sets. The experimental results reveal that our approach surpasses previous methods in the accuracy of identifying graph anomaly nodes. In addition, we carry out our approach on two real traffic data sets with high accuracies of 86.47% and 85.2%, respectively. This result demonstrates the effectiveness of our proposed approach in detecting trajectory anomalies in real traffic scenarios.},
  keywords={Roads;Internet of Things;Collaboration;Anomaly detection;Trajectory;Artificial intelligence;Topology;Anomaly detection;Augmented Intelligence of Things (AIoT);self-supervised learning (SSL);vehicle road collaboration},
  doi={10.1109/JIOT.2024.3398023},
  ISSN={2327-4662},
  month={Nov},}@INPROCEEDINGS{11306897,
  author={Shah, Yashvi and Vasava, Khushi and Pathak, Lakshin and Pathak, Lakshit and Jash, Kahan and Gupta, Rajesh and Tanwar, Sudeep},
  booktitle={2025 IEEE International Conference on Electronics, Computing and Communication Technologies (CONECCT)}, 
  title={LakshyA: Lightweight TinyML-based Framework for Securing Battlefield UAV Networks With 5G}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper introduces a 5G-enabled TinyML framework for UAV communication in the Internet of Battlefield Things (IoBT) to detect and classify cyber-attacks on UAV networks. Based on this framework, the traffic analysis of UAV networks splits the traffic into benign traffic, DoS, and replay attacks in order to enhance safe real-time communication in changing battle fields. The models considered include Support Vector Machine (SVM), Gradient Boosting, TinyML, 1D Convolutional Neural Network (1D CNN), Long ShortTerm Memory (LSTM), Gated Recurrent Units (GRU). TinyML achieves 93.32% accuracy, closely matching 1D CNN with 93.48 % however the proposed model takes only 50 KB against the 250 KB of 1 D CNN and is therefore suitable for resource scarce UAVs. Though TinyML takes slightly longer processing time (37.83s) than 1D CNN(26.09s) it is comparatively faster than LSTM(69.18s) and GRU (74.16 s). In essence, this framework makes use of 5 G connectivity to foster low latency communication in the identification of attacks and realize a solution to support real-time decision making on improving security in the IoBT through the use of UAVs.},
  keywords={Support vector machines;Training;Accuracy;5G mobile communication;Tiny machine learning;Autonomous aerial vehicles;Real-time systems;Internet;Convolutional neural networks;Security;5G;TinyML;Internet of Battlefield Things;UAV communication;DoS attack;replay attack;edge computing;model size;training time;accuracy;attack classification},
  doi={10.1109/CONECCT65861.2025.11306897},
  ISSN={2766-2101},
  month={July},}@INPROCEEDINGS{10799295,
  author={Di Dio, Giuseppe and Faro, Robin and Di Dio, Rosario and Fortuna, Angelo},
  booktitle={2024 IEEE International Conference on Internet of Things and Intelligence Systems (IoTaIS)}, 
  title={Smart Telemedicine Services for Students on University Campus and in Jogging Areas}, 
  year={2024},
  volume={},
  number={},
  pages={224-230},
  abstract={This paper aims to model and implement a smart telemedicine service for students experiencing accidents or health issues on campus or in jogging areas. Unlike traditional systems based on uncertified wrist, finger, or arm measuring devices that merely inform the user and possibly their family and doctor, the proposed service utilizes a care model that combines both engineering and medical insights, adhering to telemedicine regulations set by the Ministry of Health. This approach aims to reduce costs for both medical staff and students and support AI-based alert and anomaly detection systems for timely care. The proposed service is a module of the S3 Campus project supported by EC Regional Funds aiming at developing a platform to provide security and video surveillance services, along with health support and professional visibility opportunities for students on a university campus.},
  keywords={Wrist;Telemedicine;Fingers;Medical services;Video surveillance;Manipulators;Regulation;Security;Internet of Things;Anomaly detection;Telemedicine;Artificial Intelligence of Things (AIoT);Healthcare modeling;Health Anomaly detection},
  doi={10.1109/IoTaIS64014.2024.10799295},
  ISSN={2832-1383},
  month={Nov},}@INPROCEEDINGS{10677583,
  author={Bellavista, Paolo and Dahdal, Simon and Foschini, Luca and Tazzioli, Davide and Tortonesi, Mauro and Venanzi, Riccardo},
  booktitle={2024 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Kubernetes Enhanced Stateful Service Migration for ML-Driven Applications in Industry 4.0 Scenarios}, 
  year={2024},
  volume={},
  number={},
  pages={25-31},
  abstract={State-of-the-art ML-driven applications have shown remarkable effectiveness in enhancing manufacturing processes by detecting operational anomalies in real-time. Nevertheless, these applications place significant demands on computational resources and require constant access to data sources for managing real-time data processing. This often poses challenges in case of service migration between the Cloud and the edge, due to the stateful nature of ML-based software components and their high storage and bandwidth requirements. This paper presents a novel Kubernetes-based framework designed to enable and optimize the migration of stateful services. The framework allows to identify the most critical part of a service component state and to migrate it with very low downtimes that match the strict requirements of ML-driven applications in industrial settings. To demonstrate the practicality and benefits of our approach, we used a real-world ML-driven anomaly detection application as a case study. The efficacy of this migration mechanism is further confirmed through in depth industrial testing, which shows significant reductions in service downtime and improvements in operational continuity. These findings underscore the potential of our enhanced Kubernetes migration framework to tackle the prevalent challenges in contemporary Industry 4.0 environments.},
  keywords={Manufacturing processes;Soft sensors;Image edge detection;Learning (artificial intelligence);Bandwidth;Data processing;Real-time systems;Stateful Service Migration;Industry 4.0;Kubernetes;Anomaly Detection;Machine Learning},
  doi={10.1109/AIoT63253.2024.00015},
  ISSN={},
  month={July},}@INPROCEEDINGS{11106852,
  author={Bolat, Yernazar and Ferdosian, Nasim and Murray, Iain},
  booktitle={2025 International Conference on Smart Applications, Communications and Networking (SmartNets)}, 
  title={Low-Power Microcontroller-Based Decentralized Distributed Sequential Neural Network for Anomaly Detection in Wireless Sensor Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={As IoT applications grow, low-power Microcontroller Units (MCUs) are increasingly used for energy-efficient, local data processing. However, deploying complex Deep Neural Networks (DNNs) on such constrained devices remains challenging due to limited memory, computational power, and energy. Traditional solutions rely on cloud offloading or model compression, which can introduce bandwidth overhead, privacy risks, and accuracy loss. This paper presents a Decentralized Distributed Sequential Neural Network (DDSNN) approach to address these challenges by partitioning a DNN across multiple MCUs, enabling layer-wise, sequential inference without relying on a central coordinator. Unlike other distributed works that are dependent on a central coordinator, making them cluster-based computing, we are the first to implement fully Decentralized Distributed Deep Neural Network inference in Wireless Sensor Networks. To validate DDSNN, we deploy it in a real-world predictive maintenance scenario, where vibration data is analyzed in real-time to predict abnormal operating conditions of an industrial pump. We show that, by using our approach on hardware commonly employed in TinyML applications (under 512 KB of RAM), we achieve 99.01% accuracy, demonstrating the practical feasibility of DDSNN for TinyML deployments in WSNs.},
  keywords={Vibrations;Training;Wireless sensor networks;Accuracy;Tiny machine learning;Pipelines;Random access memory;Artificial neural networks;Robustness;Real-time systems;Distributed Inference;Edge AI;Wireless Sensor Networks;Tiny Machine Learning;IoT;Deep Neural Networks},
  doi={10.1109/SmartNets65254.2025.11106852},
  ISSN={2837-4940},
  month={July},}@INPROCEEDINGS{10976164,
  author={Chong, Kuan Pok and Lai, Chon Hou and Ling, Weibo and Lu, Zhuoqian and Wang, Rui and Wang, Ruoqi and Yu, Yanjun and Testa, Alex and Lam, Chan-Tong and Tang, Su-Kit and Delnevo, Giovanni and Casadei, Roberto and Girau, Roberto and Mirri, Silvia},
  booktitle={2025 IEEE 22nd Consumer Communications & Networking Conference (CCNC)}, 
  title={Experiments of Crowd Detection for Crowd Digital Twins}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The development of a crowd digital twin offers significant potential for enhancing public safety, urban planning, and event management. A key challenge in creating such a digital twin lies in the efficient and accurate acquisition of crowd-related data, particularly through object detection models deployed on resource-constrained devices. Through a series of experiments, we compare TinyML and Edge approaches in terms of detection accuracy, inferencing time, and resource utilization. Our findings highlight the trade-offs inherent in selecting detection models for crowd digital twin applications, underscoring the importance of aligning model choice with specific deployment needs.},
  keywords={Accuracy;Tiny machine learning;Image edge detection;Urban planning;Object detection;Public security;Data models;Digital twins;Resource management;human crowds detection;crowd digital twin;tinyml;edge ml;crowd management;crowd safety},
  doi={10.1109/CCNC54725.2025.10976164},
  ISSN={2331-9860},
  month={Jan},}@INPROCEEDINGS{10761374,
  author={Frizzo, Davide and Borsatti, Francesco and Arcudi, Alessio and De Moliner, Antonio and Oboe, Roberto and Susto, Gian Antonio},
  booktitle={2024 IEEE 8th Forum on Research and Technologies for Society and Industry Innovation (RTSI)}, 
  title={Interpretable Data-Driven Anomaly Detection in Industrial Processes with ExIFFI}, 
  year={2024},
  volume={},
  number={},
  pages={595-600},
  abstract={Anomaly detection (AD) is a crucial process often required in industrial settings. Anomalies can signal underlying issues within a system, prompting further investigation. Industrial processes aim to streamline operations as much as possible, encompassing the production of the final product, making AD an essential mean to reach this goal. Conventional anomaly detection methodologies typically clas-sify observations as either normal or anomalous without providing insight into the reasons behind these classifications. Consequently, in light of the emergence of Industry 5.0, a more desirable approach involves providing interpretable outcomes, enabling users to understand the rationale behind the results. This paper presents the first industrial application of ExIFFI, a recently developed approach focused on the production of fast and efficient explanations for the Extended Isolation Forest (EIF) Anomaly detection method. ExIFFI is tested on two publicly available industrial datasets demonstrating superior effectiveness in explanations and computational efficiency with the respect to other state-of-the-art explainable AD models.},
  keywords={Industries;Technological innovation;Computational modeling;Tiny machine learning;Production;Forestry;Predictive models;Real-time systems;Internet of Things;Anomaly detection;Anomaly Detection;Explainable Artificial Intel-ligence;Industrial Internet of Things},
  doi={10.1109/RTSI61910.2024.10761374},
  ISSN={2687-6817},
  month={Sep.},}@INPROCEEDINGS{11538854,
  author={Ali, Belkhiri and Hasnae, El Khoukhi and Abdelouahed, Sabri My and Yousef, Farhaoui},
  booktitle={2026 6th International Conference on Innovative Research in Applied Science, Engineering and Technology (IRASET)}, 
  title={Embedded Artificial Intelligence for Intelligent Diagnosis of Skin Lesions Using TinyML}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Cloud-based artificial intelligence (AI) has enabled significant progress in medical image analysis; however, its deployment remains limited by high energy consumption, network latency, privacy concerns, and restricted accessibility in resource-constrained environments. These limitations are particularly critical for medical applications requiring reliable, real-time, and privacy-preserving operation. In this paper, we propose an embedded artificial intelligence approach based on Tiny Machine Learning (TinyML), enabling on-device skin lesion classification without reliance on cloud infrastructure. The proposed system deploys a quantized and structurally pruned MobileNetV2 model on a low-cost microcontroller with severely limited memory resources. Through quantizationaware training and structured pruning, the original 14.1 MB model is reduced to 969 KB and executed entirely on-device. Experimental results on the HAM10000 dataset demonstrate a classification accuracy of 92.7%, a melanoma recall of 93.5%, and an AUC of 0.976. Compared to cloud-based inference, the embedded solution achieves a $12.3 \times$ reduction in energy consumption (0.41 J vs. 5.04 J per inference) while operating fully offline and preserving data privacy. These results demonstrate that clinically relevant AI models can be deployed on ultra-low-power embedded platforms, enabling accessible, energy-efficient, and privacy-preserving intelligent medical systems.},
  keywords={Modeling;Artificial intelligence;Clouds;Tiny machine learning;Training;Internet of Things;Quantization (signal);Microcontrollers;Printing;Architecture;Embedded AI;TinyML;Cloud Computing Challenges;Model Compression;Edge Computing;Microcontrollers;Energy Efficiency;Skin Lesion Classification;Medical Diagnosis},
  doi={10.1109/IRASET68627.2026.11538854},
  ISSN={},
  month={May},}@ARTICLE{10563982,
  author={Rafiq, Musaib and Chauhan, Yogesh Singh and Sahay, Shubham},
  journal={IEEE Journal of the Electron Devices Society}, 
  title={Efficient Implementation of Mahalanobis Distance on Ferroelectric FinFET Crossbar for Outlier Detection}, 
  year={2024},
  volume={12},
  number={},
  pages={516-524},
  abstract={The developments in the nascent field of artificial-intelligence-of-things (AIoT) relies heavily on the availability of high-quality multi-dimensional data. A huge amount of data is being collected in this era of big data, predominantly for AI/ML algorithms and emerging applications. Considering such voluminous quantities, the collected data may contain a substantial number of outliers which must be detected before utilizing them for data mining or computations. Therefore, outlier detection techniques such as Mahalanobis distance computation have gained significant popularity recently. Mahalanobis distance, the multivariate equivalent of the Euclidean distance, is used to detect the outliers in the correlated data accurately and finds widespread application in fault identification, data clustering, singleclass classification, information security, data mining, etc. However, traditional CMOS-based approaches to compute Mahalanobis distance are bulky and consume a huge amount of energy. Therefore, there is an urgent need for a compact and energy-efficient implementation of an outlier detection technique which may be deployed on AIoT primitives, including wireless sensor nodes for in-situ outlier detection and generation of high-quality data. To this end, in this paper, for the first time, we have proposed an efficient Ferroelectric FinFET-based implementation for detecting outliers in correlated multivariate data using Mahalanobis distance. The proposed implementation utilizes two crossbar arrays of ferroelectric FinFETs to calculate the Mahalanobis distance and detect outliers in the popular Wisconsin breast cancer dataset using a novel inverter-based threshold circuit. Our implementation exhibits an accuracy of 94.1% which is comparable to the software implementations while consuming a significantly low energy (27.2 pJ).},
  keywords={FinFETs;Integrated circuit modeling;Logic gates;FeFETs;Euclidean distance;Deep learning;Anomaly detection;Crossbar array;deep learning;ferroelectric FETs;Mahalanobis distance;outlier detection},
  doi={10.1109/JEDS.2024.3416441},
  ISSN={2168-6734},
  month={},}@INPROCEEDINGS{11426168,
  author={S, Pavithra and S, Narthika and M, Praveen},
  booktitle={2026 Sixth International Conference on Advances in Electrical, Computing, Communications and Sustainable Technologies (ICAECT)}, 
  title={TinyMl-Based Embedded Analytics Model Compression and Hardware Co-Design}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={TinyML represents the paradigm shift of running machine learning algorithms directly on powerconstrained microcontrollers and small edge devices. These technologies are not only capable of running these computational operations in on premises hardware, but they can also reduce dependence on a continuous cloud infrastructure, resolves time to respond, and time to travel cut down, and produce higher privacy of sensitive data. This integration becomes especially beneficial in the monitoring of industrial machinery, structural health monitoring, biomedical signal analysis, and environmental monitoring, where continuous and real-time processing in remote or bandwidth constrained environment is essential. Its underlying architecture utilizes sophisticated methods for quantization, pruning, and neural network architecture searching to minimize complex models while maintaining little loss in predictive performance At the same time, co-design methodologies enable hardware efficiencies that support intelligent functionality at milliwatt consumption profiles. The algorithm-level optimizations and architecture-level adaptations together provide for local sensor level decisionmaking which removes the need for a lot of backhauling and makes the overall system more robust. But TinyML is not simply about miniaturisation of existing technology, it is a clear shift to the provision of ubiquitous sensing intelligence integrated into devices and supported by low-power processing. This development opens new pathways for scalable deployments in smart agriculture, wearable diagnostics, asset monitoring and sustainable infrastructure. Against a backdrop of increasing global research effort, TinyML is being positioned as a cornerstone of democratizing $A I$ in the emerging field of ultralow-power embedded intelligence that are accessible, reliable, and environmentally sustainable, at scale.},
  keywords={Smart agriculture;Quantization (signal);Tiny machine learning;Neural networks;Computer architecture;Hardware;Sensors;Reliability;Signal analysis;Signal resolution;On-Device Intelligence;TinyML frameworks;Model quantization methods;Neural network pruning;Embedded edge computing;Hardware-algorithm co-design;Energy-constrained AI;Privacy-aware analytics;Ubiquitous edge intelligence;Sustainable machine learning},
  doi={10.1109/ICAECT68478.2026.11426168},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{9603120,
  author={Lu, Chih-Cheng and Gemintang Sulaiman, Muhammad Bintang and Lin, Chin-Yu and Li, Jian-Bai and Shih, Cheng-Ming and Rih, Wei-Shu and Juang, Kai-Cheung},
  booktitle={2021 IEEE International Conference on Consumer Electronics-Taiwan (ICCE-TW)}, 
  title={Using SRAM-based CIM Architecture as the Event Detector for AIoT Applications}, 
  year={2021},
  volume={},
  number={},
  pages={1-2},
  abstract={Convolutional neural networks (CNNs) play a key role in deep learning applications. Computing-in-memory (CIM) architecture has demonstrated great potential to effectively compute large-scale matrix-vector multiplication. For implementation a CIM–based accelerator, a software and hardware co-design approach have to consider the hardware limitations of the CIM macro to map the weight into the AI edge-devices. In this paper, we proposed a hierarchical AI architecture to optimized the end-to-end system power in the AIoT application. CIM-based architecture for event detection is designed to trigger the next stage precision inference. In the experiment, CIM-aware algorithm with 4-bit activation and 4-bit weight on Hand gesture [2] and Yale face [3] datasets are examined to have >95% accuracy. Profiling tool to analyzed the entry-level CIM architecture are also developed.},
  keywords={Event detection;Image edge detection;Computer architecture;Tools;Hardware;Software;Inference algorithms;Artificial Internet of Things;Convolutional Neural Network;Computing in Memory},
  doi={10.1109/ICCE-TW52618.2021.9603120},
  ISSN={2575-8284},
  month={Sep.},}@ARTICLE{11456786,
  author={Fayyaz, Yasamin and Yang, Li and El-Khatib, Khalil},
  journal={IEEE Aerospace and Electronic Systems Magazine}, 
  title={Toward Resilient Intrusion Detection in CubeSats: Challenges, TinyML Solutions, and Future Directions}, 
  year={2026},
  volume={41},
  number={7},
  pages={52-70},
  abstract={CubeSats have revolutionized access to space by providing affordable and accessible platforms for research and education. However, their reliance on commercial off-the-shelf components and open-source software has introduced significant cybersecurity vulnerabilities. Ensuring the cybersecurity of CubeSats is vital as they play increasingly important roles in space missions. Traditional security measures, such as intrusion detection systems (IDS), are impractical for CubeSats due to resource constraints and unique operational environments. This article provides an in-depth review of current cybersecurity practices for CubeSats, highlighting limitations and identifying gaps in existing methods. In addition, it explores noncyber anomaly detection techniques that offer insights into adaptable algorithms and deployment strategies suitable for CubeSat constraints. Open research problems are identified, including the need for resource-efficient intrusion detection mechanisms, evaluation of IDS solutions under realistic mission scenarios, development of autonomous response systems, and creation of cybersecurity frameworks. The addition of tiny machine learning into CubeSat systems is explored as a promising solution to address these challenges, offering resource-efficient, real-time intrusion detection capabilities. Future research directions are proposed, such as integrating cybersecurity with health monitoring systems, and fostering collaboration between cybersecurity researchers and space domain experts.},
  keywords={CubeSat;Computer security;Intrusion detection;Satellites;Modeling;Tiny machine learning;Monitoring;Computer crime;Testing;Digital twins;CubeSats;Cybersecurity;Intrusion Detection Systems;TinyML;Space Systems Security},
  doi={10.1109/MAES.2026.3677755},
  ISSN={1557-959X},
  month={July},}@INPROCEEDINGS{11415724,
  author={Yahia, Yacine Ahmed and Lelouey, Sam and Xiang, Jiahui and Salem, Osman and Mehaoua, Ahmed},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Comparison of Euclidean and Riemannian Metrics for Unsupervised Detection of Anomalies in Authentication Logs}, 
  year={2025},
  volume={},
  number={},
  pages={758-763},
  abstract={Identity and Acces Management (IAM) Authentication logs play a critical role in monitoring computer systems. However, identifying suspicious behaviors without explicit labels remains a significant challenge. In this paper, we explore the use of unsupervised methods based on Euclidean and Riemannian metrics to detect anomalies in a labeled dataset of authentication logs. We compare the performance of several algorithms, including classical k-means (Euclidean metric) and advanced methods leveraging Riemannian geometry (e.g., covariance matrix means). The results show that Riemannian metrics offer superior accuracy in detecting complex anomalies while reducing false positives. This study highlights the potential of geometric approaches to enhance cybersecurity.},
  keywords={Measurement;Accuracy;Scalability;Authentication;Telecommunication traffic;Semisupervised learning;Internet of Things;Risk management;Artificial intelligence;Unsupervised learning;Riemannian Metrics;IAM;CyberSecurity;Anomaly Detection;Authentication Logs;Unsupervised Learning},
