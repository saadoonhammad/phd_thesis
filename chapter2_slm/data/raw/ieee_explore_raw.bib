  ISSN={},
  month={Nov},}@INPROCEEDINGS{11037060,
  author={Gulati, Stuti and Shah, Priyal and Pathak, Lakshin and Trivedi, Chinmay and Gupta, Rajesh and Tanwar, Sudeep},
  booktitle={2025 Joint European Conference on Networks and Communications & 6G Summit (EuCNC/6G Summit)}, 
  title={NanoXAI: Explainable AI for Anomaly Detection in Electromagnetic Nano-Networks of CAVs}, 
  year={2025},
  volume={},
  number={},
  pages={103-108},
  abstract={The authors propose a novel lightweight and interpretable framework to perform anomaly detection in electromagnetic nano-networks in connected autonomous vehicles. The proposed approach adopts TinyML due to its light memory footprint and high accuracy of 98.12 %, while the models which are varying from 56.26 KB to 71.72 KB outperform LSTM and GRU counterparts in terms of resource usage. Using state-of-art techniques such as SHAP and LIME to improve explainability and help analyze and interpret the data, the authors decide that latency and error rate should be used for defining anomalies. The proposed framework is trained and tested on a synthetic data set, which covers traffic patterns for nano-scale communication and preprocessed to have acceptable quality. The obtained validation confirms the performance and efficiency achieved by TinyML on resource-limited devices, which are comparable to other approaches. The future work is about integration of real-world dataset, availability of solutions in large nano networks, experimentations with privacy preserving for distributed systems.},
  keywords={Performance evaluation;Explainable AI;Error analysis;Tiny machine learning;Traffic control;Electromagnetics;Anomaly detection;Autonomous vehicles;Long short term memory;Synthetic data;TinyML;Explainable AI;SHAP;LIME;Electromagnetic Nano-Networks;Anomaly Detection;Autonomous Vehicles},
  doi={10.1109/EuCNC/6GSummit63408.2025.11037060},
  ISSN={2575-4912},
  month={June},}@INPROCEEDINGS{10993050,
  author={Liu, Hao and Wang, Qing and Zuniga, Marco},
  booktitle={2025 Design, Automation & Test in Europe Conference (DATE)}, 
  title={SolarML: Optimizing Sensing and Inference for Solar-Powered TinyML Platforms}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Machine learning models can now run on microcontrollers. Thanks to the advances in neural architectural search, we can automatically identify tiny machine learning (tinyML) models that satisfy stringent memory and energy requirements. However, existing methods often overlook the energy used during event detection and data gathering. This is critical for devices powered by renewable energy sources like solar power, where energy efficiency is paramount. To address it, we introduce SolarML, a solution designed specifically for solar-powered tinyML platforms, which optimizes the end-to-end system's inference accuracy and energy consumption, from data gathering and processing to model inference. Considering two applications of gesture recognition and keywords spotting, SolarML has the following contributions: 1) a hardware platform with an optimal event detection mechanism that reduces event detection costs by up to 10 x compared to state-of-the-art alternatives; 2) a joint optimization framework eNAS that reduces the energy consumption of the sensor and inference model by up to 2 x, compared to methods that only optimize the inference model. Jointly, they enable SolarML to run end-to-end gesture and audio inference on a battery-free tinyML platform by only harvesting solar energy for 30 and 57 seconds, respectively, in an office environment (500 lux). Source code is available at [1].},
  keywords={Energy consumption;Renewable energy sources;Costs;Accuracy;Event detection;Tiny machine learning;Photovoltaic cells;Source coding;Solar energy;Sensors},
  doi={10.23919/DATE64628.2025.10993050},
  ISSN={1558-1101},
  month={March},}@INPROCEEDINGS{11416359,
  author={Wylie, Jordan and Pitropakis, Nikolaos and Papadopoulos, Pavlos and Babaagba, Kehinde and Tan, Zhiyuan},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={An Evaluation of a Tree-based Federated Learning Approach for Internet of Things Anomaly Detection}, 
  year={2025},
  volume={},
  number={},
  pages={556-564},
  abstract={The Internet of Things (IoT) has gained significant popularity in recent years, resulting in an increased focus from malicious individuals. This is particularly concerning as these networks tend to utilise sensitive data, resulting in the need for effective methods that detect and classify attacks. However, significant challenges must be overcome, including the limited computational resources available within IoT networks. To this end, this work evaluates the effectiveness of a lightweight approach based on Federated XGBoost in detecting and classifying attacks on IoT networks. To evaluate this approach, two datasets, Edge-IIoTset and NSL-KDD, are considered, along with their pre-defined feature set. Additionally, we explore a custom feature set of 30 features for Edge-IIoTset. Using these datasets, 10- fold stratified cross-validation is employed. From the evaluation, it was identified that our approach is generally effective when considering established datasets, including outperforming neural network-based FL approaches in terms of Accuracy for the attack classification problem. However, improvements are needed to ensure that adequate performance is achieved when considering recent datasets.},
  keywords={Training;Accuracy;Federated learning;Image edge detection;Computational modeling;Intrusion detection;NSL-KDD;Internet of Things;Artificial intelligence;Anomaly detection;Federated Learning;Internet of Things;Intrusion Detection;XGBoost},
  doi={10.1109/AIoT66900.2025.00084},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10690105,
  author={Zacharias, Cyril and Jose, John and Zain, Muhammed and Noushad, Nafis Muhib and Kartha, Praseeda P and P, Jisha Kuruvilla},
  booktitle={2024 IEEE Recent Advances in Intelligent Computational Systems (RAICS)}, 
  title={Fault Detection using TinyML, Design and Control of Three-Phase Two-Level Inverter}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={The depletion of natural sources of mineral oil has led to a search for alternative sources, particularly in the transportation industry where electric vehicles (EVs) are gaining traction. However, current EV technology is still relatively primitive and requires significant improvements to ensure better and prolonged service. Efforts are underway to design and develop more efficient EV models, with a key focus on the powertrain. The powertrain, comprising the electric motor, power electronics, and transmission, is crucial for efficient energy conversion in EVs[1]–[2]. Through literature surveys and iterative processes, various parameters for Permanent Magnet Synchronous Motor (PMSM) based drives have been identified[4]. These parameters include electromagnetic speed, peak and RMS current, inductances (Ld, Lq), flux, inertia (J), resistance (Rs), damping coefficient (B), and pole pairs. The control strategy employed is Field Oriented Control (FOC), which encompasses Field-Weakening Control[7] and Maximum Torque Per Ampere (MTPA) as the operating regions. A three-phase 2-level inverter utilizing Space Vector Pulse Width Modulation (SVPWM)[5] for precise voltage control has been selected as the inverter of choice. This design also incorporates Insulated-Gate Bipolar Transistors (IGBTs) as switching devices, along with TinyML for comprehensive powertrain operation efficiency in EVs. The objective of this comprehensive design approach is to develop a three-phase two-level voltage source inverter with fault detection using TinyML (Edge Impulse) that optimizes the performance of electric vehicles to meet the growing demand for efficient transportation solutions.},
  keywords={Insulated gate bipolar transistors;Torque;Tiny machine learning;Fault detection;Mechanical power transmission;Control systems;Electric vehicles;TinyML;Edge Impulse;PMSM;SVPWM;FOC;MATLAB;SIMULINK},
  doi={10.1109/RAICS61201.2024.10690105},
  ISSN={2769-5565},
  month={May},}@ARTICLE{11314171,
  author={Pirbhulal, Sandeep and Muzammal, Muhammad and Abie, Habtamu},
  journal={IEEE Wireless Communications}, 
  title={Enabling Secure Edge Intelligence: TinyML-Based Threat Detection in 5G and Future Networks}, 
  year={2026},
  volume={33},
  number={2},
  pages={32-39},
  abstract={The evolution of 5G networks toward 6G presents an opportunity to shift from centralized security to decentralized, intelligent, and autonomous security. While 5G introduces decentralization through software-based virtualization and edge computing, it also exposes network infrastructure to a new and dynamic threat landscape that still relies largely on static, centrally deployed threat detection. This work proposes a lightweight anomaly detection framework based on Tiny Machine Learning (TinyML), specifically designed to address the latency, memory, and energy constraints of 5G edge devices. Using promising model compression techniques, including integer quantization and pruning, we demonstrate that highly optimized models can run entirely on-device without relying on cloud infrastructure. Our experiments using a real-world 5G dataset demonstrate that the quantized TinyDenseNet achieves over 99% detection accuracy while keeping the model size below 30 KB and inference latency under 11 ms. By embedding intelligent detection at the network edge, this approach presents self-defending, ultra-reliable, and context-aware infrastructures for future 6G networks. The proposed approach focuses on next-generation networks, in which decentralized, low-power, and privacy-preserving security mechanisms will be essential.},
  keywords={5G mobile communication;Image edge detection;Tiny machine learning;Anomaly detection;6G mobile communication;Feature extraction;Computational modeling;Real-time systems;Threat assessment;Quantization (signal);Energy efficiency;Edge computing;5G;6G;TinyML;security;anomalies;energy efficiency;edge intelligence;future networks;threat detection},
  doi={10.1109/MWC.2025.3641534},
  ISSN={1558-0687},
  month={April},}@ARTICLE{11563448,
  author={Wei, Jianhao and Li, Mengjie and Li, Chuang and Wen, Yanhua and Liu, Limei and Shi, Qingyu},
  journal={IEEE Internet of Things Journal}, 
  title={Privacy-Preserving Federated Multimodal Agriproduct Anomaly Detection in AIoT via Modality-Under-Optimized Knowledge Distillation}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={As a key application of the Agricultural Internet of Things (AIoT), multimodal agriproduct anomaly detection faces severe privacy and security challenges. Existing federated learning (FL) methods struggle to capture fine-grained cross-modal correlations and to address the modality under-optimization problem, thereby limiting both detection accuracy and privacy levels. To this end, this paper proposes a privacy-preserving federated multimodal agriproduct anomaly detection scheme in AIoT based on modality-under-optimized knowledge distillation (PAMAD), achieving high-utility anomaly detection with enhanced privacy protection. Specifically, we develop a hierarchical privacy protection method for multimodal fine-grained alignment fusion based on meta-learning (HPPMF), which effectively captures cross-modal semantic correlations and protects the privacy of fused features. In addition, we propose a multi-task pre-training algorithm based on modality-under-optimized knowledge distillation (MTLMKD) to alleviate modal imbalance. We further design a pre-training dynamic protection algorithm based on adaptive gradient quantization (PDAGC) to ensure model security. Subsequently, a multimodal agriproduct anomaly detection method with a self-supervised denoising encoder (MAPADSE) is introduced to improve detection accuracy under noisy conditions. Rigorous security analysis demonstrates that the PAMAD scheme satisfies differential privacy. Experimental results show that, compared with existing state-of-the-art methods, our PAMAD scheme improves AUROC and accuracy by 7.56% and 8.71%, respectively, achieving a desirable balance between privacy protection and anomaly detection accuracy in AIoT services.},
  keywords={Anomaly detection;Modeling;Privacy;Training;Accuracy;Noise;Protection;Quantization (signal);Federated learning;Optimization;Federated learning;Agriproduct anomaly detection;Knowledge distillation;Differential privacy},
  doi={10.1109/JIOT.2026.3703645},
  ISSN={2327-4662},
  month={},}@INPROCEEDINGS{11539724,
  author={V M, Navaneethakrishnan and Kurinjimalar, R and Suseendhar, P and Muthuselvan, K and Narayan, S Sathish and Varma, M Ravi},
  booktitle={2026 12th International Conference on Communication and Signal Processing (ICCSP)}, 
  title={Swarm-Based WSN Disaster Area and Surveillance Using RNN}, 
  year={2026},
  volume={},
  number={},
  pages={744-748},
  abstract={This paper proposes a decentralized swarm intelligent wireless sensor network (WSN) for the realtime surveillance of disaster-prone areas. The proposed system overcomes the drawbacks of the conventional system by allowing the LoRa- and Wi-Fi-enabled wireless sensor nodes to communicate in an autonomous and collaborative fashion. The nodes are capable of independent surveillance of important environmental factors characteristic of natural and industrial disasters like landslides, earth quakes, gas leaks, and fires. The swarm intelligence approach makes it easy for the nodes to interact and collaborate in their neighborhood. The sensor nodes are also equipped with a sound sensing feature that can identify the surrounding sounds. The system includes edge intelligence for validating the sensor information in an efficient TinyML model. The system also includes an alert system that broadcasts alerts through audio-visual signals. The highconfidence alerts are communicated from LoRa communication to the Raspberry Pi gateway. The proposed system has energy-efficient properties and can be easily implemented in areas prone to disasters.},
  keywords={Image sensors;Modeling;LoRa;Disasters;Equations;Tiny machine learning;Long short term memory;Timing;Internet of Things;Printing;Wireless Sensor Network;Swarm Intelligence;LoRa Communication;Tiny Machine Learning;Edge Intelligence;Disaster Monitoring},
  doi={10.1109/ICCSP68173.2026.11539724},
  ISSN={2836-1873},
  month={April},}@ARTICLE{10820881,
  author={Jhaveri, Rutvij H. and Chi, Hao Ran and Wu, Huaming},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={TinyML for Empowering Low-Power IoT Edge Consumer Devices}, 
  year={2024},
  volume={70},
  number={4},
  pages={7318-7321},
  abstract={Pervasive Artificial Intelligence (AI) has been promoted to be applicable to multiple services and markets, based on the recent surge in AI and machine learning (ML) techniques. Together with the fact that the market size of edge computing has been boosted to 16 billion USD last year (and a forecast to reach more than 200 billion USD by 2030), TinyML will be one of the main forces to embrace the new era of pervasive AI, by embedding the main operations (e.g., training, modeling, and others) in edge computing, relying on its relatively short physical distance to the users/end devices. Therefore, TinyML has promised to support ultra-low latency, enhanced security/privacy, highly demanded scalability, and potentially sustainability by reducing the frequency accessing centralized cloud computing.},
  keywords={Tiny machine learning;Consumer electronics},
  doi={10.1109/TCE.2024.3482353},
  ISSN={1558-4127},
  month={Nov},}@ARTICLE{10947564,
  author={Mellit, A. and Blasuttigh, N. and Pastore, S. and Zennaro, M. and Pavan, A. Massi},
  journal={IEEE Transactions on Industry Applications}, 
  title={TinyML for Fault Diagnosis of Photovoltaic Modules Using Edge Impulse Platform and IR Thermography Images}, 
  year={2025},
  volume={61},
  number={5},
  pages={8158-8169},
  abstract={Fault detection, localization and diagnosis are critical for increasing the efficiency and dependability of photovoltaic (PV) plants. In this paper, a fault diagnosis method for PV modules is developed using a Machine Learning (ML) platform (Edge Impulse) and infrared images. The idea is to develop a TinyML model to classify certain defects that can frequently occur on PV modules (e.g., dirty, short-circuit and sand deposit on PV modules) and check the feasibility of the developed TinyML model by integrating it into a low-cost and lower power microcontroller (MCU). In this regard, a database of infrared thermography images was built and used. Then, different MobileNets versions are evaluated and compared in terms of accuracy, hardware resources and inference latency. Simulation and co-simulation results clearly report the feasibility of the method based on two different MCUs, with a maximum classification accuracy of 98%. The key advantage of the used platform is that the embedded ML models can be developed quickly and run locally without internet connection. Moreover, edge processes are not affected by latency, bandwidth limitations, energy constraints, or data privacy issues, making them outstanding methods for real-time diagnostics. To verify the ability of the developed TinyML model to classify defects in real- time, the model has been experimentally evaluated and the results demonstrated its capability to diagnose PV modules with good accuracy.},
  keywords={Image edge detection;Fault diagnosis;Accuracy;Tiny machine learning;Fault detection;Classification algorithms;Real-time systems;Infrared imaging;Imputation;Data models;Photovoltaic;fault diagnosis;TinyML;edge impulse;edge device},
  doi={10.1109/TIA.2025.3556792},
  ISSN={1939-9367},
  month={Sep.},}@ARTICLE{11087749,
  author={Sharma, Ankita and Rani, Shalli},
  journal={IEEE Transactions on Intelligent Transportation Systems}, 
  title={Redesigning Transportation Cyber-Physical Systems: Enhancing Connectivity and Bolstering Security Using TinyML}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The rapid evolution of Transportation Cyber-Physical Systems (TCPS) necessitates secure, efficient, and real-time data processing capabilities to support autonomous and intelligent transportation networks. However, existing machine learning-based security frameworks face significant challenges, including limited computational resources, data scarcity for model training, and evolving cybersecurity threats. To address these challenges, we propose a novel TinyML-driven security framework optimized for resource-constrained IoT edge devices within TCPS. Our approach integrates Few-shot Transfer Learning to enhance model adaptability and improve anomaly detection accuracy, even with limited labeled data. The core of our framework is DenseCapsNet, a hybrid deep learning model that combines DenseNet (for efficient feature propagation) and Capsule Networks (for hierarchical spatial feature representation), significantly improving cyber threat detection while preserving computational efficiency. Additionally, we incorporate adversarial training and privacy-preserving techniques to enhance resilience against sophisticated cyber threats, ensuring secure data transmission and model robustness. The proposed framework leverages 6G-enabled ultra-reliable low-latency communication (URLLC) to facilitate secure, real-time data exchange across autonomous vehicle networks, overcoming latency and connectivity constraints. Extensive experiments demonstrate that our TinyML-optimized DenseCapsNet model achieves 99.72% accuracy, 99.7% F1-score, and 99.4% recall, significantly outperforming state-of-the-art models such as GoogleNet, HybridNet, and MobileResNet in TCPS security applications. By bridging the gap between efficiency, security, and real-time adaptability, our work contributes a highly scalable, energy-efficient, and privacy-preserving AI solution tailored for next-generation intelligent transportation systems, addressing critical security and computational constraints in real-world TCPS environments.},
  keywords={Security;Computational modeling;6G mobile communication;Real-time systems;Tiny machine learning;Data models;Training;Anomaly detection;Adaptation models;Accuracy;TCPS;security;TinyML;6G},
  doi={10.1109/TITS.2025.3589570},
  ISSN={1558-0016},
  month={},}@INPROCEEDINGS{9682107,
  author={Ooko, Samson Otieno and Muyonga Ogore, Marvin and Nsenga, Jimmy and Zennaro, Marco},
  booktitle={2021 IEEE Globecom Workshops (GC Wkshps)}, 
  title={TinyML in Africa: Opportunities and Challenges}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={The integration of Internet of Things (IoT) and Machine Learning (ML) is driving the emergence of TinyML, a subset of ML for which models are constrained to be executed on low resource embedded devices. Currently, most IoT applications in Africa are based on cloud-centric architecture making it difficult to enjoy ML-driven intelligence due to connectivity, energy, and cost challenges making tinyML an ideal solution to such challenges. This paper presents an introduction to TinyML and discusses its general applications, solutions to concerns on the impact of Artificial Intelligence (AI) in the achievement of the sustainable development goals (SDGs), and the Information Technology for Development (ICT4D) TinyML technology requirements. TinyML applications classifications are highlighted with specific examples from Africa. Different challenges for the adoption of tinyML in Africa have also been presented with the opportunities that can arise from such challenges being shown. This paper shows how tinyML has great potential in Africa where the use of Embedded systems and AI is still underexploited.},
  keywords={Training;Africa;Machine learning;User interfaces;Hardware;Internet of Things;Proposals;TinyML;TinyML and SDGs;TinyML and ICT4D;TinyML in Africa;TinyML Applications},
  doi={10.1109/GCWkshps52748.2021.9682107},
  ISSN={},
  month={Dec},}@ARTICLE{10251832,
  author={Sunaga, Kazuki and Kondo, Masaaki and Matsutani, Hiroki},
  journal={IEEE Micro}, 
  title={Addressing the Gap Between Training Data and Deployed Environment by On-Device Learning}, 
  year={2023},
  volume={43},
  number={6},
  pages={66-73},
  abstract={The accuracy of tiny machine learning applications is often affected by various environmental factors, such as noises, location/calibration of sensors, and time-related changes. This article introduces a neural network based on-device learning (ODL) approach to address this issue by retraining in deployed environments. Our approach relies on semisupervised sequential training of multiple neural networks tailored for low-end edge devices. This article introduces its algorithm and implementation on wireless sensor nodes consisting of a Raspberry Pi Pico and low-power wireless modules. Experiments using vibration patterns of rotating machines demonstrate that retraining by ODL improves anomaly detection accuracy compared with a prediction-only deep neural network in a noisy environment. The results also show that the ODL approach can save communication cost and energy consumption for battery-powered Internet of Things devices.},
  keywords={Training;Artificial intelligence;Anomaly detection;Wireless communication;Prediction algorithms;Neural networks;Internet of Things;Tiny machine learning;Microcontrollers;Machine learning},
  doi={10.1109/MM.2023.3314711},
  ISSN={1937-4143},
  month={Nov},}@ARTICLE{11594408,
  author={Xu, Shengjie and Qian, Yi},
  journal={IEEE Journal of Selected Areas in Sensors}, 
  title={A Unified Federated Framework for Trust Management and Privacy-Preserving Anomaly Detection in Zero Trust Edge Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1-15},
  abstract={Edge computing and Internet of Things (IoT) have expanded the attack surface of modern networks. Security designs often trade off detection quality and privacy: centralized trust creates single points of failure, while distributed approaches may sacrifice accuracy or formal privacy guarantees. This paper presents a Federated Trust Modeling (FTM) framework that integrates multi-modal anomaly detection, Byzantine-resilient federated learning with $(\epsilon,\delta)$-differential privacy (DP), and context-aware Zero Trust Architecture (ZTA) decision-making. The three-layer architecture comprises Device-Level Trust Learning (DTL) with enhanced variational autoencoder (VAE), Isolation Forest, long short-term memory (LSTM), and statistical process control (SPC) modalities; a Federated Aggregation Layer (FAL) for robust aggregation with DP; and a Trust Scoring & Decision Layer (TSDL) that maps evidence to continuous trust and access levels using a Subjective Logic–inspired formulation. We provide detailed algorithmic implementations with pseudocode for each layer. Comprehensive evaluation demonstrates exceptional performance: high precision with low false positive rate, near-linear scalability achieving high efficiency, high accuracy with precision detecting most of attacks with zero false alarms, and sub-linear time complexity. Privacy preservation is maintained through differential privacy guarantees without accuracy degradation. The results support deployability studies for large-scale IoT and Artificial Intelligence of Things settings, with generalization to real telemetry left to future work.},
  keywords={Modeling;Federated learning;Internet of Things;Anomaly detection;Security;Timing;Poles and zeros;Accuracy;Signal detection;Zero Trust;Zero Trust;Distributed Intelligence;Federated Learning;Artificial Intelligence of Things;Anomaly Detection;Edge Computing},
  doi={10.1109/JSAS.2026.3709766},
  ISSN={2836-2071},
  month={},}@INPROCEEDINGS{11212291,
  author={Nalini, N and Elrashidi, Ali and Vaishnavi, T and Rosi, A. and Manideep, B. and Karthikeyan, G.},
  booktitle={2025 6th International Conference on Electronics and Sustainable Communication Systems (ICESC)}, 
  title={An AIoT-Enabled Smart Home Automation Framework: Intelligent Control, Security, and Predictive Monitoring}, 
  year={2025},
  volume={},
  number={},
  pages={634-638},
  abstract={The convergence of Artificial Intelligence (AI) and the Internet of Things (IoT) has cemented the way for intelligent, secure, and efficient smart home environments. This paper proposes a unified AIoTenabled smart home automation framework that integrates real-time control, high-level security, and predictive monitoring to enhance modern living. Unlike conventional systems, the proposed framework influences machine learning processes to analyze user behavior and automate appliance management while ensuring robust anomaly detection for security against potential threats. The architecture also includes an AI-powered floor monitoring system to proactively identify hazards, thereby improving home safety and enabling predictive maintenance. Experimental results demonstrate the system’s capability to reduce energy consumption by $35 \%$, detect anomalies with an accuracy of $94 \%$, and significantly enhance both user comfort and safety. This research highlights the potential of AIoT to build resilient, self-learning smart home ecosystems, addressing current limitations in security, adaptability, and efficiency.},
  keywords={Energy consumption;Automation;Smart homes;Machine learning;Real-time systems;Energy efficiency;Security;Internet of Things;Monitoring;Intelligent control;AIoT;Smart Home;Home Automation;Artificial Intelligence;Predictive Monitoring;Anomaly Detection;Energy Efficiency;IoT Security;Machine Learning;Intelligent Control Systems},
  doi={10.1109/ICESC65114.2025.11212291},
  ISSN={2996-5357},
  month={Sep.},}@INPROCEEDINGS{10780555,
  author={Li, Senjie and Shi, Zhiguo and Wang, Yong},
  booktitle={2024 International Conference on Artificial Intelligence of Things and Systems (AIoTSys)}, 
  title={A Lightweight Video Surveillance Anomaly Detection Method Based on Image Semantic Representation}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In this paper, a lightweight method for video surveillance anomaly detection based on image semantic representation is proposed, aimed at enabling widespread deployment on low-cost video surveillance devices. The approach efficiently embeds representations of each video frame and detects anomalies by comparing the similarity between these embeddings and those of normal and abnormal samples stored in a template library. A key innovation of this method is an enhanced lightweight model training technique for image semantic representation, which incorporates specific semantic information into the model's weights, significantly improving anomaly detection accuracy. This approach achieved an impressive 98.7% accuracy on a custom dataset with an inference speed of 9.4fps on the IoT terminal chip K210. Furthermore, an innovative image-to-image generation pipeline for expanding training datasets is introduced. This pipeline generates a diverse set of images with potential anomalies through multimodal understanding and local editing. Additionally, the method features a hardware-friendly and efficient CNN network structure, specifically designed for resource-constrained devices. This structure optimizes parameter efficiency and computational speed, outperforming traditional techniques in both accuracy and efficiency. The proposed method demonstrates superior performance, making it highly suitable for practical deployment in real-world video surveillance applications.},
  keywords={Training;Performance evaluation;Technological innovation;Accuracy;Semantics;Pipelines;Video surveillance;Libraries;Internet of Things;Anomaly detection;Video Surveillance;Anomaly Detection;Image Semantic Representation;Lightweight Model},
  doi={10.1109/AIoTSys63104.2024.10780555},
  ISSN={},
  month={Oct},}@ARTICLE{11266886,
  author={Yahyati, Chaymae and Lamaakal, Ismail and Maleh, Yassine and El Makkaoui, Khalid and Ouahbi, Ibrahim and Almousa, May and Abd El-Latif, Ahmed A.},
  journal={IEEE Access}, 
  title={A Systematic Review of State-of-the-Art TinyML Applications in Healthcare, Education, and Transportation}, 
  year={2025},
  volume={13},
  number={},
  pages={204513-204562},
  abstract={Tiny Machine Learning (TinyML) has emerged as a transformative paradigm enabling machine learning inference directly on ultra-low-power microcontrollers and edge devices. As AI expands beyond cloud computing to resource-constrained environments, TinyML offers promising solutions for latency-sensitive, bandwidth-efficient, and privacy-preserving applications. This paper presents a Systematic review of state-of-the-art TinyML applications across three critical domains: healthcare, education, and transportation. By analyzing 136 peer-reviewed publications from 2020 to 2025, we identify key trends, representative use cases, and the enabling technologies that support domain-specific deployments. Our review evaluates software frameworks, hardware platforms, model optimization techniques (e.g., quantization, pruning, and neural architecture search), and real-world deployment challenges such as energy consumption, memory limitations, and explainability. We further synthesize the metrics used to assess TinyML systems and highlight open research questions. Unlike previous surveys, our domain-centric approach offers a deeper contextual analysis of how TinyML is being adapted to solve real-world problems across diverse sectors. We conclude by outlining future directions and practical insights to guide researchers and practitioners in designing scalable, resilient, and ethically grounded TinyML systems.},
  keywords={Tiny machine learning;Medical services;Transportation;Education;Convolutional neural networks;Artificial intelligence;Surveys;Hardware;Microcontrollers;Artificial neural networks;Edge AI;edge machine learning;edge intelligence;Internet of Things;model compression;embedded systems;TinyML},
  doi={10.1109/ACCESS.2025.3633575},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11432258,
  author={Anuva, Shaila T and Iqbal, Shahrear and Zulkernine, Mohammad},
  booktitle={GLOBECOM 2025 - 2025 IEEE Global Communications Conference}, 
  title={LIDIT: Low-Latency Intrusion Detection in IoMT Devices using TinyML}, 
  year={2025},
  volume={},
  number={},
  pages={6093-6098},
  abstract={The Internet of Medical Things (IoMT) is reshaping healthcare by facilitating real-time monitoring, diagnosis, and treatment through interconnected devices and systems. However, the proliferation of resource-constrained IoMT devices introduces substantial cybersecurity challenges. Due to limited computational and energy resources, conventional security mechanisms such as complex encryption algorithms and robust firewalls are often infeasible. This poses serious risks in critical healthcare applications where delayed threat detection can lead to life-threatening outcomes. To address these pressing challenges, this research presents LIDIT, a novel anomaly-based intrusion detection framework with specialized feature segmentation designed for resource-constrained environments using TinyML. Our approach employs a multi-branch LSTM-autoencoder model trained exclusively on benign traffic, utilizing an input segmentation strategy based on session-level, TCP flags, and time-window features to capture fine-grained temporal as well as contextual patterns in network behavior. We evaluated the model on the CICIoMT2024 and IoMT-TrafficData dataset and demonstrated that our proposed segmentation framework improves anomaly detection performance over unified models. The best-performing model achieved an accuracy of 0.9990 and an F1-score of 0.9988 with a recall of 0.9995 for the CICIoMT2024 dataset. Post-training quantization using FLOAT16 and INT8 further significantly reduced the model sizes, making it suitable for real-time deployment. The system was successfully deployed on a Raspberry Pi Zero 2 W and tested under a live SYN flood attack, detecting anomalies in real time with an average inference time of 10.25 milliseconds. These results confirm the effectiveness, efficiency, and deployability of LIDIT as a lightweight, low-latency intrusion detection solution for modern healthcare IoT systems.},
  keywords={Adaptation models;Quantization (signal);Tiny machine learning;Intrusion detection;Internet of Medical Things;Feature extraction;Real-time systems;Floods;Low latency communication;Anomaly detection;Internet of Medical Things;Intrusion Detection;TinyML;LSTM-Autoencoder;Feature Segmentation;Edge Computing},
  doi={10.1109/GLOBECOM59602.2025.11432258},
  ISSN={2576-6813},
  month={Dec},}@INPROCEEDINGS{9722636,
  author={Han, Hui and Siebert, Julien},
  booktitle={2022 International Conference on Artificial Intelligence in Information and Communication (ICAIIC)}, 
  title={TinyML: A Systematic Review and Synthesis of Existing Research}, 
  year={2022},
  volume={},
  number={},
  pages={269-274},
  abstract={Tiny Machine Learning (TinyML), a rapidly evolving edge computing concept that links embedded systems (hardware and software) and machine learning, with the purpose of realizing ultra-low-power and low-cost and efficiency and privacy, brings machine learning inference to battery-powered intelligent devices. In this study, we conduct a systematic review of TinyML research by synthesizing 47 papers from academic and grey publication since 2019 (the early TinyML publication starts from 2019). Relevant TinyML literature is analyzed from five aspects: hardware, framework, datasets, use cases, and algorithms/model. This systematic review will serve as a roadmap for understanding the literature within the new emerging field of TinyML.},
  keywords={Privacy;Systematics;Machine learning algorithms;Software algorithms;Machine learning;Hardware;Software;TinyML;Systematic review;Data synthesis;MCUs;TensorFlow Lite;Neural networks},
  doi={10.1109/ICAIIC54071.2022.9722636},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11137032,
  author={Thapa, Sunil and Poudel, Sushil and Abouyoussef, Mahmoud},
  booktitle={2025 1st International Conference on Secure IoT, Assured and Trusted Computing (SATC)}, 
  title={TinyML-Enabled Intrusion Detection for Securing Electric Vehicle Supply Equipment (EVSE)}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Electric Vehicles (EVs) and Electric Vehicle Supply Equipments (EVSEs) are vulnerable to cybersecurity threats like malware injections, unauthorized access, denial-of-service (DoS) attacks, distributed denial-of-service (DDoS) attacks, and man-in-the-middle (MITM) attacks, which can compromise their functionality and security. While Machine Learning (ML) effectively addresses cybersecurity threats, implementing traditional ML solutions in EVSE is challenging due to resource limitations, requiring lightweight and efficient solution to ensure effective threat detection and mitigation. Tiny Machine Learning (TinyML) is an emerging solution that enables running ML models on resourceconstrained devices, making it ideal for implementing Intrusion Detection Systems (IDS) in EVSE charger units. This paper explores the potential of TinyML as an effective solution for enhancing EVSE cybersecurity. The proposed TinyML model is evaluated using the Hardware Performance Counter (HPC) and Network data sources of CICEVSE2024 dataset, achieving accuracies of $98.72 \%$ and $99.84 \%$, F1-scores of $98.65 \%$ and $99.83 \%$, recall scores of $98.72 \%$ and $99.84 \%$, and precision scores of $98.88 \%$ and $99.84 \%$, respectively.},
  keywords={Performance evaluation;Adaptation models;Trusted computing;Tiny machine learning;Soft sensors;Intrusion detection;Denial-of-service attack;Data models;Threat assessment;Long short term memory;Machine Learning;TinyML;EVSE;CyberSecurity;IoT Security},
  doi={10.1109/SATC65530.2025.11137032},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11449806,
  author={Liu, Yuming and Yuan, Feng and Long, Zhe and Wu, Hong},
  booktitle={2026 IEEE International Conference on Consumer Electronics (ICCE)}, 
  title={Transformer-Based Variational Autoencoder for Anomaly Detection in Public Lighting Power Consumption Data}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The rapid expansion of Internet of Things (IoT) technologies has enabled high-resolution health monitoring of public lighting systems through smart meters and distributed sensing infrastructure. In this study, we propose a Transformer-based Variational Autoencoder (TransVAE) for unsupervised anomaly detection in active power consumption data from smart city lighting networks. The model utilizes a multi-head self-attention mechanism to capture global temporal dependencies and an attention-based variational latent memory to enhance representation learning. The TransVAE model is evaluated on a real-world dataset, with four representative fault scenarios systematically injected to establish ground truth. Anomaly detection is performed using reconstruction error thresholds determined via the N-sigma statistical rule. Experimental results demonstrate that the proposed model achieves superior performance compared to baseline methods, attaining 96.77% accuracy, 91.67% recall, and 95.65% F1-score. Furthermore, computational efficiency analysis shows that TransVAE introduces higher execution time than LSTM-AE and Transformer, but with effective GPU utilization, indicating a practical trade-off between accuracy and resource consumption. The results confirm the effectiveness of the proposed architecture for robust, data-driven anomaly detection in smart public lighting systems.},
  keywords={Accuracy;Power demand;Smart cities;Autoencoders;Lighting;Graphics processing units;Transformers;Computational efficiency;Internet of Things;Anomaly detection;anomaly detection;deep learning;Transformer;variational autoencoder;public lighting;smart city;active power consumption},
  doi={10.1109/ICCE67443.2026.11449806},
  ISSN={2158-4001},
  month={Feb},}@ARTICLE{11370394,
  author={Quadar, Nordine and Chehri, Abdellah and Debaque, Benoit},
  journal={IEEE Wireless Communications}, 
  title={TinyML Datasets as Enablers of 6G Edge Intelligence: Key Insights and Research Gaps}, 
  year={2026},
  volume={33},
  number={2},
  pages={40-49},
  abstract={Tiny Machine Learning (TinyML) enables intelligent inference on resource-constrained edge devices, positioning it as a cornerstone for sixth-generation (6G) wireless systems demanding ubiquitous, low-latency, distributed intelligence at unprecedented scale. However, TinyML development is significantly constrained by limited availability of representative datasets and absence of standardized benchmarking protocols aligned with 6G requirements. This survey analyzes 12 representative TinyML datasets across five critical application domains, selected for 6G relevance, edge compatibility, and validation potential. Experimental results demonstrate practical feasibility: 25.9 $\times$  compression with <0.5% accuracy loss, and lightweight channel estimation achieving classical-method performance within 453.6 KB memory. Each dataset is characterized for preprocessing complexity, edge deployment feasibility, and alignment with 6G paradigms including integrated sensing and communication (ISAC), non-terrestrial networks (NTN), and mmWave operation. Through this systematic evaluation, we uncover critical gaps including limited support for mmWave and THz bands, indoor-centric bias, and inadequate scaling to high-density scenarios. We provide recommendations for dataset design and open benchmarking to enable reproducible TinyML development for 6G edge intelligence.},
  keywords={6G mobile communication;Tiny machine learning;Surveys;Millimeter wave communication;Computational modeling;Protocols;Complexity theory;Hardware;Ultra reliable low latency communication;Systematics;6G mobile communication;Edge computing;6G networks;TinyML;edge computing;datasets;machine learning;wireless communications;Internet of Things;device authentication},
  doi={10.1109/MWC.2025.3645146},
  ISSN={1558-0687},
  month={April},}@INPROCEEDINGS{11281142,
  author={Lamaakal, Ismail and Yahyati, Chaymae and El Makkaoui, Khalid and Maleh, Yassine and Ouahbi, Ibrahim},
  booktitle={2025 International Conference on Electrical Systems & Automation (ICESA)}, 
  title={TinyML vs LLMs: A Survey of Extreme Scales in Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={ML now works with an unmatched range of computational scales, from microcontrollers with models that are only a few kilobytes big to cloud infrastructures with Large Language Models (LLMs) that have trillions of parameters. These extremes show how AI has made progress in different ways: Tiny Machine Learning (TinyML) is great for green apps that don’t have a lot of resources because it focuses on real-time, ultra-low-power inference on edge devices. LLMs, on the other hand, are the best at understanding, reasoning, and generating language, but they often use a lot of energy and hurt the environment. This research provides a comprehensive analysis of TinyML and LLMs, highlighting their importance in the context of green and sustainable technology. We offer a systematic taxonomy that evaluates both paradigms based on critical factors such as model size, latency, energy consumption, memory footprint, training methodologies, privacy considerations, and deployment architecture. There are talks about how to use TinyML in smart agriculture, IoT, and wearable health monitoring, and how to use LLMs in cloud-based text generation, code synthesis, and decision support. We carefully consider the pros and cons of centralization and decentralization, scalability and sustainability, and performance and efficiency. Finally, we talk about what might happen in the future, like quantized TinyLLMs, federated learning for privacy-aware sustainability, and hybrid edge-cloud systems where TinyML acts as a green intelligence filter for LLM backends. The purpose of this poll is to get people to share their ideas on how to make AI systems that are both helpful and good for the environment.},
  keywords={Surveys;Energy consumption;Microcontrollers;Federated learning;Tiny machine learning;Computational modeling;Taxonomy;Real-time systems;Cognition;Sustainable development;TinyML;LLMs;Edge AI;Embedded Machine Learning;Edge Intelligence},
  doi={10.1109/ICESA66763.2025.11281142},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10639989,
  author={Rüb, Marcus and Tuchel, Philipp and Sikora, Axel and Mueller-Gritschneder, Daniel},
  booktitle={2024 IEEE 7th International Conference on Industrial Cyber-Physical Systems (ICPS)}, 
  title={A Continual and Incremental Learning Approach for TinyML On-device Training Using Dataset Distillation and Model Size Adaption}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={A new algorithm for incremental learning in the context of Tiny Machine learning (TinyML) is presented, which is optimized for low-performance and energy efficient embedded devices. TinyML is an emerging field that deploys machine learning models on resource-constrained devices such as microcontrollers, enabling intelligent applications like voice recognition, anomaly detection, predictive maintenance, and sensor data processing in environments where traditional machine learning models are not feasible. The algorithm solve the challenge of catastrophic forgetting through the use of knowledge distillation to create a small, distilled dataset. The novelty of the method is that the size of the model can be adjusted dynamically, so that the complexity of the model can be adapted to the requirements of the task. This offers a solution for incremental learning in resource-constrained environments, where both model size and computational efficiency are critical factors. Results show that the proposed algorithm offers a promising approach for TinyML incremental learning on embedded devices. The algorithm was tested on five datasets including: CIFAR10, MNIST, CORE50, HAR, Speech Commands. The findings indicated that, despite using only $43 \%$ of Floating Point Operations (FLOPs) compared to a larger fixed model, the algorithm experienced a negligible accuracy loss of just $1 \%$. In addition, the presented method is memory efficient. While state-of-the-art incremental learning is usually very memory intensive, the method requires only $1 \%$ of the original data set.},
  keywords={Training;Adaptation models;Incremental learning;Machine learning algorithms;Tiny machine learning;Computational modeling;Heuristic algorithms;Embedded AI;Edge AI;Neural networks;efficient training},
  doi={10.1109/ICPS59941.2024.10639989},
  ISSN={2769-3899},
  month={May},}@INPROCEEDINGS{11182560,
  author={Gurav, Shashidhar and Rangamani, Tayi Preethi and Muthusundar, S.K. and Charumathi, A.C. and M.S.Nidhya and Maram, Balajee},
  booktitle={2025 International Conference on Modern Sustainable Systems (CMSS)}, 
  title={Machine Learning Models for Energy Consumption Sensors in Wireless Sensor Networks}, 
  year={2025},
  volume={},
  number={},
  pages={172-177},
  abstract={Wireless Sensor Networks make it possible to the Internet of Things to gather crucial information in real time in various environments. However, the sensor nodes possess a finite energy level and it is also hard to keep up longevity, reliability, and scalable operation of the network. In this paper, the author examines how machine learning (ML) models may address these problems. LSTM Scheduler, RL-LEACH+, Autoencoder-based Anomaly Detection, TinyML Edge Intelligence, and Hybrid ACO-PSO Routing may increase energy utilization, maintain trusted communication, and allow the devices to be deployed conveniently to an expanding network is examined. It was determined that RL-LEACH+ and TinyML are the most likely solutions since they employ adaptive intelligence alongside equally lightweight processing simultaneously. The findings indicate that, applying smart algorithms in WSNs can enhance the resource utilization and prolong the lifespan of a WSN network, and hence, are appropriate in big IoT applications.},
  keywords={Wireless sensor networks;Tiny machine learning;Scalability;Autoencoders;Reinforcement learning;Routing;Internet of Things;Resource management;Long short term memory;Anomaly detection;Wireless Sensor Networks (WSNs);Energy Efficiency;Machine Learning;Reliability;IoT Scalability},
  doi={10.1109/CMSS66566.2025.11182560},
  ISSN={},
  month={Aug},}@ARTICLE{11175363,
  author={Martinez-Rau, Luciano Sebastian and Zhang, Yuxuan and Oelmann, Bengt and Bader, Sebastian},
  journal={IEEE Open Journal of Instrumentation and Measurement}, 
  title={On-Device Anomaly Detection in Conveyor Belt Operations}, 
  year={2025},
  volume={4},
  number={},
  pages={1-9},
  abstract={Conveyor belts are crucial in mining operations by enabling the continuous and efficient movement of bulk materials over long distances, which directly impacts productivity. While detecting anomalies in specific conveyor belt components has been widely studied, identifying the root causes of these failures, such as changing production conditions and operator errors, remains critical. Continuous monitoring of mining conveyor belt work cycles is still at an early stage and requires robust solutions. Recently, an anomaly detection method for duty cycle operations of a mining conveyor belt has been proposed. Based on its limited performance and unevaluated long-term proper operation, this study proposes two novel methods for classifying normal and abnormal duty cycles. The proposed approaches are pattern recognition systems that make use of threshold-based duty-cycle detection mechanisms, manually extracted features, pattern-matching, and supervised tiny machine learning (ML) models. The explored low-computational models include decision tree, random forest, extra trees, extreme gradient boosting, Gaussian naive Bayes, and multilayer perceptron. A comprehensive evaluation of the former and proposed approaches is carried out on two datasets. Both proposed methods outperform the former method in anomaly detection, with the best-performing approach being dataset-dependent. The heuristic rule-based approach achieves the highest F1-score in the same dataset used for algorithm training, with 97.3% for normal cycles and 80.2% for abnormal cycles. The ML-based approach performs better on a dataset, including the effects of machine aging, with an F1-score scoring 91.3% for normal cycles and 67.9% for abnormal cycles. Implemented on two low-power microcontrollers, the methods demonstrate efficient, real-time operation with energy consumption of 13.3 and  $20.6~\mu $ J during inference. These results offer valuable insights for detecting mechanical failure sources, supporting targeted preventive maintenance, and optimizing production cycles.},
  keywords={Belts;Hydraulic systems;Data mining;Monitoring;Sensors;Temperature measurement;Real-time systems;Pumps;Tiny machine learning;Temperature sensors;Anomaly detection;conveyor belt;edge computing;industry 4.0;low-power microcontroller;machine learning (ML);tinyML},
  doi={10.1109/OJIM.2025.3613073},
  ISSN={2768-7236},
  month={},}@ARTICLE{10781407,
  author={Njor, Emil and Hasanpour, Mohammad Amin and Madsen, Jan and Fafoutis, Xenofon},
  journal={IEEE Access}, 
  title={A Holistic Review of the TinyML Stack for Predictive Maintenance}, 
  year={2024},
  volume={12},
  number={},
  pages={184861-184882},
  abstract={Downtime caused by failing equipment can be extremely costly for organizations. Predictive Maintenance (PdM), which uses data to predict when maintenance should be conducted, is an essential tool for increasing safety, maximizing uptime and minimizing costs. Contempoary PdM systems primarily have sensors collect information about the equipment under observation. This information is afterwards transmitted off the device for processing at a high-performance computer system. While this can allow high-quality predictions, it also imposes barriers that keep some organisations from adopting PdM. For example, some applications prevent data transmission off sensor devices due to regulatory or infrastructure limitations. Being able to process the collected information right at the sensor device is, therefore, desirable in many sectors - something that recent progress in the field of TinyML promises to deliver. This paper investigates the intersection between PdM and TinyML and explores how TinyML can enable many new PdM applications. We consider a holistic view of TinyML-based PdM, focusing on the full stack of Machine Learning (ML) models, hardware, toolchains, data and PdM applications. Our main findings are that each part of the TinyML stack has received varying degrees of attention. In particular, ML models and their optimisations have seen a lot of attention, while data optimisations and TinyML datasets lack contributions. Furthermore, most TinyML research focuses on image and audio classification, with little attention paid to other application areas such as PdM. Based on our observations, we suggest promising avenues of future research to scale and improve the application of TinyML to PdM.},
  keywords={Tiny machine learning;Surveys;Program processors;Costs;Organizations;Maintenance;Reviews;Microcontrollers;Energy efficiency;Optimization;Embedded AI;embedded machine learning;optimization;predictive maintenance;resource-constrained systems;TinyML},
  doi={10.1109/ACCESS.2024.3512860},
  ISSN={2169-3536},
  month={},}@ARTICLE{11557456,
  author={Sai, Siva and Shah, Kunjan and Jain, Granth and Chamola, Vinay},
  journal={IEEE Consumer Electronics Magazine}, 
  title={TinyML for Transportation Systems: Enabling Smart Mobility}, 
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={Tiny Machine Learning (TinyML) is an innovative technology paradigm that allows Machine Learning (ML) inference on resource-constrained microcontrollers. This paper surveys TinyML for transportation systems. Eight application areas from the literature are covered: (i) intrusion detection for in-vehicle networks and EV-charging interfaces, (ii) safety monitoring (alcohol impairment, drowsiness, falls), (iii) vehicle perception in embedded vision, (iv) environmental impact estimation (fuel type classification, CO2 soft sensors), (v) vehicle diagnostics for automotive and rail systems, (vi) driver behavior analytics, (vii) automotive enhancements, and (viii) traffic control with adaptive signal timing. We highlight representative deployments on MCUs (Microcontroller Units) across these domains and present their quantization choices, memory footprints, and real-time performance. Furthermore, we present the limitations of TinyML, including hardware resource constraints, framework fragmentation, data scarcity, robustness–accuracy trade-offs, integration challenges, constraints on online learning, and application-specific challenges. TinyML is a promising enabler of responsive, private, and affordable technology for transportation intelligence, but progress requires standardized toolchains and benchmarks, richer open datasets, robustness methods for non-stationary environments, and lightweight on-device adaptation.},
  keywords={Modeling;Tiny machine learning;Vehicles;Timing;Real-time systems;Driver behavior;Accuracy;Quantization (signal);Image sensors;Machine learning},
  doi={10.1109/MCE.2026.3702289},
  ISSN={2162-2256},
  month={},}@INPROCEEDINGS{11173000,
  author={S, Yayathi Pavan Kumar and Mishra, Sudeepta},
  booktitle={2025 28th International Symposium on Real-Time Distributed Computing (ISORC)}, 
  title={Optimized Deep Learning for Anomalous Traffic Classification in Resource-Constrained IoT Networks: A Novel Approach}, 
  year={2025},
  volume={},
  number={},
  pages={368-373},
  abstract={AI-based traffic classification is crucial for optimizing resource allocation and threat detection in networks, particularly in resource-constrained IoT environments where traditional methods are inadequate. However, deploying large machine learning (ML) and deep learning (DL) models in such environments poses significant challenges due to their high computational requirements and storage needs, which can lead to inefficiencies and scalability issues. This paper introduces novel model optimization techniques-Min-BitNet and SlimMatrixNet-to overcome these limitations and replace state-of-the-art TinyML-based approaches. These models significantly reduce size while maintaining high accuracy: Min-BitNet achieves 99.46% and SlimMatrixNet achieves $\mathbf{9 6. 3 7 \%}$, compared to $\mathbf{9 9. 9 6 \%}$ for the uncompressed model. Validated through OMNeT++ simulations and hardware implementations, SlimMatrixNet offers superior performance in accuracy, size, and delay, providing an efficient IoT anomaly detection solution without compromising accuracy.},
  keywords={Deep learning;Accuracy;Computational modeling;Tiny machine learning;Scalability;Threat assessment;Real-time systems;Hardware;Resource management;Optimization;IoT;Anomalous Traffic Classification;TinyML;MiniBitNet;SlimMatrixNet;Covert Communication Channels},
  doi={10.1109/ISORC65339.2025.00060},
  ISSN={2770-162X},
  month={May},}@INPROCEEDINGS{9746093,
  author={Paissan, Francesco and Ancilotto, Alberto and Brutti, Alessio and Farella, Elisabetta},
  booktitle={ICASSP 2022 - 2022 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Scalable Neural Architectures for End-to-End Environmental Sound Classification}, 
  year={2022},
  volume={},
  number={},
  pages={641-645},
  abstract={Sound Event Detection (SED) is a complex task simulating human ability to recognize what is happening in the surrounding from auditory signals only. This technology is a crucial asset in many applications such as smart cities. Here, urban sounds can be detected and processed by embedded devices in an Internet of Things (IoT) to identify meaningful events for municipalities or law enforcement. However, while current deep learning techniques for SED are effective, they are also resource- and power-hungry, thus not appropriate for pervasive battery-powered devices. In this paper, we propose novel neural architectures based on PhiNets for real-time acoustic event detection on microcontroller units. The proposed models are easily scalable to fit the hardware requirements and can operate both on spectrograms and waveforms. In particular, our architectures achieve state-of-the-art performance on UrbanSound8K in spectrogram classification (around 77%) with extreme compression factors (99.8%) with respect to current state-of-the-art architectures.},
  keywords={Performance evaluation;Event detection;Smart cities;Acoustics;Real-time systems;Internet of Things;Object recognition;sound event detection;tinyML;scalable backbone;IoT},
  doi={10.1109/ICASSP43922.2022.9746093},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11544971,
  author={T, Rajesh and Muthuswamy, Sakthimanikandan and Pillai, Anju S and Saravanan, Vijayalakshmi},
  booktitle={2026 IEEE 19th Dallas Circuits and Systems Conference (DCAS)}, 
  title={Edge-Centric Anomaly Detection Framework for Industrial Automation System}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Industrial automation with Internet of Things(IIoT) systems in critical water treatment infrastructure face escalating cybersecurity risks that target the cyber-physical layer. The detrimental latency is introduced and a single point of failure is presented using the Traditional cloud-centric anomaly architectures. This study proposes an edge centric security approach in which Tiny Machine Learning model (TinyML) has been deployed directly on edge device ESP32 based sensors to perform anomaly detection effectively at the data source. This proposed system maintains a bidirectional connection with the Innovate Engineering Products IoT (IEP-IoT) platform for visualization, historical monitoring and alert handling, enabling coordinate edge cloud operation validation using the BATADAL water treatment SCADA data set, shows that the proposed framework detects complex attacks such as pressure tampering, water flow manipulation and unauthorized control commands compared with conventional threshold based methods. This framework achieves approximately a 23 % improvement in deduction performance while reducing cloud data transmission by over 85 % by executing inference locally. The system minimizes energy consumption and latency making it suitable for resource constraint safety critical industrial environments.},
  keywords={Modeling;Internet of Things;Anomaly detection;Timing;Equations;Water;Printing;Image sensors;Signal detection;Tagging;SCADA;Water treatment and distribution;TinyML;IIoT;Anomaly Detection},
  doi={10.1109/DCAS69364.2026.11544971},
  ISSN={2766-5186},
  month={April},}@INPROCEEDINGS{10730006,
  author={Angeline, Lorita and Lim, Kit Guan and Tan, Min Keng and Uda, Muhd. Nur Afnan and Jenarun, Joaquim Abel and Teo, Kenneth Tze Kin},
  booktitle={2024 IEEE International Conference on Artificial Intelligence in Engineering and Technology (IICAIET)}, 
  title={AloT-Driven Machine Learning for Anomaly Detection in Structural Health Monitoring}, 
  year={2024},
  volume={},
  number={},
  pages={687-692},
  abstract={Structural health monitoring (SHM) is crucial for real-time assessment of structures to preemptively detect anomalies that may lead to failures. This study explores the integration of Artificial Intelligence of Things (AIoT) principles to enhance anomaly detection using acceleration and gyroscopic sensor data. The study involved setting up hardware comprising acceleration and gyroscopic sensors, integrated with a web server for real-time data monitoring. Issues with the raw dataset, including noise and variability, were addressed through preprocessing techniques. Four machine learning models, Support Vector Machine (SVM), Random Forest, Gradient Boosting, and Neural Network were evaluated on preprocessed data, focusing on recall as critical for anomaly detection in SHM. Models trained on reduced datasets showed varied performance compared to those using large, raw datasets, which, while computationally intensive, exhibited similar performance. SMOTE significantly improved recall, achieving 93.94% in Random Forest after correcting class imbalance and reducing dataset size. The findings underscore the potential of AIoT-driven machine learning approaches, to significantly enhance SHM modelling. By leveraging these technologies, infrastructure management can be fortified with more reliable anomaly detection capabilities, ensuring heightened safety and resilience in the AIoT era.},
  keywords={Support vector machines;Computational modeling;Focusing;Real-time systems;Web servers;Safety;Internet of Things;Anomaly detection;Monitoring;Random forests;AIoT;structural health monitoring;anomaly detection;machine learning;neural network},
  doi={10.1109/IICAIET62352.2024.10730006},
  ISSN={},
  month={Aug},}@ARTICLE{11488232,
  author={Qin, Shanming and Chen, Yingchun and Masuduzzaman, Md and Xu, Chengshun and Li, Rui and Wu, Tong and Fu, Dongyu and Jiang, Weiwei and Reddy Gadekallu, Thippa},
  journal={IEEE Internet of Things Journal}, 
  title={TinyML for Eddy Current Testing: A Review of Advances, Challenges, and Applications}, 
  year={2026},
  volume={13},
  number={12},
  pages={25630-25654},
  abstract={Eddy current testing (ECT) is a widely adopted electromagnetic nondestructive testing (NDT) technique for detecting defects in conductive materials. In practical deployments, however, ECT systems often suffer from low signal-to-noise ratio, strong sensitivity to lift-off and environmental variations, and complex multiparameter coupling, which makes robust signal interpretation challenging. Meanwhile, the growing demand for portable and always-on inspection pushes data processing toward resource-constrained embedded hardware. Tiny machine learning (TinyML) provides a promising pathway for enabling on-device intelligence by deploying compact models with low-latency and low-power consumption. This review summarizes recent progress in integrating TinyML into ECT, covering the ECT signal characteristics and key technical bottlenecks, the TinyML workflow and optimization techniques for embedded deployment, and representative application scenarios, including pipeline inspection, corrosion detection, and thickness evaluation. We further analyze the main barriers to adoption, such as limited computing power and memory, data scarcity, calibration overhead, and generalization across materials, probes, and defect types, and we outline future research directions, including physics-guided learning, federated learning (FL), and standardized benchmarks for ECT-oriented TinyML evaluation.},
  keywords={Sensor systems;Aerospace and electronic systems;Feeds;Radio broadcasting;Frequency modulation;Microcontrollers;Microprocessors;Circuits;Circuits and systems;Filters;Artificial intelligence (AI);eddy current testing (ECT);edge computing;Industrial Internet of Things (IIoT);tiny machine learning (TinyML)},
  doi={10.1109/JIOT.2026.3685248},
  ISSN={2327-4662},
  month={June},}@INPROCEEDINGS{11416306,
  author={Hasanpour, Mohammad Amin and Fafoutis, Xenofon and Roveri, Manuel},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={A Survey of Quantization Techniques in Embedded AI Toolchains}, 
  year={2025},
  volume={},
  number={},
  pages={520-527},
  abstract={Quantization has become a key method for enabling deep learning (DL) inference on resource-constrained embedded systems. As the demand for privacy-preserving, low-latency, and energy-efficient artificial intelligence (AI) increases, quantization allows models to run efficiently on edge hardware by reducing the precision of weights and activations—often with minimal impact on accuracy. This survey presents a tool-centric analysis of quantization support in twelve widely used embedded artificial intelligence (eAI) frameworks, including TensorFlow Lite, PyTorch, ONNX Runtime, and vendor-specific stacks like Qualcomm’s QNN and Intel’s OpenVINO. We examine how each tool implements quantization across several axes: supported workflows (post-training vs. quantization-aware training), bit-width flexibility, execution realism (simulated vs. integer kernels), and quantization granularity and schemes. Our findings reveal common patterns—such as the dominance of 8-bit uniform affine quantization—and highlight key distinctions in flexibility, deployment readiness, and hardware integration. We summarize our results in a unified comparison table to guide practitioners and researchers in selecting the most appropriate tool for their deployment needs. Finally, we discuss trends such as mixed-precision quantization and speculate on future directions for eAI tooling.},
  keywords={Training;Surveys;Deep learning;Quantization (signal);Accuracy;Embedded systems;Hardware;Internet of Things;Artificial intelligence;Low latency communication;Quantization;TinyML;Embedded AI;Machine Learning;Deep Learning},
  doi={10.1109/AIoT66900.2025.00079},
  ISSN={},
  month={Dec},}@INBOOK{11345355,
  author={Kara, Ilker},
  booktitle={Tiny Machine Learning: Design Principles and Applications}, 
  title={Efficient Data Cleaning and Anomaly Detection in IoT Devices Using TinyCleanEDF}, 
  year={2026},
  volume={},
  number={},
  pages={205-223},
  abstract={Summary <p>The proliferation of IoT devices has led to an exponential growth in the amount of generated data. In many applications, ranging from smart cities to healthcare monitoring, data should be clean and reliable to support critical decision&#x2010;making. However, the nature of IoT devices themselves constrains them from operating in environments that typically pose significant challenges to traditional data cleaning and anomaly detection methods. Thus, this paper presents a new data cleaning and anomaly detection approach &#x2013; called TinyCleanEDF. TinyCleanEDF employs a federated learning scheme to overcome the disadvantages of traditional methods, which require central data processing, and enables data cleaning and anomaly detection on IoT devices. This enables the framework to learn collaboratively from its distributed data in a manner that eliminates the need for transferring data to a central server. The approach keeps data privacy and reduces the burden associated with data transmission. Hence, this work proposes a compatible and scalable solution for various IoT applications, ranging from smart home systems to industrial automation, including environmental monitoring.</p>},
  keywords={Internet of Things;Cleaning;Anomaly detection;Reliability;Federated learning;Monitoring;Medical services;Automation;Performance evaluation;Data privacy},
