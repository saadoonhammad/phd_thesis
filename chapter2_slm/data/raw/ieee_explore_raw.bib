  url={https://ieeexplore.ieee.org/document/10790323},}@INPROCEEDINGS{10448698,
  author={Shen, Haocheng and Guo, Bin and Ding, Yasan and Xiao, Jie and Lv, Mingze and Yu, Zhiwen},
  booktitle={2023 IEEE Smart World Congress (SWC)}, 
  title={Fast-DAVAD : Domain Adaptation for Fast Video Anomaly Detection on Resource-Constrained Edge Devices}, 
  year={2023},
  volume={},
  number={},
  pages={1-8},
  abstract={The development of artificial intelligence of things (AIoT) makes it possible to detect video anomalies on intelligent edge devices with low transmission delay and data privacy. However, the performance of these applications is constrained by the domain shift between the diverse real-world environment and the training data. Despite the existence of many advanced domain adaptation methods, it is difficult to deploy these methods on resource-constrained intelligent edge devices due to their model complexity. In addition, there is a lack of large amounts of labeled real-scenario data to complete model training. In this paper, we propose the Fast-DAVAD, an unsupervised end-to-end lightweight adaptive video anomaly detection framework. It solves the domain shift problem through multi-level adversarial domain adaptation. Furthermore, it achieves short training time and inference latency on resource-constrained edge devices with Residual Unet, and applies a memory module to guarantee detection accuracy. Extensive experiments on public datasets and multiple platforms, such as PC and NVIDIA Jetson, demonstrate that the effectiveness and superiority of Fast-DAVAD compared with state-of-the-art domain adaptation-based video anomaly detection solutions.},
  keywords={Training;Adaptation models;Image edge detection;Memory modules;Internet of Things;Artificial intelligence;Anomaly detection;domain adaptation;video anomaly detection;edge computing},
  doi={10.1109/SWC57546.2023.10448698},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11125733,
  author={Leslin, Jelin and Trapp, Martin and Andraud, Martin},
  booktitle={2025 IEEE International Conference on Omni-layer Intelligent Systems (COINS)}, 
  title={Hardware-efficient tractable probabilistic inference for TinyML Neurosymbolic AI applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Neurosymbolic AI (NSAI) has recently emerged to mitigate limitations associated with deep learning (DL) models, e.g. quantifying their uncertainty or reason with explicit rules. Hence, TinyML hardware will need to support these symbolic models to bring NSAI to embedded scenarios. Yet, although symbolic models are typically compact, their sparsity and computation resolution contrasts with low-resolution and dense neuro models, which is a challenge on resource-constrained TinyML hardware severely limiting the size of symbolic models that can be computed. In this work, we remove this bottleneck leveraging a tight hardware/software integration to present a complete framework to compute NSAI with TinyML hardware. We focus on symbolic models realized with tractable probabilistic circuits (PCs), a popular subclass of probabilistic models for hardware integration. This framework: (1) trains a specific class of hardware-efficient deterministic PCs, chosen for the symbolic task; (2) compresses this PC until it can be computed on TinyML hardware with minimal accuracy degradation, using our nth-root compression technique, and (3) deploys the complete NSAI model on TinyML hardware. Compared to a 64b precision baseline necessary for the PC without compression, our workflow leads to significant hardware reduction on FPGA (up to 82.3% in FF, 52.6% in LUTs, and 18.0% in Flash usage) and an average inference speedup of 4.67× on ESP32 microcontroller.},
  keywords={Uncertainty;Limiting;Microcontrollers;Computational modeling;Tiny machine learning;Probabilistic logic;Hardware;Table lookup;Integrated circuit modeling;Field programmable gate arrays},
  doi={10.1109/COINS65080.2025.11125733},
  ISSN={2996-5330},
  month={Aug},}@ARTICLE{10470440,
  author={Akram, Junaid and Anaissi, Ali and Othman, Wajdy and Alabdulatif, Abdulatif and Akram, Awais},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={DroneSSL: Self-Supervised Multimodal Anomaly Detection in Internet of Drone Things}, 
  year={2024},
  volume={70},
  number={1},
  pages={4287-4298},
  abstract={In this study, we introduce a pioneering framework, DroneSSL, that integrates the concept of spatial crowdsourcing with TinyML to enhance anomaly detection in the Internet of Drone Things (IoDT). This innovative approach leverages drones and unmanned ground vehicles (UGVs) for expansive data collection in environments that are typically inaccessible or hazardous, such as during Australian bushfire incidents. By employing lightweight machine learning models alongside advanced communication technologies, DroneSSL transcends traditional spatial-temporal data analysis methods. It efficiently processes multimodal data from diverse Points-of-Interest (PoIs), significantly improving the quality and speed of data collection and analysis. The framework’s integration of a temporal feature extraction module with a Graph Neural Network (GNN) and its adaptable, scalable GNN architecture tailor DroneSSL for real-time operations in resource-constrained IoDT environments. Achieving an 89.6% F1 score, DroneSSL marks a substantial 4.9% improvement over existing approaches, highlighting its effectiveness in critical applications such as environmental surveillance and emergency response. This advancement not only showcases the potential of combining TinyML with spatial crowdsourcing for IoDT but also sets a new standard for efficient, scalable anomaly detection, paving the way for future innovations in IoT edge devices and environmental monitoring systems.},
  keywords={Drones;Anomaly detection;Graph neural networks;Crowdsourcing;Correlation;Data models;Training;Self-supervised learning;autoencoder;GNN;anomaly detection;drones;data fusion;TinyML},
  doi={10.1109/TCE.2024.3376440},
  ISSN={1558-4127},
  month={Feb},}@INPROCEEDINGS{11416234,
  author={Tuman, Muzart and Fang, Dongfeng and Hasan, Mohammad H},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Edge-Friendly IoT Intrusion Detection Using Efficient Boosted Convolutional Trees}, 
  year={2025},
  volume={},
  number={},
  pages={239-244},
  abstract={The growth of Internet of Things (IoT) devices has driven demand for real-time intrusion detection on constrained edge hardware. Traditional deep-learning intrusion detection systems (IDS) like CNNs and LSTMs deliver strong accuracy but impose large memory and compute requirements. This paper proposes a novel edge-friendly Boosted Convolutional Trees (BCT) model tailored for IoT network intrusion detection. Our BCT utilizes a compact convolutional front-end (no pooling) paired with differentiable soft decision-tree ensembles, enabling partial routing and end-to-end backpropagation of both convolutional and tree parameters. Results from testing on different datasets show that our model achieves comparable detection performance to deep CNN/LSTM baselines while using orders of magnitude fewer resources in model size, inference latency, and training footprint, while maintaining competitive F1 scores. Simulation results show that our edge-friendly BCT cuts latency by an average of 67.7% compared to competing deep learning models, making it ideal for real-time AIoT edge deployments.},
  keywords={Training;Image edge detection;Trees (botanical);Simulation;Network intrusion detection;Routing;Real-time systems;Internet of Things;Artificial intelligence;Testing;iot;ids;edge-friendly boosted convolutional trees},
  doi={10.1109/AIoT66900.2025.00044},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9795542,
  author={Sookpong, Satida and Kasetkasem, Teerasit and Phatrapornnant, Teera and Yu, Jaehoon},
  booktitle={2022 19th International Conference on Electrical Engineering/Electronics, Computer, Telecommunications and Information Technology (ECTI-CON)}, 
  title={A Unhealthy Plant Identification System Using a Generative Adversarial Network}, 
  year={2022},
  volume={},
  number={},
  pages={1-4},
  abstract={In this work, we investigated the use of Generative Adversarial Networks (GAN) for the unhealthy leaves identification in crop images for the automatic crop monitoring system. Here, we trained the GAN to generate healthy crop images from a healthy leaves image dataset. An unhealthy crop image can be detected by comparing the best-fit healthy crop image generated by GAN, and actually observed image. If the Mahalanobis distance between the observed image and model-generated one is larger than a pre-defined threshold, an image can be considered an unhealthy leaves image. The results from the ROC and Precision-Recall curves show that our model can detect unhealthy crop images with high accuracy.},
  keywords={Computational modeling;Neural networks;Crops;Generative adversarial networks;Telecommunications;Information technology;Monitoring;Anomaly Detection;Generative Adversarial Networks;Convolutional Neural Networks},
  doi={10.1109/ECTI-CON54298.2022.9795542},
  ISSN={},
  month={May},}@INPROCEEDINGS{11416284,
  author={Zheng, Zi-Wei and Tsai, Yu-Ting},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={A Deep Sequential Neural Network-Based Approach for Abnormal Vibration Detection in Robotic Arms}, 
  year={2025},
  volume={},
  number={},
  pages={717-721},
  abstract={With the advent of Industry 4.0, Prognostics and Health Management (PHM) has become a core issue in industrial automation. Traditional supervised learning approaches are hindered by the need for large volumes of manually labeled data, limiting their applicability in dynamic manufacturing settings. This paper proposes a novel abnormal vibration detection method based on an IoT-enabled sensor network, integrating controller-based automatic labeling with deep sequential neural networks, enabling deployment in flexible, high-mix, low-volume production lines. Vibration signals are collected from distributed robotic arm accelerometers via an IoT infrastructure using the MQTT protocol and are automatically labeled according to real-time controller actions, forming a multi-class anomaly dataset. Time-frequency analysis (STFT) is used for feature extraction, and a hybrid deep network combining convolutional, recurrent, and attention modules is designed with automated hyperparameter optimization. Experimental results show that the method achieves anomaly detection accuracy up to 96.59% and robust performance under various fault conditions. The paper further analyzes dataset and model design factors, and discusses extensions to robot health management enabled by IoT-based data integration.},
  keywords={Vibrations;Time-frequency analysis;Accuracy;Service robots;Supervised learning;Robot sensing systems;Manipulators;Feature extraction;Labeling;Prognostics and health management;deep learning;neural networks;prognostics and health management;robotic arms;abnormal vibration detection;time-frequency analysis;IoT},
  doi={10.1109/AIoT66900.2025.00111},
  ISSN={},
  month={Dec},}@ARTICLE{11422957,
  author={Wu, Haotian and Zhang, Jiwei and Feng, Minxi and Dai, Minghui and Mohiuddin, Samra and Bashir, Ali Kashif and Mumtaz, Shahid and Pei, Jiaming},
  journal={IEEE Communications Standards Magazine}, 
  title={Swarm Smarts: Enabling Real-Time Self-Healing With TinyML at the Edge}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Edge devices in 6G wireless networks are driving unprecedented levels of intelligence and autonomy, where billions of interconnected nodes collaboratively sense, learn, and adapt in real time. However, the coexistence of massive device heterogeneity, stringent resource constraints, and highly dynamic operational environments critically affects the stability and timeliness of decentralized model training and network management. The key challenge lies in achieving adaptive and reliable intelligence at the extreme edge, where computation, energy, and connectivity are fundamentally limited. To address this challenge, we propose a TinyML-driven self-healing framework that embeds lightweight learning agents into edge devices, enabling on-device analytics for local anomaly detection, adaptive self-recovery, and swarm-inspired collaboration for knowledge diffusion. Through model quantization and context-aware adaptation, TinyML effectively mitigates the impact of device heterogeneity by tailoring models to local capabilities, overcomes resource constraints via ultra-low-power inference, and sustains robustness under dynamic environments through distributed swarm coordination. A 6G-oriented smart factory case study demonstrates that, under these challenging conditions, our framework significantly improves fault detection latency, recovery speed, and communication efficiency compared with centralized solutions. Future work will focus on standardizing the TinyML-based self-healing architecture and defining interoperability interfaces to support large-scale deployment of resilient and autonomous Zero-Touch 6G Networks.},
  keywords={Peer-to-peer computing;6G mobile communication;Tiny machine learning;Image edge detection;Collaboration;Real-time systems;Adaptation models;Dynamic scheduling;Decision making;Federated learning},
  doi={10.1109/MCOMSTD.2026.3665678},
  ISSN={2471-2833},
  month={},}@INPROCEEDINGS{11416281,
  author={Yang, Dong-Hyuk and Lee, Hyeongjun and Kang, Yong-Shin},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Development of an AI Model Adaptation Strategy based on Multi-Resolution Concept Drift Detection: A Case Study in Virtual Metrology for Smart Manufacturing}, 
  year={2025},
  volume={},
  number={},
  pages={335-341},
  abstract={In dynamic manufacturing environments, artificial intelligence (AI) models are increasingly used to support data-driven decision-making through tasks such as quality prediction and anomaly detection. However, the presence of concept drift (CD)—changes in data distributions over time—poses a major challenge to maintaining AI model performance. Existing model performance-based CD detection methods have primarily focused on single-resolution temporal analysis, limiting their ability to detect diverse CD patterns occurring at varying time scales. In this paper, we propose a novel multi-resolution drift detection method (MRDDM) designed to detect both sudden and incremental drift by analyzing AI model performance across multiple temporal resolutions. A case study was conducted using real-world virtual metrology data collected from a steel manufacturing plant in Korea. Experimental results show that MRDDM outperforms benchmark methods. These findings demonstrate that MRDDM enables more flexible and reliable AI model adaptation in the presence of complex and evolving CD, thereby sustaining AI model performance in dynamic manufacturing settings.},
  keywords={Adaptation models;Analytical models;Statistical analysis;Concept drift;Metrology;Benchmark testing;Steel;Reliability;Artificial intelligence;Smart manufacturing;industrial internet of things;concept drift;multi-resolution analysis;virtual metrology;smart manufacturing},
  doi={10.1109/AIoT66900.2025.00056},
  ISSN={},
  month={Dec},}@ARTICLE{10177729,
  author={Abadade, Youssef and Temouden, Anas and Bamoumen, Hatim and Benamar, Nabil and Chtouki, Yousra and Hafid, Abdelhakim Senhaji},
  journal={IEEE Access}, 
  title={A Comprehensive Survey on TinyML}, 
  year={2023},
  volume={11},
  number={},
  pages={96892-96922},
  abstract={Recent spectacular progress in computational technologies has led to an unprecedented boom in the field of Artificial Intelligence (AI). AI is now used in a plethora of research areas and has demonstrated its capability to bring new approaches and solutions to various research problems. However, the extensive computation required to train AI algorithms comes with a cost. Driven by the need to reduce the energy consumption, the carbon footprint and the cost of computers running machine learning algorithms, TinyML is nowadays considered as a promising AI alternative focusing on technologies and applications for extremely low-profile devices. This paper presents the results of a literature survey of all TinyML applications and related research efforts. Our survey builds a taxonomy of TinyML techniques that have been used so far to bring new solutions to various domains, such as healthcare, smart farming, environment, and anomaly detection. Finally, this survey highlights the remaining challenges and points out possible future research directions. We anticipate that this survey will motivate further discussions on the various fields of applications of TinyML and the synergy of resource-constrained devices and edge intelligence.},
  keywords={Surveys;Medical services;Internet of Things;Hardware;Costs;Smart agriculture;Anomaly detection;TinyML;embedded machine learning;deep learning;edge intelligence},
  doi={10.1109/ACCESS.2023.3294111},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11590005,
  author={Abisek, S and Adithya, R M and Krishna Prashanth, P and Sundar, S},
  booktitle={2026 International Conference on Next Generation Electronics (NELEX)}, 
  title={Edge AI-Based Real-Time Fault Diagnostics for Industrial Motors Using Lightweight Neural Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Industrial motor fault detection traditionally relies on fixed-threshold monitoring or cloud-based analytics, both of which suffer from limited adaptability, latency, infrastructure dependency, and reduced operational efficiency. This paper presents a structured comparative study of three diagnostic approaches: conventional serial-monitor-based threshold monitoring without machine learning, cloud-based machine learning for predictive analysis, and fully on-device TinyML inference deployed on an ESP32 microcontroller. A physics-informed multisensor dataset comprising temperature, current, vibration, RPM, infrared, smoke, and load parameters was generated to represent eight different motor operating conditions. The cloud-based model achieves an accuracy of $96.67 \%$, while the proposed INT8quantized TinyML model shows $\mathbf{9 5. 1 8 \%}$ classification accuracy, with a weighted precision of $95.21 \%$, weighted recall of $95.18 \%$, weighted F1-score of $95.19 \%$, ROC-AUC of $99.68 \%$, and a validation loss of 0.152. When deployed on a 240 MHz ESP32 microcontroller, the optimized model achieves millisecond level inference latency ($\lt 1 \mathrm{~ms}$), requires only 1.9 KB of RAM, and occupies 26.7 KB of flash memory, enabling fully offline and real-time operation without network dependency. Comparative analysis shows that the TinyML approach significantly increases robustness over threshold-based systems ($68.3 \%$ accuracy) while eliminating latency and infrastructure complexities in cloudbased systems thereby establishing a scalable, low-cost, and energy-efficient solution for Industry $\mathbf{4. 0}$ motor health monitoring systems.},
  keywords={Modeling;Clouds;Tiny machine learning;Motors;Accuracy;Monitoring;Image sensors;Printing;Machine learning;Quantization (signal);TinyML;Edge AI;Industrial Motor Fault Detection;Multi-Sensor Fusion;ESP32;Cloud-Based Machine Learning;Threshold Monitoring;Industry 4.0;Embedded Systems;Real-Time Inference},
  doi={10.1109/NELeX69209.2026.11590005},
  ISSN={},
  month={May},}@ARTICLE{10443619,
  author={Zheng, Tao and Qiu, Yunxiang and Zheng, Yundan and Wang, Qixu and Chen, Xingshu},
  journal={IEEE Internet of Things Journal}, 
  title={Enhancing TinyML-Based Container Escape Detectors With Systemcall Semantic Association in UAVs Networks}, 
  year={2024},
  volume={11},
  number={12},
  pages={21158-21169},
  abstract={The adoption of lightweight container technology enables the cross-architecture deployment of tiny machine learning (TinyML) models, while the implementation of container escape detectors ensures the security of both models and applications. However, a significant challenge faced by TinyML-based detectors is model aging, which leads to a substantial decline in their effectiveness as attack patterns evolve. Most existing approaches address this issue by retraining models through the labeling of new samples. However, this process can be costly and challenging to implement for updating models in resource-constrained UAVs networks. In this article, we begin by analyzing the correlation of threat data and observe that throughout evolution, different versions of container escape attacks tend to maintain semantically identical or similar system calls. This observation prompts us to approach the model aging problem from a novel perspective: if the model can acquire knowledge of these fundamental system calls, it will be capable of effectively detecting emerging new attacks. Based on this perspective, we have developed sysE to capture system call data that remains unchanged or exhibits similarities to container escape attacks during evolution. This augmentation complements six TinyML-based detectors. Experimental results obtained from a large-scale evolving data set demonstrate that our proposed approach effectively mitigates the aging rate of these models, reducing it from 7.3% to 21.5%. Additionally, it significantly decreases the labeling effort required from 28.06% to 65.47%.},
  keywords={Containers;Biological system modeling;Detectors;Data models;Semantics;Aging;Security;Container escape;model aging;systemcall association;TinyML-based detector},
  doi={10.1109/JIOT.2024.3361452},
  ISSN={2327-4662},
  month={June},}@ARTICLE{10835408,
  author={Yi, Ling and Liu, Shiyu and Zhou, Li and Ning, Zhaolong and Song, Jiajie and Chen, Qingda and Zhang, Ke and Ding, Jinliang},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={Sensitivity Analysis-Based Explainable Diffusion Transformers for Anomaly Detection in Consumer Electronics Manufacturing}, 
  year={2025},
  volume={71},
  number={1},
  pages={2039-2050},
  abstract={Consumer electronics play a crucial role in the artificial intelligence Internet of Things (AIoT), with anomaly detection (AD) being particularly critical for the consumer product manufacturing industry. However, existing AD methods suffer from limitations such as poor detection accuracy and lack of explainability, hindering their widespread adoption in industrial manufacturing. To address these issues, we propose SADiTAD, a Sensitivity Analysis-based Diffusion Transformer for Anomaly Detection. This model comprises a diffusion transformer (DiT)-based reconstruction enhancement sub-network and a vision transformer (ViT)-based detection sub-network. In the DiT sub-network, we introduce a structural similarity index measure (SSIM)-guided one-step denoising method to expedite the denoising process. Additionally, to enhance the model’s explainability, we develop a sensitivity analysis-based ViT (SA-ViT) model, which evaluates the sensitivity of input embeddings to various image regions to determine if the fault region is being accurately identified during anomaly detection. The proposed SADiTAD model has been evaluated on public datasets MVTec AD and VisA, demonstrating superior performance over existing state-of-the-art anomaly detection methods and providing enhanced explainability.},
  keywords={Consumer electronics;Anomaly detection;Diffusion models;Sensitivity analysis;Transformers;Image reconstruction;Artificial intelligence;Noise reduction;Internet of Things;Anomaly detection;diffusion model;explainability;sensitivity analysis},
  doi={10.1109/TCE.2025.3527809},
  ISSN={1558-4127},
  month={Feb},}@INPROCEEDINGS{11492961,
  author={Banerjee, Vedanta and Chowdhury, Debjyoti and Chattopadhyay, Madhurima},
  booktitle={2026 International Conference on Computing, Electronics & Communications Engineering (ICCECE)}, 
  title={On-Device Low-Frequency Mechanical Fault Detection of Induction Motors using MEMS Sensors and Edge AI}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents a TinyML system for end-to-end, on-device vibration-based mechanical fault detection in single-phase induction motors. The sensing node integrates a low-cost MEMS inertial sensor (LSM6DSO) with an ESP32-C3 microcontroller. The proposed firmware implements orientation-invariant preprocessing, contiguous leakage-safe segmentation, and int8 quantized inference of a compact multi-channel 1D Convolutional Neural Network (CNN). Window-level outputs are aggregated using a confidence-weighted majority voting rule to provide robust diagnoses across four states: motorOFF, motorON, motorON_NoFan, and motorON_BadFan. By employing strictly contiguous file splits to prevent temporal data leakage, we report a window-level macro F1-score of 0.98 and a recording-level macro F1-score of 0.95 on held-out, position-specific data. The quantized model requires only 80 KB of Flash and 120 KB of RAM, with an inference latency of 82 ms. This demonstrates the feasibility of deploying sophisticated diagnostic AI on low-power edge devices for real-time industrial condition monitoring of induction motors.},
  keywords={Filtering;Microcontrollers;Filters;Microprocessors;Circuits and systems;Oscillators;Protocols;HTTP;Communication systems;Instant messaging;Condition monitoring;convolutional neural networks (CNN);edge AI;induction motors;microcontrollers;predictive maintenance;TinyML;vibration analysis},
  doi={10.1109/ICCECE69715.2026.11492961},
  ISSN={2768-0576},
  month={Feb},}@INPROCEEDINGS{10189195,
  author={Zonzini, Federica and Burioli, Letizia and Gashi, Andi and Mancini, Nicola Francesco and De Marchi, Luca},
  booktitle={2023 IEEE International Conference on Omni-layer Intelligent Systems (COINS)}, 
  title={A Tiny Convolutional Neural Network driven by System Identification for Vibration Anomaly Detection at the Extreme Edge}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Vibration data analysis is the driving tool for the Structural Health Monitoring (SHM) of structures in the dynamic regime, i.e., structures showing important oscillatory behaviours, which largely dominate the transportation back-bone: from terrestrial/aerial vehicles (e.g., trains, aircraft, etc.) to the supporting infrastructures (e.g., bridges, viaducts, etc.). Outstanding opportunities have recently been disclosed in the field of Intelligent Transportation Systems (ITS) by the advent of sensor-near processing functionalities, eventually empowered by Artificial Intelligence (AI). The latter allow for the extraction of damage-sensitive features at the extreme edge, without the need of transmitting long time series over the monitoring network. In this work, we explore for the first time a novel anomaly detection workflow for on-sensor vibration diagnostics, which combines the unique advantages of embedded System Identification (eSysId) as a data compression strategy with the computational/energy advantages of Tiny Machine Learning (TinyML). Experimental results conducted on a representative SHM dataset demonstrate that the proposed pipeline can achieve high classification scores (above 90%) for the health assessment of the well-known Z24 bridge. In particular, the minimal inference time (less than 44 ms) and power consumption performed while running on three different general-purpose microprocessors make it a promising solution for the development of the next generation of SHM-oriented ITS.},
  keywords={Vibrations;Bridges;Image edge detection;Time series analysis;Transportation;Machine learning;Feature extraction;Anomaly Detection;Embedded System Identification;Convolutional Neural Network;Intelligent Transportation Systems;Structural Health Monitoring;Tiny Machine Learning},
  doi={10.1109/COINS57856.2023.10189195},
  ISSN={},
  month={July},}@INPROCEEDINGS{11416302,
  author={Kuo, Nai-An and Fan, Chia-Hao and Liu, Ping-Chih and Sun, Shi-Sheng},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Hybrid Sybil Attack Detection in IoV Networks Using Rule-Based and Deep Learning Methods}, 
  year={2025},
  volume={},
  number={},
  pages={262-270},
  abstract={The Internet of Vehicles (IoV) connects vehicles, infrastructure, and pedestrians to enable efficient traffic management, autonomous driving, and real-time interactions. However, security concerns have emerged with Sybil attacks, where attackers forge multiple identities posing a serious threat. While many machine learning approaches have been used to detect Sybil nodes, they often result in high computational and communication costs. To address this, we proposed an efficient two-stage Sybil detection method that integrates rule-based techniques with deep learning. In the first stage, vehicles implement individual detection, and Roadside Units (RSUs) collect vehicle broadcast data to detect anomalies. Upon detection, data is sent to a central IoV server, where a deep learning model analyzes time-series data to accurately identify Sybil nodes, thus enhancing detection accuracy while reducing system overhead.},
  keywords={Deep learning;Pedestrians;Simulation;Scalability;Road side unit;Network architecture;Real-time systems;Servers;Security;Internet of Vehicles;Internet of Vehicles (IoV);Sybil attack;Deep learning;Rule-based;Attack detection},
  doi={10.1109/AIoT66900.2025.00047},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11416414,
  author={Baniya, Babu Kaji},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={An Efficient Intrusion Detection Framework for IoMT Using Hybrid LSTM-XGBoost Model}, 
  year={2025},
  volume={},
  number={},
  pages={923-928},
  abstract={The Internet of Things (IoT) has become ubiquitous, with applications across healthcare, education, agriculture, autonomous driving, smart grids, smart homes, and tracking systems. While IoT offers advantages such as lightweight design, reliability, and cost-effectiveness, it also introduces challenges including security vulnerabilities, scalability issues, and privacy concerns. This study addresses a critical security issue in IoT-based healthcare systems-intrusion detection under highly imbalanced sample distributions. The proposed method integrates Long Short-Term Memory (LSTM) classifier with Extreme Gradient Boosting (XGBoost): LSTM extracts temporal patterns as fixed-size embeddings, and XGBoost performs the final classification while handling class imbalance. Experiments on the WUSTL-EHMS-2020 dataset, which contains both network-level and patient biometric features, show that the proposed method achieves 95.28% accuracy with consistently high precision, recall, and F1-scores. To address class imbalance, Adaptive Synthetic Sampling (ADASYN) and class weighting are applied. The proposed hybrid LSTM (HLSTM) model also achieves an average response time of 0.0097 ms per sample, ensuring rapid detection. Comparative results demonstrate that the hybrid model outperforms individual classifiers such as XGBoost and Random Forest (RF), making it effective for real-time intrusion detection in IoT-based healthcare environments.},
  keywords={Adaptation models;Accuracy;Intrusion detection;Medical services;Real-time systems;Internet of Things;Time factors;Security;Artificial intelligence;Long short term memory;XGBoost;explainable;prediction;confusion matrix;intrusion;embedding},
  doi={10.1109/AIoT66900.2025.00150},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11416282,
  author={Kornaros, George and Martini, Stavros and Spyridakis, Nicolas and Polixronidou, Alexandra},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Trusted Execution, Updating of AI/ML Models and Sensor Data through Isolation on IoT Devices}, 
  year={2025},
  volume={},
  number={},
  pages={861-865},
  abstract={Despite the fact that Artificial Intelligence and Machine Learning (AI/ML) is one of the most popular computing paradigms in the IoT architecture and has been incorporated into many applications, the vulnerabilities of AI/ML in a IoT ecosystem require device-level hardening techniques. AI/ML models commonly designed in not malignant environment need updating and optimizations when running on a variety of IoT devices with heterogeneous communications, that generate vast amounts of real-time data, and have limited resources, which rises adversarial perturbations. Hence, in this work, we develop protection methods combining hardware and software methods to guarantee both deterministic real-time processing and trusted models execution in embedded systems. Through isolated hard-ware and software components to achieve controlled scheduling, updating and critical data transfers after authentication, we demonstrate a real system-level trusted IoT device executing secure real-time deterministic algorithms such as ML inferencing on sensor data.},
  keywords={Trusted computing;Technological innovation;Job shop scheduling;Biological system modeling;Computational modeling;Authentication;Real-time systems;Data models;Software;Internet of Things;Edge AI/ML model;IoT trusted execution;secure industrial cyber physical systems;secure scheduling;isolation of real-time firmware;secure interprocess communication},
  doi={10.1109/AIoT66900.2025.00139},
