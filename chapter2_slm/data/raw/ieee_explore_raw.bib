  number={},
  pages={1-6},
  abstract={ThirstyAI and resource-constrained environments have become evergrowing challenges for Machine Learning (ML), especially large-scale Deep Learning (DL) models. This paper introduces NanoDeploy Automator, an Automated Machine Learning (AutoML) subsystem for the TANDEM native Artificial Intelligence (AI) edge platform, designed for efficient and reliable Tiny Machine Learning (TinyML), addressing the need for smaller models with minimal loss of accuracy and automated model compression and deployment at the edge. This work has been conducted in scope of project TANDEM and is currently expanded and adapted, forming the basis for the TinyML mechanisms of project SUNRISE-6G. The paper showcases the novel application of Time Generative Pre-Trained Transformer (TimeGPT) in real-world Internet of Things (IoT) scenarios, emphasizing three key contributions: a cutting-edge Automated TinyML (AutoTinyML) pipeline, the integration of TimeGPT in IoT, and a comprehensive evaluation of time series forecasting and anomaly detection techniques. Evaluation results demonstrate the efficiency of the AutoTinyML pipeline in terms of accuracy and model compression. The proposed system holds promise for diverse applications, leveraging the power of AutoTinyML, and reflects a significant stride towards democratizing access to accurate predictions and reducing uncertainty in edge computing scenarios, eliminating the need for a dedicated team of ML engineers.},
  keywords={Adaptation models;Accuracy;Uncertainty;Pipelines;Time series analysis;Transformers;Reliability engineering;Automated Machine Learning;Tiny Machine Learning;Artificial Intelligence;Big Data;Internet of Things;Edge Computing;Edge Intelligence},
  doi={10.1109/SmartNets61466.2024.10577687},
  ISSN={2837-4940},
  month={May},}@ARTICLE{9969601,
  author={Albanese, Andrea and Nardello, Matteo and Fiacco, Gianluca and Brunelli, Davide},
  journal={IEEE Sensors Journal}, 
  title={Tiny Machine Learning for High Accuracy Product Quality Inspection}, 
  year={2023},
  volume={23},
  number={2},
  pages={1575-1583},
  abstract={The quality inspection of industrial products is a fundamental step in large-scale production as it boosts the yield and reduces the costs. Intelligent embedded platforms with built-in tiny machine learning (tinyML) algorithms and cameras can automate quality inspection; however, running complex deep learning algorithms in low-cost and low-power embedded devices is still challenging because of limited memory and energy resources. This article presents an innovative sensor system with three microcontroller unit (MCU)-based tinyML cameras capable of automatic artifact and anomaly detection in plastic components. The system consists of a top camera responsible for identifying shape defects and two side cameras for color anomalies. Data processing is executed locally with tinyML reducing data transmission to a few bytes. Two state-of-the-art convolutional neural network (CNN) architectures are evaluated, namely, MobileNetV2 and SqueezeNet. Results show how both the architectures—with appropriate compression techniques—are suitable to be evaluated by resource-constrained microcontrollers. The networks achieve 99% classification accuracy while maintaining suitable real-time performance, respectively, equal to 5 and 2 frames/s.},
  keywords={Cameras;Inspection;Sensors;Visualization;Cloud computing;Belts;Production;Edge processing;Industrial Internet of Things (I-IoT);Industry 4.0;tiny machine learning (tinyML);visual inspection},
  doi={10.1109/JSEN.2022.3225227},
  ISSN={1558-1748},
  month={Jan},}@INPROCEEDINGS{11415782,
  author={Xue, Ruitao and Jha, Devki Nandan and Szydlo, Tomasz and Ranjan, Rajiv},
  booktitle={2025 IEEE International Conference on Data Mining Workshops (ICDMW)}, 
  title={STREAM-LAD: A Practical Streaming Lifelong Anomaly Detection Algorithm for IoT}, 
  year={2025},
  volume={},
  number={},
  pages={1546-1550},
  abstract={Lifelong anomaly detection holds immense promise for enabling on-device intelligence in the Internet of Things (IoT), as devices need to adapt to evolving environments continuously. State-of-the-art algorithms based on random sub-sampling and the Local Outlier Factor (LOF) have demonstrated high accuracy in experiments. However, their reliance on Python and resourceintensive scientific computing libraries has created a critical deployment gap, preventing their use on real-world, resourceconstrained microcontrollers (MCUs). This paper bridges this gap by presenting STREAM-LAD, the first high-performance, self-contained $\mathbf{C}$ implementation of this lifelong learning framework, with a seamless Python wrapper to facilitate rapid prototyping and evaluation. We demonstrate that our implementation achieves full accuracy parity. More importantly, we show that our C-accelerated version provides a modest but consistent latency reduction while achieving an order-of-magnitude reduction in deployment footprint (binary size and memory), enabling its deployment on a real MCU-based hardware. By providing the first open-source, stream-native implementation of this framework, we provide a foundational tool for the next wave of research into practical, lifelong learning on continuous data streams.},
  keywords={Training;Adaptation models;Accuracy;Scientific computing;Tiny machine learning;Scalability;Hardware;Complexity theory;Internet of Things;Anomaly detection;Lifelong Learning;Anomaly Detection;Embedded Systems;TinyML;Internet of Things (IoT);Local Outlier Factor (LOF)},
  doi={10.1109/ICDMW69685.2025.00185},
  ISSN={2375-9259},
  month={Nov},}@INPROCEEDINGS{10405679,
  author={Esmaili, Parisa and Cavedo, Federico and Esmaili, Parvaneh and Norgia, Michele},
  booktitle={2023 IEEE International Conference on Metrology for eXtended Reality, Artificial Intelligence and Neural Engineering (MetroXRAINE)}, 
  title={TinyML Anomaly Detection in Portable Cutting Tools}, 
  year={2023},
  volume={},
  number={},
  pages={747-751},
  abstract={Through electrical impedance measurement between the bar of the cutting tool and the operator's body, an active impedance protection system can discriminate between the body proximity while cutting a tree. However, the performance of simple threshold-based systems can be affected by the unpredictability of the working environment in addition to the complexity of cutting tasks. This paper proposes and evaluates a protection system for portable cutting tools based on end-to-end anomaly detection using TinyML paradigm. The model is based on the fully connected neural network and K-means clustering algorithm, which is developed on the ESP32-DevKitC-V4. Considering anomaly rank while approaching normal or hazardous situations, the proposed system shows an improvement in detecting different states enabling real-time decision-making through a compact, low-cost, and low-power consumption solution.},
  keywords={Cutting tools;Impedance measurement;Clustering algorithms;Safety;Impedance;Task analysis;Anomaly detection;Impedance measurement;Portable cutting tools;Object detection Anomaly detection;Fully connected neural network;k-means clustering;Edge computing;embedded machine learning;Safety devices},
  doi={10.1109/MetroXRAINE58569.2023.10405679},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11223294,
  author={Ibraheem, Amani},
  booktitle={2025 16th International Conference on Network of the Future (NoF)}, 
  title={Lightweight and Energy-Efficient Anomaly Detection for Green IoT Networks}, 
  year={2025},
  volume={},
  number={},
  pages={86-90},
  abstract={The Internet of Things (IoT) is highly susceptible to cyberattacks due to its vast attack surface and the limited security capabilities of connected devices. These devices are often resource-constrained, lacking the computational power, memory, and energy capacity to support conventional anomaly detection methods. To address this challenge, we propose a lightweight and energy-efficient anomaly detection framework based on Tiny Machine Learning (TinyML). Our approach employs a quantized neural network, enabling real-time detection while operating within the tight resource budgets of IoT edge devices. The model achieves a $\mathbf{9 1 . 6 5 \%}$ reduction in model size and a $\mathbf{4, 4 9 2} \times$ speedup in inference time, with only a minor drop in performance, maintaining $93.99 \%$ accuracy and strong F1-score results with $\mathbf{9 6 . 7 1 \%}$. This work demonstrates the feasibility of deploying sustainable, on-device AI for IoT cybersecurity and provides a detailed evaluation of the trade-offs between detection accuracy and energy efficiency.},
  keywords={Performance evaluation;Accuracy;Quantization (signal);Image edge detection;Tiny machine learning;Energy efficiency;Real-time systems;Internet of Things;Artificial intelligence;Anomaly detection;Neural networks;IoT;energy efficiency;anomaly detection;sustainable AI},
  doi={10.1109/NoF66640.2025.11223294},
  ISSN={2833-0072},
  month={Sep.},}@INPROCEEDINGS{10780735,
  author={Gao, Huaxu and Wang, Ziming and Wan, Jinhao and Zheng, Haojie and Zheng, Ye and Zhou, Yejian and Hong, Zhen},
  booktitle={2024 International Conference on Artificial Intelligence of Things and Systems (AIoTSys)}, 
  title={Networked Radar Anomaly Detection Based on Graph Deep Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={Due to its stable performance advantages, networked radar has garnered increased attention in recent years. To address the numerous challenges of traditional radar anomaly detection, a graph deep learning-based method is proposed. This method models radar scenarios as graph structures and utilizes graph convolutional networks to learn and extract features from graph data, effectively capturing spatial and temporal information of anomalies. This approach significantly enhances detection accuracy and robustness. Experimental results demonstrate that the proposed algorithm achieves notable performance improvements in networked radar anomaly detection tasks, providing a viable solution for radar systems in complex environments.},
  keywords={Correlation;Accuracy;Graph convolutional networks;Radar detection;Radar;Radar tracking;Feature extraction;Spatial databases;Spatiotemporal phenomena;Anomaly detection;Networked radar;anomaly detection;graph convolutional networks},
  doi={10.1109/AIoTSys63104.2024.10780735},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10792760,
  author={Gurram, Mani Rupak and PK, Mithun Kumar and Amsaad, Fathi},
  booktitle={2024 IEEE Physical Assurance and Inspection of Electronics (PAINE)}, 
  title={Isolation Forest Based TinyML for Detecting Hardware Trojans on FPGA in Real Time}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The growing utilization of microcontrollers and FPGAs across several sectors has amplified the vulnerability to hardware attacks, namely the potential for information leakage via hardware Trojans. Real-time detection of these Trojans is essential for preserving the integrity and security of hardware systems. This research presents a new method for detecting hardware Trojans in real-time by combining TinyML and FPGA technology. By utilizing the capabilities of FPGA, we gather timing and power data to detect irregularities that could potentially indicate the existence of hardware Trojans. We employ a training process that utilizes an Isolation Forest machine learning model, which is recognized for its strong capability in identifying anomalies. Subsequently, the model is transformed into Verilog code and implemented on the FPGA, facilitating the detection of Trojans with high efficiency and effectiveness during the execution of a program. The proposed solution not only improves the security of the hardware, but also proves the possibility of combining advanced machine learning models with FPGA technology for real-time applications. The outcomes of our study demonstrate substantial enhancements in the precision and efficiency of detection, therefore facilitating the development and implementation of more secure hardware designs.},
  keywords={Training;Runtime;Tiny machine learning;Hardware security;Forestry;Real-time systems;Timing;Trojan horses;Field programmable gate arrays;Anomaly detection;Isolation forest;TinyML;FPGA;Side Channel;Hardware Trojan},
  doi={10.1109/PAINE62042.2024.10792760},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11140465,
  author={Trivedi, Dharma and Bhatia, Shreya and Bhatt, Shivanshi and Pathak, Lakshin and Shastri, Krisha and Vyas, Karm and Mehta, Dev and Gupta, Rajesh and Tanwar, Sudeep},
  booktitle={2025 5th Intelligent Cybersecurity Conference (ICSC)}, 
  title={DeFeAt: Explanable TinyML-based Framework for Anomaly Detection in Nano-Sensor Traffic in 6G-Enabled Smart Grid}, 
  year={2025},
  volume={},
  number={},
  pages={43-48},
  abstract={This paper presents an Explainable Artificial Intelligence (XAI) based methodology for anomaly detection framework, i.e., DeFeAt, to detect anomalies in nano-sensor traffic in smart grids. TinyML is also incorporated in the framework besides other deep learning models like LSTM and GRU, along with optimizers like Adam, Nadam, and RMSprop. TinyML surpassed the other models as it maintained an average validation accuracy of 98.12 % for all optimizers with the minimum validation loss of 0.3343 using the Adam optimizer and has a model size of 56.26 KB. GRU and LSTM also delivered similar results, however, they needed larger model capacities – with GRU requiring 237.73 KB (Nadam) and LSTM 293.85 KB (Nadam). To promote accessibility, SHAP was used to explain the given model’s prediction, and LIME was also used, the major insights indicated that latency and error rate were the primary emerging features. The proposed DeFeAt framework offers costeffective, accurate, and interpretable fault detection which opens up possibilities for next-generation work on scalability, real-time and online decision-making, and integration with other nextgeneration technologies such as edge computing.},
  keywords={Accuracy;Explainable AI;Tiny machine learning;Scalability;Predictive models;Real-time systems;Smart grids;Long short term memory;Anomaly detection;Next generation networking;Smart Grids;Nano-Sensor Traffic;Anomaly Detection;Explainable AI;TinyML;LSTM;GRU;SHAP;LIME},
  doi={10.1109/ICSC65596.2025.11140465},
  ISSN={},
  month={May},}@INPROCEEDINGS{11256366,
  author={Bhatt, Shivanshi and Shah, Yashvi and Shah, Parishi and Pathak, Lakshin and Gupta, Rajesh and Tanwar, Sudeep},
  booktitle={2025 IEEE International Conference on Contemporary Computing and Communications (InC4)}, 
  title={FinGuard: TinyML-based Framework for Anomaly Detection in Meta Gaming Financial Transactions}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper presents a novel TinyML-based lightweight solution for the meta gaming financial transactions anomaly detection in constrained environments like the edges. The framework provides the essential capability of processing transactional data, and then arranging it into risk-based categories, by utilizing a powerful preprocessing module, and a simple, yet effective model. It makes 98% accurate results, 0.97 recall, and a precision of 0.96 of TinyML, and this model is comparatively better than a traditional model, LSTM, GRU, CNN1D. TinyML requires a mere 45 seconds to train its model while it only uses 300 KB of space meaning that it can practically work with any platform and respond in real time. The framework also includes a governance and security layer for protecting financial transactions, increasing the stability of meta gaming environment. This work, therefore, presents a wide possibility of extension to other fields such as IoT and health, where the detection of anomalous events must be efficient and light.},
  keywords={Accuracy;Tiny machine learning;Image edge detection;Scalability;Stability analysis;Real-time systems;Data models;Security;Anomaly detection;Long short term memory;TinyML;anomaly detection;meta gaming;financial transactions;edge devices;precision;scalability;lightweight framework;resource efficiency},
  doi={10.1109/InC465408.2025.11256366},
  ISSN={},
  month={March},}@INPROCEEDINGS{10385110,
  author={Casiroli, Martina and Pau, Danilo Pietro},
  booktitle={2023 IEEE Global Conference on Artificial Intelligence and Internet of Things (GCAIoT)}, 
  title={Tiny Machine Learning Business Intelligence in the Semiconductor Industry: A Case Study}, 
  year={2023},
  volume={},
  number={},
  pages={9-16},
  abstract={This paper sets its primary objective to understand the transformative potential of Tiny Machine Learning (Tiny ML) and Artificial Intelligence (AI) in enhancing industrial efficiency. Using a research design that juxtaposes the theoretical understanding of these technologies with real-world applications, the methodology adopted emphasizes three pivotal use cases, substantiated with tangible examples. The main outcomes show the influential role of STMicroelectronics, a leading semiconductor entity, in bridging the gap between Tiny ML, AI, and industrial applications. Results from in-depth examinations highlight the value of Predictive Maintenance as evidenced by offshore wind farms, the importance of Gesture Recognition in Human-Machine Interaction with a focus on autonomous vehicles, and the efficient integration of Tiny ML into IoT Sensor Networks, notably seismic monitoring. In conclusion, this manuscript underscores the impending future where Tiny ML and AI synergize, particularly hinting at breakthroughs in humanoid robotics. Such advancements are anticipated to redefine the contours of human-technology interaction impacting everyone in everyday life.},
  keywords={Human computer interaction;Technological innovation;Electronics industry;Collaboration;Humanoid robots;Wind farms;Robot sensing systems;Tiny ML;Artificial Intelligence;Semiconductor;ST;Use cases;Predictive maintenance;Human machine interactions;IoT sensor networks;Humanoid robotics},
  doi={10.1109/GCAIoT61060.2023.10385110},
  ISSN={},
  month={Dec},}@ARTICLE{11289552,
  author={Zhao, Yue and Srivastava, Gautam and Ullah, Farhan},
  journal={IEEE Internet of Things Journal}, 
  title={HoloTiny-AD: A Trustworthy Anomaly Detection in Resource-Constrained IoT Devices Using Holographic TinyML and Deep Metaheuristics}, 
  year={2026},
  volume={13},
  number={5},
  pages={8348-8358},
  abstract={Mobile edge computing (MEC) security and performance may be threatened by network traffic anomalies such as illegal data transfers or access. Traditional detection methods, such as machine learning, statistical models, and signature-based methods, are ineffective for real-time monitoring in resource-constrained devices. TinyML deploys lightweight models on resource-limited devices for rapid, localized, low-power threat detection without cloud access, improving MEC real-time security. This article introduces HoloTiny-AD, a real-time anomaly detection technique in MEC using the holographic counterpart (HC) architecture, TinyML, and deep particle swarm optimization (DPSO). The proposed approach effectively monitors and detects anomalies while using minimum computing resources, making it suitable for MEC. HC uses TinyML models trained with lightweight classifiers to mimic device state transitions and analyze anomalies to identify potential risks. DPSO optimizes parameters and task scheduling to increase detection accuracy and predict overload or busy state device failures. The proposed methodology is evaluated on two benchmark datasets: CIC-BCCC-NRC-ACI-IOT-2023 and CIC-IDS2017. Results show that HoloTiny-AD is a robust, scalable solution for securing edge devices against evolving network threats under resource constraints.},
  keywords={Anomaly detection;Tiny machine learning;Image edge detection;Real-time systems;Accuracy;Internet of Things;Mathematical models;Machine learning;Computer architecture;Computational modeling;Cybersecurity;holographic analysis;metaheuristic algorithms;mobile edge computing (MEC);TinyML;trustworthy anomaly detection},
  doi={10.1109/JIOT.2025.3642146},
  ISSN={2327-4662},
  month={March},}@INPROCEEDINGS{11331528,
  author={Islam, Anik and Karimipour, Hadis and Gadekallu, Thippa Reddy},
  booktitle={2025 IEEE International Conference on Cloud Computing Technology and Science (CloudCom)}, 
  title={TwinSnake: A ZTN-Orchestrated Architecture for Secure AIoT Model Training with Digital Twins and Bio- Inspired Snake Learning in Smart Cities}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Artificial Intelligence of Things (AIoT) systems are increasingly deployed in smart cities to enable automation, resource optimization, and real-time decision-making. How-ever, large-scale deployments face significant challenges, in-cluding device-level resource limitations, communication over-head, synchronization inefficiencies, and security threats such as data and model poisoning. To address these issues, a digi-tal twin-assisted collaborative learning framework is proposed. Resource-constrained devices are virtualized at home edge servers to offload computationally intensive training, while Multi- access Edge Computing (MEC) nodes equipped with Zero-Touch Networking (ZTN) autonomously orchestrate training policies. Snake learning is adopted to reduce synchronization delays and communication costs compared with federated and split learning, and Harris Hawks Optimization is applied to select participants based on trust, resources, and latency. Robustness against ad-versarial updates is ensured through a trust-weighted Adaptive Multi-Krum aggregation mechanism, while a permissioned blockchain provides tamper-proof auditability and accountability. Experimental results on a smart home intrusion detection dataset demonstrate a 50-65% reduction in communication, 30-45% reduction in computation and energy consumption, and Fl- scores above 95 % even under 40 % adversarial participation.},
  keywords={Training;Cloud computing;Smart cities;Computational modeling;Learning (artificial intelligence);Digital twins;Blockchains;Internet of Things;Synchronization;Optimization;Artificial intelligence of things;bio-inspited algorithm;blockchain;digital twin;home edge computing;multi-access edge computing;snake learning;zero touch networks},
  doi={10.1109/CloudCom67567.2025.11331528},
  ISSN={2380-8004},
  month={Nov},}@INPROCEEDINGS{11416278,
  author={Adewole, Kayode S. and Jacobsson, Andreas and Davidsson, Paul},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Self-supervised Behavioral Anomaly Detection for Internet of Things Environments}, 
  year={2025},
  volume={},
  number={},
  pages={231-238},
  abstract={Internet of things (IoT) environments, such as smart homes and intelligent buildings, provide significant convenience but introduce serious security vulnerabilities through abnormal user behaviors. Traditional intrusion detection systems (IDS) that rely on signature-based methods fail to recognize novel or adversarial attacks, while anomaly detection approaches, although capable of identifying unknown threats, typically suffer from false alarms. To address these challenges, this paper proposes a self-supervised learning approach using two autoencoder models, one based on classical autoencoder and the other based on Long Short-Term Memory (LSTM) autoencoder. We leverage Generative Adversarial Networks (GAN) to model user behavioral changes and design five scenarios to evaluate the efficacy of our proposed approach. Using publicly available dataset, the results show that the LSTM-based autoencoder outperforms the other models, including two models that are commonly used for anomaly detection, Isolation Forest (IF) and Local Outlier Factors (LOF). Our proposed approach improves detection accuracy while reducing error rates of anomaly detection in IoT environments.},
  keywords={Accuracy;Autoencoders;Smart homes;Self-supervised learning;Generative adversarial networks;Robustness;Internet of Things;Security;Anomaly detection;Long short term memory;Internet of Things;smart homes;intelligent buildings;unsupervised machine learning;anomaly detection;security;threat;zero-day attack;adversarial attack},
  doi={10.1109/AIoT66900.2025.00043},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10710811,
  author={Kühnel, Johannes and Eißmann, Timo and Wiede, Christian and Schwung, Dorothea and Grabmaier, Anton},
  booktitle={2024 IEEE 29th International Conference on Emerging Technologies and Factory Automation (ETFA)}, 
  title={Semi-Supervised Anomaly Detection in the TinyML Domain Through Multi-Target Few-Shot Domain Adaptation}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Tiny ML, defined by its ability to integrate AI into the smallest devices, unlocks the potential for always-on AI solutions at the edge. This capability is essential in predictive maintenance, enabling smart sensors within the Industrial In-ternet of Things (1IoT). In factory automation, the ability to detect anomalies and adapt those anomaly detection models to varying operating conditions is crucial for the efficiency and longevity of machinery. However, the challenge of semi-supervised anomaly detection with domain adaptation across diverse working conditions has not been sufficiently addressed in TinyML. This paper presents Shared Encoder Domain Adaptation (SEDA) to overcome these limitations. SEDA is a multi-target domain adaptation method for anomaly detection tailored to TinyML applications. Our approach facilitates the transfer of knowledge from existing domains to new ones, ensuring reliable anomaly detection in all domains with minimal data under new operational conditions. This is particularly relevant for IloT applications, where sensors must perform condition monitoring in a self-learning manner. The effectiveness of our method is evaluated through an extensive parameter study on the Toy-ADMOS 2 data set and compared to various baseline methods. The results show an improvement of up to 0.212 on the Area Under the Receiver Operating Characteristic Curve (ROC-AUC) score. It demonstrates that our method significantly enhances performance in multi-target domain adaptation. Importantly, it does this while remaining efficient for resource-constrained systems. This method has the potential to enable self-learning sensor systems with adaptation strategies to different working conditions while requiring only a few data points from these new domains.},
  keywords={Employee welfare;Training;Tiny machine learning;Training data;Sensor phenomena and characterization;Sensor systems;Artificial intelligence;Anomaly detection;Manufacturing automation;Signal to noise ratio;ANN;TinyML;Embedded AI;Edge AI;Autoen-coder;Domain-Shift;Anomaly Detection;Domain Adaptation;Semi-Supervised;Few-Shot},
  doi={10.1109/ETFA61755.2024.10710811},
  ISSN={1946-0759},
  month={Sep.},}@INPROCEEDINGS{11200680,
  author={P, Essakki Gomathy and R, Bagavathi Lakshmi},
  booktitle={2025 4th International Conference on Innovative Mechanisms for Industry Applications (ICIMIA)}, 
  title={Lightweight TinyML-based Anomaly Detection for Intelligent Robotic Process Automation Workflows}, 
  year={2025},
  volume={},
  number={},
  pages={93-97},
  abstract={Robotic Process Automation (RPA) has immensely automated manual business processes in industry, finance, and administration. Nevertheless, the traditional RPA bots are still predominantly reactive, i.e., they cannot make intelligent decisions to identify anomalies or other atypical behavior in real time. This paper introduces a lightweight, embedded anomaly detection framework based on TinyML to provide RPA systems with a self-monitoring tier of intelligence. The suggested approach uses data on the structured event logs of the payment request processes, which are handled through feature engineering, outlier mitigation, and normalization of the full-scale process. A small 1D Convolutional Neural Network (CNN) was trained to classify anomalous patterns, achieving 94% accuracy and the .tflite model was deployed using Edge Impulse to be compatible with the microcontroller. The experimental evaluation effectively identified suspicious transactions based on time, amount, and pattern deviations. The system was tested and validated on real data from the BPI Challenge 2020 task. The study would be valuable in understanding scalable AI embedment at the specific stage of RPA to allow proactive anomaly detection to move beyond the intelligent automation systems of the previous generation.},
  keywords={Intelligent automation;Industries;Microcontrollers;Tiny machine learning;Prevention and mitigation;Manuals;Real-time systems;Convolutional neural networks;Anomaly detection;Monitoring;robotic process automation;tinyml;anomaly detection;edge computing;1d convolutional neural network;tensorflow lite;machine learning on microcontrollers;intelligent automation;isolation forest;real-time anomaly detection;edge impulse;workflow monitoring;embedded ai},
  doi={10.1109/ICIMIA67127.2025.11200680},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11418151,
  author={Mondal, Molay and Datta, Arko and Durgam, Prashanth and Mondal, Astom and Shyam, Khushi and Majhi, Pabitra and Nandi, Subrata and Bhattacharjee, Sanghita and Saha, Sujoy},
  booktitle={2026 18th International Conference on COMmunication Systems and NETworks (COMSNETS)}, 
  title={iAirGuard: A Modular IoT Architecture with Dynamic Sampling and TinyML-Based Fault Detection for Air Quality Monitoring}, 
  year={2026},
  volume={},
  number={},
  pages={1397-1402},
  abstract={The paper iAirGuard is introduced, the open-source, modular, and wireless sensor network intended for large-scale and affordable air quality scrutiny. Conventional high-precision stations, which are scattered, still set a high price and are not widely maintained, while many low-cost systems encounter the problems of drifting calibration, low reliability, and reliance on centralization. iAirGuard’s limitation is solved with a service centric architecture structured in four layers where the layers are; sensor nodes, data storage, service modules, and user interfaces. Communication between the nodes, which are based on ESP32-S3 and have PM, CO, CO2 and VOC sensors with BLE/Wi-Fi connectivity, is done through a lightweight MQTT protocol. The framework puts forward three main innovations: (i) adaptive dynamic sampling which modifies the sampling rates based on real-time environmental variations to save power and prolong the life of the sensor; (ii) on-node TinyML-based AQI prediction for real-time inference; and (iii) fault-resilient secondary sensing that uses threshold-based learning mechanisms to identify sensor drift. The experimental tests kitchen, office and outdoors reveal that the reduction of storage and bandwidth is between 45 and 58 percent, consequently, the daily data transmission is down from 0.275 MB to 0.155 MB while still giving 100 percent synchronization reliability. The entire hardware, firmware, and software stack being open-source allows transparency, reproducibility, and extensibility, thus, iAirGuard is characterized as a strong, cheap, and ecological system for IoT-enabled air quality monitoring over the long term.},
  keywords={Wireless sensor networks;Technological innovation;Heuristic algorithms;Fault detection;Tiny machine learning;User interfaces;Air quality;Real-time systems;Synchronization;Monitoring;Adaptive Sampling;Dynamic Sampling Algorithm;Air Quality Monitoring;TinyML Fault Detection;Synchronization Sensor Drift;Energy Efficiency},
  doi={10.1109/COMSNETS67989.2026.11418151},
  ISSN={2155-2509},
  month={Jan},}@INPROCEEDINGS{11374890,
  author={Govindaraj, Ramkumar and Neelima, B and Surekha, C and Al-Shaikh, Ala'a and Babu, M Ashok and Srinivasan, K.},
  booktitle={2025 Tenth International Conference on Science Technology Engineering and Mathematics (ICONSTEM)}, 
  title={Convolutional Neural Network-Based Smart Crop Yield Recommendations Through Tiny Machine Learning in IoT Edge Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={By integrating deep learning, ensemble machine learning, attention mechanisms, and climate-sensitive predictive modelling to address precision agriculture and cybersecurity challenges, we designed the CNN-based smart crop yield prediction using TinyML on Internet of Things (IoT) Edge Devices (CSCYTI) model. An optimised Convolutional Neural Network (CNN) architecture for edge devices using TinyML to enable real-time image quality assessments with low latency, utilisingquantisation-aware training and TensorFlow Lite for efficient model deployment on IoT devices. For network intrusion detection, an ensemble-based Random Forest (RF) method alongside eXtreme Gradient Boosting (XGBoost) is proposed, improving classification accuracy through majority voting and weighted gradient boosting, enhanced by an Attention Score Calculation (ASC) mechanism to capture contextual dependencies. An agricultural recommendation system that includes climate factors and historical data to understand localized agricultural patterns that can be disrupted by climate change. The training accuracy is 0.98, and the validation accuracy achieves a perfect score of 1.0 at the 10th epoch. Training and validation losses are both at 0.7, and they decrease significantly to 0.05 and 0.06, over the next 15 epochs. Throughout the following 84 epochs. It achieves 93.3 % accuracy on positive samples and a 97.5 % true negative rate of 50 cases. A test set of 260 cases (120 positive, 140 negative), the model reported a true positive rate of 92.3 %, a true negative rate of 82.4 %, 10 false negatives, 30 false positives, and an overall accuracy of 86.6 %. The CSCYTI achieved an accuracy of 0.9993, slightly below IHDEN's 0.9994. CSCYTI attained the highest precision (0.9995), recall (0.9996), and F1-score (0.9998).},
  keywords={Training;Radio frequency;Accuracy;Tiny machine learning;Image edge detection;Predictive models;Boosting;Real-time systems;Internet of Things;Convolutional neural networks;Internet of Things (IoT);Convolutional Neural Network (CNN);Random Forest (RF);eXtreme Gradient Boosting (XGBoost);Attention Score Calculation (ASC)},
  doi={10.1109/ICONSTEM65670.2025.11374890},
  ISSN={2996-2986},
  month={Nov},}@INPROCEEDINGS{11031259,
  author={El-Rahman, Sahar A. and Zeid, Shimaa},
  booktitle={2025 15th International Conference on Electrical Engineering (ICEENG)}, 
  title={The Complex Interplay of Artificial Intelligence and Internet of Things: Enhancing Functionality Amidst Challenges}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Integrating Artificial Intelligence into the Internet of Things is reworking industries by making them more clever, effective, and agile. AI techniques, like system mastering and deep gaining knowledge, similarly empower IoT by processing massive volumes of sensor records to derive higher insights for selection-making and optimization. However, this collaboration also brings up numerous demanding situations, including extended computational necessities, electricity inefficiencies, and privacy issues. The manuscript deals with the transformative capacity of AI in IoT systems, their blessings and disadvantages, and further improvement perspectives that might be orientated toward sustainability.},
  keywords={Privacy;Scalability;Smart homes;Energy efficiency;Internet of Things;Security;Resource management;Artificial intelligence;Sustainable development;Research and development;Artificial Intelligence;Internet of Things;Machine Learning;IoT Security;Scalability;Energy Efficiency},
  doi={10.1109/ICEENG64546.2025.11031259},
  ISSN={},
  month={May},}@ARTICLE{10682534,
  author={Andrade, Pedro and Silva, Marianne and Medeiros, Morsinaldo and Costa, Daniel G. and Silva, Ivanovitch},
  journal={IEEE Sensors Journal}, 
  title={TEDA-RLS: A TinyML Incremental Learning Approach for Outlier Detection and Correction}, 
  year={2024},
  volume={24},
  number={22},
  pages={38165-38173},
  abstract={The Internet of Things (IoT) paradigm encompasses computing and networking capabilities within electronic objects, acting as a fundamental development framework with vast potential for improving lives, enhancing industrial processes, and enabling real-time decision-making. However, as the number of connected objects increases, the infrastructure for processing and handling large volumes of data is highly impacted. In response, edge computing has been exploited as a way to bring the processing burden closer to the data sources, shifting the conventional data processing flow. As a result, a series of innovative machine learning applications has been developed for resource-constrained devices, such as microcontrollers, enabling efficient data processing on the edge and inaugurating the era of tiny machine learning (TinyML). Nevertheless, although the benefits have proven promising in different scenarios, particularly when the flexibility of embedded models meets the requisites of unsupervised learning approaches, TinyML-based applications may need to perform real-time identification of data outliers since they could waste resources and impair the expected model accuracy. In this context, this article proposes an innovative TinyML outlier detection and correction algorithm based on incremental learning. This algorithm was implemented in an on-board diagnostics (OBD-II) scanner as a proof of concept, where a microcontroller acquires real-time vehicle data to identify data outliers and perform necessary corrections, benefiting practical applications in multiple scenarios.},
  keywords={Tiny machine learning;Anomaly detection;Streams;Sensors;Data models;Internet of Things;Real-time systems;Embedded systems;Internet of Things (IoT);machine learning;on-board diagnostics (OBD-II);smart vehicles},
  doi={10.1109/JSEN.2024.3458917},
  ISSN={1558-1748},
  month={Nov},}@INPROCEEDINGS{10483145,
  author={Fraidling, Florens and Hochreiter, Christian and Heinrich, Ferdinand and Rieger, Florian and Wenninger, Franz},
  booktitle={MikroSystemTechnik Kongress 2023; Kongress}, 
  title={Tiny Machine Learning Sensor Platform for Local Sensor Data Fusion and Evaluation}, 
  year={2023},
  volume={},
  number={},
  pages={714-721},
  abstract={Cunently prevalent methods for analyzing sensor data rely on centralized processing. The transmission of collected sensor data leads to increased latency, and applications could additionally suffer from bandwidth constraints and privacy concerns. On-device data analysis is crucial for many future edge computing applications. Embedded machine learning is an increasingly important approach to enable local sensor data analysis on resource constrained edge devices. This paper demonstrates a concrete implementation of the embedded machine learning life cycle on the developed Tiny Machine Learning Sensor Platform to enable local sensor data fusion and evaluation for generic applications. The featured Tiny Machine Learning Sensor Platform exhibits cormnon microcontroller interfaces to attach generic sensors suitable for domain-specific applications in a wide range of use cases. It is intended for time series domain specific task such as anomaly detection, classification and prediction. The platform runs machine learning models and neural networks that are specifically optimized for resource constrained embedded microcontrollers. The advantage of on-device data analysis is that the sensor platform itself can decide locally how to proceed when the deployed machine learning model detects certain events. Data only needs to be transmitted to a centralized service when an event has occuned. The device does not need to constantly send its monitored data when there is little or no new information reducing the amount of data transmitted significantly and allowing extended run times of battery-powered systems. The platfonn can react autonomously to specific events without waiting for a server response, reducing the latency for real-time, safety critical applications. This paper describes the applied hardware, software, and the data science pipeline used to develop machine learning enhanced applications on embedded hardware. A first version of the Tiny Machine Learning Sensor Platform is already deployed in several applications. It is planned to adapt the Tiny Machine Learning Sensor Platform to additional use cases and further develop identified challenges. In summary, the practicability of tiny machine learning in real world time series data applications is demonstrated.},
  keywords={},
  doi={},
  ISSN={},
  month={Oct},}@INBOOK{11345227,
  author={Mistillioglou, Eftychia and Konstantopoulou, Evangelia and Sklavos, Nicolas and Kyriakou, Andronikos},
  booktitle={Tiny Machine Learning: Design Principles and Applications}, 
  title={Security and Privacy of TinyML Devices}, 
  year={2026},
  volume={},
  number={},
  pages={431-467},
  abstract={Summary <p>Tiny machine learning (TinyML) models are increasingly deployed in resource&#x2010;limited applications like healthcare, industrial monitoring, and smart cities, making security and privacy essential. This work addresses the unique challenges of securing TinyML models on microcontrollers and low&#x2010;power devices vulnerable to cyber&#x2010; and physical threats. A layered security approach combines hardware and software solutions to protect model integrity and data privacy. Privacy&#x2010;preserving model updates are enabled through federated learning frameworks, and adversarial robustness is enhanced with adversarial training and defensive distillation. Additionally, hardware protections, including physically unclonable functions, anti&#x2010;tampering mechanisms, lightweight encryption, and trusted execution environments, safeguard data from unauthorized access. Real&#x2010;time threat detection supports secure, continuous monitoring, enabling TinyML models to operate reliably within privacy&#x2010;sensitive Internet of Things deployments.</p>},
  keywords={Tiny machine learning;Security;Adaptation models;Computational modeling;Real-time systems;Anomaly detection;Training;Privacy;Data models;Robustness},
  doi={10.1002/9781394294572.ch12},
  ISSN={},
  publisher={IEEE},
  isbn={9781394294565},
  url={https://ieeexplore.ieee.org/document/11345227},}@INPROCEEDINGS{11569212,
  author={De Villa, Rafran P. and Inajada, Melvin and Derit, David Matthew and Narvios, Wilen Melsedec O. and Batayola, Ferdinand F. and Silagpo, Gilbert M. and Palconit, Maria Gemel B. and Jueco, Jayson C.},
  booktitle={2025 IEEE 17th International Conference on Humanoid, Nanotechnology, Information Technology, Communication and Control, Environment, and Management (HNICEM)}, 
  title={Cyber-Physical Interoperability in Artificial Intelligence of Things for Intelligent Energy Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In energy systems, interoperability enables IoT infrastructures to share data and optimize operations, but integrating AI with communication technologies remains challenging, often reducing reliability. High retransmission rates and latency can delay anomaly detection and degrade real-time analysis. To address this, an intelligent energy monitoring system was deployed across selected sites in Cebu, capturing power reliability and IoT metrics. Data were securely transmitted via TLS to a Firebase database, and labeled datasets trained supervised and unsupervised machine learning models to detect anomalies in both power and network conditions. Network performance varied across sites, with latency from 1.0017 ms (San Fernando) to 1.7821 ms (Carmen), jitter from 0.16005 ms to 177.57 ms, retransmissions from 0.1697% to 43.887%, and throughput from 0.562 to 1.000. Sites such as San Fernando, Naga, and Punta had low latency and retransmissions under 1%, supporting stable control loops, while Carmen, Kodia, and SantaFe suffered high delays and jitter, compromising CPS responsiveness. The PSO-based performance score (0.108–2.090) integrated latency, jitter, retransmission, and throughput, and K-means clustering (k=2) identified two operational regimes (PSO = 0.263 vs. 1.723). Supervised models, including Decision Trees, Random Forest, Gradient Boosting, and MLPs, achieved perfect performance (precision, recall, F1 = 1.00), outperforming Logistic Regression (0.94), SVM (0.97), and Autoencoder (0.35). These results show that PSO-based metrics and machine learning can significantly enhance CPS interoperability in energy systems.},
  keywords={Jitter;Interoperability;Internet of Things;Measurement;Modeling;Information rates;Throughput;Optimization;Monitoring;Machine learning;Cyber-Physical Systems;Artificial Intelligence of Things (AIoT);Energy Monitoring;Interoperability;Network Performance;Particle Swarm Optimization (PSO);K-means Clustering;Latency;Jitter;Anomaly Detection;Machine Learning;Power Quality;Philippines},
  doi={10.1109/HNICEM69498.2025.11569212},
  ISSN={2770-0682},
  month={Nov},}@INPROCEEDINGS{10883083,
  author={Sharifirad, Iman and Boudjadar, Jalil and Larsen, Peter Gorm},
  booktitle={2025 IEEE 23rd World Symposium on Applied Machine Intelligence and Informatics (SAMI)}, 
  title={TinyML for Computation-aware Transformer-based Anomaly Detection in Internal Combustion Systems}, 
  year={2025},
  volume={},
  number={},
  pages={000141-000146},
  abstract={This paper proposes a highly accurate, computation-efficient anomaly detection for an industrial internal combustion engine using a Transformer model. The proposed anomaly detection model enables identifying anomaly occurrences and quan-tifying how far the abnormality deviates from a normal state. This leads to informed decisions for efficient mitigation in the control loop of the combustion engine. To achieve computation-awareness while maintaining considerable accuracy, we have applied Pruning, a Tiny ML technique, to reduce the computation cost of the proposed Transformer model. The capacity analysis of the proposed model shows that, while trained on anomalies from a few combustion cylinders, our model can recognize and quantify anomalies from the entire set of cylinders. Furthermore, the analysis results demonstrated that Pruning reduced the computation cost by 8.4% and memory usage by up to 39% while the model's prediction performance barely decreased. Our transformer-based model to identify and quantify anomalies is deployable on the resource-constrained platform of the use case.},
  keywords={Analytical models;Accuracy;Costs;Computational modeling;Tiny machine learning;Transformers;Combustion;Real-time systems;Data models;Anomaly detection;Anomaly detection;Anomaly quantification;Transformer model;Pruning;Computation-efficiency},
  doi={10.1109/SAMI63904.2025.10883083},
  ISSN={2767-9438},
  month={Jan},}@INPROCEEDINGS{10470881,
  author={Karras, Aristeidis and Karras, Christos and Giannaros, Anastasios and Giotopoulos, Konstantinos C. and Tsolis, Dimitrios and Oikonomou, Konstantinos and Sioutas, Spyros},
  booktitle={2023 8th South-East Europe Design Automation, Computer Engineering, Computer Networks and Social Media Conference (SEEDA-CECNSM)}, 
  title={TinyML-based Event Detection: An Edge-Cloud Approach for Smart Agriculture over LoRa WSNs}, 
  year={2023},
  volume={},
  number={},
  pages={1-10},
  abstract={In modern agriculture, the capability to promptly detect and respond to specific events is crucial. This study centres on the transformative potential of TinyML for enhancing event detection in Smart Agriculture, particularly when integrated with LoRa-based Wireless Sensor Networks (WSNs). In this work, we underscore the unique advantages of utilizing TinyML at the edge-bypassing the latency and overhead associated with cloud-centric models and ensuring immediate, on-site analytical insights. Employing LoRa WSNs as the backbone provides a seamless, low-power, and expansive data communication framework. Detailed experiments demonstrate TinyML's efficacy in accurately predicting agricultural events while reducing computational and energy consumption. In conclusion, the synergy between TinyML and LoRa WSNs offers a promising approach for fine-tuned, real-time event detection, aiming for sustainable and high-yield agricultural practices.},
  keywords={Smart agriculture;Energy consumption;Design automation;Event detection;Social networking (online);Image edge detection;Computational modeling;Edge AI;TinyML;IoT;Event Detection;LoRa;LPWAN;WSN;Edge Computing;Cloud Computing;Smart Agriculture},
  doi={10.1109/SEEDA-CECNSM61561.2023.10470881},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11416377,
  author={Attarha, Shadi and Förster, Anna},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Building Resilient IoT Systems through Resource-Efficient Sensor Fault Correction}, 
  year={2025},
  volume={},
  number={},
  pages={512-519},
  abstract={Resilience is a critical requirement for dependable IoT systems, enabling them to maintain reliable operation despite faults. One common source of such faults is inaccurate sensor data, which may result from hardware malfunctions or noise. While advances in fault detection have improved anomaly identification in sensor readings, detection alone is insufficient. Truly resilient systems must also incorporate recovery mechanisms to mitigate the impact of faults. Simply flagging or discarding abnormal values can disrupt data continuity and degrade the performance of downstream applications. To address this challenge, we propose a resource-efficient fault correction framework for real-time operation in multi-sensor IoT systems. Our approach leverages temporal and spatial data patterns by extracting informative features from recent readings of the affected sensor and its correlated peers. This joint representation captures short-term dynamics and contextual cues, enabling the model to bridge external information from correlated sensors into the temporal dynamics of the target sensor. These enriched features are then processed by a lightweight LSTM-based model to reconstruct readings with minimal computational overhead. We validate the effectiveness of our approach through experiments on real-world sensor datasets, demonstrating low reconstruction error and support for edge deployment via a TinyML implementation. Furthermore, experimental results show that the framework can successfully correct faulty sensor readings even when tested on previously unseen data characterized by patterns and distributions distinct from the training data, highlighting its robustness and generalization capability. This sustained correction capability complements existing fault detection methods, forming a unified and resilient solution for dependable IoT operation.},
  keywords={Adaptation models;Tiny machine learning;Fault detection;Computational modeling;System performance;Training data;Feature extraction;Real-time systems;Internet of Things;Resilience;Fault correction;resilience;TinyML;Internet of Things (IoT);sensor data quality},
  doi={10.1109/AIoT66900.2025.00078},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10774465,
  author={Xu, Feng},
  booktitle={2024 IEEE 22nd International Conference on Industrial Informatics (INDIN)}, 
  title={TinyMLEdge: A Workflow for Deploying TinyML Models in Industrial Edge Devices}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In the current machine learning landscape, numerous algorithms and new models continuously emerge, demon-strating impressive capabilities across various tasks. However, models specifically tailored for particular environments remain limited. Despite their powerful performance, models like YOLO encounter challenges in small object detection and require substantial adjustments for different datasets and tasks. Further-more, their extensive parameters make them difficult to deploy on edge devices. Addressing these issues, TinyMLEdge is proposed as a workflow designed to facilitate the deployment of embedded TinyML models in specialized industrial edge devices.},
  keywords={Performance evaluation;YOLO;Training;Machine learning algorithms;Image edge detection;Tiny machine learning;Data models;Haptic interfaces;Informatics;Optimization;TinyML;Edge Devices;Object Detection;Industrial Applications;Model Deployment},
  doi={10.1109/INDIN58382.2024.10774465},
  ISSN={2378-363X},
  month={Aug},}@INPROCEEDINGS{11087914,
  author={Sharifirad, Iman and Boudjadar, Jalil and Larsen, Peter Gorm},
  booktitle={2025 IEEE 8th International Conference on Industrial Cyber-Physical Systems (ICPS)}, 
  title={Cascaded TinyML-Based Reduction for the Anomaly Detection Model of an Industrial Combustion System}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Machine learning (ML) based anomaly detection has been thoroughly studied in the literature where different architectures and models have been developed for different industrial cyber-physical systems (CPS). However, given that most CPS control systems are deployed on embedded platforms with limited storage and computational resources, deployment and real-time functionality remain challenging. This paper applies a combination of TinyML techniques, Pruning, and quantization to reduce the computation cost and memory footprint of a transformer-based anomaly detection for an industrial combustion system without degrading the accuracy and classification performance. To assess reliability, we compare the reduced model's performance and accuracy to the original model and the state-of-the-art Cumulative Sum Control Chart (CUSUM) analytical model. The experiment results demonstrate that, while reducing the memory footprint by 70% and computation cost by 8%, the resulting model does not degrade the classification accuracy. Moreover, the reduced transformer model outperforms the CUSUM classification accuracy by up to 99%.},
  keywords={Analytical models;Accuracy;Costs;Quantization (signal);Computational modeling;Tiny machine learning;Transformers;Combustion;Computational efficiency;Anomaly detection;Computation performance;Anomaly detection;TinyML;Combustion systems},
  doi={10.1109/ICPS65515.2025.11087914},
  ISSN={2769-3899},
  month={May},}@INPROCEEDINGS{11388202,
  author={Choi, Youngjun and Park, Sungsik and Lee, Junwook},
  booktitle={2025 16th International Conference on Information and Communication Technology Convergence (ICTC)}, 
  title={Development of an audio event detection system for complex situational awareness for intelligent urban safety control}, 
  year={2025},
  volume={},
  number={},
  pages={1384-1388},
  abstract={In smart city environments, ensuring citizen safety requires intelligent monitoring systems capable of rapidly detecting unexpected incidents. Conventional video-based surveillance systems face inherent limitations such as restricted visibility and privacy concerns. This study proposes an audio event detection system for urban safety control, designed to identify critical events such as screams, vehicle horns, sirens, dog barks, and explosions. The system transforms acoustic signals into Mel-spectrograms and employs pretrained neural network models to extract features and perform multi-class classification. Detected events are then mapped to risk levels and integrated with a complex situational awareness service. Experimental results demonstrate that the proposed system achieves strong performance on both public datasets and real-world urban recordings, thereby validating the potential of audio-based real-time threat detection technologies.},
  keywords={Smart cities;Event detection;Surveillance;Image edge detection;Safety management;Computer architecture;Feature extraction;Real-time systems;Artificial intelligence;Videos;AIoT;smart city;edge computing;audio event detection;audio surveillance;AI detection},
  doi={10.1109/ICTC66702.2025.11388202},
  ISSN={2162-1241},
  month={Oct},}@ARTICLE{10197602,
  author={Wang, Xiaoyou and Wu, Wanglin and Du, Yao and Cao, Jiannong and Chen, Qianyi and Xia, Yong},
  journal={IEEE Internet of Things Journal}, 
  title={Wireless IoT Monitoring System in Hong Kong–Zhuhai–Macao Bridge and Edge Computing for Anomaly Detection}, 
  year={2024},
  volume={11},
  number={3},
  pages={4763-4774},
  abstract={The emergence of the Internet of Things (IoT) has facilitated the development and usage of low-computational microcontrollers at the edge of the network, which process data in the proximity of data sources and thereby offload the pressure of data transmission. Recently, IoT is becoming a key technology for structural health monitoring (SHM) systems. This study designs a novel wireless IoT monitoring system for the Hong Kong–Zhuhai–Macao Bridge, the world longest sea-crossing bridge. The 5G technology and edge computing are integrated to improve the system performance in sensor serviceability, data transmission, time synchronization, and data quality control. The artificial intelligent (AI) algorithm is embedded into the NVIDIA Xavier NX edge computing boards to preliminarily detect data anomalies caused by sensor faults, before uploading the massive data to the cloud platform. As training AI models requires a large amount of labeled data and is always time consuming, a novel data anomaly detection method is developed by transferring the model trained from the other bridge to the target bridge. Given that prestoring source data in edge devices consumes expensive storage resources, the source-free domain adaptation is developed by integrating the robust self-training mechanism and self-knowledge distillation strategy. Thus, the model transfer is achieved cross bridges in the absence of source data. This study provides a valuable and practical reference for developing a wireless IoT SHM system for large-scale infrastructure and enabling edge computing for data anomaly detection with high efficiency and accuracy.},
  keywords={Sensors;Wireless sensor networks;Wireless communication;Edge computing;Sensor systems;Cloud computing;Anomaly detection;edge computing;Internet of Things (IoT);source-free domain adaptation;structural health monitoring (SHM)},
  doi={10.1109/JIOT.2023.3300073},
  ISSN={2327-4662},
  month={Feb},}@INPROCEEDINGS{11542250,
  author={Albaiz, Abdulrahman and Amsaad, Fathi},
  booktitle={2026 IEEE 2nd International Conference on Secure IoT, Assured and Trusted Computing (SATC)}, 
  title={Fully Autonomous Z-Score-Based TinyML Anomaly Detection on Resource-Constrained MCUs using Power Side-Channel Data}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a fully autonomous Tiny Machine Learning (TinyML) Z-Score-based anomaly detection system deployed on a low-power microcontroller for real-time monitoring of appliance behavior using power side-channel data. Unlike existing Internet of Things (IoT) anomaly detection approaches that rely on offline training or cloud-assisted analytics, the proposed system performs both model training and inference directly on a resource-constrained microcontroller without external computation or connectivity. The system continuously samples current consumption, computes Root Mean Square (RMS) values on-device, and derives statistical parameters during an initial training phase. Anomalies are detected using lightweight Z-Score thresholds, enabling interpretable and computationally efficient inference suitable for embedded deployment. The architecture was implemented on an STM32-based platform and evaluated using a 14-day dataset collected from a household mini-fridge under normal operation and controlled anomaly conditions. Results demonstrate perfect detection performance, with Precision and Recall of 1.00, inference latencies on the order of tens of microseconds, and a total memory footprint of approximately 3.3 KB SRAM and 63 KB Flash. These results confirm that robust and fully autonomous TinyML anomaly detection can be achieved on low-cost microcontrollers. Future work includes extending the framework to incorporate additional lightweight models and multi-device learning scenarios.},
  keywords={Modeling;Root mean square;Anomaly detection;Internet of Things;Training;Compressors;Current;Timing;Memory;Microcontrollers;TinyML;Anomaly Detection;Microcontrollers;Edge Computing;Z-Score;Power Monitoring;RMS Current;Side-Channel Sensing},
  doi={10.1109/SATC69565.2026.11542250},
  ISSN={},
  month={March},}@INBOOK{11345357,
  author={Bello, Abeeb Akorede and Imoize, Agbotiname Lucky and Odewale, Abiodun Temitope},
  booktitle={Tiny Machine Learning: Design Principles and Applications}, 
  title={TinyML Devices and Tools}, 
  year={2026},
  volume={},
  number={},
  pages={225-257},
  abstract={Summary <p>Tiny machine learning (TinyML) refers to a new paradigm enabling machine learning (ML) on resource&#x2010;constrained, low&#x2010;power devices, which revolutionized the Internet of Things (IoT) by bringing intelligence to the edge. This chapter provides in&#x2010;depth capabilities, limitations, and applications on TinyML devices and tools. This chapter further explores some hardware platforms, such as microcontrollers and single&#x2010;board computers, that further state their ability to perform real&#x2010;time and low&#x2010;power operations. It also covers essential software frameworks like TensorFlow Lite (TFL) and Edge Impulse, which are applied to deploying ML models in these constrained devices. This chapter introduces advanced techniques in model quantization, pruning, and neural architecture search (NAS). It shows their effectiveness in obtaining highly optimized model sizes with energy efficiency without losing as much accuracy as other lightweight models. In this direction, it also discusses the critical trade&#x2010;off needed in these advances between computational complexity, memory constraints, and inference latency. It introduces equations and figures to explain key concepts. Finally, the experience of existing deployments indicates the more significant importance of power efficiency, data privacy, and real&#x2010;time decision&#x2010;making in TinyML systems. Specifically, future perspectives highlight mature hardware accelerators, unified frameworks, and standardized benchmarks toward enhancing impact in areas such as healthcare, smart agriculture, and industrial IoT by TinyML. Now, scalable, cost&#x2010;effective, and privacy&#x2010;preserving TinyML solutions for next&#x2010;generation IoT applications are built. This chapter contains a guide for researchers, developers, and practitioners using TinyML to build innovative and impactful real&#x2010;world applications.</p>},
  keywords={Tiny machine learning;Energy efficiency;Embedded systems;Microcontrollers;Real-time systems;Cloud computing;Computational modeling;Random access memory;Data privacy;Complexity theory},
  doi={10.1002/9781394294572.ch6},
  ISSN={},
  publisher={IEEE},
  isbn={9781394294565},
  url={https://ieeexplore.ieee.org/document/11345357},}@INPROCEEDINGS{9491592,
  author={Yang, Joy Qiping and Zhou, Siyuan and Van Le, Duc and Ho, Daren and Tan, Rui},
  booktitle={2021 18th Annual IEEE International Conference on Sensing, Communication, and Networking (SECON)}, 
  title={Improving Quality Control with Industrial AIoT at HP Factories: Experiences and Learned Lessons}, 
  year={2021},
  volume={},
  number={},
  pages={1-9},
  abstract={Enabled by the increasingly available embedded hardware accelerators, the capability of executing advanced machine learning models at the edge of the Internet of Things (IoT) triggers wide interest of applying the resulting Artificial Intelligence of Things (AIoT) systems in industrial applications. The in situ inference and decision made based on the sensor data containing patterns with certain sophistication allow the industrial system to address a variety of heterogeneous, local-area non-trivial problems in the last hop of the IoT networks, avoiding the wireless bandwidth bottleneck and unreliability issues and also the cumbersome cloud. However, the literature still lacks presentations of industrial AIoT system developments that provide insights into the challenges and offer important lessons for the relevant research and engineering communities, no matter the development is successful or not. In light of this, we present the design, deployment, and evaluation of an industrial AIoT system for improving the quality control of Hewlett-Packard’s ink cartridge manufacturing lines. While our development has obtained promising results, we also discuss the lessons learned from the whole course of the effort, which could be useful to the developments of other industrial AIoT systems.},
  keywords={Wireless communication;Wireless sensor networks;Conferences;Quality control;Ink;Machine learning;Manufacturing;Industrial AIoT;quality control},
  doi={10.1109/SECON52354.2021.9491592},
  ISSN={2155-5494},
  month={July},}@INPROCEEDINGS{11415491,
  author={Tlemçani, Khadija and Azbeg, Kebira and Fetjah, Laila and Ouchetto, Ouail and Andaloussi, Said Jai},
  booktitle={2025 8th International Conference on Networking, Intelligent Systems & Security (NISS)}, 
  title={Proactive Insulin Pump Security with TinyML and Blockchain: Real-Time Anomaly Detection for Diabetes Management}, 
  year={2025},
  volume={},
  number={},
  pages={55-62},
  abstract={The management of diabetes increasingly relies on networked insulin pumps paired with continuous glucose monitoring (CGM) to stabilize blood sugar levels; though these systems face cyber risks including interception attacks and unauthorized dose adjustments. Encryption methods applied after data collection fail to verify the clinical validity of insulin instructions if the pump's internal system is breached. This study presents a TinyML-driven anomaly detection approach embedded within the pump's microcontroller to evaluate insulin-glucose dynamics in real time. Our method prevents harmful doses by spotting irregularities locally before network transfer, rather than just documenting them. This is complemented by a blockchain system for secure, tamper-proof storage and decentralized access to confirmed insulin events. Early feasibility studies, based on IoT security guidelines and basic blockchain tests, show that streamlined machine learning models can operate within the pump's limited capacity while maintaining effective detection performance. A full hardware prototype is yet to be developed, but this design offers robust defense against malicious insulin doses and supports wider use of on-device detection in medical IoT devices. Future efforts will focus on adjusting model thresholds for personal metabolic differences and validating performance through clinical trials.},
  keywords={Tiny machine learning;Prototypes;Insulin pumps;Medical services;Real-time systems;Blockchains;Security;Reliability;Insulin;Anomaly detection;Insulin Pump Security;TinyML;Anomaly Detection;Blockchain;Healthcare IoT},
  doi={10.1109/NISS66502.2025.00017},
  ISSN={},
  month={April},}@ARTICLE{11205905,
  author={Yoshioka, Kanta and Tamukoh, Hakaru},
  journal={IEEE Embedded Systems Letters}, 
  title={A 340- μ W TinyML Using LUT-Based Reservoir Computing on Low-Cost FPGAs}, 
  year={2025},
  volume={17},
  number={5},
  pages={357-360},
  abstract={We propose a reservoir computing (RC) system that operates under extremely strict power consumption constraints of less than  $340~{\mu }$ W, which enables continuous operation for one year on a LR6 battery. By combining a look-up tables networks based RC (LUTNet-RC) with iCE40 series field-programmable gate arrays (FPGAs), the proposed system achieves high computational accuracy while significantly reducing power consumption compared with conventional TinyML devices. The proposed method achieves 93.1%, 98.6%, and 92.7% accuracy in real TinyML applications such as human activity recognition, epilepsy detection, and electrocardiogram signal analysis, respectively, while operating at about 254 to  $335~{\mu }$ W power consumption. This work shows that the proposed LUTNet-RC on iCE40 FPGAs are promising solutions for long-term operational machine learning application implementations in battery-powered edge devices.},
  keywords={Power demand;Accuracy;Tiny machine learning;Reservoir computing;Batteries;Table lookup;Internet of Things;Human activity recognition;Signal analysis;Field programmable gate arrays;Field programmable gate array;Internet of Thing (IoT);machine learning;neuromorphic computing;reservoir computing (RC);TinyML},
  doi={10.1109/LES.2025.3598209},
  ISSN={1943-0671},
  month={Oct},}@INPROCEEDINGS{11394422,
  author={B, Sahana and Devi, Manju and S, Neha and M, Soubhagya},
  booktitle={2026 International Conference on Intelligent and Innovative Technologies in Computing, Electrical and Electronics (IITCEE)}, 
  title={Design and Implementation of a Multi-Parameter Health Monitoring SoC using RISC-V and TinyML for Real-Time Edge-Based Diagnostics}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={The increasing demand for continuous cardiac monitoring has created the need for portable, low-power, and intelligent health-tracking systems capable of operating reliably in edge environments. Traditional cloud-dependent solutions suffer from latency, bandwidth limitations, and privacy concerns, making them unsuitable for real-time diagnostics. This work presents a compact multi-parameter health monitoring System-on-Chip (SoC) implemented on an ESP32-C3 RISC-V microcontroller with integrated TinyML for on-device analytics. The system acquires ECG signals using the AD8232 module and measures heart rate and $\text{SpO}_{2}$ using the MAX30100 optical sensor, while HRV metrics are computed directly from ECG-derived RR intervals. A lightweight TinyML model deployed on the microcontroller enables local classification of cardiac conditions without cloud support, achieving low latency and reduced energy consumption. Experimental evaluation demonstrates stable ECG waveform detection, accurate heart rate, and $\text{SpO}_{2}$ estimation, and reliable HRV computation, supported by real-time visualization through serial and dashboard interfaces. The results validate the feasibility of a low-cost, scalable, and edge-based IoMT system capable of early detection of cardiac anomalies such as arrhythmia and hypoxemia, highlighting its potential for wearable and remote healthcare applications.},
  keywords={Accuracy;Microcontrollers;Tiny machine learning;Image edge detection;Computational modeling;Electrocardiography;Real-time systems;Reliability;Heart rate variability;Monitoring;ECG;Heart Rate;SpO2;HRV;TinyML;RISC-V;Edge Computing arrhythmia detection},
  doi={10.1109/IITCEE67948.2026.11394422},
  ISSN={},
  month={Jan},}@INBOOK{11345266,
  author={Shafik, Wasswa and Adam, Mumin},
  booktitle={Tiny Machine Learning: Design Principles and Applications}, 
  title={Advanced Security Schemes for TinyML Devices}, 
  year={2026},
  volume={},
  number={},
  pages={367-402},
  abstract={Summary <p>Tiny machine learning (TinyML) devices have already transformed many aspects of our modern technology use. By integrating specialized machine learning tasks into tiny, power&#x2010;constrained, inexpensive devices, new and exciting use cases have opened that were previously prohibitive. In a car, low&#x2010;cost sensors process image or audio data, detecting pedestrians or obeying commands. In our homes, small, low&#x2010;power devices use Wi&#x2010;Fi connections to respond to voice commands. In an industrial setting, low&#x2010;cost sensors can be placed close to rotating machinery to monitor the maintenance of production lines. These applications are considered unusual; however, they share commonalities beyond being &#x201c;tiny.&#x201d; Each of these systems operates in a semiautonomous fashion, reliant on the outside world for making inferences either directly or through transitive properties. Open research issues dot the TinyML landscape, spanning from preventing against white&#x2010;box, black&#x2010;box, and gray&#x2010;box adversaries. Owing to these challenges, providing chip&#x2010;level or language&#x2010;level privacy is a significant challenge that the TinyML community can no longer ignore. The work herein will dramatically expand the accepted attack landscape on TinyML devices and discuss extant work related to the threat model and system under discussion. Finally, we present preliminary results as an example of this work's potential, showing that dumb&#x2010;radio attacks on reinforcement learning agents pose a severe threat.</p>},
  keywords={Tiny machine learning;Security;Privacy;Hardware;Microcontrollers;Memory management;Data models;Computational modeling;Cloud computing;Software algorithms},
  doi={10.1002/9781394294572.ch10},
  ISSN={},
  publisher={IEEE},
  isbn={9781394294565},
  url={https://ieeexplore.ieee.org/document/11345266},}@INBOOK{11345204,
  author={Noor, Kinzah and Ahmad, Hasnain and Imoize, Agbotiname Lucky},
  booktitle={Tiny Machine Learning: Design Principles and Applications}, 
  title={Semantic Management of TinyML for Industrial Application}, 
  year={2026},
  volume={},
  number={},
  pages={469-502},
  abstract={Summary <p>By fostering the collaborative design of resource&#x2010;constrained Internet of Things (IoT) hardware devices and their corresponding learning&#x2010;based software architectures, tiny machine learning (TinyML) plays a pivotal role in the ongoing fourth and fifth industrial revolutions, enabling individuals, economies, and societies to harness the power of efficient AI&#x2010;driven computing technologies, such as medical robotics, autonomous vehicles, and smart cities. Given its inherently interdisciplinary nature, TinyML has been explored from a variety of perspectives. However, the hardware and software limitations pose significant challenges for TinyML. The small memory capacity and the complex deep learning models designed for cloud platforms are difficult to implement on such constrained devices, including mobile platforms. Additionally, the support for compilers and inference engines is limited, especially on bare&#x2010;metal devices. To overcome these challenges, a co&#x2010;design approach to both the system stack and algorithms is essential. This chapter aims to provide an up&#x2010;to&#x2010;date overview, emphasizing the diverse learning methods employed in TinyML&#x2010;based solutions. In this research, a framework is presented that leverages Semantic Web technologies to enable the large&#x2010;scale, collaborative management of TinyML models and IoT devices. This approach spans from data modeling to identifying potential pairings and benchmarks, ultimately facilitating the seamless exchange and repurposing of TinyML components. A semantic schema for neural network models aligns with the World Wide Web Consortium's Thing Description, offering a semantic representation of IoT devices. Additionally, it introduces a publicly accessible knowledge graph consisting of 23 models. To demonstrate the approach, three case studies involving ML models and six IoT devices are discussed.</p>},
  keywords={Tiny machine learning;Semantics;Internet of Things;Biological system modeling;Interoperability;Intelligent sensors;Artificial neural networks;Performance evaluation;Sensor phenomena and characterization;Industrial Internet of Things},
  doi={10.1002/9781394294572.ch13},
  ISSN={},
  publisher={IEEE},
  isbn={9781394294565},
  url={https://ieeexplore.ieee.org/document/11345204},}@INPROCEEDINGS{11416285,
  author={Chen, Tai-Lin and Tsai, Yu-Ting and Yang, Wen-Yi and Zheng, Zi-Wei},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Voltage Anomaly Detection and Forecasting of Electrical Energy Consumption for Machine Tools using an AI-based Agent Framework}, 
  year={2025},
  volume={},
  number={},
  pages={695-699},
  abstract={This study proposes an AI-based agent system for voltage anomaly detection and electrical energy consumption forecasting, specifically designed for small-scale manufacturing equipment such as a machine tool. Traditional production lines often rely on manual monitoring of equipment status and electrical energy usage, leading to delayed detection of anomalies and inefficient responses. Moreover, existing solutions commonly depend on cloud platforms, raising concerns over data privacy and making them less accessible for small and medium-sized enterprises. To address these challenges, this research develops a locally deployable, multi-tool analytical platform that integrates AI agent technology with edge computing. The system is built using the OpenAI SDK Agent framework in combination with the Ollama platform, encapsulating analytical tasks into tools.The Autoencoder-based voltage anomaly detector achieved stable reconstruction with validation loss below 0.001, while the Prophet forecasting module reached MAE = 0.2591 and MAPE = 0.04 % on the January dataset, demonstrating high prediction accuracy. An LLM agent analyzes user requests and determines which tools to use for the analysis.},
  keywords={Energy consumption;Voltage;Production;Machine tools;Manufacturing;Internet of Things;Forecasting;Artificial intelligence;Anomaly detection;Monitoring;AIoT;Intelligent Agents;Sensor Deployment;Electricity Consumption Forecasting},
  doi={10.1109/AIoT66900.2025.00107},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10253705,
  author={Chen, Zijie and Gao, Yiming and Liang, Junrui},
  booktitle={2023 IEEE 3rd International Conference on Industrial Electronics for Sustainable Energy Systems (IESES)}, 
  title={A Self-Powered Sensing System with Embedded TinyML for Anomaly Detection}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={In the coming Industry 4.0 era, IoT (Internet of Things) technology plays a more and more critical role. Anomaly detection is one of the essential applications for ensuring safe manufacturing, living, etc. It equips the machine with intelligence for perceiving its situation in real-time to prevent disastrous breakdown. Such monitoring systems were usually based on commercial inertial measurement units (IMU) and artificial intelligence (AI) algorithms that run on resource-rich, power-hungry servers, causing a certain amount of energy for sensing and data transmitting. In this paper, we introduce a novel self-powered sensing system with tiny machine learning (Tiny ML) technique for anomaly detection. A lightweight piezoelectric self-powered sensor (SPS) is utilized to substitute the IMU. The system runs on a low-cost embedded system, realizing the low-power in-situ inferring. A rich dataset has been collected on a vibration platform and analyzed by six well-known machine-learning models. A compressed deep neuron network (DNN) with three hidden layers achieves an accuracy of 97.6 % given only 8-point normalized SPS data. The TinyML model is then deployed on embedded systems for on-device inferring and condition-based monitoring. Power measurement is conducted to compare the systems based on an IMU and an SPS. It has shown that the proposed self-powered sensing approach can save up to 66.74% of energy. The system provides a valuable reference for realizing pervasive sensing and ubiquitous AI.},
  keywords={Vibrations;Embedded systems;Biological system modeling;Machine learning;Real-time systems;Sensors;Servers;Self-powered sensing;tiny machine learning;anomaly detection;AIoT},
  doi={10.1109/IESES53571.2023.10253705},
  ISSN={},
  month={July},}@INPROCEEDINGS{11183718,
  author={Jones, Jefferson Parker and Van Kempen, Philipp and Mueller-Gritschneder, Daniel},
  booktitle={2025 Austrochip Workshop on Microelectronics (Austrochip)}, 
  title={Vicuna2.0: RISC-V Embedded Vector Unit with Half-Precision Floating-Point Support for TinyML}, 
  year={2025},
  volume={},
  number={},
  pages={69-72},
  abstract={With increasing computation demands on resource-constrained embedded systems, half-precision floating-point has emerged as a possible datatype to make use of the dynamic range of floating-point representations while reducing overall design complexity. The RISC-V vector extension includes a sub-extension for half-precision floating point, but its viability for embedded systems has not be evaluated. After implementing the Zvfh extension and all required dependencies, a design-space exploration was performed to find an optimal system for a common machine learning task, anomaly detection. When compared to an integer-only vector system, the half-precision floating-point system had a 25% lower LUT overhead due to the change in program characteristics and use of a smaller datatype for intermediate values with only a 8% higher execution time.},
  keywords={Embedded systems;Tiny machine learning;Conferences;Neural networks;Dynamic range;Vectors;Table lookup;Microelectronics;Complexity theory;Software development management;half-precision floating-point;RISC-V;neural network inference;tinyML;vectorization},
  doi={10.1109/Austrochip67945.2025.11183718},
  ISSN={2689-8144},
  month={Sep.},}@INPROCEEDINGS{11415725,
  author={Chen, Kuan-Cheng and Chen, Samuel Yen-Chi and Liu, Chen-Yu and Leung, Kin K.},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Federated Quantum Kernel Learning for Anomaly Detection in Multivariate IoT Time-Series}, 
  year={2025},
  volume={},
  number={},
  pages={278-285},
  abstract={The rapid growth of industrial Internet of Things (IIoT) systems has created new challenges for anomaly detection in high-dimensional, multivariate time-series, where privacy, scalability, and communication efficiency are critical. Classical federated learning approaches mitigate privacy concerns by enabling decentralized training, but they often struggle with highly non-linear decision boundaries and imbalanced anomaly distributions. To address this gap, we propose a Federated Quantum Kernel Learning (FQKL) framework that integrates quantum feature maps with federated aggregation to enable distributed, privacy-preserving anomaly detection across heterogeneous IoT networks. In our design, quantum edge nodes locally compute compressed kernel statistics using parameterized quantum circuits and share only these summaries with a central server, which constructs a global Gram matrix and trains a decision function (e.g., Fed-QSVM). Experimental results on synthetic IIoT benchmarks demonstrate that FQKL achieves superior generalization in capturing complex temporal correlations compared to classical federated baselines, while significantly reducing communication overhead. This work highlights the promise of quantum kernels in federated settings, advancing the path toward scalable, robust, and quantum-enhanced intelligence for next-generation IoT infrastructures.},
  keywords={Training;Privacy;Correlation;Federated learning;Time series analysis;Feature extraction;Vectors;Kernel;Anomaly detection;Industrial Internet of Things;Federated Learning;Quantum Kernel Learning;Industrial IoT;Time-Series Analysis;Anomaly Detection},
  doi={10.1109/AIoT66900.2025.00049},
  ISSN={},
  month={Dec},}@ARTICLE{11611191,
  author={Ali, Muhammad and Qayyum, Tariq and Tariq, Asadullah and Trabelsi, Zouheir and Din, Irfan Ud and Ahmed, Shabir},
  journal={IEEE Open Journal of the Communications Society}, 
  title={Lightweight TinyML-Enhanced Task Offloading in VANETs for Next-Generation Intelligent Transportation Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={Vehicular Ad Hoc Networks (VANETs) face resource constraints, high node mobility, and stringent latency requirements, especially in safety-critical applications such as collision avoidance, path planning, and emergency braking. Task offloading to nearby vehicles or Roadside Units (RSUs) mitigates local computational limits, but dynamic conditions, unreliable nodes, and rapid topology changes complicate dependable node selection. This paper proposes a Tiny Machine Learning (TinyML)-enhanced, credibility-based task offloading framework for real-time decision-making in vehicular networks. RSUs evaluate vehicle reliability through a three-component Credibility Assessment Module: a Task Assignment Component that distributes lightweight test tasks and filters unreliable nodes via TinyML inference; a Verification Component that applies TinyML anomaly detection to validate execution with minimal cloud dependence; and a Scoring Component that updates credibility using an exponentially weighted delay-penalty model. A hybrid approach then integrates Random Forest (RF) for credibility-aware node selection with TinyLSTM for link stability prediction, while vehicles pre-screen candidates locally by mobility and resource availability before querying RSUs, reducing signalling overhead. Simulations in OMNeT++, Veins, and SUMO using a Luxembourg City mobility trace show a 24% higher task success rate, 9% lower completion time, 21% lower packet drop ratio, and 65% fewer disconnection-induced failures over heuristic, MLP, and deep-RL baselines, at only 9–18% RSU-side CPU overhead. The RF (380 KB) and TinyLSTM (48KB post-quantization) models fit automotive-grade microcontroller budgets, confirming practical deployability for next-generation Intelligent Transportation Systems (ITS).},
  keywords={Vehicles;Modeling;Tiny machine learning;Timing;Joining processes;Stability;Radio frequency;Real-time systems;Delays;Optimization;Vehicular Ad Hoc Networks (VANETs);Tiny Machine Learning (TinyML);task offloading;credibility assessment;mobility-aware offloading;link stability prediction;TinyLSTM;network dynamics;autonomous vehicular networks},
  doi={10.1109/OJCOMS.2026.3713821},
  ISSN={2644-125X},
  month={},}@INPROCEEDINGS{10651090,
  author={Shalby, Hazem Hesham Yousef and Pavan, Massimo and Roveri, Manuel},
  booktitle={2024 International Joint Conference on Neural Networks (IJCNN)}, 
  title={StreamTinyNet: video streaming analysis with spatial-temporal TinyML}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Tiny Machine Learning (TinyML) is a branch of Machine Learning (ML) that constitutes a bridge between the ML world and the embedded system ecosystem (i.e., Internet-of-Things devices, embedded devices, and edge computing units), enabling the execution of ML algorithms on devices constrained in terms of memory, computational capabilities, and power consumption. Video Streaming Analysis (VSA), one of the most interesting tasks of TinyML, consists in scanning a sequence of frames in a streaming manner, with the goal of identifying interesting patterns. Given the strict constraints of these tiny devices, all the current solutions rely on performing a frame-by-frame analysis, hence not exploiting the temporal component in the stream of data. In this paper, we present StreamTinyNet, the first TinyML architecture to perform multiple-frame VSA, enabling a variety of use cases that requires spatial-temporal analysis that were previously impossible to be carried out at a TinyML level. Experimental results on public-available datasets show the effectiveness and efficiency of the proposed solution. Finally, StreamTinyNet has been ported and tested on the Arduino Nicla Vision, showing the feasibility of what proposed.},
  keywords={Performance evaluation;Power demand;Machine learning algorithms;Embedded systems;Tiny machine learning;Neural networks;Memory management;Video Streaming Analysis;Tiny Machine Learning;Video Classification;Resource-constrained devices},
  doi={10.1109/IJCNN60899.2024.10651090},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{10636584,
  author={Martinez-Rau, Luciano Sebastian and Zhang, Yuxuan and Oelmann, Bengt and Bader, Sebastian},
  booktitle={2024 IEEE Sensors Applications Symposium (SAS)}, 
  title={TinyML Anomaly Detection for Industrial Machines with Periodic Duty Cycles}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Electro-mechanical systems operating in periodic cycles are pivotal in the Industry 4.0, enabling automated processes that enhance efficiency and productivity. Early detection of failures and anomalies in duty cycles of these machines is crucial to ensure uninterrupted operation and prevent costly downtimes. Although the wear and damage of machines have been extensively studied, a significant proportion of these problems can be traced back to operator errors, underlining the importance of continuously monitoring the machine activity to ensure optimal performance. This work presents an automatic algorithm designed to identify improper duty cycles of industrial machines, exemplified on a mining conveyor belt. To enable the identification of duty cycles, the operational states of the machine are first categorized using machine learning (ML). The study compares six tiny ML techniques on two resource-constrained microcontrollers, reporting an f1-score of 87.6% for identifying normal and abnormal duty cycles and 96.8% for the internal states of the conveyor belt system. Deployed on both low-power microcontrollers, the algorithm processes input data in less than 106 μs, consuming less than 1.16 μJ. These findings promise to facilitate integration into more comprehensive preventive maintenance algorithms.},
  keywords={Productivity;Machine learning algorithms;Recurrent neural networks;Microcontrollers;Tiny machine learning;Belts;Real-time systems;anomaly detection;conveyor belt;industry 4.0;low-power microcontroller;machine learning;maintenance;tinyML},
  doi={10.1109/SAS60918.2024.10636584},
  ISSN={2766-3078},
  month={July},}@ARTICLE{9699416,
  author={Jin, Yi and Huang, Bin and Yan, Yulong and Huan, Yuxiang and Xu, Jiawei and Li, Shancang and Gope, Prosanta and Da Xu, Li and Zou, Zhuo and Zheng, Lirong},
  journal={IEEE Transactions on Industrial Informatics}, 
  title={Edge-Based Collaborative Training System for Artificial Intelligence-of-Things}, 
  year={2022},
  volume={18},
  number={10},
  pages={7162-7173},
  abstract={The descending of intelligence from the cloud to the heterogeneous and low-power edge in the Artificial Intelligence-of-Things prevents uploading user-sensitive information to the cloud. It brings an urgent demand for deploying training tasks collaboratively in industrial scenarios to manage data locally. This article proposes an edge-based collaborative training system for the smart factory which harnesses the intelligence of edge devices by balancing the computational and communicational resources and improving system dependability. Two typical scenarios of parts recognition and defect inspection are evaluated as a case study with our system. The feasibility and dependability of the presented system are verified with a platform composed of eight high-performance (Nvidia Jetson Nano) and eight low-performance edge devices (Raspberry Pi 4B). The efficiency under tradeoff between computational resource and network condition constraints in a cluster is tested to simulate real-case performance in smart factory scenarios. Our platform reaches the peak performance of 1167 images/s training efficiency on ResNet32 under a 125 MB/s bandwidth. Experimental results demonstrate that the proposed design can collaboratively perform training tasks with optimized efficiency and provide dependable collaborations for system fault detection and cluster extension.},
  keywords={Training;Collaboration;Artificial intelligence;Task analysis;Performance evaluation;Image edge detection;Computational modeling;Artificial Intelligence-of-Things (AIoT);collaborative training system;edge computing},
  doi={10.1109/TII.2022.3147831},
  ISSN={1941-0050},
  month={Oct},}@INBOOK{11345344,
  author={Sei, Yuichi and Lucky Imoize, Agbotiname},
  booktitle={Tiny Machine Learning: Design Principles and Applications}, 
  title={Robust Ground Truth Data Mining for Enhanced Privacy and Accuracy in Noisy TinyML Environments*}, 
  year={2026},
  volume={},
  number={},
  pages={403-429},
  abstract={Summary <p>Given the importance of tiny machine learning (TinyML) in the Internet of Things, where resource&#x2010;constrained devices are prevalent, data accuracy often diverges from true values due to sensing errors. Although privacy&#x2010;preserving data mining has been extensively explored over the past decade, there is a lack of focus on data values that include errors. Differential privacy (DP), the de facto standard for privacy metrics, traditionally involves adding noise to protect target values. However, adding excessive noise to already erroneous values is unnecessary. This chapter introduces a novel privacy model called inferred ground truth DP (GDP). The proposed model applies traditional DP principles to the &#x201c;ground truth,&#x201d; which is unknown to the data owner or anonymizer, rather than the erroneous &#x201c;sensor data.&#x201d; GDP reduces the noise added by DP techniques by approximately 20%. We validate GDP with various synthetic and real&#x2010;world datasets and demonstrate that the level of privacy protection remains unchanged, provided the measurement errors are not overestimated. The proposed method is particularly beneficial for TinyML, where optimizing data accuracy and privacy while minimizing resource usage is critical.</p>},
  keywords={Tiny machine learning;Noise;Economic indicators;Sensors;Data privacy;Privacy;Data collection;Accuracy;Probability distribution;Noise measurement},
  doi={10.1002/9781394294572.ch11},
  ISSN={},
  publisher={IEEE},
  isbn={9781394294565},
  url={https://ieeexplore.ieee.org/document/11345344},}@INPROCEEDINGS{11342233,
  author={Ram, Chandan B and M B, Nirmala. and Gari, Swathi Papanna},
  booktitle={2025 2nd International Conference on Software, Systems and Information Technology (SSITCON)}, 
  title={Federated TinyML on ESP32: A Resource-Constrained Framework for IoT Health Monitoring}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The combination of Tiny Machine Learning (TinyML) with Federated Learning (FL) enables intelligent analytics on low-power microcontrollers. While prior often rely on resource-rich devices (e.g., Raspberry Pi, Jetson), very few have demonstrated FL on low-power devices. This research develops a resource-limited federated learning system which operates on ESP32 devices to perform real-time health monitoring. A lightweight neural network processed parameters like blood oxygen saturation ($\text{SpO}_{2}$), heart rate and temperature. The devices run local anomaly detection while sending model updates to build a global model through federated averaging. Unlike centralized TinyML deployments, our framework maintains privacy by keeping all raw health data on the device. The proposed system reaches an average classification accuracy of 98 % while maintaining inference latency under 100 ms and keeping the quantized model size below 3 KB to support deployment on memory-restricted hardware. These results demonstrate that federated aggregation preserves accuracy while reducing centralized storage needs enabling privacy-preserving and resourceefficient solution.},
  keywords={Performance evaluation;Privacy;Accuracy;Microcontrollers;Federated learning;Tiny machine learning;Software systems;Real-time systems;Protection;Monitoring;tiny machine learning (tinyML);federated learning (FL);edge computing;esp32 microcontroller;IoT health monitoring;resource-constrained devices},
  doi={10.1109/SSITCON66133.2025.11342233},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11547543,
  author={Shraideh, Ahmad and Masadeh, Mahmoud},
  booktitle={2025 6th International Conference on Data Analytics for Business and Industry (ICDABI)}, 
  title={Exploring Efficient Hardware for AI Acceleration in TinyML}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The increasing proliferation of Internet of Things (IoT) systems requires smart, low-power solutions for on-device AI. Tiny Machine Learning (TinyML) offers a practical solution by enabling machine learning inference on microcontrollers and ultra-low-power systems. This survey explores circuit and system-level developments that enable AI acceleration in TinyML-based IoT applications. Specifically, we review the design of power-efficient system-on-chip (SoC) architectures, such as GAP-8, which is based on parallel processing and custom CNN accelerators to deliver high performance on limited power budgets. Furthermore, we examine software-based strategies, such as approximate computing techniques that improve inference latency without compromising accuracy, particularly through semantic-aware kernel skipping. We also discuss how TinyML frameworks, such as TensorFlow Lite Micro (TFLM) and CMSIS-NN, in conjunction with custom instruction set architectures (ISAs), facilitate improved model deployment on constrained devices. As a practical application, we highlight TinyDevID, a TinyML-powered framework for identifying IoT devices using network flow data with over $91 \%$ accuracy on microcontroller devices. This paper provides a comprehensive review of existing systems and identifies the challenges ahead.},
  keywords={Internet of Things;Modeling;Tiny machine learning;Artificial intelligence;Hardware;Accuracy;Optimization;Memory;Microcontrollers;Machine learning;Tiny Machine Learning;Internet of Things;Instruction Set Architectures;System-on-Chips},
  doi={10.1109/ICDABI67967.2025.11547543},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11416391,
  author={Kikuchi, Takamasa and Shigetomo, Sakuma and Matsui, Tomokazu and Suwa, Hirohiko and Yasumoto, Keiichi},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Smart Annotation with Nudging and Gamified Agents for Activity Recognition in a Home Environment}, 
  year={2025},
  volume={},
  number={},
  pages={640-644},
  abstract={With technological advancements, the need to recognize daily activity contexts is increasing for home assistant robots or automations. Most existing services focus only on activity logging and anomaly detection. Building generalizable in-home activity recognition models remains difficult due to diverse lifestyles and layouts. The most promising approach is to fine-tune a generalizable model using environmental data from AI-equipped homes and ground-truth labels. However, collecting ground truth data is generally very tedious for residents and lacks continuity. In this study, we propose an in-home activity annotation support system that utilizes motivation methods based on the concept of weak robots, gamification, and nudging. The system mainly consists of parent and child virtual agents, featuring a labeling function that utilizes non-intrusive interventions and natural conversations. Through scripted living experiments with 20 participants, the effectiveness of the proposed two types of agents was confirmed when compared to general nudging annotation intervention methods. Furthermore, both proposed methods were rated as more natural for daily use compared to the baseline, with median scores increasing by approximately 1 point on a 5-point scale. Although no statistically significant difference was found between the two methods, this suggests that individual preferences—potentially influenced by personality traits—may affect the perceived suitability of different intervention styles.},
  keywords={Annotations;Layout;Smart homes;Oral communication;Timing;Internet of Things;Labeling;Human activity recognition;Artificial intelligence;Robots;Gamification;Nudging;Annotation;Human Activity Recognition;Smart Home},
  doi={10.1109/AIoT66900.2025.00096},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11079096,
  author={Martinez-Rau, Luciano Sebastian and Zhang, Yuxuan and Phuong Vu, Quynh Nguyen and Oelmann, Bengt and Bader, Sebastian},
  booktitle={2025 IEEE International Instrumentation and Measurement Technology Conference (I2MTC)}, 
  title={An On-Device Hybrid Machine Learning Approach for Anomaly Detection in Conveyor Belt Operations}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The mining sector harnesses advancements in automation, digitalization, and interconnected technologies from Industry 4.0 to enhance efficiency, safety, and sustainability. Conveyor belts play a critical role in mining operations, facilitating the continuous and efficient transport of bulk materials over long distances, directly impacting productivity. While anomaly detection in specific conveyor belt components has been extensively studied, continuous monitoring to identify root causes of failures remains in its early stages. Existing methods for anomaly detection in mining conveyor belt duty cycles rely on supervised machine learning (ML) to classify internal machine modes as an intermediate step. While these approaches offer high explainability, they are constrained by the need for extensive labeled data for internal machine modes. This study proposes a novel pattern recognition approach combining unsupervised and supervised ML models for real-time anomaly detection in conveyor belt operational cycles. By evaluating combinations of TinyML models, the approach achieved average F1-scores of 83.2% for abnormal cycles and 97.0% for normal cycles, surpassing the state-of-the-art by 11.4% and 3.3%, respectively. Deployed on low-power microcontrollers, the proposed methods demonstrated efficient, real-time operation, reducing energy consumption by up to 84.5% (4.1 µJ per inference) and program memory usage by up to 72.1%. These results provide valuable insights for detecting early mechanical failures and enabling targeted preventive maintenance.},
  keywords={Machine learning algorithms;Microcontrollers;Tiny machine learning;Training data;Random access memory;Clustering algorithms;Belts;Real-time systems;Robustness;Anomaly detection;anomaly detection;conveyor belt;industry 4.0;low-power microcontroller;TinyML;unsupervised learning},
  doi={10.1109/I2MTC62753.2025.11079096},
  ISSN={2642-2077},
  month={May},}@INPROCEEDINGS{11092258,
  author={Grzymkowski, Łukasz and Cejrowski, Tymoteusz and Stefański, Tomasz P.},
  booktitle={2025 32nd International Conference on Mixed Design of Integrated Circuits and System (MIXDES)}, 
  title={Anomaly Detection on the Edge: Comparison of Reconstruction and Classification Based Approaches}, 
  year={2025},
  volume={},
  number={},
  pages={45-50},
  abstract={In this work we discuss and evaluate different approaches to solving anomaly detection task when the target platform is a tiny microcontroller. We investigate modeling techniques and propose a comprehensive set of measurements to analyze performance, compute and memory requirements, and power efficiency. We run experiments to collect these measurements on platforms used in TinyML systems including Cortex-M7, Cortex-M55 and Ethos-U55 running TensorFlow Lite for Microcontrollers. The measurements are collected for an autoencoder in reconstruction-based anomaly detection and a MobileNetV2-like model trained for classification. We show which approach is more suitable depending on the system requirements and constraints. This work underscores the need for a holistic approach in selecting modeling and deployment strategies, providing empirical evidence to guide the development of efficient on-device anomaly detection systems.},
  keywords={Power measurement;Microcontrollers;Computational modeling;Tiny machine learning;Neural architecture search;Software measurement;Integrated circuit modeling;Anomaly detection;Standards;Sound recognition;Edge computing;embedded software;tiny machine learning;anomaly detection;sound recognition},
  doi={10.23919/MIXDES66264.2025.11092258},
  ISSN={},
  month={June},}@INPROCEEDINGS{11159421,
  author={Sharifirad, Iman and Boudjadar, Jalil and Roveri, Manuel and Larsen, Peter Gorm},
  booktitle={2025 International Conference on Advanced Machine Learning and Data Science (AMLDS)}, 
  title={Sensitivity Analysis Exploration of ML Architectures to TinyML Techniques}, 
  year={2025},
  volume={},
  number={},
  pages={72-78},
  abstract={TinyML techniques, such as pruning and quantization, enable the deployment of machine learning (ML) models on resource-constrained embedded devices by reducing computational and memory demands. However, the impact of these techniques varies across different ML architectures, influencing accuracy, inference speed, computation cost, and memory footprint. This paper presents a sensitivity analysis of three prominent architectures—CNN, LSTM, and Transformer—to TinyML techniques: L1-structured pruning and integer 8-bit quantization within an industrial anomaly detection application scenario. A two-stage optimization methodology is applied, first pruning models to reduce computational complexity and then quantizing them to minimize memory footprint. Performance is evaluated using Mean Squared Error (MSE), Floating Point Operations (FLOPs), Execution Time (ET), and Memory Space (MS). The findings highlight the trade-offs between computational efficiency and predictive accuracy, underscoring the need for architecture-aware TinyML strategies for optimized model deployment in embedded systems.},
  keywords={Adaptation models;Quantization (signal);Accuracy;Sensitivity analysis;Tiny machine learning;Computational modeling;Transformers;Optimization;Long short term memory;Anomaly detection;Anomaly Detection;TinyML;Pruning;Quantization;CNN;LSTM;Transformer},
  doi={10.1109/AMLDS63918.2025.11159421},
  ISSN={},
  month={July},}@INPROCEEDINGS{11541968,
  author={Ranganathan, Viswanathan and Elengovan, Arun Kumar and Nutalapati, Venkat and Kole, Deepak and Parikh, Milan and Seshagiri, Nandagopal},
  booktitle={2026 International Conference on Artificial Intelligence, Systems, and Emerging Technologies (ICAISET)}, 
  title={A TinyML-Based Out-of-Distribution Security Monitor for Energy-Constrained Industrial and Medical IoT Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The sudden increase in industrial and medical Internet of Things (IoT) systems deployment has created serious cybersecurity and reliability problems under tight energy and resource constraints, where unknown attacks and device failures are to be detected at the edge itself. In this work, a TinyML-based out-of-distribution (OOD) security monitoring framework is introduced for energy-constrained IoT devices, where normal operational behavior is learned in an unsupervised way and deviation is detected without the need for previous attack signatures. A lightweight autoencoder in conjunction with a confidence-weighted OOD scoring mechanism and persistence-based decision logic is used to achieve robust detection without continuous high-rate sensing. The proposed approach achieves a good performance in the detection, with a ROC-AUC of 0.9257 and a PR-AUC of 0.8913 for OOD detection, with no false escalation in normal operation. Deployment-time evaluation shows timely detection with an average latency of around 41.5 windows and 61.65% system-level energy reduction as compared to always-on monitoring. The whole framework is implemented with an INT8-quantized TinyML model with only 2.98 KB memory footprint, that can be used for practical on-device deployment. By jointly integrating TinyML, confidence-aware OOD detection and adaptive energy-aware security actions, this work addresses one critical gap in sustainable and reliable protection of industrial and medical cyber-physical IoT systems.},
  keywords={Internet of Things;Security;Printing;Signal detection;Tiny machine learning;Modeling;Equations;Monitoring;Energy;Machine learning;TinyML;Out-of-Distribution Detection;Energy-Aware IoT Security},
  doi={10.1109/ICAISET66439.2026.11541968},
  ISSN={},
  month={April},}@INPROCEEDINGS{10885641,
  author={Datta, Arko and Chakraborty, Joyita and Majhi, Pabitra and Mondal, Astom and Roy, Satyaki and Nandi, Subrata and Saha, Sujoy},
  booktitle={2025 17th International Conference on COMmunication Systems and NETworks (COMSNETS)}, 
  title={PolluSenseCheck: Cost Effective TinyML-based Air Quality Monitoring System with In-Built Sensor Fault Detection}, 
  year={2025},
  volume={},
  number={},
  pages={623-631},
  abstract={Air pollution is a significant contributor to respiratory diseases, posing severe health risks globally. Traditional air quality monitoring stations, while effective, are too expensive, particularly in developing nations like India, where numerous monitoring sites may be required to cover diverse urban and industrial regions. Existing cost-effective air quality monitoring systems are rendered inadequate by their reliance on sensors that are prone to drift, which necessitates frequent recalibration. This study addresses the gap by developing a cost-effective air quality monitoring device capable of detecting particulate matter, carbon monoxide (CO), temperature, and humidity, and incorporating self-diagnostic capabilities. It enhances reliability through a dual-sensing mechanism: it calculates the Air Quality Index (AQI) directly and uses a TinyML model to provide secondary-sensed AQI estimations. Deviations between these two AQI values signal sensor malfunction, which is tracked by a proposed algorithm, Interocept, that assigns fault scores to the sensors. Models were created for eight cities, showing accuracies from 0.69 – 0.89 for dust and 0.76 – 0.95 for CO. These models were optimized for real-time performance by converting them into TensorFlow Lite micro-models, allowing deployment on the device itself for continuous, autonomous sensor health diagnostics and improved long-term air quality management systems.},
  keywords={Temperature sensors;Atmospheric modeling;Tiny machine learning;Urban areas;Air quality;Sensor systems;Real-time systems;Sensors;Reliability;Monitoring;Air Quality;Sensor Drift;TinyML;Cost Effective Air Quality Monitoring Device},
  doi={10.1109/COMSNETS63942.2025.10885641},
  ISSN={2155-2509},
  month={Jan},}@INPROCEEDINGS{11161868,
  author={Dehrouyeh, Fatemeh and Shaer, Ibrahim and Nikan, Soodeh and Ajaei, Firouz Badrkhani and Shami, Abdallah},
  booktitle={ICC 2025 - IEEE International Conference on Communications}, 
  title={Pruning-Based TinyML Optimization of Machine Learning Models for Anomaly Detection in Electric Vehicle Charging Infrastructure}, 
  year={2025},
  volume={},
  number={},
  pages={1195-1200},
  abstract={With the growing need for real-time processing on IoT devices, optimizing machine learning (ML) models' size, latency, and computational efficiency is essential. This paper investigates a pruning method for anomaly detection in resourceconstrained environments, specifically targeting Electric Vehicle Charging Infrastructure (EVCI). Using the CICEVSE2024 dataset, we trained and optimized three models—Multi-Layer Perceptron (MLP), Long Short-Term Memory (LSTM), and XGBoost—through hyperparameter tuning with Optuna, further refining them using SHapley Additive exPlanations (SHAP)-based feature selection (FS) and unstructured pruning techniques. The optimized models achieved significant reductions in model size and inference times, with only a marginal impact on their performance. Notably, our findings indicate that, in the context of EVCI, pruning and FS can enhance computational efficiency while retaining critical anomaly detection capabilities.},
  keywords={Additives;Computational modeling;Tiny machine learning;Electric vehicle charging;Real-time systems;Computational efficiency;Model compression;Long short term memory;Anomaly detection;Tuning;CICEVSE2024;electric vehicle charging infrastructure (EVCI);model compression;Optuna;pruning;SHapley Additive explanations (SHAP);TinyML},
  doi={10.1109/ICC52391.2025.11161868},
  ISSN={1938-1883},
  month={June},}@INPROCEEDINGS{11416176,
  author={Tleuberdin, Saken and Satybaldina, Dina and Aidynov, Tolegen and Nurusheva, Assel and Issainova, Aliya and Abisheva, Gulsipat},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Vulnerabilities Assessment of WPA3-Enterprise in Evil Twin Attacks}, 
  year={2025},
  volume={},
  number={},
  pages={888-893},
  abstract={As increasing numbers of wireless networks and Internet of Things (IoT) devices are being used, it is becoming more important to protect wireless communications. WPA3 was out in 2018 to fix the problems with WPA2. Even with these enhancements, evil twin attacks, which try to steal credentials by pretending to be a business network, can still be very dangerous. In this paper, we present an experimental vulnerability assessment in a WPA3-Enterprise environment to test the latest WPA3 security mechanisms perform on various devices and operating systems, such as iOS, macOS, Ubuntu, and Windows. We built a test platform based on Kali Linux and used the ALFA AWUS036AXML adapter, as well as Hostapd and FreeRADIUS tools, to deploy RADIUS servers and a rogue access point (rogue AP). We tested several client connection scenarios to a rogue AP using three device configurations: Safe (mandatory CA certificate verification), Weak (server certificate verification is disabled or the CA is not installed), and Mixed (the device trusts the CA, but the certificate is expired). The results of the experiments showed that Evil Twin attacks were successful on clients running Ubuntu 24.04.2 and Windows 10 due to insecure certificate verification settings. We developed recommendations for mitigating information security risks for these cases.},
  keywords={Protocols;Operating systems;Wireless networks;Linux;Authentication;Manuals;Servers;Internet of Things;Artificial intelligence;Wireless fidelity;Evil Twins-attack;Internet of Things;vulnerability assessment;Wi-Fi Protected Access 3 (WPA3) protocol;WPA3-Enterprise;wireless communication},
  doi={10.1109/AIoT66900.2025.00144},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11318372,
  author={Verma, Pratham and Patel, Devarsh and Vyas, Karm and Pathak, Lakshin and Gupta, Rajesh and Tanwar, Sudeep and Gawanmeh, Amjad},
  booktitle={2025 8th International Conference on Signal Processing and Information Security (ICSPIS)}, 
  title={LLM and Quantum-Secured Nano Traffic Anomaly Detection for Military Spacecraft in Battlefields}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper proposes a quantum-secured nano-traffic anomaly detection framework enhanced by Large Language Models (LLMs) for 5G-enabled battlefield networks in military spacecraft. The system integrates quantum key distribution for secure communication, nanoscale sensing for ultra-fast traffic monitoring, and deep recurrent neural architectures for adaptive anomaly detection. Among RNN-based models, LSTM and GRU optimized with Nadam and RMSprop achieved up to 98% validation accuracy, confirming the efficiency of adaptive optimizers in dynamic network conditions. The framework further leverages LLM-driven reasoning to interpret and classify complex threat patterns, attaining benchmark scores above 0.90 on ROUGE-1, BLEU, and METEOR metrics, with Gemma2 9B IT demonstrating strong performance. Overall, the proposed architecture ensures secure, low-latency, and intelligent threat detection, providing a scalable and resilient defense mechanism for space-based military communication systems.},
  keywords={Space vehicles;Adaptive systems;Large language models;Tiny machine learning;Signal processing;Threat assessment;Quantum key distribution;Sensors;Anomaly detection;Long short term memory;Quantum key distribution;nano-scale traffic anomaly detection;TinyML;LSTM;GRU;large language models;5G battlefield networks;explainable AI (SHAP;LIME)},
  doi={10.1109/ICSPIS67605.2025.11318372},
  ISSN={2831-3844},
  month={Nov},}@ARTICLE{10804678,
  author={Zeng, Jiuzhen and Yang, Laurence T. and Wang, Chao and Deng, Xianjun and Yang, Xiangli},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={Tensor-Based Multi-Scale Correlation Anomaly Detection for AIoT-Enabled Consumer Applications}, 
  year={2025},
  volume={71},
  number={1},
  pages={2061-2071},
  abstract={Artificial Intelligence of Things (AIoT) is an innovative paradigm expected to enable various consumer applications that is transforming our lives. While enjoying benefits and services from these applications, we also face serious security issues due to malicious cyber attacks on the massive growth of AIoT consumer devices. Accurate anomaly detection is one of the critical tasks for the trustworthy AIoT removing those obstacles. However, limited by the vector-based data pattern and ill-considered factors for anomalous samples analysis, existing methods suffer from the low detection performance. In this paper, a multi-scale correlation tensor convolutional Gaussian mixture network (named as MTCGM) is presented for ameliorating this actuality. Specifically, MTCGM suggests to construct the multi-scale correlation tensor by stacking one self-correlation matrix and multiple surrounding-correlations of different scales, which well characterizes the network status of AIoT. Subsequently, a 3D-convolutional autoencoder (3DCA) is designed for capturing inter-feature correlations, and followed with a Gaussian mixture probability (GMP) network for the observations likelihood estimation. Moreover, low-dimensional space features, relative Euclidean distance and tensor cosine similarity (TCS) are adopted in MTCGM as the multi-factor to boost the likelihood estimation. Extensive experiments on public benchmark datasets verify the validity of MTCGM, and demonstrate its superiority over the state-of-the-art baselines even in presence of contaminated training samples and input noise.},
  keywords={Correlation;Anomaly detection;Feature extraction;Tensors;Estimation;Artificial intelligence;Internet of Things;Consumer electronics;Training;Noise measurement;Correlation tensor;tensor cosine similarity;anomaly detection;consumer electronics;AIoT},
  doi={10.1109/TCE.2024.3519437},
  ISSN={1558-4127},
  month={Feb},}@INPROCEEDINGS{11244435,
  author={Elahi, Mehdi and Elshamy, Mohamed R. and Badawy, Abdel-Hameed and Patooghy, Ahmad},
  booktitle={2025 IEEE 68th International Midwest Symposium on Circuits and Systems (MWSCAS)}, 
  title={iThermTroj: Exploiting Intermittent Thermal Trojans in Multi-Processor System-on-Chips}, 
  year={2025},
  volume={},
  number={},
  pages={912-916},
  abstract={Thermal Trojan attacks present a pressing concern for the security and reliability of System-on-Chips (SoCs), especially in mobile applications. The situation becomes more complicated when such attacks are more evasive and operate sporadically to stay hidden from detection mechanisms. In this paper, we introduce Intermittent Thermal Trojans (iThermTroj) that exploit the chips' thermal information in a random timetriggered manner. According to our experiments, iThermTroj attack can easily bypass available threshold-based thermal Trojan detection solutions. We investigate SoC vulnerabilities to variations of iThermTroj through an in-depth analysis of Trojan activation and duration scenarios. We also propose a set of tiny Machine Learning classifiers for run-time anomaly detection to protect SoCs against such intermittent thermal Trojan attacks. Compared to existing methods, our approach improves the attack detection rate by 29.4%, 17.2%, and 14.3% in scenarios where iThermTroj manipulates up to 80%, 60%, and 40% of SoC's thermal data, respectively. Additionally, our method increases the full protection resolution to 0.8 degrees Celsius, meaning that any temperature manipulations exceeding $\pm 0.8$ degrees will be detected with 100% accuracy.},
  keywords={Program processors;Tiny machine learning;Thermal management;System-on-chip;Trojan horses;Security;Reliability;Protection;Anomaly detection;Resilience;Intermittent Thermal Trojan Attacks;Machine Learning Anomaly Detection;System-on-Chips (SoCs)},
  doi={10.1109/MWSCAS53549.2025.11244435},
  ISSN={1558-3899},
  month={Aug},}@INPROCEEDINGS{11539405,
  author={G, Shoba and M, Ezhilvendan and J, Sherine Glory and M, Sadhasivam and K, Vijayakumar and Sekar, G},
  booktitle={2026 12th International Conference on Communication and Signal Processing (ICCSP)}, 
  title={WhisperNet: An On-Device TinyML Architecture for Real-Time Anomaly Detection in Industrial Machinery}, 
  year={2026},
  volume={},
  number={},
  pages={256-261},
  abstract={Cloud-dependent anomaly detection in industrial Internet of Things (IoT) introduces prohibitive latency, bandwidth costs, and data privacy risks for real-time predictive maintenance. To overcome this, we present WhisperNet, a novel TinyML architecture for direct deployment on resource-constrained microcontroller units (MCUs). WhisperNet employs a hybrid 1D-CNN and Depthwise Separable Convolution design, enhanced with a temporal attention module to efficiently extract salient features from vibration signals. The model was optimized via post-training integer quantization for ARM Cortex-M cores. Evaluated on the CWRU bearing dataset, WhisperNet achieves 94.2% F1-score accuracy with an inference time of 25 ms, consumes under 50 mW of power, and requires only 250 KB of memory. This demonstrates a practical, cost-effective, and privacy-preserving solution for on-device, real-time anomaly detection in industrial machinery.},
  keywords={Modeling;Timing;Accuracy;Quantization (signal);Training;Printing;Vibrations;Anomaly detection;Memory;Architecture;TinyML;Anomaly Detection;Predictive Maintenance;On-Device Inference;Industrial IoT (IIoT);Edge AI},
  doi={10.1109/ICCSP68173.2026.11539405},
  ISSN={2836-1873},
  month={April},}@INPROCEEDINGS{11416270,
  author={Zheng, Qiaojie and Wakin, Michael B. and Gockel, Joy and Brice, Craig and Zhang, Xiaoli},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Extracting spatial features from time-series photodiode recordings for anomaly detection in additive manufacturing}, 
  year={2025},
  volume={},
  number={},
  pages={115-122},
  abstract={Photodiode monitoring offers a high-speed sensing modality well-suited for capturing rapid phenomena such as pore formation in metal additive manufacturing. However, its 1D time-series recordings significantly limit the scope of spatial analysis, making 2D or 3D spatial interpretations difficult. Even when paired with positional data, the resulting measurements can be sparse and unstructured, posing challenges for downstream tasks like anomaly detection. In this study, we introduce a spatial pooling method that transforms sparse photodiode signals into dense, structured representations, enabling efficient detection for fine-scale anomalies in metal additive manufacturing. Our approach exploits the redundancy inherent in ultra-high sampling rates from photodiodes and the homogeneity of material in additive manufacturing processes to select representative signal segments within defined pooling regions. We demonstrate the utility of this method in detecting anomalies in parts produced by a laser powder bed fusion process. The dense and structured post-pooling data not only supports computationally efficient anomaly detection but also enables the extraction of small-scale process-related features.},
  keywords={Redundancy;Metals;Feature extraction;Three-dimensional printing;Recording;Photodiodes;Internet of Things;Artificial intelligence;Monitoring;Anomaly detection;Additive Manufacturing;Defect Detection;Insitu Monitoring;Signal Processing},
  doi={10.1109/AIoT66900.2025.00027},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11348379,
  author={Malagi, Vindhya P and Shaikh, Shazia and Ghamande, Manasi Vyankatesh and Bhutani, Monica and Ramva, D. and Nisha, P.},
  booktitle={2025 International Conference on Communication and Smart Devices (ICCoSD)}, 
  title={Low-Power Machine Learning Models for Edge-Based Anomaly Detection in Wearable IoT Healthcare Devices}, 
  year={2025},
  volume={1},
  number={},
  pages={1-6},
  abstract={Wearable IoT devices: With the fast development of wearable technologies in the field of IoT., there is now the possibility of constant monitoring of the health of individuals and spotting any anomaly at an early stage., which can be greatly beneficial in providing personal health care. Nevertheless., it is still not hard to imagine using machine learning (ML) in resource-constrained edge devices because of the shortages in memory, energy, and processing capabilities. The current paper explores the most recent breakthroughs in the area of low-power ML models - namely, TinyML, model pruning, and quantization - that enables real-time anomaly detection in wearable healthcare systems. Besides the overview of edge computing frameworks (TensorFlow Lite for Microcontrollers and Edge Impulse), the given research provides a mathematical model and parametric investigation of a TinyML-based anomaly detection model. Through emulating a shallow CNN on the ARM Cortex-M4 architecture in respect to detecting ECG anomalies, we evaluate how well different models perform along with different latency, energy, and accuracy limits. Findings demonstrate that model size can be minimized by ~83%., energy use by ~65%., as well as latency by~61.” Compared to current compressed deep learning models, our results match them and are even better, which demonstrates the feasibility of shallow TinyML models in realistic edge-based healthcare systems that have low latencies, low power, and high accuracy. In this paper, the concluding observations are made on the scalability, interpretability, and moral concerns, which lead to a systematic roadmap on developing an effective wearable health system that is not only secure but also intelligent.},
  keywords={Accuracy;Computational modeling;Tiny machine learning;Image edge detection;Medical services;Mathematical models;Real-time systems;Biomedical monitoring;Anomaly detection;Monitoring;Edge AI;TinyML;Wearable Healthcare Devices;Anomaly Detection;IoT;Low-Power ML Models;Edge Computing;Healthcare Monitoring},
  doi={10.1109/ICCoSD66074.2025.11348379},
  ISSN={},
  month={July},}@INPROCEEDINGS{10636542,
  author={Mikhaylov, Denis and Polonelli, Tommaso and Magno, Michele},
  booktitle={2024 IEEE Sensors Applications Symposium (SAS)}, 
  title={On-Sensor TinyML Event-Based Fault Detection Strategies on Wind Turbine Blades}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={With the advent of wireless low-power Internet of Things (IoT) devices, Structural Health Monitoring (SHM), in which structures or machines are monitored using sensors, has become increasingly important to reduce costs and increase structure longevity. On-sensor machine learning represents a significant leap forward in addressing the challenge of managing the copious amounts of data these SHM systems generate. Novel sensors such as the ISM330IS Inertial Measurement Unit (IMU) from STMicroelectronics feature an onboard Intelligent Sensor Processing Unit (ISPU) enabling some of the required data processing to be computed onboard the sensor, reducing the need to run the main processor and ensuring only interesting data is collected, e.g., when a fault occurs. Using an existing state-of-the-art monitoring system as a baseline, this work investigates the power consumption, bandwidth requirements, and latency of potential data acquisition strategies using an event-based tiny Machine Learning (tinyML) model for fault detection in the context of wind turbine blades. The results demonstrate that replacing the current time-based data acquisition strategy of the existing system with an event-based strategy using the ISPU could reduce power consumption by up to 75% while decreasing latency between fault occurrence and alerting of the remote monitoring system to near-zero, with an always-on power of just 1.29mW.},
  keywords={Power demand;Tiny machine learning;Fault detection;Blades;Data acquisition;Bandwidth;Data models;Structural Health Monitoring;Ultra-Low Power;On-Sensor Processing;ISPU;tinyML;IoT;SHM},
  doi={10.1109/SAS60918.2024.10636542},
  ISSN={2766-3078},
  month={July},}@INPROCEEDINGS{11307279,
  author={Shirly, A.R. Danila and Prathiba, S. and Hyacinth, L. Ramya and K, Lokeshwar and G, Jennifer Ruth Pauline},
  booktitle={2025 Second International Conference on Intelligent Technologies for Sustainable Electric and Communications Systems (iTech SECOM)}, 
  title={Edge-Based TinyML for Fault Detection Using Sound Vibration Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In this work, we propose a new edge computing framework for fault detection of industrial machines based on sound vibration analysis. A low footprint TinyML model has been used and deployed on the Arduino Nano RP2040 microcontroller via TensorFlow Lite. The machines' acoustic signals are evaluated for unusual patterns indicative of damage or wear. Features are extracted by the MelFrequency Energy (MFE), which is introduced to effectively represent spectral properties of the audio signal related to the machine condition monitoring. Conventional fault detection systems are generally based on cloud services, which inevitably rely on continuous data to be transmitted from the edge devices to the remote servers for the purpose of processing and inferencing. This solution comes with the added latency, power usage and network dependency and security risks. In contrast, the proposed edge computing approach enhances extensive work on scene graph generation and detection. online inference on the embedded device. This provides immediate fault finding, low latency, higher data security, and removes the requirement of always-on cloud connection. Local processing of data reduces Operative Costs due to less bandwidth consumption and less dependence on Cloud services. It may save energy, thus making it suitable for use in the industrial area which is far away from the city or lack of energy sources. By reducing the response time any potential for delays, which can often manifest as system failures or downtime, is kept at a minimal. The paper also provides empirical evaluation and comparative studies to show that the edge-based model is more effective than the conventional cloud approach. In summary, this work showcases the promise of TinyML and edge computing for smart, cost-effective, and energy-efficient fault detection in industrial applications.},
  keywords={Vibrations;Microcontrollers;Tiny machine learning;Fault detection;Image edge detection;Computational modeling;Low latency communication;Edge computing;Predictive maintenance;Industrial Internet of Things;Edge Computing;TinyML;Machine Learning;Industrial IoT (IIoT);TensorFlow Lite for Microcontrollers (TFLM);Incremental Learning;Multi-Sensor Integration;Industrial Applications},
  doi={10.1109/iTechSECOM64750.2025.11307279},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11544500,
  author={Aryaprasadh, Kanduri and M, Deepu and Devendra, B and S, Sheela and Patil, Basavaraj},
  booktitle={2026 International Conference on Artificial Intelligence and Data Engineering (AIDE)}, 
  title={Zero Trust IoT Security Platform}, 
  year={2026},
  volume={},
  number={},
  pages={589-594},
  abstract={The proposed Zero Trust IoT Security Platform with a hardware–SaaS hybrid security framework is presented, utilizing Zero Trust architecture, encryption, and monitoring. Every sensor connected to the proposed platform, such as PIR and DHT22, will operate as an independent node carrying out TinyML-based anomaly detection and sending encrypted data via AES/ECC to the cloud. The proposed hardware component is made up of modular IoT nodes driven by ESP32 microcontrollers. The cloud management layer is a SaaS platform built on Firebase, functioning as the centralized management layer providing real-time dashboards, device management, compliance tracking, and role-based access control. Extensive testing achieved over 95% intrusion detection accuracy, rapid deployment under one hour, and scalability beyond 100 nodes.},
  keywords={Internet of Things;Modeling;Poles and zeros;Security;Zero Trust;Clouds;Tiny machine learning;Encryption;Image sensors;Timing;Zero Trust Architecture;Internet of Things (IoT);Edge Security;ESP32;TinyML;AES;ECC;Firebase;SaaS Platform;Device Authentication;Certificate Verification;Cloud Security;Anomaly Detection;Role-Based Access Control (RBAC);Micro-Segmentation;End-to-End Encryption},
  doi={10.1109/AIDE69088.2026.11544500},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11490061,
  author={Gollapalli, Vaibhav and Aarella, Seema G. and Mohanty, Saraju P. and Kougianos, Elias},
  booktitle={2025 IEEE International Symposium on Smart Electronic Systems (iSES)}, 
  title={Federated TinyML for Lightweight Anomaly Detection in IoMT Using MQTT-Enabled Edge Deployment}, 
  year={2025},
  volume={},
  number={},
  pages={411-416},
  abstract={The rise of the Internet of Medical Things (IoMT) enables continuous health monitoring, but traditional cloud-based Machine Learning (ML) models face challenges in latency, privacy, and reliability, especially in resource-constrained settings. This paper presents a lightweight anomaly detection framework using TinyML models deployed on microcontroller-based edge devices for real-time physiological signal analysis. DHT11 sensors simulate temperature signals and inference is performed locally using an optimized TensorFlow Lite model. Communication with external systems is handled via Message Queuing Telemetry Transport (MQTT) for efficient data logging and visualization. The framework integrates Tiny Federated Learning (TinyFL) for continual model updates, achieving an average accuracy of 99% while significantly reducing latency and energy consumption across the evaluation rounds. This approach offers a low-latency, scalable and secure solution for decentralized IoMT applications.},
  keywords={Activity recognition;Human activity recognition;Telemetry;Aerospace and electronic systems;Broadcasting;Broadcast technology;Microcontrollers;Very large scale integration;Microprocessors;System-on-chip;Machine learning;healthcare;Internet of Medical Things (IoMT);Edge processing;TinyML;MQTT;Data security;privacy},
  doi={10.1109/iSES67504.2025.00086},
  ISSN={2832-3602},
  month={Dec},}@ARTICLE{10485394,
  author={Szydło, Tomasz and Nagy, Marcin},
  journal={IEEE Micro}, 
  title={Management of TinyML-Enabled Internet of Things Devices}, 
  year={2025},
  volume={45},
  number={1},
  pages={87-94},
  abstract={Internet of Things (IoT) systems are used in many aspects of our lives. Thanks to TinyML algorithms, they provide several new and smart functionalities that were impossible before. However, implementing such a solution on a large scale and maintaining it over time is a big challenge. This is due to the need to not only update the device firmware to remove errors and extend the functionality of the devices but also to update the ML models. This imposes several requirements for device monitoring and management mechanisms. In this article, we discuss not only the required aspects that an IoT system should meet, but we also show how they fit into the ML model management process.},
