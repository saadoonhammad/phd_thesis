  number={},
  pages={91-98},
  abstract={The ever-growing scale of Industrial Internet of Things (IIoT) deployments has heightened security risks, motivating adoption of Zero Trust Architecture (ZTA)—a "never trust, always verify" model that treats every user and device as potentially malicious. While ZTA greatly strengthens defense, it can also introduce non-negligible processing delays that conflict with IIoT’s stringent real-time requirements. To address this, we introduce a dynamic, trust-driven priority-queueing framework that assigns packets to service tiers based on their real-time trust score and seamlessly maps high-trust flows into Time Sensitive Network (TSN)’s eight-level priority scheduling. By modeling the post-filter traffic as a G/D/1 queueing model, we obtain closed-form delay bounds even under non-Poisson arrivals. In simulation, our two-tier prototype already yields a 10% reduction in average waiting time, and a 13% reduction is achieved by the prototype architecture implemented using the MQTT protocol. The same principles can be directly extended to TSN’s full eight-tier queuing hierarchy to guarantee bounded latency for critical IIoT messages.},
  keywords={System performance;Prototypes;Telecommunication traffic;Dynamic scheduling;Time measurement;Real-time systems;Delays;Zero Trust;Queueing analysis;Industrial Internet of Things;Zero Trust Architecture (ZTA);Industrial Internet of Things (IIoT);Priority Queue;Abnormal Detection;Time Sensitive Network (TSN)},
  doi={10.1109/AIoT66900.2025.00024},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11416431,
  author={Zhao, Shangru and Yang, Ting and Wang, He and Zhang, Yuqing},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Smart-Home Privacy in the Era of Large Models: Challenges and Opportunities}, 
  year={2025},
  volume={},
  number={},
  pages={935-941},
  abstract={Smart homes integrate advanced sensing technologies, continuous connectivity, and personalized human–AI interactions, providing remarkable convenience and automation. However, the rapid advancement of large models has also heightened privacy concerns within these environments. In this paper, we provide a comprehensive review of privacy issues in smart homes, with particular emphasis on the influence of large AI models on privacy risks and mitigation strategies. First, we outline the privacy challenges in smart home environments, with a focus on emerging threats from large-scale models. Subsequently, we survey various privacy-preserving approaches, ranging from traditional methodologies like local processing, data encryption, and traffic obfuscation to contemporary advancements that leverage large models for enhanced privacy protection, including on-device AI processing, federated learning, synthetic data generation, and AI-driven privacy tools. Ultimately, we identify ongoing challenges and propose future research directions to foster privacy-preserving smart home ecosystems in an era characterized by sophisticated AI technologies. This survey aims to provide researchers, developers, and policymakers with insights essential for striking a balance between innovation in smart home technologies and robust privacy safeguards.},
  keywords={Surveys;Privacy;Data privacy;Automation;Biological system modeling;Prevention and mitigation;Smart homes;Internet of Things;Artificial intelligence;Synthetic data;Smart Home;Privacy;Large Models;IoT},
  doi={10.1109/AIoT66900.2025.00152},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11416219,
  author={Shi, Yansong and Chen, Siyu and Hai, Xiang and Fu, Zhiyuan and Wang, Jice and He, Fannv and Sun, Hongyu and Zhang, Yuqing},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Research on Point Cloud Object Tampering Attacks for Cooperative Perception Systems}, 
  year={2025},
  volume={},
  number={},
  pages={900-905},
  abstract={Cooperative perception (CP), as a vital component of vehicle-to-everything (V2X) technology, greatly enhances the perception capability of autonomous vehicles in complex traffic environments. However, the reliance on shared external sensor data introduces critical security risks. This paper presents a novel point cloud object tampering attack framework targeting early-fusion CP systems, which enables both the injection of fake obstacles and the removal of real objects within shared LiDAR data. By leveraging the OpenCOOD framework and OPV2V dataset, we simulate these attacks in a collaborative perception setting and evaluate their impact on system performance. Experimental results demonstrate that the proposed method can significantly degrade the accuracy and reliability of perception outputs, effectively misleading detection models without triggering anomaly alarms. This study reveals a fundamental vulnerability in current CP architectures and underscores the importance of integrating perception security mechanisms into the design of collaborative autonomous systems.},
  keywords={Point cloud compression;Laser radar;System performance;Collaboration;Security;Internet of Things;Reliability;Artificial intelligence;Vehicle-to-everything;Autonomous vehicles;Cooperative Perception;Point Cloud Tampering;Autonomous Driving Security;V2X;Early Fusion},
  doi={10.1109/AIoT66900.2025.00146},
  ISSN={},
  month={Dec},}@ARTICLE{11230096,
  author={Wang, Song and Guo, Zhengzhi and Wang, Zhaoyang and Sun, Muyi},
  journal={IEEE Transactions on Computational Social Systems}, 
  title={Transformer-Based Anomaly Detection With Distributed Fiber-Optic Intelligence in End-Edge-Cloud Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1-11},
  abstract={Cyber–physical–social systems (CPSSs) emerged as a novel paradigm addressing the growing interactions among physical, social, and cyber domains. Many CPSS challenges were mathematically modeled as optimization problems, with a significant portion requiring multiobjective optimization approaches. To address inefficient learning caused by large-scale distributed sensor data in CPSS, a transformer-based anomaly detection framework for end-edge-cloud systems was proposed. For specific anomaly signals, an improved anomaly detection matrix was developed through systematic calculation of attention weights and corresponding scores. A distributed intelligence architecture integrating transformer-based anomaly detection was implemented in edge nodes for fiber-optic sensors. The proposed artificial Intelligence of Things (AIoT) based distributed edge computing model dynamically allocated tasks among idle, partially available, and fully utilized nodes through optimized resource management in task transmission. A high-efficiency allocation strategy was designed to optimize task processing rates and enable edge nodes to dynamically balance task execution and transmission without compromising detection accuracy. Experimental results demonstrated the effectiveness of both the enhanced transformer method and the computational pipeline across end-edge-cloud architectures. Compared with the vision transformer baseline, our method achieved 3.62% higher accuracy and 3.07% improved recall. Computational time was reduced by approximately 50% while memory consumption decreased by 40%. The proposed approach showed significant potential for anomaly detection in AIoT applications.},
  keywords={Transformers;Anomaly detection;Computational modeling;Edge computing;Accuracy;Optical fiber sensors;Image edge detection;Attention mechanisms;Resource management;Optimization;Anomaly detection;collaborative learning;cyber–physical–social system (CPSS);distributed fiber-optic intelligence;transformer},
  doi={10.1109/TCSS.2025.3613939},
  ISSN={2329-924X},
  month={},}@ARTICLE{11455993,
  author={Ghajari, Ghazal and Ghajari, Elaheh and Ghimire, Ashutosh and Ataei, Saeid and Alsulami, Faris and Amsaad, Fathi},
  journal={IEEE Access}, 
  title={D2H-AD: A Hybrid Model Utilizing Hyperdimensional Computing for Advanced Anomaly Detection}, 
  year={2026},
  volume={14},
  number={},
  pages={55227-55247},
  abstract={Anomaly detection is a cornerstone of modern intelligent systems, with critical applications in healthcare, cybersecurity, smart grids, and IoT environments. While traditional machine learning and deep learning models have shown promise in identifying outliers, they often face challenges such as dependence on large labeled datasets, high computational costs, and limited scalability to edge devices or high-dimensional data streams. This study introduces D2H-AD, a novel anomaly detection framework built upon Hyperdimensional Computing (HDC), a brain-inspired paradigm that encodes information using high-dimensional distributed vectors. Unlike prior HDC-based approaches, D2H-AD fuses distance-based similarity and density-aware encoding in a hybrid design, significantly improving anomaly characterization and detection accuracy. Ablation experiments confirm that hyperdimensional encoding alone contributes up to 5.4% higher ROC-AUC compared to applying the same density-distance scoring in the original Euclidean feature space, and D2H-AD consistently outperforms all five published baselines (HDAD, ODHD, One-Class SVM, Isolation Forest, and Autoencoders) across every evaluated dataset. The method is designed to be lightweight, interpretable, and computationally efficient, suggesting strong suitability for deployment in resource-constrained and real-time environments. To validate its effectiveness, we evaluate D2H-AD on five diverse benchmark datasets, comparing its performance against five leading techniques: HDAD, ODHD, One-Class SVM, Isolation Forest, and Autoencoders. Our results show that D2H-AD consistently achieves superior F1 scores and ROC-AUC metrics, demonstrating robustness against class imbalance, noise, and data complexity. Beyond accuracy, D2H-AD offers practical advantages including scalability, minimal memory footprint, and an expected low-latency profile derived from its binary operations and lightweight design. These characteristics are crucial for TinyML and edge AI applications. This work highlights the untapped potential of HDC for high-performance anomaly detection and opens new avenues for secure, interpretable, and energy-efficient AI solutions in dynamic environments such as IoT, embedded systems, and beyond. Additionally, D2H-AD provides feature-level interpretability through hypervector decoding, enabling transparent explanations for safety-critical applications.},
  keywords={Anomaly detection;Training;Real-time systems;Computational modeling;Noise;Computational efficiency;Vectors;Monitoring;Measurement;Encoding;Hyperdimensional computing;anomaly detection;density-based scoring;one-class classification;IoT security},
  doi={10.1109/ACCESS.2026.3677763},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11498799,
  author={Brito, Omar Dario Delgado},
  booktitle={2025 International Conference on Decision Aid Sciences and Applications (DASA)}, 
  title={Early Detection of Adverse Cardiac Events Using Intelligent Wearable Sensing and Edge-based Deep Learning Models}, 
  year={2025},
  volume={},
  number={},
  pages={1542-1546},
  abstract={Cardiovascular diseases (CVDs) remain the leading cause of mortality globally. Continuous, non-invasive monitoring presents a critical opportunity for the early detection of Adverse Cardiac Events (ACEs). This paper proposes a hierarchical edge-cloud architecture that leverages the ubiquity of wearable sensors, the analytical power of Deep Learning (DL), and the efficiency of Edge Computing for a proactive cardiac alert system. We design a two-tier framework: (1) A lightweight, 1D Convolutional Neural Network (CNN) optimized via TinyML principles is deployed on an edge device (e.g., a smartphone) for real-time analysis of Electrocardiogram (ECG) signals and initial anomaly detection. (2) Upon detection of a high-risk pattern, relevant ECG segments are offloaded to a cloud-based server where a more complex Long Short-Term Memory (LSTM) or Transformer-based model performs deep contextual analysis to confirm the threat and assess the risk level. This hybrid approach optimizes battery life, reduces response latency, and enhances patient privacy by minimizing raw data transmission. Experimental validation on the public MIT-BIH Arrhythmia Database demonstrates high classification accuracy for critical arrhythmias and showcases the system’s potential to revolutionize proactive cardiac telemedicine.},
  keywords={Filtering;Filters;Microcontrollers;Band-pass filters;Central Processing Unit;Active filters;Microprocessors;Application specific integrated circuits;Circuits and systems;Electronic circuits;Wearable Sensors;Internet of Things (IoT);Edge Computing;TinyML;Deep Learning;ECG;Arrhythmia Detection;Cardiovascular Disease},
  doi={10.1109/DASA68193.2025.11498799},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11371082,
  author={Dhumal, Shweta and Patil, Dipali and Firodiya, Nakul and Talokar, Gauri and Salunkhe, Vaishnavi and Mate, G.S.},
  booktitle={2025 2nd International Conference on Integration of Computational Intelligent System (ICICIS)}, 
  title={“CardioTrackGuard”: A Review on Machine Learning-Based Smart Wearable System for Cardiac Arrest Monitoring}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={A new version of smart wearable system for individual use presents itself while delivering a complete assessment of contemporary cardiac arrest tracking systems. The proposed system implements hybrid computing with machine literacy capabilities to provide immediate cardiac arrest detection and faster interventions by substituting slower cloud-processed mobile systems. On-device data processing takes place exclusively on the wearable device or the ESP32 and Jetson Nano and TinyML edge computing platforms because the system operates independently. The system delivers practical emergency applications because it improves data collection speed and minimizes internet dependency combined with superior energy performance through its independent operation. The paper presents both a description of the system components and decision framework while exploring present techniques alongside innovative technologies and health detectors. Explaining that immediate medical response remains vital while the investigation shows that automated anomaly detection operated by machines would boost cardiac arrest survival rates. The research utilizes Smart Wearable System technology to monitor cardiac arrests in real-time through Hybrid Computing with access to a mobile free solution.},
  keywords={Temperature sensors;Accelerometers;Cloud computing;Tiny machine learning;Cardiac arrest;Electrocardiography;Real-time systems;Biomedical monitoring;Wearable devices;Monitoring},
  doi={10.1109/ICICIS65613.2025.11371082},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11360947,
  author={binti Mohamad Affian, Iman Syuhadah and Bin Shibghatullah, Abdul Samad and Ali, Nor'ashikin},
  booktitle={2026 20th International Conference on Ubiquitous Information Management and Communication (IMCOM)}, 
  title={AI Adoption in Pipeline Security Monitoring: A Systematic Review of AIoT-Driven Honey Frameworks}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={As time goes by, it is undeniable that we are living in an era marked by the increasing convergence of Artificial Intelligence and the Internet of Things (AIoT) within industrial infrastructures, leading to new security vulnerabilities specifically in critical pipeline systems. Concurrently, deception-based defense mechanisms such as honeypots have shown strong potential in mitigating advanced cyber threats, presenting new opportunities to strengthen the security of such infrastructures. This paper presents a comprehensive review and thematic analysis of recent approaches that integrate AIoT and honeypot technologies to protect pipelines and related critical infrastructure. By surveying research published between 2019 and 2024, we categorize current frameworks based on architecture type, detection methodology, deployment environment and infrastructure domain. The objective of this study is to identify trends, highlight the underutilization of distribute AI frameworks and address the lack of context-aware threat adaptation in existing solutions. By synthesizing current contributions and research gaps, this review provides a structured understanding of the infrastructure protection. The results aim to inform future research directions and guide the development of resilient, intelligent security frameworks tailored to national pipeline systems.},
  keywords={Pipelines;Traffic control;Threat assessment;Critical infrastructure;Security;Internet of Things;Artificial intelligence;Monitoring;Anomaly detection;Testing;AIoT;Honeypot;Critical Infrastructure Security;Pipeline Infrastructure;Threat Detection;Deception Technology},
  doi={10.1109/IMCOM69009.2026.11360947},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{10247791,
  author={Dong, Yanchi and Jia, Tianyu and Du, Kaixuan and Jing, Yiqi and Wang, Qijun and Zhan, Pixian and Zhang, Yadong and Yan, Fengyun and Ma, Yufei and Liang, Yun and Ye, Le and Huang, Ru},
  booktitle={2023 60th ACM/IEEE Design Automation Conference (DAC)}, 
  title={A Model-Specific End-to-End Design Methodology for Resource-Constrained TinyML Hardware}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Tiny machine learning (TinyML) becomes appealing as it enables machine learning on resource-constrained devices with ultra low energy and small form factor. In this paper, a model-specific end-to-end design methodology is presented for TinyML hardware design. First, we introduce an end-to-end system evaluation method using Roofline models, which considering both AI and other general-purpose computing to guide the architecture design choices. Second, to improve the efficiency of AI computation, we develop an enhanced design space exploration framework, TinyScale, to enable optimal low-voltage operation for energy-efficient TinyML. Finally, we present a use case driven design selection method to search the optimal hardware design across a set of application use cases. Our model-specific design methodology is evaluated on both TSMC 22nm and 55nm technology for MLPerf Tiny benchmark and a keyword spotting (KWS) SoC design. With the help of our end-to-end design methodology, an optimal TinyML hardware can be automatically explored with significant energy and EDP improvements for a diverse of TinyML use cases.},
  keywords={Low voltage;Design automation;Design methodology;Computational modeling;Machine learning;Computer architecture;Benchmark testing;TinyML;Accelerator;Design space exploration},
  doi={10.1109/DAC56929.2023.10247791},
  ISSN={},
  month={July},}@INPROCEEDINGS{9909572,
  author={Brutti, Alessio and Paissan, Francesco and Ancilotto, Alberto and Farella, Elisabetta},
  booktitle={2022 30th European Signal Processing Conference (EUSIPCO)}, 
  title={Optimizing PhiNet architectures for the detection of urban sounds on low-end devices}, 
  year={2022},
  volume={},
  number={},
  pages={1121-1125},
  abstract={Sound Event Detection (SED) pipelines identify and classify relevant events in audio streams. With typical applications in the smart city domain (e.g., crowd counting, alarm triggering), SED is an asset for municipalities and law enforcement agencies. Given the large size of the areas to be monitored and the amount of data generated by the IoT sensors, large models running on centralised servers are not suitable for real-time applications. Conversely, performing SED directly on pervasive embedded devices is very attractive in terms of energy consumption, bandwidth requirements and privacy preservation. In a previous manuscript, we proposed scalable backbones from the PhiNets architectures' family for real-time sound event detection on microcontrollers. In this paper, we extend our analysis investigating how PhiNets' scaling parameters affect the model performance in the SED task while searching for the best configuration given the computational constraints. Experimental analysis on UrbanSound8K shows that while only the total number of parameters matters when training the model from scratch (i.e., it is independent of the scaling parameter configuration), knowledge distillation is more effective with specific scaling configurations.},
  keywords={Performance evaluation;Training;Analytical models;Event detection;Smart cities;Computational modeling;Computer architecture;Sound event detection;Neural Networks;PhiNets;tinyML},
  doi={10.23919/EUSIPCO55093.2022.9909572},
  ISSN={2076-1465},
  month={Aug},}@INPROCEEDINGS{11440513,
  author={Kumar, Binay Suna and Ujjainkar, Priyanka Anup and Yerpude, Sparsh and Kaul, Suneet and Qureshi, Abuzar and Ghonge, Soham},
  booktitle={2025 International Conference on Artificial Intelligence and Quantum Computation-Based Sensor Application (ICAIQSA)}, 
  title={WiFi + Bluetooth Scanning, Sniffing and Predictive Analysis of Malicious Packets using ESP32}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper presents a prototype for WiFi and Bluetooth scanning, sniffing, and predictive analysis of potentially malicious packets using the ESP32 DevKit V1. The system performs active scanning, passive sniffing, lightweight feature extraction, and on-device predictive inference for malicious-behavior detection. The hardware is low-cost, battery-powered and portable. The software stack is modular and supports offloading to the cloud for advanced analytics. Experiments demonstrate reliable discovery of access points and Bluetooth devices and feasible on-device inference times.},
  keywords={Performance evaluation;Bluetooth;Tiny machine learning;Prototypes;Hardware;Internet of Things;Predictive analytics;Wireless fidelity;Anomaly detection;Monitoring;ESP32;WiFi scanning;Bluetooth;packet sniffing;IoT security;on-device ML;TinyML},
  doi={10.1109/ICAIQSA67794.2025.11440513},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10457292,
  author={Zhou, Yikui and Wang, Jie and Tang, Junnan and Gou, Chao and Jiang, Zigui and Li, Dan and Ng, See-Kiong},
  booktitle={2023 International Conference on Artificial Intelligence of Things and Systems (AIoTSys)}, 
  title={MP-GAN: Cyber-Attack Detection and Localization for Cyber-Physical Systems with Multi-Process Generative Adversarial Networks*}, 
  year={2023},
  volume={},
  number={},
  pages={186-193},
  abstract={Cyber-Physical System (CPS) integrates sensing, computation, cybernetics, and networking to control a hybrid physical system consisting of different functional subsystems, making the production process more intelligent and controllable. However, cyber-attacks during its operation will lead to abnormal system behaviors or even system breakdowns. In recent years, data-driven anomaly detection methods have been adopted to judge whether the CPS system is under cyber-attacks based on rich sensor measurements to avoid further economic losses or safety issues. However, the multi-process essence of CPS has not been adequately addressed in existing works to locate the processes or points being attacked for in-time actions. In this work, we proposed a Multi-Process Generative Adversarial Network (MP-GAN) framework to detect anomalous CPS statuses and locate cyber-attacks. Specifically, the Long-Short-Term-Memory Recurrent Neural Networks (LSTM-RNN) was adopted as the base model to capture the temporal correlation of time series distributions, and the data was transferred between latent space and data space in a bi-directional manner, which regulated the generator to generate more realistic samples and thus better grasping the underline principles of the system. Moreover, parallel generators were employed to capture system performances at different physical processes, thus localizing the attacked CPS processes. Experiments on three CPS datasets, two collected from the Secure Water Treatment (SWaT) system and one collected from the water Distribution (WADI) system, showed that the proposed MP-GAN framework effectively reported anomalies caused by various cyber-attacks inserted in these complex multiprocess CPSs, which outperforms the state-of-the-art methods and can also locate most of the detected irregularities at the corresponding stages where the attacks were inserted.},
  keywords={Correlation;Time series analysis;Bidirectional control;Cyber-physical systems;Generative adversarial networks;Generators;Loss measurement;Cyber-Attack Detection and Localization;Cyber-Physical System;Generative Adversarial Networks;Multivariate Time Series},
  doi={10.1109/AIoTSys58602.2023.00049},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10539452,
  author={Hidalgo, Carlos Hernández and González-Vidal, Aurora and Skarmeta, Antonio F.},
  booktitle={2023 IEEE 9th World Forum on Internet of Things (WF-IoT)}, 
  title={Edge Computing in Smart Agriculture Scenario Based on TinyML for Irrigation Control}, 
  year={2023},
  volume={},
  number={},
  pages={01-08},
  abstract={Various regions around the world are encountering substantial difficulties as a result of arid conditions, vulnerability to climate change, and water shortages. These factors present significant obstacles to maintaining agricultural practices. Water stress resulting from limited water availability adversely affects crop growth and productivity. To tackle this pressing issue, the application of Tiny Machine Learning (TinyML) models for optimizing crop irrigation is proposed. TinyML involves implementing machine learning algorithms on resource-constrained devices, such as microcontrollers. By collecting and processing meteorological and crop data, a TinyML model has been trained to optimize irrigation practices and detect crop anomalies in real-time. This approach has the potential to revolutionize agricultural practices by enabling precise and efficient water management, even in remote environments. This work tackles the first steps to implementing TinyML algorithms for irrigation. We have computed the relationship between humidity and temperature changes with NDVI (Nor-malized Difference Vegetation Index) anomalies in crops to make predictions and make Intelligent decisions toward water usage.},
  keywords={Temperature measurement;Irrigation;Biological system modeling;Humidity measurement;Crops;Humidity;Water conservation;Climate change;Smart agriculture;TinyML;smart agriculture;irrigation},
  doi={10.1109/WF-IoT58464.2023.10539452},
  ISSN={2768-1734},
  month={Oct},}@INPROCEEDINGS{11374930,
  author={Ganapathy, Jayanthi and Nachiappan, Nachiappan and Menakur, Sreevijnya and Ramachandran, Purushothaman},
  booktitle={TENCON 2025 - 2025 IEEE Region 10 Conference (TENCON)}, 
  title={iTRAC: Intelligent Tracking and Real-Time Analysis on Cloud Using RFID and MQTT}, 
  year={2025},
  volume={},
  number={},
  pages={1683-1687},
  abstract={This research explores real-time monitoring of diverse assets using AIoT, leveraging edge-cloud collaboration for enhanced responsiveness and intelligence. RFID sensors are employed to validate edge computing functionality in tracking and anomaly detection. RFID tag reads are processed on the edge, which collect temporal data such as tag frequency and signal strength with precise timestamps to identify irregularities. A compound AI system integrates an LSTM model for data encoding and normalization, and an Isolation Forest for outlier detection on critical features. These models are containerized using Docker to enable consistent deployment across edge devices and cloud platforms. Processed RFID data is transmitted from a Raspberry Pi to a private OpenStack cloud via MQTT using QoS level 1, ensuring reliable, low-latency anomaly reporting. A lightweight dashboard interface enables real-time visualization and monitoring of anomalies. The proposed system architecture was evaluated on real time asset tracking using RFID and the machine learning workflow was trained using three setups 1. LSTM has shown an F1 score: 0.84, 2. Isolation forest has shown F1 score: 0.87, and 3. LSTM + Isolation Forest has shown F1 score: $\mathbf{0. 8 4}$. The hybrid model balanced both, making it suitable for real-time RFID anomaly detection. The system is scalable, secure, and adaptable for applications in logistics, healthcare, and industrial asset tracking.},
  keywords={Image edge detection;Supply chains;Forestry;Machine learning;Real-time systems;RFID tags;Low latency communication;Long short term memory;Anomaly detection;Edge computing;OpenStack;AIoT;Machine Learning;Edge Computing;RFID},
  doi={10.1109/TENCON66050.2025.11374930},
  ISSN={2159-3450},
  month={Oct},}@ARTICLE{10948425,
  author={de la Fuente, Raúl and Radrigan, Luciano and Morales, Anibal S.},
  journal={IEEE Access}, 
  title={Enhancing Predictive Maintenance in Mining Mobile Machinery Through a Hierarchical Inference Network}, 
  year={2025},
  volume={13},
  number={},
  pages={59480-59504},
  abstract={Mining mobile machinery in non-stationary operations faces high levels of wear and unpredictable stress, posing significant challenges for predictive maintenance (PdM). This paper introduces a hierarchical inference network for PdM consisting on edge sensor devices, gateways, and cloud services for real-time condition monitoring. The system dynamically can adjusts inference locations – on-device, on-gateway, or on-cloud – based on trade-offs between real-time demands and conditions such as accuracy, latency, and battery range. The edge-based architecture enables rapid decision-making directly on-sensor or on-gateway, achieving classification accuracies above 90% while reducing latency up to 30% and power consumption on sensor nodes by approximately 45% regarding the cloud inference mode. This is critical to ensure machinery uptime in remote, rugged environments. The use of Tiny-Machine-Learning (TinyML) optimization approaches allow optimal accuracy and model compression for efficient deployment of deep learning models on IoT edge devices with limited hardware resources. The ESN-PdM hierarchical framework offers a scalable and adaptive solution for reliable condition monitoring and anomaly detection, contributing to advancing technology in PdM frameworks for real-world industrial applications.},
  keywords={Logic gates;Internet of Things;Computer architecture;Machinery;Cloud computing;Wireless sensor networks;Tiny machine learning;Accuracy;Real-time systems;Condition monitoring;Internet of Things;edge computing;cloud computing;deep learning;TinyML;heavy machinery;predictive maintenance},
  doi={10.1109/ACCESS.2025.3557405},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9365816,
  author={Wang, Zhixuan and Ye, Le and Liu, Ying and Zhou, Peng and Tan, Zhichao and Fan, Haitao and Zhang, Yihan and Ru, Jiayoon and Wang, Yangyuan and Huang, Ru},
  booktitle={2021 IEEE International Solid-State Circuits Conference (ISSCC)}, 
  title={12.1 A 148nW General-Purpose Event-Driven Intelligent Wake-Up Chip for AIoT Devices Using Asynchronous Spike-Based Feature Extractor and Convolutional Neural Network}, 
  year={2021},
  volume={64},
  number={},
  pages={436-438},
  abstract={Power is a major bottleneck in AIoT devices, which usually operate in random-sparseevent (RSE) scenarios [1] (Fig. 12.1.1, bottom). To process RSEs energy-efficiently, one can integrate an always-on wake-up chip [1] –[5] that only turns on the power-hungry high-performance system (HPS) once valid events are detected. Previous dedicated voice-activity-detection (VAD) wake-up chips using analog front-ends (AFE) followed by neural-network (NN) circuits consume $1 \mu \mathrm{W}$ [2] and 142nW [3]. Keyword spotting (KWS) wake-up, which is more complicated than VAD, can be achieved by an NN engine at 510nW [4], but it needs an off-chip power-hungry 16b ADC to drive its digital input. For general purpose, an event-driven wake-up chip [1] consumes 57nW. But without an intelligent inference engine (IIE), false detection due to invalid events will consume excessive power. The IIE can be realized by a finite-state-machine (FSM) pattern recognition circuit but with massive $2.2 \mu \mathrm{W}$ [5]. This work, to our best knowledge, presents a first reported event-driven intelligent wake-up chip that achieves ultra-low power and intelligent event detection for various AIoT RSEs.},
  keywords={Knowledge engineering;Event detection;Feature extraction;Solid state circuits;Pattern recognition;Low-power electronics;Engines},
  doi={10.1109/ISSCC42613.2021.9365816},
  ISSN={2376-8606},
  month={Feb},}
@INPROCEEDINGS{11454174,
  author={Sinha, Shrutika and Park, Soo-Hyun},
  booktitle={2026 International Conference on Artificial Intelligence in Information and Communication (ICAIIC)}, 
  title={On-Device AI for Maritime Communication: Trends, Challenges, and a Simulation-Only Case Study}, 
  year={2026},
  volume={},
  number={},
  pages={912-916},
  abstract={This paper reviews key challenges and emerging trends in On-Device AI, including model efficiency, energy constraints, and communication computation trade-offs in edge systems. Emerging directions such as TinyML, lightweight training, and hardware-aware optimization are discussed. In addition to the survey, a simulation case study is given in which an on-device representation of reinforcement learning is used to select adaptive Wi-Fi/LTE links using the relaying maritime environment with battery and channel variability. The findings have shown that learning-based policies are able to offer contextdependent decision-making as opposed to fixed heuristics and that On-Device AI has a potential in the future to be used in wireless and resource-constrained settings.},
  keywords={Wireless communication;Training;Surveys;Tiny machine learning;Reinforcement learning;Market research;Batteries;Artificial intelligence;Optimization;Maritime communications;Edge AI;NTN;On-Device AI;Reinforcement Learning},
  doi={10.1109/ICAIIC68212.2026.11454174},
  ISSN={2831-6983},
  month={Feb},}@INPROCEEDINGS{11547919,
  author={Dharani, M.K. and Abdullayeva, Mukhtasarkhon and M S, Muneshwara and Mamadiyarov, Zokir and Nasretdinova, Feruza and Latipova, Mukhayyo},
  booktitle={2025 International Conference on Emerging Engineering Technologies and Applications (IC-EETA)}, 
  title={Machine Learning-Driven Lightweight Protocol for Energy-Efficient IoT Communication}, 
  year={2025},
  volume={},
  number={},
  pages={494-500},
  abstract={The Internet of Things (IoT) ecosystems have grown at a very high rate and this has increased the demand of energy-efficient and scalable communication protocols especially in smart grid and advanced metering infrastructure (AMI) applications. Because of their high energy consumption, latency bottlenecks and lack of adaptability, traditional IoT communication techniques like MQTT, CoAP as well as heuristic duty cycling are frequently inappropriate for large-scale installations. The hybrid multi-layered system proposed in this research integrates Bayesian Optimisation (BO) at the cloud level, Federated Reinforcement Learning (FRL) in the gateway level and Tiny Machine Learning (TinyML) on the node level to overcome these limitations. The methodology uses TinyML to reduce duplicate data transmissions by predicting local usage and detecting anomalies. While cloud-based Bayesian Optimisation constantly adjusts hyperparameters like learning rates along with duty cycles to maintain the network running efficiently, gateways use FRL to learn the most effective way to schedule transmissions in a way that reduces latency while maximising energy savings. AMI data was used to compare the proposed method to standard protocols and centralised machine learning models. Contrasting experimental findings to traditional approaches, it is shown that there is a 30% decrease in bandwidth, a 45% reduction in energy and an improvement in latency performance. The findings underline that diffusion of intelligence across the IoT hierarchy enables scalable, versatile and energy efficient communication besides safeguarding of privacy, as well as cut in communication overhead. This study opens the way to more sustainable IoT infrastructure of smart cities and manufacturing systems.},
  keywords={Internet of Things;Modeling;Optimization;Protocols;Energy efficiency;Machine learning;Tiny machine learning;Clouds;Energy;Schedules;Internet of Things;Communication Protocol;Energy Consumption;Privacy;Bayesian Optimisation},
  doi={10.1109/IC-EETA66496.2025.11547919},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11196733,
  author={Priya, Kilari Ram and Khemraj, Ikhar Avinash and Gupta, Sudeep Kumar and Obbayed, Saif and Singh, K. Ranjith and Yajaman, Gummagatta Vybhavi},
  booktitle={2025 International Conference on Metaverse and Current Trends in Computing (ICMCTC)}, 
  title={Edge Computing Powered Embedded Vision System for Real-Time Industrial Automation and Fault Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Embedded vision systems in real time are powered by edge computing, which allows low latency processing and intelligence decision making, enhanced operational efficiency, and have transformed the industrial automation and fault detection. To address this problem, this research presents a novel embedded vision where edge computing is integrated with deep learning based fault detection to enhance the manufacturing accuracy and reduce downtime. The actionable anomalies in the system are detected using transformer-based vision models and self-supervised learning with little labeled data alongside ultra-low latency vision sensors based on event sensing. The federated learning is made to run on top of the continuous model optimization using a hybrid edge cloud architecture that achieves defect recognition over time. Moreover, TinyML energy efficiency and adaptive compression reduces computational overhead to make the system extremely scalable and deployable in several industrial settings. A tamper-proof log and homomorphic encryption based blockchain ensures secure data management of sensitive industrial information. Experimental validation shows that proposed system achieves higher fault detection accuracy, lower latency and better energy efficiency than industrial vision systems commonly used in the industry. The proposed system improves predictive maintenance, quality control, resource utilization in the automotive, electronics, and pharmaceutical industries. This research proposes an advanced framework that advances industrial automation concerning challenges in real-time processing, security, and adaptability for providing smarter, faster, and more reliable fault detection in next generation smart manufacturing environments.},
  keywords={Deep learning;Automation;Accuracy;Federated learning;Fault detection;Machine vision;Computational modeling;Energy efficiency;Real-time systems;Edge computing;Embedded;edge computing;decision making;deep learning;energy efficiency;accuracy},
  doi={10.1109/ICMCTC62214.2025.11196733},
  ISSN={},
  month={April},}@INPROCEEDINGS{11416175,
  author={Karamzadeh, B. and Knights, P. and Kizil, M.S.},
  booktitle={2025 IEEE Annual Congress on Artificial Intelligence of Things (AIoT)}, 
  title={Fast Correlation With Rolling Windows Via Clustering for Predictive Maintenance}, 
  year={2025},
  volume={},
  number={},
  pages={685-689},
  abstract={Effective predictive maintenance in mining depends on accurately understanding sensor correlations. Correlation discovery is complex due to noise, non-stationarity, and the lack of labelled failure data in mining datasets. This research focuses on a novel clustering approach that explains sensor relationships by identifying similar transition patterns across clusters of recent time-series measurements, which eliminates the dependency on full statistical correlation and historical failure labels. The dataset used consists of chemical analysis of oil samples from mining equipment, and the most recent time-series windows were used as input for clustering algorithms such as DBSCAN, K-Means, and Agglomerative Clustering. In addition, Dynamic Time Warping (DTW) was used to align signals that occur at different shifts and identify similar patterns. Results from the cluster transition patterns are used to represent functional signs of correlated behavior and serve as training data for supervised machine learning models, such as Long Short-Term Memory (LSTM) and Random Forest, for early fault detection. The proposed methodology combines robust data preprocessing stages, including data cleaning and handling class imbalance using techniques like the Synthetic Minority Over-sampling Technique (SMOTE), to properly learn from minority fault events. Performance evaluation metrics, such as the F1 score, recall, and precision, demonstrate the strength of the proposed correlation-driven method and its ability to improve predictive maintenance in mining activities.},
  keywords={Correlation;Oils;Data preprocessing;Mining equipment;Data models;Data mining;Internet of Things;Long short term memory;Random forests;Predictive maintenance;Predictive Maintenance;Sensor Correlation;Time-Series Clustering;Data Analytics;Mining Equipment Condition Monitoring;Class Imbalance Handling},
  doi={10.1109/AIoT66900.2025.00105},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11431962,
  author={Mehta, Dev and Pathak, Lakshin and Jain, Mahek and Vyas, Karm and Dharaiya, Ayush and Gupta, Rajesh and Tanwar, Sudeep and Rodrigues, Joel J. P. C.},
  booktitle={GLOBECOM 2025 - 2025 IEEE Global Communications Conference}, 
  title={AarogyaLLM: LLM Guided DL Framework for Smart Telesurgery Systems in Healthcare with 6G}, 
  year={2025},
  volume={},
  number={},
  pages={350-355},
  abstract={Intrusion detection in self-regulating manufacturing requires light yet precise modes to do real-time threat prevention. The performance of TinyML, 1D-CNN, GRU, and LSTM models is tested based on different metrics in this research. TinyML works better than all models with 97% accuracy and log-loss as low as 1.2, which is an indication of confident predictions. One of the significant aspects of TinyML is improved accuracy, and decreased sensitivity, with increased false negative and false positive rates also making it more useful in resource-constrained areas. For natural language generation tasks, Mixtral 8x7B 32768 shows the highest BLEU score of 0.60 and METEOR score of 0.86, reflecting its high similarity with reference outputs. It also scores the highest in ROUGE-1 (0.77) and ROUGE-2 (0.75), providing high-quality phrase-level recall. These results confirm that TinyML is the most effective for intrusion detection, while Mixtral 8x7B 32768 excels in text generation tasks.},
  keywords={Accuracy;Sensitivity;Tiny machine learning;Prevention and mitigation;Natural language generation;Intrusion detection;Predictive models;Real-time systems;Manufacturing;Meteors;Intrusion Detection;TinyML;Deep Learning;BLEU Score;METEOR Score;ROUGE Score;Automated Manufacturing;Natural Language Generation},
  doi={10.1109/GLOBECOM59602.2025.11431962},
  ISSN={2576-6813},
  month={Dec},}@INPROCEEDINGS{11298760,
  author={de Matos, Dejair José and Gurtov, Andrei and Dos Santos de Souza, Flavio Luiz and Teixeira, Marcio Andrey and Pereira, Lourenco Alves and Ribeiro, Carlos Henrique Costa},
  booktitle={2025 IEEE 5th International Conference on Smart Information Systems and Technologies (SIST)}, 
  title={AIoT-Driven Smart Water Monitoring: A Solution Towards Sustainable Resource Management}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Effective water management is essential for ensuring sustainability, reducing resource waste, and addressing challenges such as water scarcity and pollution. This paper presents an Artificial Intelligence of Things (AIoT) driven smart water monitoring system, integrating Internet of Things (IoT) technologies and machine learning (ML) to optimize water consumption and detect anomalies in real-time. Implemented at the IFSP Catanduva Campus in Brazil, the system monitors key water parameters, identifies irregularities like leaks, and enables proactive management through data-driven decision-making. Case studies demonstrate its effectiveness, showcasing improvements such as swift leak detection, reduced response times, and operational cost savings. The system achieved an F1-score of 97.3\% using a Random Forest classifier, highlighting its performance in anomaly detection. Despite minor data variability and network reliability challenges, the scalable design offers adaptability to other institutions and urban environments.},
  keywords={Costs;Decision making;Urban areas;Water quality;Water pollution;Internet of Things;Water monitoring;Resource management;Leak detection;Sustainable development;Sustainable water management;IoT;Machine learning;AIoT;Leak detection},
  doi={10.1109/SIST61657.2025.11298760},
  ISSN={},
  month={May},}@INPROCEEDINGS{11186607,
  author={Abozaid, Omar and Selim, Bassant and Jaumard, Brigitte},
  booktitle={2025 International Telecommunications Conference (ITC-Egypt)}, 
  title={Adaptive Embedded Machine Learning on IoT Devices: A Review}, 
  year={2025},
  volume={},
  number={},
  pages={553-560},
  abstract={Embedded Machine Learning (EML) refers to the ability of machine learning models deployed on resource-constrained Internet of Things (IoT) devices to maintain performance over time by adjusting to evolving data distributions and operating conditions. Unlike static models, adaptive EML enables IoT devices to cope with the challenges of dynamic environments, such as concept drift, changing user behavior, and environmental conditions variability. This survey provides a focused overview of recent efforts to enable adaptation in EML, exploring different approaches from system-level strategies like over-the-air (OTA) model update or by directly enabling on-device training of Machine learning (ML) models. We also highlight different learning paradigms, including online learning, continual learning, and meta-learning, that shall improve adaptability in EML. This work synthesizes representative advances in the field and aims to raise awareness of adaptability as a critical but underexplored dimension of EML research. By highlighting key gaps, such as limited time-series adaptation and lack of standardized evaluation, the paper encourages deeper investigation into adaptive mechanisms to support the continued growth of intelligent, resilient, and reliable IoT systems.},
  keywords={Training;Surveys;Adaptation models;Adaptive systems;Wireless networks;Tiny machine learning;Concept drift;Machine learning;Telecommunications;Internet of Things;embedded machine learning;TinyML;on-device training;edge computing;adaptive IoT},
  doi={10.1109/ITC-Egypt66095.2025.11186607},
  ISSN={},
  month={July},}@INPROCEEDINGS{11087822,
  author={Rüb, Marcus and Rüb, Michael and Sikora, Axel},
  booktitle={2025 IEEE 8th International Conference on Industrial Cyber-Physical Systems (ICPS)}, 
  title={Sparse Forward-Forward Algorithm: Efficient Machine Learning for Resource-Constrained Edge Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Deploying machine learning models on resource-constrained edge devices, such as microcontroller, is central to EdgeML. However, traditional training algorithms like backpropagation are computationally intensive and energy demanding. We propose the Sparse Forward-Forward (SFF) Algorithm, a novel training approach that reduces computational effort by selectively processing only the top-$k$ most significant activations during training, maintaining accuracy while improving efficiency. We evaluate SFF on five benchmark datasets—MNIST, Fashion MNIST, Human Activity Recognition (HAR), Speech Commands, and Flower—against backpropagation (BP) and the standard Forward-Forward (FF) algorithm. Results show that SFF achieves comparable accuracy with substantial efficiency gains: up to $20 \times$ lower effort than BP on MNIST and up to $61 \times$ on the Flower dataset, demonstrating its suitability for energy-constrained edge scenarios. SFF offers a trade-off between performance and resource usage. It is well-suited for scalable EdgeML and Industrial Cyber-Physical Systems (ICPS), where local adaptability and low-latency learning are essential.},
  keywords={Training;Backpropagation;Machine learning algorithms;Accuracy;Tiny machine learning;Speech recognition;Flowering plants;Cyber-physical systems;Human activity recognition;Standards;Tinyml;On-device training;Edge AI},
  doi={10.1109/ICPS65515.2025.11087822},
  ISSN={2769-3899},
  month={May},}@ARTICLE{11480846,
  author={Nguyen, Viet Linh and Chu, Duy Lanh and Nguyen, van Huy},
  journal={IEEE Access}, 
  title={From Dataset to Deployment: A Full-Stack Autoencoder-Based Anomaly Detection Pipeline for Gas Turbine BLDC Fuel Pumps}, 
  year={2026},
  volume={14},
  number={},
  pages={58103-58122},
  abstract={Reliable health monitoring of fuel pumps is essential for maintaining the stability and safety of gas turbine engines. Brushless DC (BLDC) fuel pumps operate under tightly coupled electrical–mechanical–hydraulic dynamics, where fault progression is often subtle and real fault data are scarce. This article presents a full-stack anomaly detection pipeline spanning dataset construction, feature engineering, model development, evaluation, and embedded deployment, built on an unsupervised autoencoder trained exclusively on normal operating data. A real-world dataset was collected from BLDC fuel pumps integrated into gas turbine testbeds over multiple engines and years; however, the available corpus remains modest, comprising 18 log files and nearly three hours of cumulative operation. A 48-dimensional handcrafted feature set was designed to capture statistical, energetic, derivative, and autocorrelation characteristics of pump behavior. The autoencoder learns a compact representation of healthy operation, while anomalies are identified through reconstruction error using a fixed threshold and a persistence-based decision rule. In offline analysis, the proposed autoencoder achieves competitive discrimination relative to strong unsupervised baselines, while its primary practical advantage lies in supporting a deterministic end-to-end TinyML deployment pipeline rather than maximizing offline discriminative performance alone. Real-time on-device experiments on an STM32 platform demonstrate successful detection for the evaluated dry-run and aeration scenarios, while no alarms are produced under normal steady and transient tests after persistence filtering. Under the current feature set and calibration, the evaluated partial-blockage and gradual-restriction scenarios did not produce persistence-triggered alarms, indicating incomplete fault-mode coverage and motivating future work on broader fault characterization and adaptive calibration. These results support the practical feasibility of real-time, on-device anomaly detection for gas-turbine fuel-pump monitoring in a resource-constrained TinyML setting.},
  keywords={Telemetry;Aerospace and electronic systems;Aircraft propulsion;Microcontrollers;Microprocessors;Filtering;Filters;Integrated circuits;Radio access networks;Regional area networks;Autoencoder;anomaly detection;BLDC fuel pump;gas turbine engines;condition monitoring;TinyML;embedded systems},
  doi={10.1109/ACCESS.2026.3683502},
  ISSN={2169-3536},
  month={},}@ARTICLE{11244116,
  author={Tightiz, Lilia and Minh Dang, L. and Park, Ki-Woong},
  journal={IEEE Internet of Things Journal}, 
  title={AIoT-Blockchain Security for Supply Chain Threats in IEC 61850 Substations Using Informer-Powered Reinforcement Learning}, 
  year={2026},
  volume={13},
  number={2},
  pages={3138-3155},
  abstract={IEC 61850 substations enable fast-speed digital communication among intelligent electronic devices (IEDs) for power system automatic control, monitoring, and protection. Their remote configurability and interoperability, however, make them vulnerable to highly advanced cyberattacks, mainly supply chain attacks. While existing methods, such as intrusion detection systems (IDSs) and machine learning (ML)-based anomaly detection, provide partial protection, they often lack resilience against evolving attacks and real-time mitigation capabilities. We present an Artificial Intelligence of Things (AIoT)–blockchain security framework that uses Informer-augmented proximal policy optimization (PPO) for adaptive cyber defense, along with Hyperledger Fabric, for tamper-proof and automated security enforcement. The novelty of the proposed framework over state-of-the-art research lies in its combination of anomaly detection, dynamic threat mitigation, and auditable policy execution. Our security tests demonstrate robustness against zero-day and synthetic adversarial attacks while preserving privacy and integrity. Experimental findings demonstrate that Informer-PPO attains 98.4% detection accuracy and 35-ms response time, representing improvements of 3.6%, 5.0%, and 9.1% in accuracy and 32.7%, 51.4%, and 63.2% faster response time compared to Transformer-PPO, long short-term memory (LSTM)-PPO, and convolutional neural network (CNN)-PPO baselines, respectively. Blockchain-enabled policy enforcement is accomplished within 42–50 ms, facilitating scalable real-time protection for IEC 61850 substations.},
  keywords={Substations;Security;IEC Standards;Real-time systems;Blockchains;Prevention and mitigation;Anomaly detection;Supply chains;Accuracy;Computer security;Blockchain;cybersecurity;IEC 61850;Informer;proximal policy optimization (PPO);smart grid;supply chain security},
  doi={10.1109/JIOT.2025.3632117},
  ISSN={2327-4662},
  month={Jan},}@ARTICLE{11235988,
  author={Jia, Yunjian and Liu, Zirui and Wen, Wanli and Li, Qingqing and Liang, Liang},
  journal={IEEE Internet of Things Journal}, 
  title={Personalized Federated Learning for Cross-Area Vehicle Trajectory Anomaly Detection}, 
  year={2025},
  volume={12},
  number={24},
  pages={55957-55960},
  abstract={Advancements in Augmented Intelligence of Things (AIoT) have made vehicle trajectory anomaly detection essential for road safety and traffic efficiency. However, the privacy-sensitive nature of trajectory data results in regional data silos, limiting model generalization. Federated learning (FL) enables collaborative training without data sharing, but still struggles with data heterogeneity and synchronous update inefficiencies in real-world scenarios. To address these challenges, we propose a personalized FL scheme for trajectory anomaly detection, named pFedVTAD. It introduces a mutual-distillation module that uses a messenger model to bidirectionally transfer knowledge between the global and personalized models, producing area-aligned personalized models via adaptive local distillation. It also presents a privacy-preserving asynchronous aggregation that combines differential privacy, a model bank, and threshold-triggered merging to balance privacy and communication efficiency under partial participation and asynchronous arrivals. Experiments on a public trajectory dataset show that under asynchronous updates, pFedVTAD yields a well-generalized global model and area-tailored personalized models, demonstrating strong deployability in dynamic cross-area AIoT settings.},
  keywords={Computational modeling;Data models;Trajectory;Anomaly detection;Servers;Adaptation models;Training;Internet of Things;Federated learning;Privacy;Asynchronous aggregation;mutual distillation;personalized federated learning (FL);vehicle trajectory anomaly detection},
  doi={10.1109/JIOT.2025.3630712},
  ISSN={2327-4662},
  month={Dec},}@ARTICLE{10509631,
  author={Xu, Lijuan and Han, Ziyu and Zhao, Dawei and Li, Xin and Yu, Fuqiang and Chen, Chuan},
  journal={IEEE Transactions on Sustainable Computing}, 
  title={Addressing Concept Drift in IoT Anomaly Detection: Drift Detection, Interpretation, and Adaptation}, 
  year={2024},
  volume={9},
  number={6},
  pages={913-924},
  abstract={Anomaly detection plays a vital role as a crucial security measure for edge devices in Artificial Intelligence and Internet of Things (AIoT). With the rapid development of IoT (Internet of Things), changes in system configurations and the introduction of new devices can lead to significant alterations in device relationships and data flows within the IoT, thereby triggering concept drift. Previously trained anomaly detection models fail to adapt to the changed distribution of streaming data, resulting in a high number of false positive events. This paper aims to address the issue of concept drift in IoT anomaly detection by proposing a comprehensive Concept Drift Detection, Interpretation, and Adaptation framework (CDDIA). We focus on accurately capturing the concept drift of normal data in unsupervised scenarios. To interpret drift samples, we integrate a search optimization algorithm and the SHAP method, providing a comprehensive interpretation of drift samples at both the sample and feature levels. Simultaneously, by utilizing the sample-level interpretation results for filtering new and old samples, we retrain the anomaly detection model to mitigate the impact of concept drift and reduce the false positive rate. This integrated strategy demonstrates significant advantages in maintaining model stability and reliability. The experimental results indicate that our method outperforms five baseline methods in adaptability across three datasets and provides interpretability for samples experiencing concept drift.},
  keywords={Adaptation models;Internet of Things;Data models;Anomaly detection;Error analysis;Training;Random forests;Concept drift;interpretability;anomaly detection;IoT},
  doi={10.1109/TSUSC.2024.3386667},
  ISSN={2377-3782},
  month={Nov},}@INPROCEEDINGS{11337752,
  author={Penner, Kevin and Wittenfeld, Felix and Hesse, Marc and Thies, Michael},
  booktitle={2025 IEEE 21st International Conference on Body Sensor Networks (BSN)}, 
  title={Into the Wild: Reliable Physiological Sensing with on-Device Autoencoder-Based Anomaly Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Pushing physiological sensing into the wild: this work equips our ultra-low-power physiological BI-Vital sensor with an int8-quantized autoencoder that produces a real-time signal-quality index (SQI) for electrocardiograms (ECG) beside standard heart rate computations. The supervised model, trained on PhysioNet CinC2017 and three newly annotated BI-Vital single-lead ECG datasets, combines a compact encoder-decoder with a lightweight classifier head. On the STM32L476JE microcontroller from BI-Vital, the model uses 31 kB of RAM and 85 kB of flash memory, completes inference in 195 ms and still leaves room for parallel sensor services. Across eight train/test splits the approach generalizes well, reaching an F1 score of 0.988 while maintaining $2 \cdot 10^{-3}$ performance loss after quantization. By converting raw continuous ECG data into periodic heart rate and SQI recordings, storage space on the device is reduced by 99.6%, demonstrating a practical way for reliable, data-efficient monitoring outside the laboratory.},
  keywords={Heart rate;Quantization (signal);Autoencoders;Electrocardiography;Real-time systems;Recording;Sensors;Reliability;Biomedical monitoring;Monitoring;wireless body sensor;wearable;autoencoder;ecg anomaly;signal quality index (SQI);ultra-low-power microcontroller;TinyML;on-device inference},
  doi={10.1109/BSN66969.2025.11337752},
  ISSN={2376-8894},
  month={Nov},}@INPROCEEDINGS{11538700,
  author={Sassi, Hajar and Jbari, Atman and Laaziz, El Hassan},
  booktitle={2026 6th International Conference on Innovative Research in Applied Science, Engineering and Technology (IRASET)}, 
  title={An AIoT-Enabled Framework for Resilient Healthcare Supply Chains: Bridging Technology Gaps through Intelligent Integration}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={The healthcare supply chain is crucial for ensuring that medicines, vaccines and medical equipment are readily accessible, of high quality, and delivered on time. However, it faces long-standing issues such as limited visibility, ineffective inventory management, broken cold chains, and risks of product wastage and fraud. The convergence of artificial intelligence (AI) and the Internet of Things (IoT), referred to as AIoT, offers significant potential to transform supply chains into intelligent, data-driven networks. In this paper, we conduct a structured literature review of existing AIoT applications in healthcare logistics and identify nine key research gaps concerning interoperability, scalability, security, and organisational deployment. We propose a conceptual multi-layered AIoT framework comprising four integrated layers, namely IoT sensing, secure data management, AI-driven analytics, and application interfaces, designed to address these gaps. To illustrate the framework’s applicability, we present a scenariobased analysis of vaccine supply chain management, demonstrating how AIoT integration can improve visibility, resilience, and operational efficiency. This work establishes a theoretical foundation for future implementation and empirical validation of AIoT-enabled healthcare supply chains.},
  keywords={Internet of Things;Supply chains;Medical services;Artificial intelligence;Printing;Vaccines;Optimization;Resilience;Real-time systems;Reviews;Artificial Intelligence;Internet of Things;AIoT;Healthcare Supply Chain;Smart Logistics;Predictive Analytics;Digital Transformation;Conceptual Framework},
  doi={10.1109/IRASET68627.2026.11538700},
  ISSN={},
  month={May},}@INPROCEEDINGS{11280883,
  author={Sharma, Sonam and Bhardwaj, Krishna and Somani, Yash and Gupta, Jashan},
  booktitle={2025 IEEE International Conference on Advances in Computing Research On Science Engineering and Technology (ACROSET)}, 
  title={Predicting Network Condition Events using Supervised Machine Learning and Network Analysis Techniques}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Optimal operation and downtime are essential challenges to be addressed. This study demonstrates a predictive framework for network condition events based on supervised machine learning and network analytics methods. Historical network data, traffic behavior, and topological information are employed in the method proposed to realize potential failures, congestion areas, and anomalies. Decision trees, support vector machines (SVM), and deep learning models are compared for prediction. In addition, network graph analysis is utilized to augment feature extraction and enhance the accuracy of event classification. Experimental results show that combining network analysis with supervised learning improves early detection of problematic network conditions, which allows proactive mitigation techniques. The research offers a solid framework for network operators to maximize performance, minimize downtime, and provide flawless connectivity.},
  keywords={Support vector machines;Analytical models;Accuracy;Computational modeling;Tiny machine learning;Supervised learning;Network analyzers;Machine learning;Predictive models;Traffic control;Network condition prediction;supervised machine learning;network analysis;anomaly detection;traffic pattern analysis;graph-based learning;predictive modeling;network optimization},
  doi={10.1109/ACROSET66531.2025.11280883},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11189781,
  author={Syed, Abrar Ahmed and Mohammed, Abdul Sajid and Ahmed, Shakeel and Mamodiya, Udit},
  booktitle={2025 International Conference on Computing, Intelligence, and Application (CIACON)}, 
  title={A Scalable Serverless Framework for Real-Time Analytics of Remote Patient Monitoring IoT Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The exponential growth of IoT-equipped remote patient monitoring (RPM) systems has generated enormous amounts of real-time health data with immense challenges related to latency, scalability, and cost of operation. Conventional cloud-based analytical platforms tend to be plagued with high overheads, sluggish response times, and inflexibility, rendering them inappropriate for critical healthcare applications. This research puts forward (SHEAF) Serverless Health Edge Analytics Framework, a light, scalable, and affordable Serverless architecture that is tailored for real-time data processing and analysis of health information from RPM IoT devices. The architecture uses MQTT for communication at the device level, Kafka for high-volume data ingestion, and AWS Lambda as the Serverless compute engine to analyze data streams in real time. On-site filtering and simple anomaly detection are done by an optional TinyML module embedded on edge devices, reducing transmission burden. Predictive analytics with light LSTM models are embedded in Serverless functions to identify anomalies and trigger alerts. Based on simulated trials with synthetic patient data, they exhibited a reduction of 40–60% in latency, 92–95% correct prediction of the occurrence of important events, and a 30% reduction of bandwidth consumption versus standard cloud systems. Moreover, the system held consistent performance using more than 1000 connections simultaneously on a device, confirming good scalability. Its Serverless core presents a low-latency, low-cost, and high-performance proposition against conventional frameworks, making it particularly well suited for under provisioned or rural health networks.},
  keywords={Patient monitoring;Tiny machine learning;Scalability;Medical services;Computer architecture;Real-time systems;Internet of Things;Time factors;Long short term memory;Standards;Serverless computing;Remote Patient Monitoring;IoT healthcare;Real-time analytics;MQTT;AWS Lambda;TinyML;LSTM;Edge AI},
  doi={10.1109/CIACON65473.2025.11189781},
  ISSN={},
  month={July},}@INPROCEEDINGS{11564282,
  author={Kalaichelvi, S and Anitha, S and Arunkumar, V and Sabitha, S and Thevatharsini, Ts and Ashuya, V},
  booktitle={2026 International Conference on AI-Driven Innovations & Applications (IC-AIDA)}, 
  title={A Green Edge-Cloud Hybrid Platform with Voice-Enabled Emergency Alerts for Real- Time Analytics in Disaster-Resilient Micro grid}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Areas susceptible to natural disasters experience recurring interruptions in power supply, wherein conventional centralized cloud designs falter with network latency, connectivity reliance, and excessive power consumption. To overcome such constraints, the present work introduces a greener green edge-cloud collaborative architecture that combines TinyML- enabled edge devices with a cloud platform supported by renewable energy sources. The edge layer provides real-time local anomaly detection and monitoring, guaranteeing autonomous operation in the event of connectivity outage, while the cloud utilizes LSTM models for short-term and long-term demand forecasting. To promote trust and transparency, SHAP-based explainability is introduced, and a voice-based emergency alert module provides multilingual speech notifications, rendering the system accessible to both technical and non-technical users, as well as visually impaired people. Experimental testing through the iFogSim simulator proves to be much improved: 30 % less energy consumption, 25 % improved prediction accuracy, and below-3-second alert latency versus traditional solutions. This indicates that the system is capable of running efficiently in both urban and rural environments. In the future, the platform can be augmented with blockchain-enabled energy trading, more renewable sources, and adaptive reinforcement learning models to further enhance resilience, scalability, and sustainability of microgrid ecosystems.},
  keywords={Modeling;Clouds;Internet of Things;Energy;Timing;Multilingual;Disasters;Long short term memory;Tiny machine learning;Forecasting;Edge Computing;TinyML;Microgrids;Renewable Energy;LSTM Forecasting;Explainable AI;SHAP;Voice-based Alerts;iFogSim;Disaster Resilience;Energy Efficiency;Smart Grids},
  doi={10.1109/IC-AIDA68291.2026.11564282},
  ISSN={},
  month={April},}@INPROCEEDINGS{10796804,
  author={Bose, Ashwin and Ishani, S and Mini, V P},
  booktitle={2024 First International Conference on Software, Systems and Information Technology (SSITCON)}, 
  title={AIoT-based Power Monitoring and Energy Conservation System}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents an Artificial Intelligence of Things-based power monitoring and energy conservation system that utilizes a mobile application for real-time monitoring and control of household appliances. The existing system offers IoT-based monitoring and control but lacks integrated tariff calculation, fault, and anomaly detection in a unified solution. Consequently, we built a system that combines all the functionalities into one cohesive structure. The system uses the Isolation Forest algorithm for anomaly detection, trained on historical energy data to identify inefficiencies. The remote control feature allows users to conveniently manage energy consumption through a mobile app. In conclusion, this approach not only helps lower energy expenses but also promotes sustainable practices, making it a valuable tool for efficient energy management.},
  keywords={Energy consumption;Energy conservation;Tariffs;Forestry;Software systems;Real-time systems;Mobile applications;Software measurement;Monitoring;Anomaly detection;Internet of Things;NodeMCU;ESP8266;PZEM 004T;Isolation Forest;Power Monitoring;Relay Module;Blynk},
  doi={10.1109/SSITCON62437.2024.10796804},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11284228,
  author={Kadechkar, Akash and Koller, Markus and Labajos, Alejandro},
  booktitle={2025 14th International Conference on Renewable Energy Research and Applications (ICRERA)}, 
  title={Connected Electric Truck Powertrain: Non-Invasive Fault Detection using Ultra-Low Power Edge AI Sensor Network}, 
  year={2025},
  volume={},
  number={},
  pages={1452-1457},
  abstract={This paper presents a non-invasive, real-time fault detection and predictive maintenance framework for Connected Electric Truck powertrain. Leveraging the ultra-low-power ISM330DHCX sensor’s Machine Learning Core (MLC), the system performs on-sensor processing of accelerometer and gyroscope signals using Edge AI and TinyML techniques. Decision Trees (DTs) and an eight-DT based Random Forest (RF) model were employed to classify vibration patterns under varying operating conditions. Five experiments were conducted on electric motor test benches to simulate rotor imbalance and gather data in both normal and faulty states. Vibration signals were first classified into three broader fault categories and then mapped into 12 subclasses using a novel output mapping scheme. Guided by the Design, Implementation, Potential Failure and Functional Failure (DIPF) curve, this framework enables accurate detection of rotor unbalance faults. Experimental results showed that while single-DT models achieved high training accuracies ($95-98.42 \%$) but poor validation performance ($\lt 50 \%$), the eight-DT based Random Forest with subclass splitting significantly improved generalization, achieving $98.74 \%$ validation accuracy. By minimizing power consumption and bandwidth requirements, this on-sensor Edge AI sensor network approach offers a scalable solution for predictive maintenance, with the potential to reduce downtime and maintenance costs by $\mathbf{3 0 - 5 0 \%}$. The findings highlight the promise of ultra-low-power intelligent sensing for enhancing the reliability and efficiency of Connected Electric Trucks.},
  keywords={Vibrations;Electric potential;Accuracy;Ultrasonic imaging;Fault detection;Mechanical power transmission;Edge AI;Real-time systems;Random forests;Predictive maintenance;Predictive Maintenance;ISM330DHCX;Machine Learning Core;Random Forest;Fault Detection;Electric Truck;Powertrain;STWIN;Decision Trees;Edge AI;TinyML;Non-Invasive;Ultra-Low Power;Smart Sensors;AI Embedded Sensors},
  doi={10.1109/ICRERA66237.2025.11284228},
  ISSN={2572-6013},
  month={Oct},}@ARTICLE{11458766,
  author={Tran, Ba Vu and Youssef, Mohamed Z.},
  journal={IEEE Transactions on Industry Applications}, 
  title={A Novel IIoT-Enabled Power Supply With Multi-Model Embedded Machine Learning for Secure Real-Time Fault Detection in Oil and Gas Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-12},
  abstract={This paper presents the design and validation of an IIoT-enabled AC-DC power supply integrating a multi-model embedded machine learning framework for secure, real-time fault detection in the oil and gas industry. Unlike conventional PC-based, single-model, or cloud-dependent approaches, the proposed architecture executes multiple lightweight classifiers directly on a microcontroller, achieving bounded, sub-millisecond inference while operating within strict speed and memory constraints. Runtime intelligence enables adaptive model selection and early-exit logic, while secure dual-path remote telemetry via HTTPS/TLS and local Modbus RTU ensures continuous SCADA integration in EMI-prone, intermittently connected environments. Experimental validation on a custom industrial-grade prototype achieved up to 97.47% accuracy with a macro F1-score of 0.96 across seven fault categories. At a 480 MHz clock, inference latencies are as low as 0.001 ms for the Decision Tree and 0.02 ms for the Quantized Neural Network, with less than 50 kB additional Flash memory. These results confirm the framework's suitability as a field-ready, extensible solution for embedding intelligent, resilient fault detection directly into industrial power conversion systems operating in remote, harsh environments.},
  keywords={Telemetry;Aerospace and electronic systems;Synthetic aperture sonar;Space power stations;Radio broadcasting;Frequency modulation;Microcontrollers;Feedback;Circuits;Microprocessors;Industrial Internet of Things (IIoT);embedded machine learning;TinyML;real-time fault detection;multi-model inference;secure telemetry;Modbus RTU;oil and gas applications},
  doi={10.1109/TIA.2026.3678549},
  ISSN={1939-9367},
  month={},}@INPROCEEDINGS{11505080,
  author={Nivethika, G and Pragiyaa, V and Rohithaa, E and Padmaja, Y and Mari Rajan, S},
  booktitle={2026 International Conference on Data Science, Agents and Artificial Intelligence (ICDSAAI)}, 
  title={CookSafe AI: An Edge–AI Framework for Intelligent Gas Knob Monitoring and Autonomous Safety Actuation Using ESP32 with TinyML}, 
  year={2026},
  volume={1},
  number={},
  pages={1-7},
  abstract={The ignition of gas stoves being unattended has been one of the major causes of deaths in residential fires around the globe. In 2017-2021, 158,400 domestic cooking fires took place on average each year in the United States, resulting in the deaths of 470 civilians, injuries to 4,150 people, and property damage costing corporations 1.15 billion dollars [1]. Current commercial offerings rely on naive, timer-driven shutoffs or independent gas detectors that lack situational awareness. In this paper, CookSafe AI, a new edge-AI platform implemented on an ESP32-S3 microcontroller [2] fusing multi-modal sensors, a quantised MobileNetV2 convolutional neural network [3] to classify flame states, an Isolation Forest [4] anomaly detector to detect novel hazard patterns and a closed-loop motorised actuation system to control a gas knob autonomously, is presented. It is a system that combines the output of an MQ-6 LPG gas sensor, an MLX90614 infrared thermopile, an ultrasonic proximity sensor (HC-SR04), a rotary encoder (KY-040), and a camera (OV2640). MobileNetV2, when quantised to INT8 (97.3 KB), achieves 98.6% accuracy for flame detection at 12 fps on-device using TensorFlow Lite for Microcontrollers [5] with ESP-NN acceleration [6]. The isolation forest anomaly module achieves an F1 Score of 0.94 for new hazard patterns. If unsafe conditions are identified, a NEMA-17 stepper motor having a worm-gear coupling may be programmed to rotate the gas knob to OFF in 1.2 seconds. Real-time monitoring and manual override are provided by a Web dashboard based on MQTT/WebSocket. The experimental findings from $\mathbf{2, 4 0 0}$ controlled trials show that the system-level hazard mitigation rate is 99.58 per cent, the false-positive rate is 0.83 per cent, and the detection-to-actuation latency is 347 ms on average. Together, CookSafe AI is an Intelligent Autonomous Safety Agent in Smart Homes that can sense its surroundings, analyse multimodal evidence, and autonomously take corrective measures.},
  keywords={Fires;Modeling;Printing;Gases;Image sensors;Signal detection;Convolutional neural networks;Timing;Firing;Artificial intelligence;Edge AI;TinyML;ESP32;Gas Safety;Flame Detection;Sensor Fusion;MobileNetV2;Anomaly Detection;Smart Home;IoT Actuation},
  doi={10.1109/ICDSAAI69492.2026.11505080},
  ISSN={},
  month={March},}@INPROCEEDINGS{11547572,
  author={Haidar, Sk Wasim and Mishra, Aditya Dev and Chaubey, Sudhakar Kumar and Shahid, Waseem},
  booktitle={2026 International Conference on Intelligent Computing and Automation for Sustainable Solutions (ICASS)}, 
  title={AI Model Manipulation and Adversarial Threats in Internet of Things (AIoT) Environments: Challenges and Defense Mechanisms}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Artificial Intelligence coupled with the Internet of Things (AIoT) has revolutionized contemporary cyber-physical systems but also augmented the attack surface: new channels to command-and-control AI models can be leveraged, and machine learning may be subjected to adversarial manipulation. This paper investigates evasion, poisoning, backdoor embedding, model extraction, and inference attacks against AI powered anomaly detection, intrusion detection, malware classification, and federated learning in resource-constrained IoT settings. Leveraging latest taxonomies and domain-specific works, the survey exposes consumer IoT, medical IoT, IIoT, blockchain-supported systems and SDN-IoT networks vulnerabilities. The paper argues that AIoT protection requires dynamic, multilayered, and privacy-aware defense strategies to withstand changing adversarial threats.},
  keywords={Internet of Things;Modeling;Printing;Security;Accuracy;Artificial intelligence;Training;Signal detection;Labeling;Toxicology;Artificial Intelligence with the Internet of Things (AIoT);Artificial Intelligence (AI) and the Internet of Things (IoT);SDN-IoT},
  doi={10.1109/ICASS69550.2026.11547572},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11038555,
  author={Ancilotto, Alberto and Farella, Elisabetta},
  booktitle={2025 IEEE International Conference on Pervasive Computing and Communications Workshops and other Affiliated Events (PerCom Workshops)}, 
  title={Tiny Neural Networks for Tiny IoT Devices}, 
  year={2025},
  volume={},
  number={},
  pages={612-613},
  abstract={Over the past decade, pervasive computing has been influenced by two major trends. First, the widespread adoption of smart, connected, and always active Internet of Things (IoT) devices, pushed by advancements in modern microcontrollers, which now offer more powerful processors, greater efficiency, and faster clock speeds Second, deep learning techniques have grown exponentially, driven by faster processors and the availability of large training datasets. However, traditional deep learning models are often too resource-intensive for embedded systems and can only be run on powerful (and power-hungry) general-purpose GPUs (GP-GPUs) [1] , [2] . The emerging field of TinyML is addressing the gap between small, low-power embedded devices and the high computational requirements of modern deep-learning workloads. This cutting-edge field is working on applying the transformative power of machine learning (ML) in the constrained environment of tiny devices and embedded systems [3] . TinyML has been successfully applied across various domains, including audio processing and sound event detection [1] , biosignal analysis [4] , gesture recognition [5] , and general time-series data. Among these areas, computer vision stands out as one of the most prominent applications of TinyML - allowing advanced multimedia processing algorithms to run on tiny, power-efficient devices. We propose two novel architectures to optimize the current resources and performance tradeoffs in embedded devices.},
  keywords={Pervasive computing;Deep learning;Training;Performance evaluation;Program processors;Embedded systems;Tiny machine learning;Conferences;Neural networks;Internet of Things},
  doi={10.1109/PerComWorkshops65533.2025.00141},
  ISSN={2766-8576},
  month={March},}@INPROCEEDINGS{11130213,
  author={Rahaman, Hafizur and Giri, Chandan and Roy, Surajit K and Chakrabarti, Amlan},
  booktitle={2025 IEEE Computer Society Annual Symposium on VLSI (ISVLSI)}, 
  title={Optimization and Security of AI Models for Deployment at Edge: A Comprehensive Review}, 
  year={2025},
  volume={1},
  number={},
  pages={1-6},
  abstract={The integration of AI with edge computing and IoT is transforming smart systems by enabling real-time decision making, improving data privacy, and optimizing resource efficiency. Edge AI addresses key challenges of traditional cloud-centric models, but faces strict limitations on compute power, memory, energy, communication bandwidth, security, energy consumption, and scalability. To address this strict limitation, various techniques have been developed to create energyefficient, secure, lightweight AI architectures. This article presents a comprehensive review of secure and sustainable Edge AI technologies that highlight recent advances in the design, optimization, and security of AI models for such environments. We discuss model compression (pruning, quantization, and knowledge distillation) and lightweight architectures (e.g., MobileNet, TinyML frameworks)and cross-layer optimization to enhance edge AI efficiency. It also addresses security and privacy concerns such as adversarial attacks, model theft, and side-channel vulnerabilities including solutions such as secure boot, trusted execution environments (TEEs), adaptive model switching, and privacy-preserving techniques such as federated learning and differential privacy. We highlight critical challenges, analyze ongoing research trends, and outline future research directions essential to building secure, energy efficient, and intelligent edge ecosystems.},
  keywords={Adaptation models;Reviews;Federated learning;Biological system modeling;Computational modeling;Tiny machine learning;Scalability;Edge AI;Switches;Security;Edge AI;IoT;Security;Federated Learning;TinyML;Lightweight Model;Privacy-Preserving AI},
  doi={10.1109/ISVLSI65124.2025.11130213},
  ISSN={2159-3477},
  month={July},}@INPROCEEDINGS{11030168,
  author={Tóth, Benedek Máté and Bánáti, Anna},
  booktitle={2025 IEEE 19th International Symposium on Applied Computational Intelligence and Informatics (SACI)}, 
  title={Autoencoder Based CAN BUS IDS System Architecture and Performance Evaluation}, 
  year={2025},
  volume={},
  number={},
  pages={000099-000104},
  abstract={With the increasing sophistication and frequency of cyber threats targeting modern vehicles [1], the need for efficient, real-time intrusion detection systems (IDS) has become critical. This study explores the feasibility of deploying an autoencoder-based IDS [2] for CAN BUS networks in resourceconstrained automotive environments. Unlike conventional deep learning approaches that rely on computationally intensive models, this research focuses on developing a lightweight, optimized autoencoder architecture capable of detecting anomalies while maintaining computational efficiency. The study follows a systematic approach, beginning with the design of a baseline autoencoder model, followed by iterative improvements in architecture complexity, parameter tuning, and dataset preprocessing to enhance detection performance. Furthermore, the model is deployed on an embedded system using the TinyML framework, enabling real-time execution on low-power microcontrollers. Key challenges such as model compression, inference latency, and memory footprint optimization are addressed to ensure practical implementation. The proposed IDS is evaluated based on detection accuracy, computational efficiency, and real-world performance metrics, providing insights into the trade-offs associated with deploying deep learning models in embedded automotive environments.},
  keywords={Systematics;Microcontrollers;Tiny machine learning;Computational modeling;Autoencoders;Intrusion detection;Real-time systems;Computational efficiency;Computer security;Tuning;autoencoder;IDS;embedded;TinyML;CAN BUS;automotive cybersecurity},
  doi={10.1109/SACI66288.2025.11030168},
  ISSN={2765-818X},
  month={May},}@INPROCEEDINGS{10795737,
  author={Ma, Jianhua and Jin, Qun and Hsu, Hui-Huang and Vergara, John Paul C. and Guerrieri, Antonio and Miceli, Claudio and Guo, Ao},
  booktitle={2024 IEEE Cyber Science and Technology Congress (CyberSciTech)}, 
  title={Challenges and Emerging Issues for Generative AI and Hyper Intelligence}, 
  year={2024},
  volume={},
  number={},
  pages={258-265},
  abstract={Generative Artificial Intelligence (GenAI) represents a significant milestone in the development of artificial intelligence, bringing sophisticated AI capabilities into daily life and work. As we approach the era of Hyper Intelligence (Hyper-I), a variety of critical challenges and emerging issues have come to light, ranging from computational complexity to ethical concerns. This paper explores the evolution of AI from the perspective of human learning, comparing machine and human intelligence, and identifying key considerations for the development of future AI systems. It also highlights the growing importance of regulating advanced AI models, such as Reinforcement Learning-based Long-Term Planning Agents, to ensure that Hyper-I remains under human control. Additionally, the paper discusses the computational complexity of transformer-based models, their applicability to intractable problems, and their role in cognitive building systems and resource-constrained environments through TinyML. By analyzing these pressing challenges, this work provides insights into the future of AI and the path toward responsible innovation in generative and hyper-intelligent systems.},
  keywords={Hyper-intelligent systems;Ethics;Technological innovation;Generative AI;Computational modeling;Tiny machine learning;Pressing;Transformers;Regulation;Computational complexity;Human Nature;Generative AI;Hyper Intelligence;Human Control;Transformer;Cognitive Buildings;TinyML},
  doi={10.1109/CyberSciTech64112.2024.00048},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11450938,
  author={K S, Shashank and M B, Nirmala},
  booktitle={2025 International Conference On Emerging Computation and Information Technologies (ICECIT)}, 
  title={Edge-Enabled Smart Beehive Monitoring and Classification Using IoT and Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The honey bee colony functions as a fundamental element of worldwide agricultural production yet their numbers continue to decline because of environmental disruptions and disease outbreaks and random colony failures. The current traditional hive monitoring systems depend on human observers who must perform invasive and time-consuming tasks while lacking the ability to provide immediate monitoring data. The solution for intelligent beehive monitoring and state detection through edge computing-based IoT technology addresses these system obstacles. The system proposal combines an ESP32 microcontroller with temperature and humidity sensors and audio detectors while using a small TinyML model which runs classification tasks directly on the device to identify honey bee colony states as Normal or Queenless or Swarming. The researchers established a dataset which contained 1,250 audio recordings together with environmental measurement data to develop and evaluate their proposed system. The framework achieved 98% classification accuracy while completing inferences within 100 ms and reducing data transmission requirements by 70% compared to cloud-based systems. The system includes a Streamlit-based dashboard which enables users to view real-time data and detect anomalies and track historical trends in the hive monitoring system. The proposed method provides a dependable system which protects user privacy while using data to support apiculture operations and prompt honey bee colony management.},
  keywords={Temperature sensors;Temperature measurement;Tiny machine learning;Image edge detection;Biological system modeling;Sensor systems;Real-time systems;Monitoring;Intelligent sensors;Edge computing;Acoustic Sensing;ESP32;Edge Computing;IoT;TinyML;Smart Beehive},
  doi={10.1109/ICECIT67774.2025.11450938},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11580659,
  author={Pathak, Lakshin and Dave, Nitya and Ganesh, Ramya and Gharmalkar, Samiksha and Anadkat, Shobhit Niraj and Sayani, Briony and Shah, Aashna},
  booktitle={2025 IEEE 7th International Conference on Cybernetics, Cognition and Machine Learning Applications (ICCCMLA)}, 
  title={Agentic Architecture Enabling Secure and Fault Tolerant Telesurgery}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper proposes an Agentic AI-facilitated deep learning approach to resilient DDoS attack detection in telesurgery networks. The approach involves several expert agents, such as a data gathering agent, preprocessing agent, learning agent, reasoning agent, observing agent, and feedback agent, which are coordinated under a Multi-Context Processing (MCP) regime. The feedback agent makes refined decision-making by ongoing detection outcomes evaluation, whereas protocol switching mechanisms provide unbroken secure communication even in the presence of adversaries. In essence, a TinyML-based deep learning model is able to obtain 94% accuracy with a small size of 0.5 MB, thus allowing lightweight yet impactful deployment in limited telesurgery environments. MCP provides hassle-free coordination between agents, making context-aware adaptability, protocol switching, and real-time threat detection possible. Experimental outcomes validate that the introduced framework effectively preserves efficiency, precision, and responsiveness, rendering it an attractive solution for protecting mission-critical telesurgery systems against DDoS attacks.},
  keywords={Modeling;Tiny machine learning;Timing;Accuracy;Equations;Training;Protocols;Long short term memory;Recurrent neural networks;Agentic AI;Agentic AI;Telesurgery;DDoS Detection;TinyML;Federated Learning;Secure Communication;Deep Learning in Healthcare},
  doi={10.1109/ICCCMLA66092.2025.11580659},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11340813,
  author={Punith, M and Nirmala, M B and Swathi, Paapanna Gari},
  booktitle={2025 International Conference on Communication, Computer, and Information Technology (IC3IT)}, 
  title={AI-Powered Real-Time Patient Monitoring System with Hybrid Health Anomaly Detection}, 
  year={2025},
  volume={},
  number={},
  pages={01-13},
  abstract={Continuous health monitoring in resourcelimited healthcare settings remains a persistent challenge, primarily due to the disparity between high-cost, real-time surveillance systems and the inadequacies of episodic care. Unlike previous IoT-based monitoring solutions that often operate in isolation, this research presents an integrated approach, employing affordable ESP32 hardware in tandem with a hybrid stacking ensemble model and multi-role clinical dashboards to ensure real-time applicability. Specifically, the proposed AIoT framework brings together ESP32-based multisensor platforms and a novel stacking ensemble that fuses Random Forest and Artificial Neural Network classifiers, achieving a notable 95.45 % accuracy rate in detecting eight distinct health anomalies-surpassing the typical 88-95% benchmark of existing systems. The framework's performance is validated through synthetic physiological data, demonstrating effective real-time anomaly detection while maintaining computational efficiency on resource-constrained devices. This technology is promising for applications such as rural clinics, home-elderly care, and post-operation monitoring, in which there is no access to conventional infrastructure. However, the study is limited by its reliance on synthetic datasets and the necessity for subsequent clinical trials and regulatory clearance before real-world implementation. Overall, the framework substantiates the practical viability of affordable, continuous monitoring within resource-limited clinical environments, while facilitating collaborative healthcare delivery through role-based access controls.},
  keywords={Patient monitoring;Stacking;Medical services;Real-time systems;Hardware;Sensors;Internet of Things;Monitoring;Anomaly detection;Synthetic data;Artificial Intelligence;Internet of Things;Patient Monitoring;Health Anomaly Detection;Machine Learning;ESP32;Stacking Ensemble;Hybrid Neural Networks;Role-Based Access Control;Real-Time Analytics;Low-Cost Sensing;Clinical Dashboards},
  doi={10.1109/IC3IT66137.2025.11340813},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11458952,
  author={Naithani, Akshit and Jain, Vrishin},
  booktitle={2026 14th International Symposium on Digital Forensics and Security (ISDFS)}, 
  title={A Lightweight Hybrid Temporal CNN-Transformer Architecture for Real-Time Healthcare Anomaly Detection on Wearables}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The advancement of wearable health technology has created a critical need for real-time anomaly detection in physiological signals, such as ECG and glucose data, directly on the device. However, the computational constraints of lowpower wearables present a significant barrier to deploying powerful deep learning models. This paper proposes a novel lightweight hybrid architecture that synergistically combines Temporal Convolutional Networks (TCNs) and a factorized selfattention mechanism to achieve efficient and accurate on-device anomaly detection. The TCN layer provides local feature extraction with a dilated receptive field, while the linear-complexity attention mechanism enables the model to capture essential longrange dependencies in time-series data. A theoretical analysis demonstrates the model's suitability for embedded deployment, with a low parameter count and computational footprint that aligns with the memory and power constraints of microcontrollers. The proposed system architecture outlines a complete pipeline for data preprocessing, on-device inference and alert generation. This work provides a theoretical framework for a new class of embedded intelligence in wearables, offering the potential for instantaneous health alerts, enhanced privacy and reliable operation independent of cloud connectivity, thereby paving the way for more accessible and proactive healthcare monitoring.},
  keywords={Activity recognition;Human activity recognition;Feeds;Antennas;Filtering;Microcontrollers;Filters;Microprocessors;Central Processing Unit;MIMICs;Anomaly Detection;Wearable Devices;Embedded Machine Learning (TinyML);Transformer;Temporal Convolutional Network (TCN);ECG;Glucose Monitoring;Realtime Systems},
  doi={10.1109/ISDFS69419.2026.11458952},
  ISSN={2768-1831},
  month={March},}@ARTICLE{9716823,
  author={Wong, David Liang Tai and Li, Yongfu and John, Deepu and Ho, Weng Khuen and Heng, Chun-Huat},
  journal={IEEE Transactions on Biomedical Circuits and Systems}, 
  title={An Energy Efficient ECG Ventricular Ectopic Beat Classifier Using Binarized CNN for Edge AI Devices}, 
  year={2022},
  volume={16},
  number={2},
  pages={222-232},
  abstract={Wearable Artificial Intelligence-of-Things (AIoT) requires edge devices to be resource and energy-efficient. In this paper, we design and implement an efficient binary convolutional neural network (bCNN) algorithm utilizing function-merging and block-reuse techniques to classify between Ventricular and non-Ventricular Ectopic Beat images. We deploy our model into a low-resource low-power field programmable gate array (FPGA) fabric. Our model achieves a classification accuracy of 97.3%, sensitivity of 91.3%, specificity of 98.1%, precision of 86.7%, and F1-score of 88.9%, along with dynamic power dissipation of only 10.5-μW.},
  keywords={Electrocardiography;Convolution;Pregnancy;Heart rate variability;Field programmable gate arrays;Convolutional neural networks;Image edge detection;Artificial Intelligence-of-Things;co-design;convolutional neural network;ECG;field programmable gate array;fusion;inference;low-power design;wearable;state machine},
  doi={10.1109/TBCAS.2022.3152623},
  ISSN={1940-9990},
  month={April},}@INPROCEEDINGS{11294396,
  author={P N, Jayanthi and Bhat, Vishwanath Ganesh and H G, Rakesh and Hegde, Bhargav and S, Nikhil and N R, Sudeep},
  booktitle={2025 9th International Conference on Computational System and Information Technology for Sustainable Solutions (CSITSS)}, 
  title={MineGuard AI: Real-Time Safety and Health Monitoring for Miners Using Edge Intelligence and LoRa Communication}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Mining environments present severe safety risks due to toxic gases, extreme temperatures, and physical hazards. Traditional safety systems lack real-time, integrated monitoring and predictive capabilities. MineGuard Al addresses these gaps through an intelligent wearable wristband that continuously tracks miner's physiological parameters (heart rate, SpO2) and environmental conditions (toxic gases, temperature, humidity). The system employs ESP32 microcontrollers with integrated sensors, LoRa-based long-range communication, and edge AI for real-time hazard detection. AI models—including fall detection keyword spotting, and health anomaly detection run locally via TensorFlow Lite Micro. Data is transmitted to a centralized dashboard (built with React, Node.js, and Three.js) for 3D visualization, live alerts, and AI-generated reports. Field tests confirmed less than 2 seconds latency, reliable communication in GPS-denied zones. MineGuard AI enhances miner safety through proactive, scalable, and autonomous monitoring.},
  keywords={Temperature sensors;Gases;Three-dimensional displays;Tiny machine learning;LoRa;Real-time systems;Hazards;Biomedical monitoring;Wearable devices;Monitoring;Internet of Things;Edge Computing;TinyML;LoRa;Mining Safety;Wearable Technology;Artificial Intelligence},
  doi={10.1109/CSITSS67709.2025.11294396},
  ISSN={2767-1097},
  month={Nov},}@INPROCEEDINGS{9565685,
  author={Kaya, Şükrü Mustafa and Güneş, Ali and Erdem, Atakan},
  booktitle={2021 International Conference on Artificial Intelligence of Things (ICAIoT)}, 
  title={A Smart Data Pre-Processing Approach by Using ML Algorithms on IoT Edges: A Case Study}, 
  year={2021},
  volume={},
  number={},
  pages={36-42},
  abstract={The internet of things (IoT) is a technology that allows many objects used in daily life to produce a variety of data and transfer those data to other objects or systems. The application domain of this system is increasing day by day, and the technologies used for its infrastructure are also varied. However, to process the huge amount of sensor data effectively, smart and fast filtering solutions are required. As a data pre-processing task, smart data filtering improves not only the data processing speed but also the quality of data as well. In other words, big data management is facilitated by getting more effective results with little noise and meaningful data. In this study, we examined big IoT data stored on IoT edges to detect anomalies in temperature, age, gender, weight, height, and time data. In this context, the Logistic Regression algorithm was applied at both sensing and network layers for anomaly detection purposes. Furthermore, the performance of the classification algorithm in terms of speed and accuracy was reported as the output of the study.},
  keywords={Temperature sensors;Temperature distribution;Filtering;Image edge detection;Data processing;Classification algorithms;Sensors;component;internet of things;big data management;big data analytics;data filtering},
  doi={10.1109/ICAIoT53762.2021.00014},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10126917,
  author={Prabha, Chander and Mittal, Priya and Sharma, Akshita and Singh, Jaspreet},
  booktitle={2022 IEEE North Karnataka Subsection Flagship International Conference (NKCon)}, 
  title={AIoT Emerging Technologies, Use Cases, and Its Challenges in Implementing Smart Cities}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={The concept of a Smart City (SC) and its challenges have been under evolution for the last decade due to an increase in urbanization. During this period, the growing number of smart city projects resulted in deployment issues. But after successful implementation, it enhances city operations and raises inhabitants' quality of life. Therefore, smart cities are an immensely pertinent concept that needs a lot of development, until it enables them to realize their greatest potential and produces sturdy and strong solutions. The paper focuses on the Artificial Internet of Things (AIoT) emerging technologies for SC that have been embedded within city services. It reviews present scenarios of AIoT-enabled SCs and their contribution to the implementation of the same. This paper also presents some challenges along with technologies and initiatives that are still being developed to deal with them.},
  keywords={Smart cities;Internet of Things;AIoT;Interoperability;Quality of Life;Smart City;Sensors;Sustainable},
  doi={10.1109/NKCon56289.2022.10126917},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10102115,
  author={Wang, Shengwei and Zhou, Zheng and Liao, Rongtao and Wang, Yixi and Li, Lei and Hu, Huanjun and Ye, Yuxuan and Zhang, Jian and Ning, Hao and Li, Xiang},
  booktitle={2022 International Conference on Artificial Intelligence of Things and Crowdsensing (AIoTCs)}, 
  title={Comprehensive Awareness Security Gateway and Multidimensional Situation Analysis of Power Internet of Things Terminal}, 
  year={2022},
  volume={},
  number={},
  pages={163-168},
  abstract={The power Internet of Things terminal is a highly complex and widely connected organic whole. Each element of the system is interconnected through the power information network, and there is a very complex dependency relationship. This complex information system is inevitably filled with various normal access and attack behaviors. Faced with such a complex network environment, the importance of network security(NS) situation research has become increasingly prominent. This paper briefly analyzes the network security situation awareness(NSSA) and the key technologies of NSSA, time series prediction and anomaly detection; The multi-dimensional situation model of the comprehensive awareness security network based on the hierarchical and diffusion analysis model is designed. Finally, the comprehensive awareness security gateway and multi-dimensional situation of the power Internet of Things terminal are analyzed through experiments. Considering the threat and vulnerability factors of the information system, the comprehensive assessment of the risk of the entire information network is realized. The effectiveness of the model is verified in the experimental environment.},
  keywords={Analytical models;Time series analysis;Predictive models;Logic gates;Network security;Data models;Security;Power Internet of Things terminal;Data Mining Technology;Comprehensive Perception Security Gateway;Multi-Dimensional Situation Analysis},
  doi={10.1109/AIoTCs58181.2022.00031},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9978484,
  author={Zhang, Yujie and Wijerathne, Dhananjaya and Li, Zhaoying and Mitra, Tulika},
  booktitle={2022 IEEE 40th International Conference on Computer Design (ICCD)}, 
  title={Power-Performance Characterization of TinyML Systems}, 
  year={2022},
  volume={},
  number={},
  pages={644-651},
  abstract={TinyML systems are enabling machine learning (ML) inference at the edge. However, there exists little quantitative analysis of such systems. This paper presents a systematic performance and power characterization of diverse TinyML applications on micro-controllers (MCUs), spanning neural network models, software libraries, operating systems, and hardware architectures. We focus on the impact of the multiple layers of abstractions that provide higher programmability at the expense of performance and energy efficiency. We propose a model to estimate the costs of different abstraction layers and make recommendations for minimizing those costs. Our findings can help designers with Neural Architecture Search (NAS) and CNN inference optimization on edge devices.},
  keywords={Performance evaluation;Analytical models;Systematics;Costs;Software libraries;Statistical analysis;Computational modeling;TinyML;MCU;general matrix multiplication},
  doi={10.1109/ICCD56317.2022.00099},
  ISSN={2576-6996},
  month={Oct},}@INPROCEEDINGS{10562187,
  author={Yadav, Poonam},
  booktitle={2024 IEEE 3rd Workshop on Machine Learning on Edge in Sensor Systems (SenSys-ML)}, 
  title={Advancements in Machine Learning in Sensor Systems: Insights from Sensys-ML and TinyML Communities}, 
  year={2024},
  volume={},
  number={},
  pages={21-26},
  abstract={The integration of machine learning (ML) algorithms with edge sensor systems has fundamentally transformed numerous industries. This convergence empowers real-time data processing, analysis, and decision-making at the network’s periphery. This paper investigates the latest advancements in this domain by examining two key communities: Sensys-ML and TinyML. While Sensys-ML concentrates on optimizing ML for sensor systems, TinyML prioritizes deploying ML models on resource-constrained devices. Through a critical analysis of these communities’ contributions and interactions, this work aims to provide a comprehensive overview of cutting-edge methodologies, persistent challenges, and promising future directions for ML at the edge within sensor systems. By tracing the trajectory of advancements in this field, we offer a critical reflection on the broader research landscape and its scope. Additionally, we identify emerging research areas as reflected in prominent forums and underscore persisting knowledge gaps that call for further investigation.},
  keywords={Industries;Machine learning algorithms;Conferences;Decision making;Data processing;Sensor systems;Reflection;Machine Learning;TinyML;UltraML;Sensor systems},
  doi={10.1109/SenSys-ML62579.2024.00009},
  ISSN={},
  month={May},}@ARTICLE{10124961,
  author={Recio-Garcia, Juan A. and Diaz-Agudo, Belen and Acuaviva, Arturo},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Becalm: Intelligent Monitoring of Respiratory Patients}, 
  year={2023},
  volume={27},
  number={8},
  pages={3806-3817},
  abstract={The Becalm project is an open and low-cost solution for the remote monitoring of respiratory support therapies like the ones used in COVID-19 patients. Becalm combines a decision-making system based on Case-Based Reasoning with a low-cost, non-invasive mask that enables the remote monitoring, detection, and explanation of risk situations for respiratory patients. This paper first describes the mask and the sensors that allow remote monitoring. Then, it describes the intelligent decision-making system that detects anomalies and raises early warnings. This detection is based on the comparison of cases that represent patients using a set of static variables plus the dynamic vector of the patient time series from sensors. Finally, personalized visual reports are created to explain the causes of the warning, data patterns, and patient context to the healthcare professional. To evaluate the case-based early-warning system, we use a synthetic data generator that simulates patients' clinical evolution from the physiological features and factors described in healthcare literature. This generation process has been verified with a real dataset and allows the validation of the reasoning system with noisy and incomplete data, threshold values, and life/death situations. The evaluation demonstrates promising results and good accuracy (0.91) for the proposed low-cost solution to monitor respiratory patients.},
  keywords={COVID-19;Medical services;Biomedical monitoring;Predictive models;Pandemics;Adaptation models;Artificial intelligence;Case-based Reasoning;eXplainable Artificial Intelligence;Artificial Intelligence of Things;non-invasive respiratory device},
  doi={10.1109/JBHI.2023.3276638},
  ISSN={2168-2208},
  month={Aug},}@INPROCEEDINGS{11539155,
  author={Guralla, Kumaraswamy and Narasimhulu, E. and Naseema, Shaik and Kishore, Jonnala Nanda and Reddy, M. Bharath Kumar},
  booktitle={2026 12th International Conference on Communication and Signal Processing (ICCSP)}, 
  title={Real-Time Sensor Drift Detection in Iot Edge Devices Using Lightweight Machine Learning}, 
  year={2026},
  volume={},
  number={},
  pages={841-845},
  abstract={Low-cost environmental sensors are widely used in Internet of Things (IoT) systems; however, their reliability degrades over time due to gradual sensor drift. Detecting such drift is challenging using traditional threshold-based methods, especially when changes occur slowly. This paper proposes a lightweight edge-based approach for real-time sensor drift detection using supervised machine learning. Temperature and humidity data collected from a DHT11 sensor are processed using statistical feature extraction techniques, and multiple classification algorithms are evaluated. The selected Decision Tree model is deployed directly on an ESP8266 microcontroller, enabling real-time local inference without cloud dependency. The model achieved 96.8% accuracy with low inference latency (18 ms), demonstrating its effectiveness and feasibility for real-time edge deployment. The results highlight the potential of lightweight machine learning models for improving sensor reliability in IoT applications.},
  keywords={Modeling;Internet of Things;Machine learning;Image sensors;Timing;Machining;Decision trees;Printing;Real-time systems;Accuracy;IoT;Drift Fault Detection;TinyML;Edge Computing;ESP8266;Machine Learning;Sensor Reliability},
  doi={10.1109/ICCSP68173.2026.11539155},
  ISSN={2836-1873},
  month={April},}@INPROCEEDINGS{10570025,
  author={Medeiros, Morsinaldo and Flores, Thommas and Silva, Marianne and Silva, Ivanovitch},
  booktitle={2024 IEEE International Conference on Evolving and Adaptive Intelligent Systems (EAIS)}, 
  title={A Multi-Layered Methodology for Driver Behavior Analysis Using TinyML and Edge Computing}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={The rapid increase in vehicular sensor data and advances in Internet of Things (IoT) technologies pose a dual challenge and opportunity for real-time traffic management and driver behavior analysis in the domain of Intelligent Transportation Systems (ITS). The current gap lies in effectively processing this data at the network edge, which is critical for timely and efficient decision-making in ITS. Our study proposes a novel, multi-layered, stream-oriented data processing methodology specifically designed for edge computing environments to address this challenge. This approach integrates soft sensors, the Typicality and Eccentricity Data Analytics (TEDA) framework, and an incremental clustering algorithm to detect and classify driver behavior patterns. The emphasis on using low-energy hardware and TinyML techniques is crucial, aiming to optimize processing efficiency while minimizing the environmental impact. To substantiate the efficacy of our methodology, we conducted a practical case study in Natal-RN, Brazil, utilizing the Freematics One + OBD-II microcontroller device for real-world application and validation. This involved two participants and focused on real-time data analysis for driver profile detection. The preliminary results demonstrate a significant potential of our approach in accurately classifying driving behaviors and patterns, offering insights for enhancing vehicle efficiency and reducing fuel consumption. This study fills a critical gap in ITS. It sets the stage for future research in sustainable and adaptive transportation systems, leveraging the power of edge computing and incremental algorithms in real-time data stream processing.},
  keywords={Data analysis;Soft sensors;Image edge detection;Heuristic algorithms;Clustering algorithms;Real-time systems;Classification algorithms;Edge Computing;Intelligent Transportation Systems;Driver Behavior Analysis;IoT Sensor Data;TinyML Techniques},
  doi={10.1109/EAIS58494.2024.10570025},
  ISSN={2473-4691},
  month={May},}@INPROCEEDINGS{10724454,
  author={Krishna, H Jai Venkat and Meena, S M},
  booktitle={2024 15th International Conference on Computing Communication and Networking Technologies (ICCCNT)}, 
  title={AIoT for Smart Homes: Real-Time Non-Intrusive Load Monitoring}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Facing rising energy demand, we need smarter solutions for conservation. Non-Intrusive Load Monitoring (NILM) offers a cost-effective way to track energy usage, but current methods struggle with real-world implementation. This presentation introduces a novel AI-powered approach to NILM using Deep Neural Networks (DNN). We convert power signatures from appliances into image representations, allowing our DNN to accurately classify which appliances are active. This breakthrough addresses key challenges, including the need for manual training and limited data availability. Our research paves the way for practical NILM solutions, enabling homeowners to gain real-time insights into their energy consumption and make informed decisions for conservation.},
  keywords={Training;Load monitoring;Energy consumption;Artificial neural networks;Smart homes;Image representation;Real-time systems;Non-Intrusive load monitoring;Deep Neural Network;GAN;GenAI},
  doi={10.1109/ICCCNT61001.2024.10724454},
  ISSN={2473-7674},
  month={June},}@INPROCEEDINGS{10717767,
  author={Cong, Duan Luong and Quang, Bien Nguyen and Thanh, Long Hoang and Cao, Dung Truong and Trung, Hieu Nguyen and Ngoc, Minh Nguyen},
  booktitle={2024 9th International Conference on Applying New Technology in Green Buildings (ATiGB)}, 
  title={Real-Time Fan Anomaly Detection Using Embedded Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={362-367},
  abstract={Currently, detecting anomalies in electrical devices, particularly electric fans, is crucial. Ensuring the stable operation of industrial electric fans helps early prevention of electronic system failures, thereby saving repair costs before the issues become more severe. This study has developed an early fault detection method for industrial electric fans using machine learning techniques, which can be deployed on resource-limited embedded devices. The proposed system monitors vibration and current consumption through accelerometers and sensors, employing a machine-learning model to evaluate anomalies. Unlike conventional machine learning models, the results show that applying Convolutional Neural Networks (CNN) and Deep Neural Networks (DNN) significantly increases accuracy without requiring extensive feature extraction. Additionally, due to the lack of data on abnormal and normal states, we created a fan model in the laboratory to collect data for up to 7 hours. The trained model achieved an accuracy of 98.3% with six labels, Fan On, Fan Off, Fan Tapping, Fan Broken Wings, Fan Stuck, and Fan Unstable, on the self-collected dataset.},
  keywords={Vibrations;Fans;Accuracy;Machine learning;Maintenance engineering;Real-time systems;Sensor systems;Sensors;Convolutional neural networks;Electric motors;real time fan;anomaly detection;CNN;DNN;embedded machine learning (ML);TinyML},
  doi={10.1109/ATiGB63471.2024.10717767},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10833579,
  author={Li, Dun and Li, Yan-Fu and Wang, Huan},
  booktitle={2024 IEEE Global Conference on Artificial Intelligence and Internet of Things (GCAIoT)}, 
  title={Next-Gen AIoT-Driven Predictive Maintenance and Health Management System for High-Speed Train Wheel and Axle Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper proposes an AIoT-driven predictive maintenance and health management system specifically designed for high-speed train wheel and axle systems. By integrating advanced artificial intelligence techniques—such as Multi-Scale Transformer (MST) for accurate wheel wear prediction and Deep Wavelet Network (DWN) for precise axle stress analysis—within a comprehensive Internet of Things framework, the system enhances operational efficiency and safety. To address challenges like data quality, model interpretability, and real-time processing constraints, the research incorporates edge computing solutions to improve responsiveness. Experimental results demonstrate a 22% improvement in predictive accuracy for wheel wear and a 27.5% reduction in mean absolute error for stress prediction compared to traditional methods. Additionally, anomaly detection performance achieved an F1-score of 0.90, outperforming existing models by 26.8%. These findings validate the system's effectiveness and lay the groundwork for future advancements in intelligent railway systems, emphasizing data fusion, interpretable AI, and real-time processing capabilities.},
  keywords={Wavelet transforms;Accuracy;Computational modeling;Wheels;Real-time systems;Internet of Things;Artificial intelligence;Stress;Axles;Predictive maintenance;AIoT;Predictive Maintenance;High-Speed Trains;MSTs;Railway Systems},
  doi={10.1109/GCAIoT63427.2024.10833579},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9488546,
  author={Andrade, Pedro and Silva, Ivanovitch and Signoretti, Gabriel and Silva, Marianne and Dias, João and Marques, Lucas and Costa, Daniel G.},
  booktitle={2021 IEEE International Workshop on Metrology for Industry 4.0 & IoT (MetroInd4.0&IoT)}, 
  title={An Unsupervised TinyML Approach Applied for Pavement Anomalies Detection Under the Internet of Intelligent Vehicles}, 
  year={2021},
  volume={},
  number={},
  pages={642-647},
  abstract={Vehicles have been endowed with new technologies in the last years, mostly influenced by an increasing in the instrumentation level and availability of smart devices for embedded processing. In this scenario, which has paved the way for the construction of Internet of Intelligent Vehicles, the edge computing paradigm emerges with the primary role to promote the processing of raw data streams in their early stages, as close as possible to their origins. Therefore, this paper proposes the processing of data streams based on an unsupervised tiny machine learning approach to detect anomalies on the roads, exploiting for that a microcontroller and an embedded accelerometer on vehicles. The obtained results through real experiments were promising: the f1 score mean was 0.76 for the first driver and 0.78 for the second. This indicates that the classifier model reached significant performance in the defined scenarios.},
  keywords={Energy consumption;Intelligent vehicles;Microcontrollers;Roads;Instruments;Geology;Machine learning;TinyML;Edge Computing;Vehicles;Anomalies Detection;Internet of Intelligent Vehicles;Unsupervised Machine Learning},
  doi={10.1109/MetroInd4.0IoT51437.2021.9488546},
  ISSN={},
  month={June},}@ARTICLE{11364132,
  author={Moura, Gerffeson Almeida and Wallace Antunes Soares, Antonio and Rodrigues Belfort, Diomadson and Yuri Cavalcanti Catunda, Sebastian},
  journal={IEEE Access}, 
  title={On-Device Edge AI for Monthly Energy Forecasting on ESP32-S3 Using 3-Day Windows: Hardware-Constrained Feasibility With Harmonics and Offline Interharmonic Benchmarking}, 
  year={2026},
  volume={14},
  number={},
  pages={15414-15435},
  abstract={This paper investigates the feasibility of monthly energy consumption forecasting on microcontroller-class edge devices under strict memory and energy constraints. Real-world data were collected over 30 consecutive days from two sites—a residential single-phase installation and an industrial three-phase feeder—using an ESP32-S3 microcontroller interfaced with an ADE7880 energy-measurement IC. Models are trained from contiguous 3-day windows to predict same-month targets, and a non-overlapping triplet split is used to prevent data leakage. Three input regimes are evaluated: No Harmonics, Harmonics, and Interharmonics. Interharmonics are obtained from an external power-quality analyzer and are evaluated exclusively offline as a non-deployable analytical upper bound; on-device deployment is restricted to ADE7880-supported regimes. Dimensionality reduction and resampling are applied offline, and only the quantized forward pass is executed on the ESP32-S3. We benchmark inference-only latency, memory footprint, and device-side energy per inference using an INA226 sensor. Results show that accurate monthly forecasting from short 3-day windows under extreme data scarcity and hardware-constrained conditions is feasible on MCU-class hardware, achieving up to  $R^{2} \approx 0.93$  in the single-phase case with sub-millisecond latency and sub-millijoule energy per inference. Cross-site performance degradation is observed and discussed as domain shift. This work is explicitly scoped as a site-specific feasibility study; multi-season and multi-site validation is left for future work to assess generalization.},
  keywords={Forecasting;Harmonic analysis;Power quality;Accuracy;Microcontrollers;Hardware;Tiny machine learning;Power system harmonics;Planning;Edge AI;Edge AI;TinyML;load forecasting;smart metering;on-device inference;power quality;harmonics;interharmonics;ESP32-S3;ADE7880},
  doi={10.1109/ACCESS.2026.3658109},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11448882,
  author={Rao, Chikati Madava and Anusha, P and Shravya, Ch and Swathi, Mattaparthi and Sasikala, M. and B.Suresh},
  booktitle={2025 2nd International Conference on Recent Trends in Electrical, Electronics and Computing Technologies (ICRTEECT)}, 
  title={Light Weight Deep Learning for Enhancing Security in IoT and Smart Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Progress in modern times brought both rapid growth of smart devices and Internet of Things (IoT) together with simple connection abilities and automation control. Although the fast growth of smart devices and IoT poses essential security problems that involve data breaches together with unauthorized access and hostile cyber attacks. Limited resources among IoT devices present barriers for traditional security systems built around encryption cryptography and firewall defenses because these systems lack sufficient capability to identify threats in real-time. This study determines methods to enhance IoT and smart system security through lightweight deep learning model integration. Low-power optimized neural networks including MobileNet, TinyML and Quantized CNNs enable detection of anomalies together with malware signs and instant threat response utilizing minimum energy consumption compared to conventional deep learning systems that demand substantial processing resources. The proposed solution provides automated adaptation of security measures through federated learning and edge AI as well as adversarial defenses for privacy protection. Research demonstrates that low-cost processing supports lightweight deep learning models which achieve high accuracy levels exceeding 95% thus making them suitable for securing industrial automation systems as well as healthcare wearable’s smart homes and IoT networks. Deep learning models that operate efficiently enable IoT devices to deliver automatic real-time protection against cyber attacks which results in higher privacy standards as well as dependability and resilience in smart environments of the future.},
  keywords={Deep learning;Automation;Tiny machine learning;Smart homes;Real-time systems;Malware;Internet of Things;Security;Smart devices;Protection;Smart devices;IoT;lightweight deep learning;IoT security;adversarial defence;anomaly detection},
  doi={10.1109/ICRTEECT67512.2025.11448882},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11470278,
  author={Mellit, Adel and Zennaro, Marco},
  booktitle={2025 International Conference on Artificial Intelligence, Embedded Systems, and Renewable Energy (AIESRE)}, 
  title={Recent Advances in the Application of TinyML and Edge Devices in Photovoltaic Systems: Bridging the Gap Between Laboratory Research and Industry}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={With advancements in Artificial Intelligence (AI) techniques and embedded systems, various platforms have been developed to design and deploy Tiny Machine Learning (TinyML) on edge devices for real-time applications. TinyML enables ML models to run efficiently on resource-constrained devices, making it particularly useful in photovoltaic (PV) systems. This paper briefly overviews potential TinyML applications in PV systems, including solar energy forecasting, fault detection and diagnosis, predictive maintenance, and more. Recent applications are discussed regarding the edge devices used, platforms, accuracy and real-time deployment. Most research in this topic is still conducted at the laboratory scale; therefore, bridging the gap between laboratory research and industry is crucial for transitioning from theory to real-world applications. The paper also discusses the challenges and outlines future directions for implementing embedded ML on edge devices in real-world PV system applications.},
  keywords={System-on-chip;Central Processing Unit;Field programmable gate arrays;Microcontrollers;Microprocessors;Circuits and systems;Application specific integrated circuits;Electronic circuits;Integrated circuits;Internet;Photovoltaic;TinyML;embedded Machine learning;edge devices},
  doi={10.1109/AIESRE67541.2025.11470278},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11318821,
  author={Aboudrar, Yassine and Kissi, Chaïmaâ and Srifi, Mohamed Nabil},
  booktitle={2025 7th International Symposium on Advanced Electrical and Communication Technologies (ISAECT)}, 
  title={Early Detection of Solar Panel Faults Using Embedded Machine Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The global shift to renewable energy depends critically on the dependability of photovoltaic (PV) systems. Although current methods for detecting PV faults, such as thermal imaging, drone inspections, or artificial neural networks, have proven to be highly accurate, they frequently depend on expensive equipment, intricate setups, or cloud-based computing that impede real-time and embedded deployment. By presenting a unique Embedded Machine Learning (EML) framework for proactive, low-power, on-site PV failure detection, this study gets beyond these restrictions. Our Support Vector Machine (SVM) classifier, in contrast to ANN-based models, is designed for lightweight deployment on an ESP32 microcontroller, guaranteeing reliable performance with low computational overhead. When combined with high-precision sensors, data preprocessing, and IoT interaction with Adafruit IO and MQTT, the system attains a 96.5% classification accuracy while using just 250 mw significantly reducing the energy footprint compared to existing solutions. This work demonstrated the possibility of deploying scalable, autonomous, and energy-efficient diagnostic systems in resource-constrained environments with real-time monitoring, which had not been taken into consideration in prior papers in the literature, in addition to early identification of common faults like shading, short circuits, open circuits, and hot spots. This work makes an exceptional contribution to solar energy predictive maintenance by bridging the gap between cutting-edge AI methods and real-world field application, opening the door for more intelligent and greener PV installations.},
  keywords={Support vector machines;Accuracy;Tiny machine learning;Sensor systems;Real-time systems;Sensors;Circuit faults;Internet of Things;Space vector modulation;Predictive maintenance;Photovoltaic Systems;Fault Detection;Embedded Machine Learning;TinyML;ESP32;Support Vector Machine (SVM);Internet of Things (IoT);MQTT;Predictive Maintenance;Hardware Integration;Meteorological Station;Precision Sensors;Low-Power Computing},
  doi={10.1109/ISAECT68904.2025.11318821},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11139345,
  author={Zhang, Ning},
  booktitle={2025 International Conference on Artificial Intelligence and Engineering Management (ICAIEM)}, 
  title={Research on Lightweight AI Models for UAV Identity Authentication and Intrusion Detection in the Low-Altitude Economy}, 
  year={2025},
  volume={},
  number={},
  pages={91-95},
  abstract={This paper proposes a TinyML-based lightweight deep learning model to address the risks of UAV identity forgery and illegal intrusion, enabling real-time identity authentication and abnormal behavior detection at the drone edge. To further optimize computational efficiency, we explore pruning and dynamic sparsity techniques alongside quantization-aware training, reducing FLOPs by 40% without accuracy loss. By combining depthwise separable convolution with an attention mechanism, the proposed network architecture significantly reduces computational complexity while maintaining recognition accuracy. Future work will integrate multimodal data (e.g., acoustic/lidar) to enhance robustness against environmental variations. Experimental results demonstrate that the model achieves 98.7% accuracy in UAV identity authentication tasks, an F1-score of 96.3% for anomaly detection, and a compact size of only 1.2MB, enabling real-time inference on mainstream drone edge computing chips. This research provides an effective lightweight solution for low-altitude economy security, with scalability to diverse regulatory frameworks.},
  keywords={Accuracy;Computational modeling;Scalability;Image edge detection;Authentication;Intrusion detection;Autonomous aerial vehicles;Real-time systems;Security;Drones;Low-altitude economy;UAV security;Identity authentication;Intrusion detection;TinyML;Lightweight model},
  doi={10.1109/ICAIEM66060.2025.11139345},
  ISSN={},
  month={June},}@INPROCEEDINGS{10121852,
  author={Mabunda, Ntsako and Ramotsoela, Daniel T. and Abu-Mahfouz, Adnan M.},
  booktitle={2022 International Conference on Artificial Intelligence of Things (ICAIoT)}, 
  title={Intrusion Detection In Water Distribution Systems Using Machine Learning Techniques}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={Water distribution systems/networks (WDS/WDN) use complex pipe networks to distribute water from reservoirs, tanks and rivers to consumers. Over the years, the water industry has deployed SCADA (Supervisory Control and Data Acquisition) systems into WDNs so that there is a uniform water balance and so that the demands of a fast-growing world population are met optimally. These SCADA systems use standard protocols, hardware and software and thus are targeted due to their propensity to connect to institutional networks and the internet. Accurate and timeous detection of these attacks is necessary to protect critical infrastructure. Recently, Machine learning (ML) models have been initiated so that these cyber-attacks can be detected. These models can be categorized as Regression and prediction-based models, Classification-based models and Min-max based models. This paper will serve to cover the research gap in intrusion detection using machine learning, specifically in water distribution networks. This paper will aid in understanding which machine learning techniques are best suited for water distribution applications.},
  keywords={Sociology;SCADA systems;Intrusion detection;Machine learning;Distribution networks;Predictive models;Software;Water distribution network (WDN);Systems control and data acquisition (SCADA);Logistic Regression (LR);K-Nearest Neighbors (K-NN)},
  doi={10.1109/ICAIoT57170.2022.10121852},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10121875,
  author={Aljazairy, Ban Jabbar and Çevik, Mesut},
  booktitle={2022 International Conference on Artificial Intelligence of Things (ICAIoT)}, 
  title={Photovoltaic Cells Anomaly Classification Using Deep Learning Techniques}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={In recent years, solar photovoltaic (PV) systems have seen widespread use in the field of environmentally friendly energy harvesting. Additionally, the rate at which units reach the end of their useful life cycle is increasing. Heavy metals like lead, tin, and cadmium can be found in solar modules and cause environmental damage. Regular inspections and maintenance for your solar modules are essential to extending their useful life, cutting down on energy waste, and keeping the environment safe. This paper proposes a system that uses PV cell electroluminescence (EL) and deep learning techniques to efficiently screen for and categorize solar modules that exhibit anomalous behavior. Deep neural networks can accurately predict anomalies and classify types of anomalies. Using PV cell electroluminescence, we propose convolution neural network techniques based on residual network architecture and ensemble technology to accurately predict and classify anomalous solar modules.},
  keywords={Deep learning;Microprocessors;Photovoltaic cells;Neural networks;Computer architecture;Tin;Maintenance engineering;Solar Panel;Detection;Classification;Pv Cell;and Rcnn},
  doi={10.1109/ICAIoT57170.2022.10121875},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10780547,
  author={Zhang, Heng and Wang, Yinchu and Xue, Yawen and Deng, Ruilong and Li, Hongran and Zhang, Jian},
  booktitle={2024 International Conference on Artificial Intelligence of Things and Systems (AIoTSys)}, 
  title={Fourier Series Fitting-Based Intrusion Detection for Real-Time Industrial Control Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Recent incidents have shown the attacks against Industrial Control System (ICS), which may result in failure or even catastrophe and prompt the studies of defense. Existing security systems are mostly based on network perimeter defenses which lacking effective countermeasures in the event that such defenses are bypassed and attackers gain access to the system. In this paper, we propose a Fourier series fitting based intrusion detection method, which enables a detection and an alarm when ICS is under attack. Specifically, we first divide the data into three parts based on time with a sliding window, namely real-time data, sliding window data to be predicted, and historical data. Then we fit the data within the prediction window to the data around the window, together with the root mean squared error (RMSE) calculated for the data within the window and the historical data. The intrusion detection system (IDS) will alarm when the difference between the above RMSE and the reference one is greater than a threshold value. We test two types of data injection attacks, extensive simulations illustrate the effectiveness of our method in detecting both of these attacks.},
  keywords={Industrial control;Fitting;Intrusion detection;Control systems;Polynomials;Real-time systems;Windows;Fourier series;Security;Internet of Things;Fourier Series;Curve Fitting;Sliding Window;Root Mean Squared Error;Industrial Control System},
  doi={10.1109/AIoTSys63104.2024.10780547},
  ISSN={},
  month={Oct},}@INBOOK{10790733,
  author={Houmer, Meriem and Ouaissa, Mariya and Ouaissa, Mariyam and Eddamiri, Siham},
  booktitle={Artificial Intelligence of Things in Smart Environments: Applications in Transportation and Logistics}, 
  title={Applying machine learning algorithms to improve intrusion detection system in IoV}, 
  year={2022},
  volume={},
  number={},
  pages={35-50},
  abstract={Since the last decade, Internet of vehicles (IoV) keeps attracting the interest of researchers and automakers with a growing variety of applications and services. The aim of these applications is to provide road safety and comfort for drivers and passengers. However, the quantities of data propagated in this network make its security a challenge. The big data generated, collected, and processed on IoV involve valuable and delicate information that malicious intruders might manipulate. Besides that, the specific characteristics of IoV make intrusion detection in this network complicated. The intrusion detection system (IDS) represents the most common approach for network protection. It monitors the traffic activity to identify signs of safety risks and generates alerts for any security anomalies detected. In order to ensure the accuracy of intrusion detection in IoV, the main purpose of this chapter is to apply machine learning (ML) algorithms for training the IDS with a sufficient dataset of security menaces. The IDS based on ML will be able to make crucial decisions in case of intrusion detection whereas continuing to learn about their highly dynamic environment. This chapter describes different security issues in IoV and presents diverse ML algorithms employed for constructing IDS toward protecting IoV from diverse cyber-attacks.},
  keywords={Security;Intrusion detection;Radiofrequency identification;Touch sensitive screens;Social networking (online);Road safety;Monitoring;Mobile ad hoc networks;Machine learning algorithms;Machine learning},
