  pages={450-456},
  abstract={Management of water quality is a very challenging task?for the protection of public health, ecosystem and economic reasons. recent water quality monitoring systems that?use Internet of Things (IoT), machine learning (ML) and sensors? Through systematic watering, waste and other?systems in environmental, agricultural and industrial contexts; this work highlights trends, innovations and challenges which persist in water research. Although IoT-enabled sensors integrated with ML algorithms achieve up?to 88.6% accuracy in laboratory, only 31% of studies (14/46) provide field validation. Important factors concerning pH,?turbidity, total dissolved solids systems such as ESP32 (26.47%) and Arduino (23.53%) with XG Boost being the most?frequently used algorithm (33.33% of implementations). Still there are significant hardware limitations and sensor reliability is?a big bottleneck (68% of field deployments[1] report drift problems needing monthly recalibration). This work makes three novel contributions: (1) first quantitative analysis of the laboratory-to-field deployment gap across diverse geographical contexts (Bangladesh, USA, China, South Africa). (2) comprehensive constraint taxonomy identifying hardware-software co-design requirements. (3) science-based suggestions to close the distance between research prototypes and operational systems. Key recommendations include standardized validation protocols, drift-compensating calibration algorithms, energy-efficient architectures, and integration of water quality with quantity management for sustainable resource administration. We conducted a comparative assessment of 13 primary research studies, selected from an initial sample of 46 papers (2015-2025), using a mixed-methods approach to assess the transition of IoT-ML structures from the laboratory to the sector. The evaluation identifies excessive scalability obstacles, specifically sensor go with the flow (68% of instances) and reminiscence constraints (<100KB RAM) that currently prevent operational reliability.},
  keywords={Modeling;Internet of Things;Water quality;Image sensors;Water;Monitoring;Machine learning;Accuracy;Timing;Hardware;water quality monitoring;iot devices;machine learning;real time detection;tinyml;sensor networks;water purification;environment surveillance},
  doi={10.23919/CCICTCPS00010.2026.00080},
  ISSN={},
  month={April},}@INPROCEEDINGS{11510675,
  author={Ammiche, Sarah and Gadri, Said},
  booktitle={2025 26th International Arab Conference on Information Technology (ACIT)}, 
  title={Fire Detection and Localization Using AI and IoT: Trends and Future Directions}, 
  year={2025},
  volume={},
  number={},
  pages={696-705},
  abstract={Early fire detection is critical to protecting people, property, and the environment. Recent advances in artificial intelligence (AI), the Internet of Things (IoT), and edge computing have enabled faster and more intelligent solutions than traditional smoke- or heat-based detectors. This survey reviews state-of-the-art research and organizes it into three complementary categories: (i) vision-based systems, (ii) sensor-based and fusion systems, and (iii) AI- and IoT-enabled edge deployments. In addition, we summarize fire localization approaches and identify open challenges and research gaps related to evaluation metrics, real-world robustness, and deployment constraints. The goal is to provide researchers and practitioners with a comprehensive and practical reference for designing intelligent, reliable, and field-deployable fire detection systems.},
  keywords={Fires;Firing;Internet of Things;Modeling;Image sensors;Signal detection;Timing;Location awareness;Energy;Autonomous aerial vehicles;Fire Detection;IoT;Deep Learning;Edge AI;Sensor Fusion;Computer Vision;TinyML;Fire Localization;GIS},
  doi={10.1109/ACIT68900.2025.11510675},
