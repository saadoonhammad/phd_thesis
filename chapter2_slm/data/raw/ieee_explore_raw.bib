  url={https://ieeexplore.ieee.org/document/11345352},}@INPROCEEDINGS{11181444,
  author={Huang, Der-Chen and Hsiao, Chun-Fang and Wang, Ching-Li and Chu, Ying-Yi},
  booktitle={2025 6th International Conference on Big Data & Artificial Intelligence & Software Engineering (ICBASE)}, 
  title={Prediction Method for Abnormal Behaviors of Embedded Systems}, 
  year={2025},
  volume={},
  number={},
  pages={198-202},
  abstract={With the rise of Artificial Intelligence Internet of Things (AIoT), the demand for embedded systems has increased. In the past, different testing tools were required for the security testing of different embedded systems, resulting in increased manpower and time costs. This study proposes a method for detecting and predicting abnormal behaviors of embedded systems, which can be adapted to different embedded systems, avoiding the need for the establishment of specific abnormal detection systems on different embedded systems. This can reduce the development and time costs of some anomaly detection systems. In addition, the server can be used to monitor embedded systems and manage different embedded systems. This study uses Arduino Mega2560 Rev3 as the development and verification platform of the embedded system. Different malicious behaviors in four experiments are used to verify the feasibility of the proposed method. The experimental results show that using the instruction sequence of the proposed embedded system as behavioral feature data is an effective method of detecting abnormal behaviors within the system.},
  keywords={Embedded systems;Costs;Predictive models;Shift registers;Internet of Things;Servers;Security;Long short term memory;Testing;Software engineering;embedded system;abnormal behaviors;program instructions;Multiple Input Shift Register (MISR) compression;Long Short-Term Memory (LSTM)},
  doi={10.1109/ICBASE66587.2025.11181444},
  ISSN={},
  month={July},}@INPROCEEDINGS{11440831,
  author={Zhou, Yu and Sun, Yuan},
  booktitle={2025 5th International Symposium on Artificial Intelligence and Big Data (AIBDF)}, 
  title={Research on AIoT-based Intelligent Early Warning System for Workshops}, 
  year={2025},
  volume={},
  number={},
  pages={1061-1066},
  abstract={With the integration of Industrial Internet of Things (IIoT) and Artificial Intelligence (AI) technologies, traditional manufacturing is evolving towards digitalization. Addressing issues such as information silos and slow response in traditional workshop warning systems, this paper researches an AIoT-based intelligent early warning system for workshops. The system adopts a hierarchical "Cloud-Edge-Device" collaborative architecture, utilizing the terminal perception layer for video and image collection and recording, relying on the edge computing layer for data analysis, and leveraging the cloud analysis layer for historical data analysis and information mining. This paper focuses on key technologies such as multi-modal data fusion, edge-cloud collaboration, and lightweight algorithm design, and analyzes the system's practical utility in scenarios like predictive maintenance, personnel safety management and control, and environmental monitoring. The results indicate that this system can transform existing passive systems into active prevention, improving workshop production efficiency and reducing the rate of unexpected failures. Finally, this paper prospects the future challenges and research directions the system will face regarding data security, algorithm interpretability, and system integration.},
  keywords={Cloud computing;Conferences;Safety management;Collaboration;Computer architecture;Production;Alarm systems;Artificial intelligence;Industrial Internet of Things;Predictive maintenance;AIoT;Intelligent Early Warning;Predictive Maintenance;Industrial Internet of Things (IIoT);Anomaly Detection},
  doi={10.1109/AIBDF67964.2025.11440831},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9533927,
  author={Ren, Haoyu and Anicic, Darko and Runkler, Thomas A.},
  booktitle={2021 International Joint Conference on Neural Networks (IJCNN)}, 
  title={TinyOL: TinyML with Online-Learning on Microcontrollers}, 
  year={2021},
  volume={},
  number={},
  pages={1-8},
  abstract={Tiny machine learning (TinyML) is a fast-growing research area committed to democratizing deep learning for all-pervasive microcontrollers (MCUs). Challenged by the constraints on power, memory, and computation, TinyML has achieved significant advancement in the last few years. However, the current TinyML solutions are based on batch/offline setting and support only the neural network's inference on MCUs. The neural network is first trained using a large amount of pre-collected data on a powerful machine and then flashed to MCUs. This results in a static model, hard to adapt to new data, and impossible to adjust for different scenarios, which impedes the flexibility of the Internet of Things (IoT). To address these problems, we propose a novel system called TinyOL (TinyML with Online-Learning), which enables incremental on-device training on streaming data. TinyOL is based on the concept of online learning and is suitable for constrained IoT devices. We experiment TinyOL under supervised and unsupervised setups using an autoencoder neural network. Finally, we report the performance of the proposed solution and show its effectiveness and feasibility.},
  keywords={Training;Performance evaluation;Deep learning;Adaptation models;Microcontrollers;Neural networks;Memory management},
  doi={10.1109/IJCNN52387.2021.9533927},
  ISSN={2161-4407},
  month={July},}@INPROCEEDINGS{10193265,
  author={Chepyk, Oleksiy and Bruna, Arcangelo and Campolo, Maurizio and Mammone, Nadia and Morabito, Franceso Carlo and Ruggeri, Giuseppe and Tomaselli, Valeria},
  booktitle={2023 8th International Conference on Smart and Sustainable Technologies (SpliTech)}, 
  title={An Embedded EOG-based Brain Computer Interface System for Robotic Control}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Brain computer interfaces (BCIs) provide new opportunities for individuals with motor disabilities to interact with their environment. One challenge for BCI systems is to produce control commands for robotics quickly and accurately. This study proposes using four types of electrooculography (EOG) signals, including left and right winks, voluntary and involuntary eye blinks, to control a remote robotic system. Voluntary and involuntary eye blinks are differentiated to avoid unintended commands. The system uses tinyML algorithm to analyze and interpret the EOG signals in real-time, adapting to resource-limited settings. The proposed system includes an event detection algorithm to select signal segments and a 1D CNN for classification. Our BCI solution is entirely embedded on a custom-made board with dedicated components and a STM32L476RG microcontroller unit (MCU) which takes care of the whole process without the need of any external device. The system enables three degrees of freedom control (e.g., a robotic platform) with 99.3% average classification accuracy for the four classes of EOG signals. Multiple users have tested the system, reporting high accuracy and ease of use when controlling a three-wheeled robot.},
  keywords={Performance evaluation;Electrooculography;Microcontrollers;Event detection;Real-time systems;Brain-computer interfaces;Robustness;noninvasive BCI;EOG Blink/Wink Classifier;TinyMl;1D-CNN;Real-time;Reliable;Low-Cost;MCU;Low Energy},
  doi={10.23919/SpliTech58164.2023.10193265},
  ISSN={},
  month={June},}@INPROCEEDINGS{10731064,
  author={Sai Krishna, J V N and Anand, R. and Ramprabhakar, J. and Meena, V. P. and Benedetto, Francesco},
  booktitle={2024 IEEE 3rd World Conference on Applied Intelligence and Computing (AIC)}, 
  title={Integrated Airflow and Temperature Monitoring System for Enhanced Underground Mine Safety}, 
  year={2024},
  volume={},
  number={},
  pages={1235-1241},
  abstract={Beneath the surface lies a huge challenge and opportunity, the underground environment of coal mines. This subterranean world, where human endeavor meets the rawness of nature, is a melting pot of industry, technology, and resource extraction. Coal mining is an industry deeply rooted in history, dating back centuries to the earliest human civilizations. It represents an effort to use the Earth’s ancient energy reserves, stored as carbon-rich coal, for heating, industrial processes, and power generation. Mining in the underground environment presents a unique set of challenges and risks that require constant vigilance and innovative safety measures. This article proposes a continuous, seamless monitoring system that transmits the underground mine data to the surface station which requires advanced arrangements to emerge from the impediments of routine hardware, which falls flat to supply real-time knowledge. Next, attention is drawn to a cutting-edge system fitted with an ESP32 microcontroller, temperature, CO, methane, and airflow sensors, and LoRa for data transfer. Thresholds and buzzers have been set for alarming, which alerts workers at the right moment. A novel TinyML-based anomaly detection system that integrates with an Arduino cloud and MQTT broker. By implementing cutting-edge techniques and imposing historical constraints, this revolutionary strategy ultimately increases the safety of under- ground mines where there will be a significant improvement in safety monitoring technology.},
  keywords={Temperature sensors;Temperature measurement;Performance evaluation;Temperature distribution;Tiny machine learning;Real-time systems;Sensor systems;Safety;Coal mining;Monitoring;LoRa;MQTT;Telemonitoring;TinyML;Mobile Application},
  doi={10.1109/AIC61668.2024.10731064},
  ISSN={},
  month={July},}@INPROCEEDINGS{11338608,
  author={Wang, Jung-Hua and Weng, Yu-Ting and Lai, Yi-Chung and Huang, Chih-Wei and Huang, Chang-Wen and Chiang, Chung-Ping},
  booktitle={2025 TRON Symposium (TRONSHOW)}, 
  title={Edge AIoT for Smart Breeding: Real-Time Phenotype Analysis in Taiwan Tilapia}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Conventional aquaculture breeding is often labor-intensive and susceptible to genetic degradation over generations. To address these challenges, this study initiates a multi-year research project aimed at developing a smart breeding platform that integrates state-of-the-art deep learning (DL) models, high-throughput IoT sensing, and an omics cloud infrastructure. Supported by Taiwan’s Ministry of Agriculture, the project focuses on elucidating genotype–phenotype relationships to advance data-driven breeding strategies. This paper reports the first-year outcomes using Tilapia as a model species. Algorithms harnessing the outcome of DL were implemented for real-time monitoring of fish morphology, behavior, and environmental conditions. The behavior recognition model achieved an F1-score of 95% and a precision of 91%, indicating high classification performance. Concurrently, the stereo vision-based measurements demonstrated high accuracy, with a mean error rate < 4% for length estimation. YOLOv11s achieved 0.78 mAP@50 and 0.93 mAP@50, at 30 FPS on RTX 2080Ti, for detection and size estimation of juvenile fish aged 1-3 months, demonstrating the platform’s potential for scalable, AI-driven aquaculture breeding.},
  keywords={Phenotypes;Measurement uncertainty;Estimation;Morphology;Length measurement;Fish;Real-time systems;Sensors;Behavior recognition;Aquaculture;AIoT;fish breeding;phenotypic trait;genotype;behavior recognition},
  doi={},
  ISSN={},
  month={Dec},}@ARTICLE{11130497,
  author={Costa, Miguel and Gomes, Tiago and Pinto, Sandro},
  journal={IEEE Internet of Things Journal}, 
  title={SecureQNN: Shielding the Intellectual Property of QNNs in TinyML Systems}, 
  year={2025},
  volume={12},
  number={21},
  pages={44642-44655},
  abstract={Building accurate machine learning (ML) models requires substantial expertise and large-scale datasets typically only available in big data companies. These companies have been selling their models as ML as a Service. However, concerns about data privacy and the appliance of ML in mission-critical scenarios are forcing ML computation to move from the cloud to the deep edge, near sensor data. If edge ML increases user data privacy and makes decision latency predictable, deploying proprietary ML models on untrusted edge devices may harm the intellectual property of service provider. A natural response to this issue comes from trusted execution environments (TEEs), which provide hardware-based security. However, adapting ML computation to the constraints of TEEs remains an open challenge. In this article, we propose SecureQNN, a framework that leverages state-of-the-art TEE technology (TrustZone-M) available in Arm Cortex-M microcontrollers to increase the protection of quantized neural networks (QNNs) against unauthorized replication. SecureQNN evaluates which layers lessen the effort of an attacker when building a surrogate QNN with the same accuracy. The layers making the attacker spend less training epochs than the owner training from scratch are stored and executed in the secure-world of the TEE. Experiments demonstrate that SecureQNN undermines the cost-benefit of unauthorized QNN replication by isolating 51%–65% of the model size while incurring a worst-case decision latency overhead of only 0.06%. Although SecureQNN has broader applicability, the negligible impact on decision latency and its deterministic behavior highlight the suitability of SecureQNN for mission-critical and real-time applications.},
  keywords={Internet of Things;Intellectual property;Data models;Computational modeling;Accuracy;Training;Threat modeling;Training data;Protection;Data privacy;Arm cortex-M;machine learning (ML) privacy;quantized neural networks (QNNs);trusted execution environment (TEE);TinyML;TrustZone},
  doi={10.1109/JIOT.2025.3600300},
  ISSN={2327-4662},
  month={Nov},}@ARTICLE{9552498,
  author={Wang, Zhixuan and Liu, Ying and Zhou, Peng and Tan, Zhichao and Fan, Haitao and Zhang, Yihan and Shen, Linxiao and Ru, Jiayoon and Wang, Yangyuan and Ye, Le and Huang, Ru},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 148-nW Reconfigurable Event-Driven Intelligent Wake-Up System for AIoT Nodes Using an Asynchronous Pulse-Based Feature Extractor and a Convolutional Neural Network}, 
  year={2021},
  volume={56},
  number={11},
  pages={3274-3288},
  abstract={This article presents a 148-nW always-on wake-up system that drastically reduces the system power consumption of Internet of Things (IoT) sensor nodes while oftentimes operating in random-sparse-event (RSE) scenarios. To significantly reduce the long-term average (LTA) power consumption and realize multiapplication and intelligent event detection, three techniques are proposed: 1) In a three-stage pipelined event-driven architecture, a frame generator and a convolutional neural network intelligent inference engine (CNN IIE) in stage III are event-driven by the preliminary detectors in stage II, and the detectors are triggered by a level-crossing (LC) analog-to-digital converter (ADC), i.e., stage I, dramatically reducing the overall power consumption. 2) The clock-free pulse-based instant rate of change (IROC) feature extractor directly processes the asynchronous pulses of the LC-ADC outputs in the temporal domain instead of utilizing a conventional power-hungry frequency-domain method. 3) A reconfigurable IROC, the frame generator, and the CNN IIE provide adaptive intelligence for various IoT events, enhancing the accuracy of multipurpose detection with ultralow power. We demonstrate two artificial intelligence IoT (AIoT) applications at 0.6-V VDD. For electrocardiogram (ECG) recognition, one example works at a typical event rate (ER) of ~4800/h, with an active power of 1.68  $\mu \text{W}$  and a precision of up to 99%; the other is used for keyword spotting (KWS), where the chip achieves 378 nW at ~720/h ER and 94% accuracy. The LTA power is bounded to 148 nW, while the event-driven chip is on call and waiting for events; this chip dominates the AIoT device battery life in RSE scenarios.},
  keywords={Power demand;Feature extraction;Task analysis;Erbium;Detectors;Neural networks;Convolutional neural networks;Always-on wake-up chip;artificial intelligence Internet of Things (AIoT);asynchronous;convolutional neural network (CNN);event-driven architecture;level-crossing (LC) analog-to-digital converter (ADC);random sparse event (RSE);reconfigurable;temporal-domain feature extraction},
  doi={10.1109/JSSC.2021.3113257},
  ISSN={1558-173X},
  month={Nov},}@INPROCEEDINGS{10315589,
  author={Huang, Xiang-Rui and Huang, Guan-Zhi and Chen, Liang-Bi},
  booktitle={2023 IEEE 12th Global Conference on Consumer Electronics (GCCE)}, 
  title={A Deep Learning-based ROV Surveillance System for Monitoring Illegal Fishing}, 
  year={2023},
  volume={},
  number={},
  pages={1190-1191},
  abstract={The issue of illegal fishing is a global concern that requires attention. This paper focuses on marine biodiversity and sustainable development and proposes a deep learning-based computer vision technology for monitoring illegal fishing using ROV surveillance systems. By combining deep learning-based technology with a remotely operated underwater vehicle (ROV), supervisors can remotely control the underwater robot to take images and send them to the AI server through a 4G/5G mobile network. The AI server quickly identifies any instances of illegal fishing by divers in underwater images. Additionally, supervisors can use the illegal fishing monitoring platform to monitor for any illicit activity fishing underwater.},
  keywords={Deep learning;Autonomous underwater vehicles;Computer vision;Surveillance;Real-time systems;Safety;Servers;AIoT;illegal fishing;deep learning},
  doi={10.1109/GCCE59613.2023.10315589},
  ISSN={2693-0854},
  month={Oct},}@ARTICLE{11471831,
  author={Wang, Tianjing and Huang, Sunhua and Zhang, Zhijun and Huang, Zuliang and Zheng, Zuqing and Dong, Zhao Yang},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={Risk-Aware AIoT-Based Fault Detection for Power Line Monitoring in Consumer Energy Systems}, 
  year={2026},
  volume={72},
  number={2},
  pages={4018-4028},
  abstract={Reliable power line monitoring is critical for consumer energy systems that increasingly depend on distributed sensors, smart terminals, and IoT-enabled edge devices. In practical deployments, fault detection performance is often affected by changing operating conditions, noisy measurements, and unreliable prediction confidence. This paper proposes a risk-aware AIoT-based fault detection framework that integrates multi-domain signal representation, uncertainty-aware inference, and confidence-adaptive decision making. High-frequency waveform signals are analyzed across time, frequency, and wavelet domains to capture complementary fault characteristics, and are adaptively fused to preserve localized and nonstationary patterns. Instead of producing deterministic outputs, a Dirichlet-based Prior Network is employed to jointly estimate fault probability and predictive uncertainty. These quantities are combined into a scalar risk score that enables a three-outcome decision strategy, allowing the system to issue alarms, defer uncertain cases, or identify normal operation. Experiments on a real-world power line dataset show that the proposed approach maintains stable detection performance and well-calibrated confidence under distribution shift. The results demonstrate that incorporating uncertainty-aware inference and risk-adaptive decision logic improves the reliability of AI-enabled monitoring systems, making the framework suitable for IoT-driven consumer energy applications.},
  keywords={Feeds;High frequency;Internet of Things;Communication systems;Internet;Radio frequency;Network topology;Protocols;Zigbee;Fuses;Fault diagnosis;power line;risk-aware decision;predictive confidence;uncertainty-aware inference},
  doi={10.1109/TCE.2026.3680386},
  ISSN={1558-4127},
  month={May},}@INPROCEEDINGS{11037027,
  author={Khacha, Amina and Saadouni, Rafika and Harbi, Yasmine and Gherbi, Chirihane and Aliouat, Zibouda and Harous, Saad},
  booktitle={2024 International Conference of the African Federation of Operational Research Societies (AFROS)}, 
  title={Federated Learning and Convolutional Autoencoder for Robust Anomaly Detection in Agricultural IoT}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={Security is a vital challenge that must be addressed in the Agricultural Internet of Things (AIoT) to ensure enhanced productivity, quality, and resilience. Robust security measures are essential to protect sensitive data, prevent unauthorized access, and safeguard against cyberthreats, ultimately contributing to agricultural operations' overall efficiency and reliability. One solution to improve security is the integration of intelligent Intrusion Detection Systems (IDS) using deep learning methods. However, traditional deep learning training methods require centralizing data and compromise client privacy. Federated learning (FL) addresses this challenge by enabling privacy-preserving and cooperative training of deep learning models among clients. This paper presents an anomaly-based IDS using a Convolutional Autoencoder (CAE) and FL. We assess our proposed solution using a new real and large dataset, CICIoT-2023. We evaluate our model with independent and identically distributed (IID) and non-IID data distributions to further enhance performance. Our model demonstrates superior performance compared to centralized training, achieving a recall of 99.99% and an F1score of 99.40%.},
  keywords={Training;Deep learning;Productivity;Federated learning;Autoencoders;Intrusion detection;Security;Reliability;Internet of Things;Resilience;Privacy-preserving;Deep Learning;Convolutional Autoencoder (CAE);Independent and Identically Distributed (IID);Distributed training;Anomaly-based IDS},
  doi={10.1109/AFROS62115.2024.11037027},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9321824,
  author={Wu, Chung Kit and He, Yaqing and Tsang, Kim Fung and Mozar, Stefan},
  booktitle={2020 IEEE International Symposium on Product Compliance Engineering-Asia (ISPCE-CN)}, 
  title={The IDex Case Study on the Safety Measures of AIoT-based Railway Infrastructures}, 
  year={2020},
  volume={},
  number={},
  pages={1-4},
  abstract={Railway safety is a tremendously essential aspect of urban management. The railway network is a highly sophisticated infrastructure comprising numerous devices, machines, networks, services, etc. Therefore, the Internet-of-things (IoT) and Artificial Intelligence (AI) can be conceived as the crucial technologies for enabling ubiquitous data collection and unmanned decision-making, respectively. The exploitation of AI and IoT (AIoT) will ease the monitoring, fault detection, and decision-making in railway safety measures. Nonetheless, the AIoT may pose some new cyber threats to the railway infrastructure, such as unauthorized data modification and hijacking. An integral evaluation of IoT solutions is thus demanding. The IEEE Standards Working Group (WG) P2668 is developing a universal and objective standard to measure and quantify the maturity of IoT solutions. The IoT maturity index, namely the IDex, will be standardized to provide a comprehensive evaluation for all IoT objects pertinent to their performance and application requirements. The IEEE P2668 has conducted various case studies in different aspects, such as supply chain, mission-critical applications, Smart City development, etc. In this paper, the IDex case study on the AIoT-based railway safety measures will be presented and discussed.},
  keywords={Rail transportation;Safety;Maintenance engineering;Railway safety;Reliability;Random access memory;Sensors;The Internet-of-things Maturity Index;IDex;Railway Safety;Reliability;Availability;Maintainability;Safety},
  doi={10.1109/ISPCE-CN51288.2020.9321824},
  ISSN={},
  month={Nov},}@ARTICLE{11541114,
  author={Cotrino Herrera, Andres Felipe and López Sotelo, Jesús Alfonso and Toro Lazo, Alonso and Blandón Andrade, Juan Carlos},
  journal={IEEE Latin America Transactions}, 
  title={Intelligent Bearing Fault Detection: Deep Learning Model Assessment and Embedded System Deployment}, 
  year={2026},
  volume={24},
  number={7},
  pages={637-647},
  abstract={Bearings are vital parts used in many industrial settings; however, their failures can greatly reduce system efficiency and operational reliability. In this context, AI-driven predictive maintenance is an effective approach for identifying and classifying bearing faults via vibration analysis. This study creates a custom dataset by recording vibration signals from a DC motor operating under various fault conditions (bearing without lubrication, bearing with one missing ball, and bearing with two missing balls), as well as under normal operation (bearing without failure), using an accelerometer and a controlled test bench. Furthermore, four neural network models Multilayer Perceptron (MLP), Convolutional Neural Network (CNN), Long Short-Term Memory (LSTM), and Transformer were trained and evaluated based on accuracy, recall, and F1-score. The CNN model performed best, achieving a 99.95% accuracy on the validation dataset. This model was then implemented on an ESP32, reaching 94.2% accuracy during real-time testing. These results demonstrate that AI-based fault detection systems can be effectively deployed on resource-limited platforms, providing a promising solution for predictive maintenance and educational efforts to boost STEM skills.},
  keywords={Modeling;Convolutional neural networks;Vibrations;Accuracy;Training;Timing;Testing;Artificial intelligence;Deep learning;Long short term memory;Artificial Intelligence;Ball bearings;Data acquisition;Data analysis;Deep Learning;Spectral Analysis;TinyML;Vibration measurement},
  doi={10.1109/TLA.2026.11541114},
  ISSN={1548-0992},
  month={July},}@INPROCEEDINGS{11383067,
  author={Lakumarapu, Srikanth and Saranya, R. and S.Deepa and M, Prithya and S.Gayathri and M.G.Dinesh},
  booktitle={2025 5th International Conference on Evolutionary Computing and Mobile Sustainable Networks (ICECMSN)}, 
  title={Intelligent IoT: Leveraging Data Analysis, Computer Vision, and Machine Learning for Smart Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1353-1359},
  abstract={High growth rate of Internet of Things (IoT) devices has led to the generation of high-volume, heterogeneous data that demand the use of advanced techniques of intelligent processing and decision-making. This survey investigates the application of data analysis, computer vision(CV), and machine learning(ML) in IoT systems, what they are applied to and how they have impacted different spheres. Data analysis techniques, including statistical, predictive and real-time stream processing, can be used to provide IoT systems with actionable insights, anomaly detection and predictive maintenance. Computer vision allows the gadgets to perceive and interpret visual information, and this capability allows their application in intelligent surveillance, industrial safety, medical, and self-driving. IoT systems can be made more flexible, predictive, and able to make decisions on their own by using machine learning techniques such as supervised and unsupervised learning, deep learning, reinforcement learning, and online learning. The survey also examines integration methodologies such as edge, cloud and hybrid computing, sensor fusion, and multimodal data processing that enhances real time intelligence and efficiency in operations. What is more, it addresses the most important concerns, namely data heterogeneity, resource limitation, security, and scalability and suggests the research areas of the future, namely explainable AI, TinyML, federated learning, multimodal AI, and 5G/6G integration.},
  keywords={Surveys;Computer vision;Data analysis;Tiny machine learning;Surveillance;Decision making;Sensor fusion;Real-time systems;Internet of Things;Security;IoT;Data Analysis;Computer Vision;Machine Learning;Edge Computing;Intelligent Systems},
  doi={10.1109/ICECMSN68058.2025.11383067},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11006805,
  author={Vaddeboina, Mounika and Yilmazer, Alper and Ecker, Wolfgang},
  booktitle={2025 IEEE 28th International Symposium on Design and Diagnostics of Electronic Circuits and Systems (DDECS)}, 
  title={Energy-Efficient Neural Network Inference through Golomb-Rice Compression of Activations for Edge Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={A key challenge for Deep Neural Network (DNN) inference on resource-constrained edge devices is the high energy consumption caused by frequent memory accesses for parameters. While our previous research has demonstrated the efficacy of data compression for weights, this paper extends our approach to include on-the-fly compression and decompression of activations. We propose a comprehensive hardware solution comprising two main components: a Golomb-Rice (GR) compression system and an Output Activation Processing Module (OAPM). The GR system provides an efficient activation compression mechanism, while the OAPM enables dynamic data-format capabilities for handling activations. Additionally, we present an enhanced Input Activation Extract Module (IAEM) with an integrated decompression unit and dynamic activation processing capabilities. When integrated with an industry-strength Neural Network accelerator and evaluated using the Anomaly Detection (AD) TinyML benchmark, our lossless compression system achieved a 2.3× compression ratio, reduced memory bandwidth usage by 49.28%, and improved inference speed by 10%.},
  keywords={Energy consumption;Tiny machine learning;Image edge detection;Memory management;Artificial neural networks;Benchmark testing;Hardware;Energy efficiency;Integrated circuit modeling;Standards;Deep Neural Networks;Internet-of-Things;Neural Network accelerators;Golomb-Rice coding},
  doi={10.1109/DDECS63720.2025.11006805},
  ISSN={2473-2117},
  month={May},}@ARTICLE{11026240,
  author={Farahdel, Arash and Khan, Alimul H. and Keshmiri, Hossein and Wahid, Khan A.},
  journal={IEEE Access}, 
  title={TinySurveillance: An Extra Low-Power Event-Based Surveillance Method for UAVs}, 
  year={2025},
  volume={13},
  number={},
  pages={98542-98556},
  abstract={Uncrewed Aerial Vehicles (UAVs) have always been faced with power management challenges to extend their flight time. Managing power consumption becomes critical, especially in surveillance applications, where the longer flight time results in wider coverage and a cheaper solution. Most of the current studies show new methods for event detection without considering power consumption. This article presents an event-driven four-stage video surveillance pipeline with an efficient video transmission algorithm balancing power consumption and image quality. The surveillance starts automatically when the low-power AI-based onboard processor detects the desired event. When The edge node detects the defined event, a sample image is sent to the server for validation. After validation, a colored image accompanied by N grayscale images are sent to the server. The server colorizes the grayscale images using a convolutional neural network trained by the colored images. In this work, an application of wildfire detection and surveillance has been implemented to show the proof of concept of the TinySurveillance method. The results show that the power consumption of the onboard processing unit in detection mode reduces by at least 4 times; during the surveillance mode, the data transmission rate can be decreased by almost 66% while achieving a competent image quality PSNRAvg of 41.35 dB, PSNR of 30.94 dB, and output frame rate of 5.2.},
  keywords={Autonomous aerial vehicles;Surveillance;Power demand;Wildfires;Servers;Event detection;Cameras;YOLO;Real-time systems;Forestry;Surveillance;power consumption;TinyML;image colorization;wildfire},
  doi={10.1109/ACCESS.2025.3576192},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11324570,
  author={De Leon, Jan Nathaniel A. and Clemente, Jane Ira Dg. and Caragan, Bryan Benedict Ds. and Baez, Kaye Celene F. and Santiago, Paul Ryan A. and Lacara, Amor A. and Lapiguera, Donald M. and Jimenez, Nasher G. and Leyesa, Marlon C. and Calinao, Hilario A. and Galvez, Reagan L. and Cruz, Dennis R. Dela and Mariano, Oliver R.},
  booktitle={2025 International Conference on Green Energy, Computing and Sustainable Technology (GECOST)}, 
  title={Low Sampling Rate of Vibration Analysis Approach for Induction Motor Condition-Based Predictive Maintenance}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents a machine condition-based maintenance approach that leverages vibration data and embedded deep learning for real-time machine fault detection. Vibration signals were collected by a machine running at 1720 rpm and processed at a sampling rate of 1 Hz. Spectral features such as spectral power and RMS were extracted using FFT and then used to train a deep neural network classifier model. The model achieved a high accuracy of $96.9 \%$ in classifying machine faults, including faulty bearings, faulty belts, combined bearing and belt faults, and normal and failure conditions. The model has been optimized for use on a microcontroller. The model’s performance on a device with TensorFlow Lite and the Edge Optimized Neural Compiler is evaluated. The results show that the classifier model is suitable for real-time condition monitoring using an ESP32 processor. The results show that accurate machine fault classification can be achieved even with a lower sampling rate, making this solution feasible for edge computing applications in industrial environments.},
  keywords={Vibrations;Accuracy;Microcontrollers;Computational modeling;Tiny machine learning;Feature extraction;Belts;Real-time systems;Monitoring;Predictive maintenance;Predictive Maintenance;Signal Processing;Vibration Analysis;TinyML;Edge AI},
  doi={10.1109/GECOST66002.2025.11324570},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11602904,
  author={N, Varshitha D and U, Latha D and S, Sameeksha and Kumar, M Chaitanya},
  booktitle={2026 International Conference on Emerging Research in Smart Electronics and Machine Informatics (ECMI)}, 
  title={SmartLumina: Sustainable Lighting and Appliance Control using AI and IoT}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={The educational and medical facilities are deemed to be the institutions with high consumption of energy due to manual use of lights. The smart systems available are mostly home-based and are not flexible, scalable and in-built control. SmartLumina is an AIoT-based initiative, which automatically controls and manages light and appliances, with the assistance of human motion detection software by YOLO model, room mapping software, adaptive lighting controlled by an Light Dependent Resistor (LDR). The system also collects real-time solutions to energy optimization and sustainability analytics. The literature review is a critical analysis of the available technologies, identification of gaps in the study, and a complex, modular model of smart institutional automation.},
  keywords={Lighting;Internet of Things;Signal detection;Image sensors;Modeling;Timing;Energy;Real-time systems;Automation;Printing;Smart Home Automation;AIoT;YOLO model;Room Mapping;LDR Sensor;Adaptive Lighting},
  doi={10.1109/ECMI68341.2026.11602904},
  ISSN={},
  month={April},}@INPROCEEDINGS{11579689,
  author={Tiwari, Mohit and S, Lokesh N. and Muthusundari, S. and Kumar, Bura Vijay and Haldorai, Anandakumar and Krishna, V. Anantha},
  booktitle={2025 Asian Conference on Communication and Networks (ASIANComNet)}, 
  title={An Intelligent IoT Architecture with Embedded AI for Smart Automation}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Conventional cloud-based IoT systems frequently experience communication lags, scalability issues, and privacy risks, rendering them inadequate for immediate decision-making. This paper presents an Intelligent IoT Architecture featuring Embedded Artificial Intelligence (AI) that combines on-device learning, edge analytics, and adaptive automation techniques to tackle these challenges. The suggested architecture integrates diverse sensing modules, lightweight embedded AI models, and a multi-tier edge–fog–cloud framework to facilitate real-time inference and dynamic management. An innovative AI-powered decision engine is utilized at the edge layer with optimized TinyML models, guaranteeing minimal power usage and quick responses while upholding excellent prediction precision. The system independently adjusts to micro-environmental variations, user behavior trends, and operational scenarios using control policies based on reinforcement learning. Experimental analysis performed in smart-home and industrial automation contexts shows a 38%–55% decrease in latency, a 31% enhancement in automation precision, and as much as 28% energy savings compared to traditional cloud-reliant IoT systems. The findings emphasize the practicality and efficiency of integrating intelligence directly into IoT nodes, opening avenues for scalable, secure, and exceptionally responsive smart automation systems.},
  keywords={Internet of Things;Artificial intelligence;Modeling;Architecture;Computer architecture;Timing;Automation;Clouds;Printing;Technology;Internet of Things (IoT);Embedded Artificial Intelligence;Edge Computing;TinyML;Smart Automation},
  doi={10.1109/ASIANComNet68615.2025.11579689},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11517063,
  author={Tran, Ba Vu and Youssef, Mohamed Z.},
  booktitle={2026 IEEE Applied Power Electronics Conference and Exposition (APEC)}, 
  title={Multi-Model Embedded ML for Real-Time Fault Detection in Industrial Power Supplies}, 
  year={2026},
  volume={},
  number={},
  pages={144-149},
  abstract={Conventional threshold-based fault detection in industrial AC–DC power supplies often fails to identify soft faults, such as those induced by environmental stress and gradual sensor degradation. While machine learning can resolve these complex nonlinear signatures, existing approaches typically rely on desktop-class computing resources or cloud-based processing, leading to constraints in cost, size, and latency. This paper bridges this gap by introducing a multi-model embedded ML framework that executes five distinct classifiers directly on an STM32H7 microcontroller. These classifiers include Decision Tree, Gaussian Naive Bayes, Support Vector Machine, Extreme Learning Machine, and a Quantized Neural Network. To manage computational resources, a runtime scheduler utilizes confidence-based early-exit logic to invoke complex models only when necessary. The system supports dual-path integration via encrypted HTTPS/TLS for remote dashboard telemetry and legacy Modbus RTU for local monitoring and control. Experimental validation on a ruggedized IP68-rated prototype shows that all classifiers achieve strong performance, with the Quantized Neural Network attaining the highest accuracy at 97.47% and a macro F1-score of 0.96 across seven fault categories. All inference operations complete within a millisecond while requiring less than 50 kB of Flash memory. These results confirm that advanced fault diagnosis can be performed entirely on-device, eliminating dependence on external gateways or cloud connectivity.},
  keywords={Modeling;Vectors;Machine learning;Machining;Equations;Support vector machines;Tagging;Image sensors;Accuracy;Printing;Embedded machine learning;TinyML;fault detection;industrial power supplies;multi-model inference;edge computing;real-time classification;microcontroller},
  doi={10.1109/APEC51134.2026.11517063},
  ISSN={2470-6647},
  month={March},}@INPROCEEDINGS{9843050,
  author={Pau, Danilo and Ambrose, Prem Kumar},
  booktitle={2022 IEEE 21st Mediterranean Electrotechnical Conference (MELECON)}, 
  title={Automated Neural and On-Device Learning for Micro Controllers}, 
  year={2022},
  volume={},
  number={},
  pages={758-763},
  abstract={mW power consumption envelope, and below, is a pillar of the TinyML community, which aggregates contributions on algorithms, tools, software, and hardware for machine learning at the edge. In the tinyML context, this paper presents the state-of-the-art review of different approaches for Neural Architecture Search targeting resource constrained devices such as microcontrollers (MCU). As well as the implementations of On-Device Learning techniques for them. On the former, part of the paper reviews different approaches of Neural Architecture Search which consider the hardware constraints into the search mechanism and how they have been able to design a tiny neural network with low memory and computational requirements which can be deployed on cheap and off-the-shelf MCU. On the latter, the paper reviews the approaches and advanced solutions for On-Device Learning with MCU to address the concept drift and cope with the accuracy drop on real time data. Moreover, this paper also introduces Extreme Learning Machines (ELM) for feature extraction and some preliminary results using Restricted Coulomb Energy neural network for On-Device Classification Learning which is highly storage conservative and more suitable for tiny, embedded devices.},
  keywords={Performance evaluation;Power demand;Microcontrollers;Neural networks;Software algorithms;Process control;Hardware;resource constraints;tiny machine learning;micro controllers;neural architecture search;on device learning},
  doi={10.1109/MELECON53508.2022.9843050},
  ISSN={2158-8481},
  month={June},}@INPROCEEDINGS{11521799,
  author={Shah, Shlok},
  booktitle={2026 International Conference on AI Innovations and Industry (ICAIII)}, 
  title={Edge-Class Silicon for Always on Intelligence: A State Retentive ML SoC in 22 nm FD SOI}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents a fabricated ultra-low-power system-on-chip that couples a RISC-V host with a dataflow-reconfigurable ML engine, embedded non-volatile MRAM for state retention, and a hierarchical power-domain scheme for duty-cycled sensing. The digital architecture integrates a SIMD array with precision-scalable MACs, on-chip L1/L2 SRAM, TCDM and APB interconnects, a uDMA for peripheral streaming, and an always-on controller that orchestrates clocking, isolation, and power gating for deep sleep and low-latency wake-up. Design features include runtime switching between MMM and MVM dataflows, block-structured sparsity with zero-skipping support, and hardware hooks for deconvolution and SVM norm evaluation to broaden workload coverage beyond CNNs. Silicon measurements on the $22-\text{nm}$ FD-SOI node validate energy-proportional operation across wide voltage-frequency ranges, demonstrating sub-milliwatt always-on inference and micro-watt deep-sleep retention suitable for extreme-edge deployments. End-to-end tests with audio and anomaly-detection pipelines confirm that co-designed hardware and software stacks can sustain real-time throughput while meeting stringent PPAC targets in embedded electrical systems.},
  keywords={Printing;System-on-chip;Hardware;Arrays;Low power electronics;Timing;Machining;Modeling;Architecture;Computer architecture;Extreme edge;tinyML;machine learning accelerators;ultra-low power;system-on-chip;MRAM;power management},
  doi={10.1109/ICAIII69475.2026.11521799},
  ISSN={},
  month={April},}@INPROCEEDINGS{11580760,
  author={Barbadekar, Ashwini and Palshikar, Prathamesh and Nikam, Mrunal and Panaskar, Avishkar and Panindre, Aryan},
  booktitle={2025 IEEE 7th International Conference on Cybernetics, Cognition and Machine Learning Applications (ICCCMLA)}, 
  title={An Optimized Edge-AI Approach for Industrial Predictive Maintenance}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The increasing reliance on cloud-based analytics in industrial predictive maintenance introduces vulnerabilities in latency, connectivity, and data privacy. This work proposes a resource-optimized Edge-AI framework for anomaly detection and predictive maintenance in Industry 4.0 environments. Using the ESP32-S3 microcontroller integrated with the PZEM-004T sensor, real-time energy parameters were captured and analyzed locally through a TinyML model. To overcome edge device constraints, pruning and weight quantization were applied, enabling efficient inference on constrained hardware. Experimental validation on lathe machines demonstrated 100% classification accuracy in distinguishing safe and abnormal states. While the results are promising, they reflect controlled conditions; real-world deployments may yield lower but more realistic performance. The proposed system eliminates dependency on continuous connectivity while offering a scalable, low-cost, and privacy-preserving solution. Potential applications include high-stakes domains such as aircraft engines and remote industrial assets where reliable network access cannot be guaranteed.},
  keywords={Modeling;Internet of Things;Machining;Monitoring;Printing;Quantization (signal);Clouds;Predictive maintenance;Accuracy;Edge AI;Edge AI;TinyML;Predictive Maintenance;Industry 4.0;Anomaly Detection},
  doi={10.1109/ICCCMLA66092.2025.11580760},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11473901,
  author={Nguyen, Viet Linh and Lanh Chu, Duy and Vu, Xuan Tung and Huy Nguyen, Van and Dang, Tieu Binh and Hai Tran, Duy and Nguyen, Xuan An},
  booktitle={2025 Asia Meeting on Environment and Electrical Engineering (EEE-AM)}, 
  title={Non-Invasive Acoustic Monitoring of BLDC Fuel Pumps Using Blade-Pass and Broadband Features}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={We present a non-invasive approach to monitor the conditions of BLDC fuel pumps using an external microphone. A MEMS microphone (SPH0645LM4H-B) is placed outside the pump casing at a fixed distance and angle-without any intervention to the fuel line-and digitized by an STM32F407VET6 acquisition platform. Data were collected at 1000rpm–2atm, 2000rpm-5atm, and 3000rpm-5atm, each under two operating states: Normal and Aeration. The processing pipeline comprises Welch power spectral density (PSD), high-resolution short-time Fourier transform (STFT) with explicit k × BPF line overlays, and Mel-frequency cepstral coefficients (MFCC). Run-level features emphasize the tonal-broadband decomposition, including BPFP (energy ratio around BPF±40Hz to the broadband 0.5-8kHz), ∆BPF ± 40Hz(dB) harmonic prominence, spectral tonalness, and HF/LF ratios. Statistical analysis (Welch’s t-test, 95% confidence intervals, and Hedges’ g) reveals significant differences between Normal and Aeration (p<0.05), while pressure variation induces systematic shifts in spectral energy distribution. The results demonstrate that a non-invasive microphone is a cost-effective solution for early anomaly detection and load estimation, and is suitable for real-time deployment (TinyML) on embedded hardware.},
  keywords={Band-pass filters;Microcontrollers;Active filters;Filtering;Microprocessors;System-on-chip;Contacts;Filters;Microwave integrated circuits;Circuits and systems;non-invasive microphone;broadband;aeration;anomaly detection},
  doi={10.1109/EEE-AM66675.2025.11473901},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9887747,
  author={Fort, Ada and Landi, Elia and Moretti, Riccardo and Parri, Lorenzo and Peruzzi, Giacomo and Pozzebon, Alessandro},
  booktitle={2022 IEEE International Symposium on Measurements & Networking (M&N)}, 
  title={Hand-Arm Vibration Monitoring via Embedded Machine Learning on Low Power Wearable Devices}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a new approach for the measurement of the Hand-Arm Vibration (HAV) exposure caused by the use of vibrating tools. In so doing, a wearable system can be designed in order to be embedded on personal protection equipment of workmen, so to preserve their health and to avoid injuries. In particular, a Machine Learning (ML) model is introduced, whose aim is to distinguish between the absence and the presence of harmful vibrations. In this way, vibration dose assessment systems can operate discarding acceleration signals related to body movements shocks or any other non-vibrational signal. The classifier is trained on a dataset composed of accelerometer data acquired in a real world scenario thus ensuring the classifier performances reliability. Moreover, the classifier is designed for its deployment on a microcontroller. The data processing technique presented in this work can be implemented in portable low cost and low power devices for the measurement of the vibration transmitted to the hand of an operator due to the use of drills, jackhammers, or other vibrating tools. Indeed, Internet of Things (IoT) sensor nodes powered with Artificial Intelligence (AI) capability can be designed by following this approach. Therefore, the brand new concept of the Artificial Intelligence of Things (AIoT) is met.},
  keywords={Vibrations;Performance evaluation;Power measurement;Wearable computers;Machine learning;Vibration measurement;Particle measurements;Machine Learning;Artificial Intelligence;IoT;AIoT;Low Power Microcontroller;Hand-Arm Vibration Monitoring;Wearable Devices},
  doi={10.1109/MN55117.2022.9887747},
  ISSN={2639-5061},
  month={July},}@INPROCEEDINGS{11228464,
  author={Ragusa, Edoardo and Zonzini, Federica and De Marchi, Luca and Gastaldo, Paolo},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={The impact of Sensing Parameters on Vibration Anomaly Detection Using Tiny DNNs}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Smart sensors with extreme-edge data processing capabilities allow to optimize the energy budget of current Structural Health Monitoring (SHM) systems. Moving inference and Deep Neural Networks (DNNs) directly to the sensing unit can bypass the constraints due to data transmission, but it has to be properly balanced against the expenditure due to data sampling, which might easily become the main source of energy consumption when the duty cycling is not chosen appropriately. Finding the optimal sampling time and frequency is a non trivial task because it depends on the peculiarities of the target facility, the surrounding environment, and the highly non-linear behavior of DNNs. This paper presents a fully decentralized scheme for vibration damage detection where each sensor can predict the health status of the structure; a tiny Convolutional Neural Network (CNN) hosted on the node is entitled to autonomously process the measurements and to complete the inference. As a further contribution, an empirical study proves the major role played by the sampling parameters on the performance of the networks. Experiments on the Z24 bridge benchmark show that the small-size CNN can achieve classification scores comparable with state-of-the-art models while i) avoiding data transmission and ii) improving the energy budget if the optimal sensing parameters are chosen. These findings are obtained after deploying the sought CNN model on a wireless accelerometer sensor based on an STM32L496 processor. Results show that, by properly tuning the sampling parameters (length of the acquisition window and sampling frequency), one can reach the best trade-off between classification performances (accuracy above 96%) and energy consumption (less than 40 mJ/h).},
  keywords={Vibrations;Energy consumption;Noise;Network architecture;Data processing;Convolutional neural networks;Data communication;Monitoring;Tuning;Intelligent sensors;Smart sensors;TinyML;Structural Health Monitoring;extreme-edge data processing},
  doi={10.1109/IJCNN64981.2025.11228464},
  ISSN={2161-4407},
  month={June},}@ARTICLE{11602104,
  author={Chan, Yu Ho Enoch and Beheshti, Amin and Hanif, Ambreen and Sheikholeslami, Afrouz and Shabani, Nasrin and Alinejad-Rokny, Hamid and Qi, Yuankai and Porntaveetus, Thantrira},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={A Survey of AutoML on Consumer Electronics in the Generative AI Era: Foundations, State of the Art, and Future Directions}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={In the Era of Generative AI (GenAI), Automated Machine Learning (AutoML) has emerged as a transformative approach for building predictive models with reduced need for expert intervention, with the aid of recent technologies such as Large Language Models (LLMs). In parallel, with the surge in demand for Pervasive AI, the concept of Tiny Machine Learning (TinyML) with the promise of low latency in resource-constrained environments has emerged. However, existing AutoML systems still face limitations, including high computational costs and reliance on human oversight, which hinders deployment in consumer-facing environments requiring efficiency and rapid integration. This paper examines the intersection of AutoML, LLMs and TinyML on consumer electronics by presenting the current state of the art and exploring the potential of GenAI-enhanced AutoML frameworks. A qualitative evaluation of fifteen AutoML consumer-facing platforms is conducted on usability, scalability, transparency, and integration. Four representative tools are further selected for quantitative analysis across four ML problems: tabular classification, tabular regression, image classification, and text classification. The findings highlight strengths and limitations of current platforms, offering insights for user-accessible AutoML solutions.},
  keywords={Automated machine learning;Modeling;Optimization;Machine learning;Machining;Large language models;Conferences;Surveys;Neural architecture search;Training;TinyML;IoT edge consumer devices;AutoML},
  doi={10.1109/TCE.2026.3711600},
  ISSN={1558-4127},
  month={},}@INPROCEEDINGS{11497014,
  author={Naik, Chandra and Nayak, Apoorva and Dhanashetti, Anushree and N, Anujna and Math, Bhagyashri},
  booktitle={2026 IEEE International Conference on Emerging Computing and Intelligent Technologies (ICoECIT)}, 
  title={Machine Learning in Wireless Sensor Networks: Techniques and Performance Trade-Offs}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Wireless Sensor Networks (WSNs) form an essential component of modern intelligent infrastructures, supporting domains such as healthcare, environmental monitoring, industrial automation, and smart urban environments. However, challenges such as limited battery power, processing capacity, latency, and security vulnerabilities hinder their performance. Machine Learning (ML) techniques have proven to be efficient tools for addressing these constraints.ML models improve routing efficiency, detect anomalies, and predict node failures. Supervised, unsupervised, and reinforcement learning methods enhance adaptability and energy management in dynamic environments. Evaluations of these models are typically conducted using simulators such as NS-2, NS-3, OMNeT++, and MATLAB, focusing on parameters such as energy efficiency, latency, and network lifetime.This paper highlights current advancements, identifies challenges such as real-time learning, scalability, and secure data sharing, and explores future directions including TinyML, federated learning, and edge intelligence for building efficient and sustainable WSNs.},
  keywords={Jamming;AI accelerators;Microprocessor chips;Neuromorphics;Communication systems;Internet of Things;Routing;Wireless sensor networks;Protocols;Radio access networks;Wireless Sensor Networks;Machine Learning;Edge Computing;TinyML;Federated Learning;IoT;Routing Optimization;Anomaly Detection},
  doi={10.1109/ICoECIT68303.2026.11497014},
  ISSN={},
  month={Jan},}@ARTICLE{11206138,
  author={Espensønn Øren, Ask and Kuna Peuker, Nina and Adeyomi Adeniran-Lowe, Akira-Miranda and Ruepp, Sarah and Nordal Petersen, Martin},
  journal={IEEE Access}, 
  title={Concept Drift Under Harsh Constraints: A Review of Potential Strategies for IoT Systems}, 
  year={2025},
  volume={13},
  number={},
  pages={182220-182237},
  abstract={Concept drift, referring to the temporal evolution of data distributions, presents a significant challenge to the deployment of machine learning models in dynamic, real-world environments. This paper surveys recent advances in autonomous concept drift detection and adaptation methods, with a particular focus on their applicability to resource-constrained platforms such as IoT devices. This survey aspires to be a guideline for choosing a suitable architecture for any situation given the trade-off among detection accuracy, adaptability, and resource efficiency. Our analysis reveals that while statistical methods offer low overhead, they are often insufficient for complex drift scenarios; conversely, more accurate methods may exceed embedded system limitations. We conclude that modular, context-aware approaches that co-optimize both detection and adaptation under tight hardware constraints are essential for practical deployment in embedded learning systems.},
  keywords={Concept drift;Internet of Things;Machine learning;Accuracy;Reviews;Training;Data models;Anomaly detection;Adaptation models;Surveys;Concept drift;change detection;TinyML;IoT;incremental learning;drift adaptation;unsupervised learning},
  doi={10.1109/ACCESS.2025.3622973},
  ISSN={2169-3536},
  month={},}@ARTICLE{10967385,
  author={He, Chengrun and Fan, Honghui and Yin, Lihua and Yan, Haonan and Luo, Xi and Li, Hui and Wang, Bin},
  journal={IEEE Internet of Things Journal}, 
  title={MalAE: A Feature-Optimized and Autoencoder Ensemble-Based Method for IoT Malware Classification}, 
  year={2025},
  volume={12},
  number={14},
  pages={27181-27192},
  abstract={In the landscape of the Internet of Things (IoT), the rapid evolution and diverse obfuscation tactics of malware render it challenging to detect and identify effectively, posing significant threats to network security. Signature or heuristic methods rely on fixed feature recognition, making it challenging to handle new variants. Recent research has proposed deep learning techniques that utilize static analysis of bytes and images or dynamic analysis of APIs. However, these methods are effective only on samples from the same platform or lead to a dimensional explosion due to excessive irrelevant obfuscation, rendering them inadequate for managing complex cross-platform malware. In this work, we propose a novel lightweight cross-platform malware classification system called MalAE. This system employs a global-local particle swarm optimization algorithm to mine frequent features, adaptively identifying distinct family characteristics and efficiently recognizing variants. An ensemble of autoencoders integrates comprehensive file features and cross-platform basic block features from various perspectives and feature spaces, compressing high-dimensional data into a low-dimensional latent space. This approach preserves essential information, captures nonlinear complex relationships, and facilitates the rapid classification of intricate cross-platform samples. Evaluations conducted on two different datasets demonstrate that MalAE reduces the original feature dimensions by approximately 70% while also enhancing accuracy. Compared to state-of-the-art methods, MalAE achieves superior results, attaining an accuracy of 97.72%.},
  keywords={Malware;Feature extraction;Accuracy;Internet of Things;Autoencoders;Particle swarm optimization;Classification algorithms;Heuristic algorithms;Gray-scale;Deep learning;Autoencoders;cross-platform;feature fusion;global and local binary particle swarm optimization (GLBPSO);malware classification},
  doi={10.1109/JIOT.2025.3561847},
  ISSN={2327-4662},
  month={July},}@INPROCEEDINGS{10444344,
  author={Mwaura, Jedidah and Araki, Shunsuke and Kakizaki, Ken’Ichi},
  booktitle={2024 IEEE International Conference on Consumer Electronics (ICCE)}, 
  title={A Study on DDoS Attacks Detection on IoT Devices Using Machine Learning for Microcontrollers}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={In recent years, there has been a proliferation of Internet of Things (IoT) devices, and so has been the attacks on them. In this paper we will propose a methodology to detect Distributed Denial of Service (DDoS) attacks on IoT devices using Machine Learning for Microcontrollers. We will discuss a model which we made for Arduino Nano 33 BLE Sense using Machine Learning for Microcontrollers. Additionally, we will discuss results of our proposal in detecting DDoS attacks on IoT devices. Lastly, we will describe the feasibility of our model on IoT devices.},
  keywords={Microcontrollers;Machine learning;Denial-of-service attack;Internet of Things;Proposals;Computer crime;Consumer electronics;IoT;Machine Learning;DDoS;TinyML},
  doi={10.1109/ICCE59016.2024.10444344},
  ISSN={2158-4001},
  month={Jan},}@INPROCEEDINGS{11492828,
  author={Saini, Rohan and Ashima},
  booktitle={2026 International Conference on Computing, Electronics & Communications Engineering (ICCECE)}, 
  title={A Comprehensive Analysis of Machine Learning Methods for Identifying, preventing and Mitigating Cybersecurity Threats in Internet of Things Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The rapid growth of the Internet of Things (IoT) has created substantial cybersecurity challenges, underscoring the limitations of standard security procedures for protecting drivers and resource-constrained IoT systems. This review paper comprehensively explores modern Machine Learning (ML) techniques for detecting and mitigating cybersecurity threats in IoT networks. It offers a thorough examination of how ML techniques address IoT vulnerabilities and respond to evolving cyberattacks, including zero-day threats. The study analyses numerous algorithms, ranging from supervised approaches such as random forests and support vector machines to deep learning models such as long short-term memory networks and convolutional neural networks, focusing on their performance, capabilities, and application settings. Key issues, such as device resource constraints, data heterogeneity, and the need for adaptable, scalable solutions, are highlighted alongside emerging technologies such as TinyML and federated learning.},
  keywords={Telemetry;Aerospace and electronic systems;Filtering;Central Processing Unit;Filters;Integrated circuits;Internet;Internet of Things;Protocols;Bot (Internet);Internet of Things (IoT);Machine Learning (ML);Cybersecurity;Anomaly Detection;Deep Learning;Network Security},
  doi={10.1109/ICCECE69715.2026.11492828},
  ISSN={2768-0576},
  month={Feb},}@INPROCEEDINGS{10754662,
  author={Ho, Nguyen and Fafouri, Zaid and Gregory, Austin and Okwori, Michael},
  booktitle={2024 IEEE 15th Annual Ubiquitous Computing, Electronics & Mobile Communication Conference (UEMCON)}, 
  title={Towards A Minimalistic Sensor-Based Smart Soccer Net With Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={581-586},
  abstract={The global appeal and competitive nature of soccer have led to the application of technology to monitor and enhance player training and performance. Effective and data-driven training can reduce injury related to over-exertion and boost player performance. Shooting is a crucial skill in soccer and can significantly influence the outcome of a game. This work addresses the lack of a smart and privacy-aware device to track and analyze players’ shot localization accuracy, particularly for amateur players. We investigate a smart soccer net that can localize the point of impact of the ball from the perturbations of small inertial measuring sensors attached to the net. We train a feedforward neural network with raw data and statistical-based features, and a convolutional neural network with time- and frequency-based features from continuous wavelet transformation (CWT). Also, we investigated one, two, three, and four sensors deployed in selected configurations on the net. Four sensors deployed in a rhombus configuration and a model trained with CWT-based features achieved the best classification accuracy of $94 \%$. A cost-effective option of using three sensors in an inverted triangle configuration and the model trained with statistical-based features achieved $90 \%$ accuracy. This work is a step towards a minimalistic system that can be used as a training aid to automatically track the positions of soccer player shots in the goal during training sessions.},
  keywords={Training;Performance evaluation;Accuracy;Continuous wavelet transforms;Tracking;Computational modeling;Sensor phenomena and characterization;Data models;Intelligent sensors;Sports;Intelligent devices;Internet of Things;tiny machine learning;sports analytics;event detection},
  doi={10.1109/UEMCON62879.2024.10754662},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11282592,
  author={Vitoonkijvanit, Karin and Sukvichai, Kanjanapan and Marukatat, Sanparith and Isshiki, Tsuyoshi},
  booktitle={2025 Research, Invention, and Innovation Congress: Innovative Electricals and Electronics (RI2C)}, 
  title={Entropy-Driven Two-Stage Flash-and-Flag Cascade for Rail Defect Inspection with YOLO-Based Detection and GPS Tagging on Standard Laptops}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Railway track defects—ranging from hairline cracks and faulty joints to surface corrosion—continue to jeopardize safety and drive–up maintenance costs. In response, we developed Tetsumi Suite (a custom GUI–based inspection toolkit) a straightforward, two–stage pipeline that runs live on an everyday laptop (Intel i5–11300H, 16 GB RAM, NVMe SSD) and can optionally harness CUDA acceleration (GeForce MX450) for bulk processing. In Stage I, a lightweight, CPU–resident filter "flashes" through multi–camera frames down sampling and applying rapid heuristic checks (histogram equalization, gradient magnitude, edge density, texture entropy, and optional background subtraction) to flag only the most suspect images without slowing down operations. Flagged frames then move to Stage II, where a TorchScript–optimized YOLO11m model (CPU or GPU) assigns detailed labels (Crack, RCF, Bad joint, Fixed, or Normal) and overlays precise bounding boxes. Every saved frame is automatically tagged with GPS EXIF metadata, enabling seamless geospatial visualization. On a reserved set of 200 hand–annotated images, Tetsumi Suite achieves mAP@0.5 = 0.989 and F1 = 0.950 at a confidence threshold of 0.567 making it, to our knowledge, the first end–to–end solution to combine real–time heuristic filtering, deep–learning classification, and GPS tagging on a standard laptop delivering a scalable, high–accuracy tool for field–ready rail inspection.},
  keywords={Rails;Technological innovation;Portable computers;Image edge detection;Graphics processing units;Inspection;Tagging;Entropy;Standards;Global Positioning System;Anomaly Detection;Rail Defect Classification;YOLO;Texture Entropy;Edge Density;GPS EXIF;2 Stage Inspection;Cascade Detection;Flash-and-Flag},
  doi={10.1109/RI2C67120.2025.11282592},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10456816,
  author={Vaddeboina, Mounika and Kaja, Endri and Yilmayer, Alper and Prebeck, Sebastian and Ecker, Wolfgang},
  booktitle={2023 26th Euromicro Conference on Digital System Design (DSD)}, 
  title={Parallel Golomb-Rice Decoder with 8-bit Unary Decoding for Weight Compression in TinyML Applications}, 
  year={2023},
  volume={},
  number={},
  pages={227-234},
  abstract={Due to the recent advances in AI, the requirement for Artificial Intelligence (AI) has increased exponentially in the domain of Internet of Things (IoT). Running Deep Neural Networks (DNNs) on edge devices gives the advantage of privacy, security, and lower latency. It is challenging to deploy them on embedded devices with constrained hardware resources since a lot of compute and memory resources are required. Memory access contributes to the majority of the energy requirements on edge devices. Although data compression plays a critical role in reducing storage and memory bandwidth requirements, most of the hardware decoders are inefficient in terms of power, area, and throughput. In this work, a hardware Parallel Golomb-Rice decoder is presented that can decode 8-bits of unary encoded data every cycle. The design has been integrated with a Neural Network (NN) accelerator and experimented with state-of-the-art benchmark models. Lossless compression is performed with an offline Golomb-Rice encoder. It encodes the weights of each layer with an optimum Golomb-Rice parameter. Applied to the benchmarks Anomaly Detection, Image Classification and Visual Wake Words the memory access during inference is reduced by 26.8%, 6.62% and 5.54% respectively. The decoder dissipates 0.4216 mW of power and delivers an average throughput of 860 MBps. The design has been synthesised with 40 nm technology and compared with state-of-the-art works.},
  keywords={Visualization;Image coding;Memory management;Benchmark testing;Throughput;Hardware;Decoding;Deep Neural Networks;Internet-of-Things;Golomb-Rice coding;Parallel decoders},
  doi={10.1109/DSD60849.2023.00041},
  ISSN={2771-2508},
  month={Sep.},}@INPROCEEDINGS{11438830,
  author={Devi, V. Saranya and Alluwaici, Mo'Ath and Lakshmi, P. Adi and Shifani, S.A. and Kumar, K Gagan and Manasa, V.},
  booktitle={2026 6th International Conference on Image Processing and Capsule Networks (ICIPCN)}, 
  title={An Efficient Signal Processing using EfficientNetB4-Lite Supported Deepfake Detection in Spectral Sensing TinyML Environment}, 
  year={2026},
  volume={},
  number={},
  pages={1056-1061},
  abstract={Efficient Signal Processing (SP) enables quick pattern recognition from raw sensor data, reducing computational load by eliminating noise and emphasizing critical areas for accurate detection, enhancing system performance. The research introduces the Efficient Signal Extraction and Deep Fake-Focused Surveillance (ESEDFS) model for structural health monitoring and video authentication in limited-resource settings. It reduces system noise with a Butterworth filter (BWF) and utilizes data from 12 transducers to create 66 master baselines for analysis. Structural changes are quantified through feature metrics. For deep fake detection, CCTV frames are resized, normalized, and converted into tensors before input to an optimized EfficientNetB4-Lite model for real-time authentication. The ESEDFS framework is tailored for real-time on-device anomaly detection in edge environments. It focuses on nondestructive structural damage detection through ultrasonic- guided-waves and light deep fake detection for CCTV surveillance, operating without cloud computing or large-scale video forensics. Efficient microcontrollers incorporate features like dynamic range and quantization for effective model performance. The performance analysis is loss of (0.9, 0.6, 0.3), accuracy of 87% to 97%, ESEDFS overall of 92.1%, 91.2% accuracy and a 90.8% F1-score, ROC-AUC of 0.97. Calculation.},
  keywords={Training;Deepfakes;Cloud computing;Accuracy;Quantization (signal);Surveillance;Computational modeling;Image edge detection;Noise;Real-time systems;Signal Processing (SP);Butterworth Filter (BWF) and EfficientNetB4-Lite model},
  doi={10.1109/ICIPCN67432.2026.11438830},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{9634140,
  author={Ooko, Samson Otieno and Mukanyiligira, Didacienne and Munyampundu, Jean Pierre and Nsenga, Jimmy},
  booktitle={2021 IEEE Jordan International Joint Conference on Electrical Engineering and Information Technology (JEEIT)}, 
  title={Edge AI-based Respiratory Disease Recognition from Exhaled Breath Signatures}, 
  year={2021},
  volume={},
  number={},
  pages={89-94},
  abstract={Every year, about 4 million people die from respiratory diseases. While early prediction would reduce this mortality rate, till now diagnosis is only done at hospitals involving costly diagnosis resources and scarce healthcare professionals. Ideally, regular noninvasive breath analysis check-ups at home would allow us to anticipate medical consultation. Considering developing country's contexts, existing commercial portable diagnosis kits under proprietary licenses are expensive and require internet connectivity to work. The study aimed to investigate the possibility of detecting respiratory diseases using edge AI. Thanks to recent advances in open source edge AI frameworks, this study presents a prototyping design of an offline STM32 based portable kit locally embedding a tiny Machine Learning (TinyML) trained model to predict respiratory disease. Evaluated on an open dataset of Chronic Obstructive Pulmonary Disease (COPD), the resulting real-time requirements of our edge AI model is 15.9 Kb of ROM and 1.5 Kb RAM and performs the inference in 1 ms. Results also show that the accuracy and peak memory for the model are affected by preprocessing, type of sensors and the number of sensors. In addition to the early detection of respiratory diseases, the proposed solution will be of great value in the process of mass collection of exhaled breath data to enable the training of efficient AI models for respiratory diseases.},
  keywords={Training;Pulmonary diseases;Image edge detection;Atmospheric modeling;Random access memory;Real-time systems;Software;Breathomics;Embedded ML;Edge AI;Respiratory Diseases;COPD;TinyML},
  doi={10.1109/JEEIT53412.2021.9634140},
  ISSN={},
  month={Nov},}@ARTICLE{10870865,
  author={Hu, Fengqing and Fu, Xiaowen and Huang, Hailong},
  journal={IEEE Transactions on Intelligent Transportation Systems}, 
  title={Safe Reinforcement Learning for Event-Triggered Control of Automated Vehicles With Uncertainty}, 
  year={2025},
  volume={26},
  number={9},
  pages={14039-14052},
  abstract={Safety is of vital importance to transportation cyber-physical systems (T-CPS). With the deeper integration of automated vehicles (AVs) in road traffic, safe control algorithms for AVs have become a crucial demand for maintaining the overall safety of T-CPS. One of the major concerns with respect to the DRL-based cyber systems of AVs is the lack of safety guarantees, which may cause physical collisions. Safe reinforcement learning (SRL) is a promising way to enhance the safety performance of traditional DRL. However, current SRL methods are designed in a time-triggered (TT) paradigm, where the controller is uniformly triggered in the time domain. Despite the safety enhancement, this TT-SRL paradigm lacks data efficiency in safety-critical scenarios, and most importantly, still cannot guarantee safety during the intervals between time steps. The main objective of this paper is to address the safety issue of the existing TT-SRL methods while improving the data efficiency by proposing an event-triggered SRL (ET-SRL) framework. In the proposed method, safety is guaranteed by designing an additional safe controller to correct the unsafe actions generated by DRL. Event-triggered control barrier functions (CBFs) are used to provide safety constraints in a discrete manner. A state and dynamics synchronization module is also designed to estimate model uncertainties considering both the state dynamics and the input dynamics. The proposed method is trained and applied in simulated car-following experiments. The effectiveness of the proposed method is demonstrated by comparison to both DRL-based and model-based baselines in both artificial safety-critical scenarios and a real trajectory dataset.},
  keywords={Safety;Training;Vehicle dynamics;Event detection;Reinforcement learning;Artificial intelligence;Aerospace electronics;Uncertainty;Time-domain analysis;Road traffic;Event-triggered control;safe reinforcement learning;control barrier functions;automated vehicles},
  doi={10.1109/TITS.2025.3533578},
  ISSN={1558-0016},
  month={Sep.},}@INPROCEEDINGS{11183207,
  author={Du, Shaohui and Liu, Yunhua and Xu, Chun and Luo, Jialin and Zhou, Yan and Li, Shijie},
  booktitle={2025 5th International Conference on Artificial Intelligence, Big Data and Algorithms (CAIBDA)}, 
  title={Research on Delay-Deterministic Context Switching Techniques for Heterogeneous Multi-Core Systems}, 
  year={2025},
  volume={},
  number={},
  pages={1190-1195},
  abstract={In application scenarios with stringent real-time requirements, such as industrial control and edge computing, context switch latency significantly affects system stability and can easily lead to unpredictability in heterogeneous multi-core architectures. This paper proposes a delay-deterministic context switching mechanism tailored for heterogeneous multi-core systems. It establishes a delay modeling framework, designs a “zero-copy” switching path based on full memory protection, and introduces a cross-architecture virtual instruction set (vISA) along with a context encapsulation scheme. The approach integrates TinyML for real-time prediction and incorporates a highprecision monitoring and anomaly detection module. Experiments conducted across x86, ARM, GPU, and FPGA platforms validate the effectiveness of the mechanism. Results show that under high load, the new mechanism reduces latency by $\mathbf{3 5 \% - 6 0 \%}$, stabilizes heterogeneous context switch latency within $5-8 \mu$ s, achieves prediction model errors below 3.1%, and keeps monitoring system response time under 1ms. The proposed mechanism significantly enhances the predictability and real-time performance of context switching, making it well-suited for high-determinism scheduling in complex heterogeneous systems.},
  keywords={Adaptation models;Job shop scheduling;Processor scheduling;Switches;Predictive models;Real-time systems;Delays;Protection;Monitoring;Context modeling;Context Switching;Delay Determinism;Heterogeneous Multi-Core Systems;Virtual Instruction Set Architecture;Real-Time Prediction and Monitoring},
  doi={10.1109/CAIBDA65784.2025.11183207},
  ISSN={},
  month={June},}@INPROCEEDINGS{9973657,
  author={Chen, Eric and Perez-Pons, Alexander},
  booktitle={2022 IEEE 19th International Conference on Mobile Ad Hoc and Smart Systems (MASS)}, 
  title={Malware Network Traffic Classification on the Edge}, 
  year={2022},
  volume={},
  number={},
  pages={754-758},
  abstract={Network traffic classification is a part of many cybersecurity applications, such as intrusion detection systems and anomaly detection. Currently, many cybersecurity tasks employ a cloud computing architecture, including network traffic classification. However, this architecture may not be able to meet the latency demands in the future with the ever-increasing number of network data. Therefore, we propose to perform network traffic classification utilizing edge computing and applying tiny machine learning to classify closer to the data source. Our approach uses TensorFlow Lite to convert a traditional convolutional neural network into a tiny machine learning model that runs on an edge device. In order to assess the impact of edge classification, we ran simulations on the edge device and compared these results to a cloud-computing counterpart. We determined that the edge device was faster and had reduced latency compared to a cloud computing alternative, with a negligible reduction in accuracy and decrease in model size throughout all experiments.},
  keywords={Performance evaluation;Cloud computing;Computational modeling;Soft sensors;Telecommunication traffic;Machine learning;Computer architecture;Traffic Classification;Convolutional Neural Network;Edge Computing},
  doi={10.1109/MASS56207.2022.00118},
  ISSN={2155-6814},
  month={Oct},}@INPROCEEDINGS{11187666,
  author={M, Omprakash and S, Saisukirtha and S, Shane Steffy and S, Dilip Kumar},
  booktitle={2025 9th International Conference on Inventive Systems and Control (ICISC)}, 
  title={IoT-Enabled Smart Ventilation System with Edge-Based Oxygen Regulation and Embedded Clinical Training}, 
  year={2025},
  volume={},
  number={},
  pages={990-996},
  abstract={An IoT-enabled, edge-intelligent ventilation system is being designed to address the shortcomings of manual Ambu bags and expensive ventilators in the decentralized and resource-scarce settings. The system envisages the use of an ESP32 microcontroller, and a modular sensor unit namely MAX30102 for oxygen saturation and pulse rate, DHT11 for temperature and humidity, MPX5010DP for differential airway pressure, MQ-135 for CO2, SF06 for oxygen flow and AWM720P1 for real-time airflow monitoring. Sensor information is transmitted via HTTP to a cloud-based dashboard where it can be continuously visualized, trended, and alerted on. TinyML-based decision tree regressor implemented based on TensorFlow Lite for Microcontrollers predicts dynamically that oxygen is needed between 1 to 10 liters/min and controls motor-driven compression and valves. A web-based simulation interface transmits artificial ventilation characteristics and identifies respiratory condition such as normoxia, hypoxia, and hyperventilation with 94.6% accuracy. For anomaly detection, a lightweight Isolation Forest model is employed and it accurately distinguishes 91.2% abnormal physiological behaviors and sensor malfunctions. Ambient light and sound sensors enable context-aware diagnostics and a capacitive stretch sensor monitors chest expansion to evaluate breathing effort. Built-in battery management and redundancy modules provide continuous operation. The system has been tested in mock clinical settings, and is being transformed into a product-grade MVPP for the intended scalable deployment during an emergency response and clinical training scenario.},
  keywords={Temperature sensors;Training;Temperature measurement;Cloud computing;Microcontrollers;Ventilation;Real-time systems;HTTP;Biomedical monitoring;Monitoring;Smart Ventilation;ESP32;TinyML;IoT;HTTP;Oxygen Prediction;Edge AI;Clinical Simulation},
  doi={10.1109/ICISC65841.2025.11187666},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10224228,
  author={Chowdhary, Mahesh and Saha, Swapnil Sayan},
  booktitle={2023 26th International Conference on Information Fusion (FUSION)}, 
  title={On-Sensor Online Learning and Classification Under 8 KB Memory}, 
  year={2023},
  volume={},
  number={},
  pages={1-8},
  abstract={Inertial sensors provide a low-power and high-fidelity pathway for state estimation and sensor fusion. Inertial measurement units now feature on-chip processors for ultra-low-power information fusion, signal processing, and neural network-based classification at the extreme edge. However, accounting for domain shifts, personalized inference requirements, and application diversity makes adopting existing learning-enabled on-device training, classification, and fusion frameworks for on-sensor processors difficult. This paper introduces a method for personalized and on-device learning for on-chip classification, inference, and information fusion applications. The proposed framework automatically segments and stores quantized gravity vector image templates and axes variance information of motion artifacts during training. During inference, templates created from the time-series windows are matched against uniform blurred templates using the universal image quality index. An adaptive rep counting module robust to varying motion primitives counts repetitions of matched motion primitives. The framework requires no human-engineered parameters and allows for the personalization and addition of new motion artifacts. Our framework recognizes human activities with 96.7% test accuracy and achieves an average rep count error of 0.44, while reducing the memory usage by 1000-2000$\times$ over existing tiny machine learning on-device learning techniques, allowing on-sensor learning and inference under 8 KB of memory.},
  keywords={Training;Program processors;Measurement units;Memory management;Signal processing;Sensor fusion;System-on-chip;intelligent sensor processing unit;on-device learning;tinyML;inertial measurement unit;classification;rep counting;inference;template matching;segmentation},
  doi={10.23919/FUSION52260.2023.10224228},
  ISSN={},
  month={June},}@INPROCEEDINGS{11380734,
  author={Vignesh, V. and Adhithya, P N. Vijay and Jamiya, S. Sri and Shree, M. Divya},
  booktitle={2025 5th International Conference on Ubiquitous Computing and Intelligent Information Systems (ICUIS)}, 
  title={LPG Gas Level and Leakage Detection using AI Integration}, 
  year={2025},
  volume={},
  number={},
  pages={1446-1452},
  abstract={LPG finds widespread application in both domestic and industrial fields. However, accidental leakage and/or unreliable control of gas levels result in serious safety and economic hazards. To address this issue, this work discusses an intelligent LPG tracking and safety system using sensor technology integrated with AI. The developed system utilizes a load cell sensor to continuously measure gas level, always detecting leakage; it uses AI algorithms like TinyML-based MLP for prediction of gas consumption behavior and Random Forest for anomaly detection in usage behavior. Graced with prediction and diagnostic capabilities, the proposed approach enables timely alerts and prevention through IoT-based notifications, thus minimizing the probability of explosions, shortages, and wastage. In addition, the system is able to automate booking upon the detection of low levels in the gas cylinders so that there will be a continuous supply without disruption. The major technical contribution of this work is a low-cost, adaptive AI framework that learns user-specific usage patterns and improves safety, while scaling to an efficient solution suitable for both domestic and industrial scenarios.},
  keywords={Accuracy;Scalability;Ubiquitous computing;Reliability engineering;Real-time systems;Safety;Sensors;Artificial intelligence;Anomaly detection;Monitoring;LPG Monitoring;Gas Leakage Detection;Real-Time Alerts;Safety;Consumption Prediction;Automatic Booking;Household and Industrial Use},
  doi={10.1109/ICUIS67429.2025.11380734},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10257195,
  author={Kalioras, Fotios and Filios, Gabriel and Karatzas, Stylianos and Nikoletseas, Sotiris},
  booktitle={2023 19th International Conference on Distributed Computing in Smart Systems and the Internet of Things (DCOSS-IoT)}, 
  title={(POSTER) A Holistic IoT-Enabled Approach for Indoor Air Quality Control}, 
  year={2023},
  volume={},
  number={},
  pages={74-76},
  abstract={Indoor air quality (IAQ) is an important yet often overlooked aspect of public health, with poor IAQ contributing to a significant number of diverse health problems worldwide. Existing air quality standards have failed to fully address the problem, however emerging technologies in the field of IoT have demonstrated promise in effectively addressing this issue. This concept paper advocates a hybrid hierarchy system for IAQ monitoring that incorporates both offline and online connectivity. The system utilizes sensing elements that can perform a wide range of functions, including autocalibration, pollution event detection, and more, autonomously from the network. By combining a gateway device, the system's capabilities are enhanced, providing increased data granularity, additional calibration and sensing options as well as connection with Building Management Systems (BMS). Furthermore, by connecting the gateway to the cloud, the system can perform more advanced data analysis and machine learning, providing users with insights into not only air quality but also general environmental quality. Key features of the envisioned system include the integration of subjective perception of pollution via crowdsourcing, a TinyML technology at the edge, digital twins, and an optimised redundancy of sensors that can alleviate poor accuracy and drift as well as capture the spatial dispersion of pollution.},
  keywords={Performance evaluation;Crowdsourcing;Pollution;Sensor phenomena and characterization;Logic gates;Sensor systems;Digital twins;Indoor Air Quality;IoT;AI;TinyML;Crowd-sourcing;Digital Twins},
  doi={10.1109/DCOSS-IoT58021.2023.00021},
  ISSN={2325-2944},
  month={June},}
@INPROCEEDINGS{11556515,
  author={Higashi, Ryosuke and Nitta, Takeshi and Oishi, Akaru and Takada, Kiwamu and Sugita, Yasuhiro and Yuyama, Yoichi and Bingo, Hidekazu and Tseng, Boyu and Otani, Sugako and Kondo, Hiroyuki},
  booktitle={2026 IEEE Symposium on Low-Power and High-Speed Chips and Systems (COOL CHIPS)}, 
  title={RX VPU: A High-Efficiency Variable-Length Vector Architecture with Widening Reduction MAC for Embedded CNNs}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents the RX VPU, a newly developed Vector Processing Unit (VPU) designed as a coprocessor for the RX series of embedded microcontrollers. The RX VPU adopts a variable-length vector architecture and features a compact, low-power implementation suitable for embedded systems. It is specifically designed to accelerate CNN inference on embedded devices while maintaining low power consumption. The RX VPU provides instructions optimized for int8-quantized CNNs, which are widely used in embedded inference workloads, enabling efficient execution of compact CNN models. The architecture is particularly optimized for anomaly detection workloads using int8-quantized CNN models, where inner-product accumulation operations account for approximately 40% of all executed instructions. This work introduces a 4× widening reduction MAC instruction that accelerates these operations within a single instruction. Using this instruction, inference throughput on the Arm ML-Zoo anomaly detection model improves by 1.85×, achieving up to 30.0 inference/s. The coprocessor also achieves 1025.6 GFLOPS/W at 600 MHz, demonstrating that highly efficient ML inference can be achieved even under stringent power and area constraints.},
  keywords={Vectors;Graphics processing units;Modeling;Registers;Computer architecture;Architecture;Design methodology;Pipelines;Reduced instruction set computing;Convolutional neural networks;RX;Vector;SIMD;AI;TinyML;CNN},
  doi={10.1109/COOLCHIPS68842.2026.11556515},
  ISSN={2473-4683},
  month={April},}@INPROCEEDINGS{10842766,
  author={Baji, Pratiksha Pradeep and Gavankar, Nitin L. and Mahambrey, Mayur and Rokade, Sonali S.},
  booktitle={2024 2nd DMIHER International Conference on Artificial Intelligence in Healthcare, Education and Industry (IDICAIEI)}, 
  title={Developing an Edge based predictive maintenance system for transformer using low-cost sensors}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Transformers are essential for ensuring the reliable distribution and transmission of electrical power. Traditional maintenance procedures, which are generally reactive and schedule-driven, can result in costly breakdowns and unanticipated expenses. This research offers an edge-based predictive maintenance system for transformers that uses powerful machine learning techniques and five temperature sensors strategically distributed throughout the transformer in non-invasive manner. The system uses edge computing to handle real-time temperature data locally, allowing for more precise and accurate anomaly detection and predictive analytics. This strategy enables proactive maintenance, timely interventions, and less operational disturbances. The proposed methodology optimises maintenance schedules, lowers downtime, and increases grid reliability, providing a viable method for managing essential infrastructure and improving overall grid dependability.},
  keywords={Temperature sensors;Temperature distribution;Accuracy;Image edge detection;Tiny machine learning;Transformers;Sensor systems;Real-time systems;Maintenance;Predictive maintenance;Edge computing;predictive maintenance;transformers;neural network;machine learning},
  doi={10.1109/IDICAIEI61867.2024.10842766},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11525863,
  author={Jangra, Renu and Sharma, Anshul and Gopi, Anoop and Bisht, Ankit and Singh, Manisha and Pandey, Pushpanjali},
  booktitle={2026 13th International Conference on Computing for Sustainable Global Development (INDIACom)}, 
  title={A Study on Research Trends in Machine Learning based WSN Security Monitoring}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper reviews the intellectual framework, research patterns, and upcoming directions of machine-learningbased security surveillance within Wireless Sensor Networks (WSNs). The articles were screened in a structured way, and a total of 776 journal articles indexed in Scopus were selected and subjected to a thorough bibliometric analysis. The analysis of quantitative growth in publications, the leading contributors, influential countries, and sources, and the discovery of the prevailing and emerging themes in the research in the field were conducted through the use of the science-mapping techniques and the quantitative performance analysis. The findings show that the level of scientific output has increased significantly since 2019, which demonstrates the interest of researchers in intelligent and automated security in the context of the IoT-based WSN environment. The most common research topics include the focus on intrusion detection, anomaly detection, machine learning, deep learning, WSN security architectures, and their fundamental implications in the field. The thematic analysis shows that current streams of research on ML-based cybersecurity are rather welldrilled, and the basic research investigating intrusion detection systems and feature selection methods can be found. Further focused research interests cover clustering, routing, and optimization-oriented security measures, whereas the new tendencies focus on deep learning techniques, integration of IoT security, and more sophisticated methods of anomaly detection. On the whole, the results indicate a preference for adaptive, dataintensive, and computationally efficient security models to address the limitations of WSNs. Simultaneously, the analysis reveals serious gaps in research in such areas as federated learning, explainable artificial intelligence, TinyML, and privacypreserving analytics. This research is presented in a wellorganized and current overview that can inform future studies on how to come up with secure, scalable, and intelligent WSN ecosystems.},
  keywords={Machine learning;Security;Internet of Things;Image sensors;Machining;Modeling;Wireless sensor networks;Printing;Intrusion detection;Deep learning;Machine Learning;Wireless Sensor Networks;Intrusion Detection;Anomaly Detection;Deep Learning;IoT Security;Bibliometric Analysis},
  doi={10.23919/INDIACom70271.2026.11525863},
  ISSN={},
  month={April},}@INPROCEEDINGS{9835378,
  author={Leroux, Sam and Simoens, Pieter and Lootus, Meelis and Thakore, Kartik and Sharma, Akshay},
  booktitle={2022 IEEE International Parallel and Distributed Processing Symposium Workshops (IPDPSW)}, 
  title={TinyMLOps: Operational Challenges for Widespread Edge AI Adoption}, 
  year={2022},
  volume={},
  number={},
  pages={1003-1010},
  abstract={Deploying machine learning applications on edge devices can bring clear benefits such as improved reliability, latency and privacy but it also introduces its own set of challenges. Most works focus on the limited computational resources of edge platforms but this is not the only bottleneck standing in the way of widespread adoption. In this paper we list several other challenges that a Tiny ML practitioner might need to consider when operationalizing an application on edge devices. We focus on tasks such as monitoring and managing the application, common functionality for a MLOps platform, and show how they are complicated by the distributed nature of edge deployment. We also discuss issues that are unique to edge applications such as protecting a model's intellectual property and verifying its integrity.},
  keywords={Privacy;Distributed processing;Conferences;Machine learning;Intellectual property;Reliability;Task analysis;TinyML;Edge AI;MLOps;TinyMLOps},
  doi={10.1109/IPDPSW55747.2022.00160},
  ISSN={},
  month={May},}@INPROCEEDINGS{11385696,
  author={Prasad, Janga and Kumari, M. Sirin and Srikanth, G. and Gopi, A},
  booktitle={2025 International Conference on Innovations and Emerging Technologies In AI & Communication Systems (IETACS)}, 
  title={Reconfigurable FPGA-Based Framework for Power-Efficient Signal Processing in AI-Assisted IoT Gateways}, 
  year={2025},
  volume={},
  number={},
  pages={1292-1297},
  abstract={In this paper, we introduce ANEMIA, a novel reconfigurable FPGA framework aimed at power-efficient signal processing in AI-assisted IoT gateways. With the increase in the reliance of IoT ecosystems on real-time edge intelligence data processing, the static traditional architectures are challenged immensely in terms of energy costs, latency, and flexibility. ANEMIA overcome these constraints by using a flexible, aware context model that combines neuromorphic processing and pipeline modules of signals. It has five key elements such as a Neuromorphic Signal Encoder (NSE) where spiking neural networks extract features in an energy-efficient manner; Modular Power-Aware Pipelines (MPAP) that activate only the signal processing units needed by the workload; an AI-Driven Reconfiguration Agent (AIRA) which optimizes hardware configurations using in real-time a lightweight meta-learning framework; an Edge-Aware Quantized Learning Core (EQL-Core) that supports low-power AI inferences by enabling ultra-low precision models; and an Hybrid Data Compression It has been experimentally demonstrated that ANEMIA is capable of saving a significant amount of power, as much as 43 percent when compared to state-of-the-art methods with competitive accuracy, latency and throughput. Its framework is also typified by the great scalability and flexibility of the heterogeneous IoT settings. The ANCEMIA is developed by reconfiguring hardware dynamically at the border, controlled by AI, hence it is an important step to create intelligent edge computing systems to be sustainable. The contributions made by this work are a new architectural paradigm of the next-generation AIoT systems that are to be energy-efficient and there is a high level of performance demanded in resource-constrained conditions.},
  keywords={Neuromorphics;Anemia;Pipelines;Computer architecture;Signal processing;Logic gates;Real-time systems;Energy efficiency;Hardware;Next generation networking;AIoT systems;Xilinx FPGA platform;Edge-Aware Quantized Learning Core (EQL-Core);FPGA-based framework},
  doi={10.1109/IETACS68750.2025.11385696},
  ISSN={},
  month={Nov},}@ARTICLE{11610660,
  author={Saleh, Sana and Jolfaei, Alireza and Tariq, Muhammad},
  journal={IEEE Transactions on Vehicular Technology}, 
  title={Cognitive Edge Intelligence for Cooperative Driving Safety: A Digital Shadow Framework in Industry 5.0}, 
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={Industry 5.0 envisions a human-centric, cognitively aware transportation ecosystem emphasizing resilience, personalization, and sustainable human-machine collaboration. This paper proposes a unified cognitive edge intelligence framework that transforms individual driving behavior into collective, predictive safety intelligence. The framework integrates Tiny Machine Learning (TinyML), cooperative perception, and human-in-the-loop augmented intelligence for real-time driver behavior understanding at the network edge. Unlike traditional cloud-centric or reactive systems, our approach employs lightweight, optimized TinyML models on in-vehicle edge units to infer behavioral states, normal, slow, and aggressive, directly from inertial sensor streams with minimal latency. This cognitive state is shared via an Internet of Vehicles (IoV) layer, enabling collective risk anticipation beyond line-of-sight. A digital shadow aggregates behavioral insights from connected vehicles to support long-term trend analysis and statistical anomaly detection, completing a closed-loop intelligence cycle from edge inference to strategic fleet oversight. The framework is experimentally validated across multiple dimensions. Real-world driving data demonstrates the system's efficacy, achieving 97.75% test accuracy and 95.7% accuracy on a separate real-world deployment dataset, with an ultralight model size of 0.03 MB and a per-inference latency of 0.35 ms. The cooperative Vehicle-to-Vehicle (V2V) mechanism achieves a Packet Delivery Ratio (PDR) exceeding 96.5% with end-to-end latency below 2 ms across highway traffic densities, while the digital shadow enables behavioral trend monitoring and statistical anomaly detection. These results demonstrate that the proposed framework delivers both immediate roadside safety and long-term system-wide resilience for next-generation transportation systems.},
  keywords={Modeling;Driver behavior;Vehicles;Shadow mapping;Timing;Accuracy;Real-time systems;Safety;Tires;Quantization (signal);Edge Computing;Deep Learning;Digital Shadow;Collision Avoidance;Industry 5.0;Intelligent Transportation System},
  doi={10.1109/TVT.2026.3713618},
  ISSN={1939-9359},
  month={},}@ARTICLE{10278089,
  author={Burrello, Alessio and Risso, Matteo and Motetti, Beatrice Alessandra and Macii, Enrico and Benini, Luca and Pagliari, Daniele Jahier},
  journal={IEEE Transactions on Emerging Topics in Computing}, 
  title={Enhancing Neural Architecture Search With Multiple Hardware Constraints for Deep Learning Model Deployment on Tiny IoT Devices}, 
  year={2024},
  volume={12},
  number={3},
  pages={780-794},
  abstract={The rapid proliferation of computing domains relying on Internet of Things (IoT) devices has created a pressing need for efficient and accurate deep-learning (DL) models that can run on low-power devices. However, traditional DL models tend to be too complex and computationally intensive for typical IoT end-nodes. To address this challenge, Neural Architecture Search (NAS) has emerged as a popular design automation technique for co-optimizing the accuracy and complexity of deep neural networks. Nevertheless, existing NAS techniques require many iterations to produce a network that adheres to specific hardware constraints, such as the maximum memory available on the hardware or the maximum latency allowed by the target application. In this work, we propose a novel approach to incorporate multiple constraints into so-called Differentiable NAS optimization methods, which allows the generation, in a single shot, of a model that respects user-defined constraints on both memory and latency in a time comparable to a single standard training. The proposed approach is evaluated on five IoT-relevant benchmarks, including the MLPerf Tiny suite and Tiny ImageNet, demonstrating that, with a single search, it is possible to reduce memory and latency by 87.4% and 54.2%, respectively (as defined by our targets), while ensuring non-inferior accuracy on state-of-the-art hand-tuned deep neural networks for TinyML.},
  keywords={DNA;Training;Hardware;Costs;Task analysis;Internet of Things;Search problems;Computing architectures;deep learning;energy-efficiency;hardware -aware NAS;IoT;neural architecture search;TinyML},
  doi={10.1109/TETC.2023.3322033},
  ISSN={2168-6750},
  month={July},}@INPROCEEDINGS{10466879,
  author={Puthal, Deepak and Mohanty, Saraju P. and Yeun, Chan Yeob and Damiani, Ernesto and Pradhan, Biswajeet},
  booktitle={2023 IEEE International Conference on High Performance Computing & Communications, Data Science & Systems, Smart City & Dependability in Sensor, Cloud & Big Data Systems & Application (HPCC/DSS/SmartCity/DependSys)}, 
  title={Pervasive AI for Secure and Scalable IoT- Edge-Cloud Continuum: A Big Picture}, 
  year={2023},
  volume={},
  number={},
  pages={566-573},
  abstract={The proliferation of Internet of Things (IoT) devices has led to an explosion of data generated at the edge of the network. This has led to the development of the IoT -Edge-Cloud continuum, where data is processed and analyzed across multiple layers of the network. However, this also poses significant security and privacy challenges, as sensitive data is transmitted across the network. In this paper, we propose the use of Pervasive Artificial Intelligence (AI) to enhance the security and efficiency of the IoT -Edge-Cloud continuum. Pervasive AI can be used at each layer of the network to process and analyze data in real-time, reducing the amount of data that needs to be transmitted across the network. This can help to improve response times, reduce network traffic, and enhance security by keeping data localized. We also discuss the potential cybersecurity threats and future research directions for the use of Pervasive AI in the IoT - Edge-Cloud continuum. Our findings suggest that Pervasive AI has significant potential to enhance the security and efficiency of the IoT -Edge-Cloud continuum, and should be considered as a viable solution for future IoT deployments.},
  keywords={System performance;Scalability;Telecommunication traffic;Real-time systems;Explosions;Internet of Things;Security;Pervasive AI;Machine Learning;Edge-AI;Tiny-ML;Security;Privacy and Scalability},
  doi={10.1109/HPCC-DSS-SmartCity-DependSys60770.2023.00083},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11522346,
  author={U, Barakkath Nisha. and M, Mathumitha and K, Sakthivel and M, Rakesh Kanna},
  booktitle={2026 4th International Conference on Artificial Intelligence and Machine Learning Applications Theme: Healthcare and Internet of Things (AIMLA)}, 
  title={Real Time Neck Posture Recognition via Adaptive Margin Dwell Gating and Quantized Linear SVM}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Neck posture correction is useful only when the system triggers feedback for a sustained tilt, not for a short and unconscious head movement. In this research work, we design a TinyML-based neck posture detection method using a quantized linear SVM and a simple dwell-time decision layer. We trained the classifier using around 2000 labelled samples collected from neck angle and position related measurements, covering normal posture and tilt posture conditions. During real-time operation, the model predicts the posture continuously from IMU feature windows. To prevent nuisance feedback, we maintain a 5 s dwell time, during which the alert is turned on only when the non-neutral posture is continuously detected for 5 s. If the user goes back to the normal posture within the 5 s dwell time, the system will not be activated. The performance is evaluated by incrementing the sizes of the evaluation sets ($N=50$ to 500) with varying proportions of both normal and tilted examples in each set. The accuracy, sensitivity (detection rate), specificity, precision, and F1 score are reported for each set size. The experiment shows that the detection rate remains at 100 % for small to moderate set sizes and slightly drops with larger set sizes, whereas accuracy and F1 score remain consistent. This code snippet offers an affordable studentlevel wearable posture detection with deterministic computational and memory requirements.},
  keywords={Support vector machines;Timing;Modeling;Signal detection;Neck;Windows;Feedback;Labeling;Monitoring;Head;TinyML;neck posture detection;linear SVM;quantized inference;dwell-time activation;IMU features},
  doi={10.1109/AIMLA67915.2026.11522346},
  ISSN={},
  month={April},}@INPROCEEDINGS{10989435,
  author={Adebiyi, Risikat Folashade and Bello-Salau, Habeeb and Onumanyi, Adeiza James and Adebiyi, Busayo Hadir and Adekale, Abdulfatai Dare and Bello-Salahuddeen, Ridwan},
  booktitle={2025 4th International Conference on Computing and Information Technology (ICCIT)}, 
  title={Exploratory Analysis of Modified Deep Learning Model for Potholes Data Augmentation}, 
  year={2025},
  volume={},
  number={},
  pages={389-394},
  abstract={A major factor contributing factor resulting to a large proportion of vehicular-related traffic accidents in developing nations is the poor condition of road networks, characterized by potholes, bumps, and other anomalies. Despite efforts by authorities to address these issues, they persist. A new approach involves equipping vehicles with sensors to detect road anomalies, enabling drivers to make informed decisions. Various models using road surface images to detect and classify these anomalies have been proposed, with recent methods leveraging deep learning. The effectiveness of these models depends on the presence of abundant and well-labelled training datasets. To address this need, a modified Deep Denoising Diffusion Probabilistic Model (mDDPM) was proposed, enhancing the U-Net backbone architecture to improve the original DDPM's performance in augmenting pothole images. The mDDPM generates more diverse augmented images, evaluated through subjective and objective assessments, including the Fréchet Inception Distance (FID) score. Experimental results showed that 98% of participants could not distinguish between real and synthetic images, classifying the augmented images as real. Additionally, an FID score of 0.52 indicated that the augmented images closely resemble real pothole images. This demonstrates the model's effectiveness in generating training data for deep learning models aimed at road anomaly detection and classification, contributing to the development of robust models for detecting and classifying potholes and other road anomalies},
  keywords={Deep learning;Training;Analytical models;Accuracy;Roads;Noise reduction;Training data;Diffusion models;Data models;Vehicles;Denoising;Datasets;GAN;Potholes;Synthetic-Image},
  doi={10.1109/ICCIT63348.2025.10989435},
  ISSN={},
  month={April},}@ARTICLE{10285603,
  author={Dere, Mustapha Deji and Jo, Ji-Hun and Lee, Boreom},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  title={Event-Driven Edge Deep Learning Decoder for Real-Time Gesture Classification and Neuro-Inspired Rehabilitation Device Control}, 
  year={2023},
  volume={72},
  number={},
  pages={1-12},
  abstract={Assistive neuro-inspired rehabilitation devices are essential for people who have suffered a spinal cord injury (SCI), stroke, or limb amputation in their activities of daily living. Neuro-inspired rehabilitation devices typically use a single-modal biosignal with a conventional machine learning algorithm on an embedded edge device for gesture classification. Although deep learning decoders provide high-accuracy gesture classification, the mismatch in the computational complexity and resource availability of edge devices has limited the deployment of real-time gesture inference on embedded devices. In this study, we describe an event-driven, edge-compatible deep neural network (DNN) capable of classifying gestures from a single or hybrid biosignal detected at the edge. The DNN-based decoders were deployed on a field-programmable gate array (FPGA) to classify motor intent acquired from the biosensors for intuitive control of a 3-D-printed upper limb rehabilitation device. The study was validated with 33 subjects offline and on-device. Offline average classification accuracy of 93.14% for single-modal electromyography (EMG), EMG-Net, 50.42% for single-modal electroencephalography (EEG), EEG-Net, and 93.35% for hybrid-modal biosignal (Hybrid-Net) using the 8-bit fixed-point quantization-aware method was obtained, while the real-time inference on the FPGA resulted in 94.97%, 58.27%, and 92.73%, respectively. The EMG biosensor shifted 5 cm to examine model degradation yielded 11.5% and 2.64% accuracy loss for the on-device EMG-Net and Hybrid-Net, respectively. The event-driven algorithm implemented performed with a reliability of 1, ensuring inference with voluntary gesture grasp. The study reports that hybrid biosignals outperformed single-modal EEG in gesture classification offline and on-device and single-modal EMG in case of EMG electrode shift. In addition, this article demonstrates an end-to-end approach that deploys a DNN decoder to an edge device for neuro-inspired control of the dexterous hand devoid of an Internet-of-Things (IoT) connection. The data and code are available at the following repository: https://github.com/HumanMachineInterface/Gest-Infer.},
  keywords={Electromyography;Electroencephalography;Data acquisition;Real-time systems;Field programmable gate arrays;Electrodes;Decoding;Electroencephalography (EEG);electromyography (EMG);hand gesture;human-machine interface (HMI);tinyML},
  doi={10.1109/TIM.2023.3323962},
  ISSN={1557-9662},
  month={},}@INPROCEEDINGS{9728969,
  author={Min, Nay Myat and Visoottiviseth, Vasaka and Teerakanok, Songpon and Yamai, Nariyoshi},
  booktitle={2022 24th International Conference on Advanced Communication Technology (ICACT)}, 
  title={OWASP IoT Top 10 based Attack Dataset for Machine Learning}, 
  year={2022},
  volume={},
  number={},
  pages={317-322},
  abstract={Internet of Things (IoT) systems are highly susceptible to cyberattacks by nature with minimal security protections. Providing a massive attack surface for attackers, they automatically become easy targets with potentially catastrophic impacts. Researchers are currently focusing on developing various anomaly detection systems for IoT networks to deal with this situation. However, these systems require a comprehensive labeled attack dataset to classify the malicious traffic correctly. This paper presents a systematic approach to design and develop an IoT testbed to generate such an attack dataset, namely the AIoT-Sol Dataset. Our proposed dataset contains the benign traffic as well as the often-overlooked attack techniques in the existing IoT datasets. It encompasses 17 attack types from several categories: network attacks, web attacks, and web IoT message protocol attacks. We selected these attacks by referencing the Open Web Application Security Project (OWASP) IoT Top Ten. Also, we provide a mapping of possible attacks for all ten security risks.},
  keywords={Systematics;Protocols;Machine learning algorithms;Machine learning;Telecommunication traffic;Logic gates;Virtual machining;Internet of Things;IoT;Attack Dataset;Anomaly Detection;Machine Learning;Security;OWASP IoT Top 10},
  doi={10.23919/ICACT53585.2022.9728969},
  ISSN={1738-9445},
  month={Feb},}@INPROCEEDINGS{10405784,
  author={Pau, Danilo and Ambrose, Prem Kumar and Pisani, Andrea and Aymone, Fabrizio M.},
  booktitle={2023 IEEE International Conference on Metrology for eXtended Reality, Artificial Intelligence and Neural Engineering (MetroXRAINE)}, 
  title={TinyRCE: Forward Learning Under Tiny Constraints}, 
  year={2023},
  volume={},
  number={},
  pages={295-300},
  abstract={The challenge posed by on-tiny-devices learning targeting ultra-low power devices has recently attracted several machine learning researchers. A typical on-device model learning session processes real time streams of data produced by heterogeneous sensors. In such a context, this paper proposes TinyRCE, a forward-only learning approach based on a hyperspherical classifier aiming to be deployed on microcontrollers and, potentially, on sensors. The learning process is fed by labeled data streams to be classified by the proposed method. The classical RCE algorithm has been modified by adding a forget mechanism to discard useless neurons from the classifier's hidden layer, since they could become redundant over time. TinyRCE is fed with compact features extracted by a convolutional neural network which could be an extreme learning machine. In such case, the weights of the topology were randomly initialized instead of trained offline with backpropagation. Its weights are stored in a tiny read-only memory of 76.45KiB. The classifier required up to 40.26KiB of RAM to perform a complete on-device learning workload in 0.216s, running on an MCU clocked at 480MHz. TinyRCE has been evaluated with a new interleaved learning and testing protocol to mimic an on-tiny-device forward learning workload. It has been tested with openly available datasets representing human activity monitoring (PAMAP2, SHL) and ball-bearing anomaly detection (CWRU) case studies. Experiments have shown that TinyRCE performed competitively against a supervised convolutional topology followed by a SoftMax classifier trained with backpropagation on all these datasets.},
  keywords={Backpropagation;Random access memory;Learning (artificial intelligence);Feature extraction;Topology;Sensors;Streams;On-Tiny-Device Learning;TinyML;Hyper-Spherical Classifier;Extreme Learning Machines;Feature Extraction;Human Activity Recognition},
  doi={10.1109/MetroXRAINE58569.2023.10405784},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11504862,
  author={R, BHAVENTHAN and X, DANIEL STANLYRAJ and PURUSHOTHAMAN, S.},
  booktitle={2026 International Conference on Recent Advances in Electrical, Electronics, Ubiquitous Communication, and Computational Intelligence (RAEEUCCI)}, 
  title={Vibration-Based Predictive Maintenance for Motors Using Edge AI}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The proposed work aims to minimize unplanned downtime and maintenance costs by implementing a vibrationbased predictive maintenance system for motor fault diagnosis. A Brushless DC (BLDC) motor integrated with a Raspberry Pi 4 Model B and an ADXL345 tri-axial accelerometer is employed for real-time vibration data acquisition at different operating speeds 1000, 1500, and 2000 RPM using an electronic speed controller. The acquired vibration signals are locally processed on the edge device, where a one-dimensional Convolutional Neural Network model classifies motor health conditions including normal operation, imbalance, misalignment, and bearing wear. Unlike conventional TinyML-based approaches that primarily focus on binary fault detection, the proposed system performs multi-class fault identification, enabling more precise condition monitoring. The diagnostic results are displayed on an OLED interface, facilitating rapid decisionmaking and real-time monitoring. The edge-based implementation reduces latency, bandwidth dependency, and reliance on cloud infrastructure, making the system suitable for practical industrial predictive maintenance applications.},
  keywords={Vibrations;Modeling;Timing;Motors;Convolutional neural networks;Real-time systems;Predictive maintenance;Printing;Fault diagnosis;Fault detection;Predictive Maintenance;Edge AI;Vibration Analysis;Convolutional Neural Networks;Fault Diagnosis;Motor Condition Monitoring},
  doi={10.1109/RAEEUCCI67649.2026.11504862},
  ISSN={},
  month={April},}@INPROCEEDINGS{10539445,
  author={Aatab, Soufiane and Freitag, Felix},
  booktitle={2023 IEEE 9th World Forum on Internet of Things (WF-IoT)}, 
  title={Towards a Library of Deep Neural Networks for Experimenting with on-Device Training on Microcontrollers}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Despite the limited computing capacity of microcontrollers, there is a growing interest in training neural networks on these devices for tiny machine learning applications. The traditional approach is to train models off-device on powerful machines, but this limits the model's ability on the microcontroller to adapt to changing data. A limitation for further research on on-device training is the lack of open source deep neural network implementations for the training on microcontroller boards. In this paper, we present the design and implementation of a library in C++ to enable neural network training and inference on microcontroller boards. We conduct a functional validation of the implementation by comparing a Convolutional Neural Network (CNN) and autoencoder model defined with our library with a reference implementation. We then integrate the library into a machine learning application and flash it on an Arduino Portenta board to demonstrate its usability for on-device training. The developed library is open source and is flexible for defining different neural network architectures. Researchers and developers can use the given implementation as a tool for building new trainable machine learning applications, but can also extend it with recent model optimization techniques for tiny nodes from the research in this field.},
  keywords={Training;Adaptation models;Microcontrollers;Computational modeling;Computer architecture;C++ languages;Libraries;embedded learning;microcontrollers;deep learning},
  doi={10.1109/WF-IoT58464.2023.10539445},
  ISSN={2768-1734},
  month={Oct},}@INPROCEEDINGS{11227211,
  author={Bonazzi, Pietro and Vogt, Christian and Jost, Michael and Qin, Haotong and Khacef, Lyes and Paredes-Valles, Federico and Magno, Michele},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={RGB-Event Fusion with Self-Attention for Collision Prediction}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Ensuring robust and real-time obstacle avoidance is critical for the safe operation of autonomous robots in dynamic, real-world environments. This paper proposes a neural network framework for predicting the time and collision position of an unmanned aerial vehicle with a dynamic object, using RGB and event-based vision sensors. The proposed architecture consists of two separate encoder branches, one for each modality, followed by fusion by self-attention to improve prediction accuracy.To facilitate benchmarking, we leverage the ABCD [8] dataset collected that enables detailed comparisons of single-modality and fusion-based approaches.At the same prediction throughput of 50Hz, the experimental results show that the fusion-based model offers an improvement in prediction accuracy over single-modality approaches of 1% on average and 10% for distances beyond 0.5m, but comes at the cost of +71% in memory and + 105% in FLOPs. Notably, the event-based model outperforms the RGB model by 4% for position and 26% for time error at a similar computational cost, making it a competitive alternative.Additionally, we evaluate quantized versions of the event-based models, applying 1- to 8-bit quantization to assess the trade-offs between predictive performance and computational efficiency.These findings highlight the trade-offs of multi-modal perception using RGB and event-based cameras in robotic applications.},
  keywords={Event detection;Computational modeling;Neural networks;Robot vision systems;Predictive models;Throughput;Computational efficiency;Collision avoidance;Vehicle dynamics;Drones;Drone;TinyML;Obstacle Avoidance;Event-Based Camera},
  doi={10.1109/IJCNN64981.2025.11227211},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{11121976,
  author={Giordano, Marco and Bonazzi, Pietro and Benini, Luca and Magno, Michele},
  booktitle={2025 10th International Workshop on Advances in Sensors and Interfaces (IWASI)}, 
  title={Sub-Millisecond Event-Based Eye Tracking on a Resource-Constrained Microcontroller}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a novel event-based eye-tracking system deployed on a resource-constrained microcontroller, addressing the challenges of real-time, low-latency, and low-power performance in embedded systems. The system leverages a Dynamic Vision Sensor (DVS), specifically the DVXplorer Micro, with an average temporal resolution of 200µs, to capture rapid eye movements with extremely low latency. The system is implemented on a novel low-power and high-performance microcontroller from STMicroelectronics, the STM32N6. The microcontroller features an 800MHz Arm Cortex-M55 core and AI hardware accelerator, the Neural-ART Accelerator, enabling real-time inference with milliwatt power consumption. The paper propose a hardware-aware and sensor-aware compact Convolutional Neuron Network (CNN) optimized for event-based data, deployed at the edge, achieving a mean pupil prediction error of 5.99 pixels and a median error of 5.73 pixels on the Ini-30 dataset. The system achieves an end-to-end inference latency of just 385µs and a neural network throughput of 52 Multiply and Accumulate (MAC) operations per cycle while consuming just 155µJ of energy. This approach allows for the development of a fully embedded, energy-efficient eye-tracking solution suitable for applications such as smart glasses and wearable devices.},
  keywords={Microcontrollers;Event detection;Gaze tracking;Vision sensors;Real-time systems;Convolutional neural networks;Low latency communication;Voltage control;Wearable sensors;Smart glasses;Smart Glasses;TinyML;Eye Tracking;Event-Based Cameras;Dataset},
  doi={10.1109/IWASI66786.2025.11121976},
  ISSN={2836-7936},
  month={July},}@INPROCEEDINGS{11282031,
  author={Gawande, Ashish},
  booktitle={2025 IEEE International Conference on Internet of Things and Intelligence Systems (IoTaIS)}, 
  title={Cloud-Edge Collaborative Learning: Real-Time IoT Data Processing with GoLang Microservices for Agriculture}, 
  year={2025},
  volume={},
  number={},
  pages={166-170},
  abstract={Agriculture is entering a new digital era, with IoT devices generating a large amount of data from soil sensors, drones, livestock trackers, and greenhouse controllers. Traditional cloud-only systems send all this data to remote servers, which causes delays, excessive network usage, and a dependence on constant internet connectivity. This paper introduces a GoLang‑based cloud–edge collaborative learning framework. In this design, edge devices handle tasks such as local inference, anomaly detection, and actuator control that require rapid processing. At the same time, the cloud collects anomaly data, retrains AI models, and sends updated TinyML models back to the edge. This paper provides clear technical guidance, including GoLang microservice code, JSON formats, Kafka topic, MQTT message structures, and Kubernetes deployment examples. A basic evaluation reveals that the system can respond in under 250 ms, reduce bandwidth usage by approximately 80%, and scale effectively to support large farms.},
  keywords={Smart agriculture;Cloud computing;Codes;Federated learning;Image edge detection;Microservice architectures;Data models;Livestock;Internet of Things;Edge computing;Cloud Computing;Edge Computing;GoLang;IoT;Kafka;Kubernetes;MQTT;Smart Agriculture;TinyM},
  doi={10.1109/IoTaIS67227.2025.11282031},
  ISSN={2832-1383},
  month={Nov},}@ARTICLE{11419082,
  author={Bezerra, Ranulfo and Tadokoro, Satoshi and Ohno, Kazunori},
  journal={IEEE Internet of Things Journal}, 
  title={AI-IoT-Robotics Integration: Survey of Frameworks, Emerging Trends, and the Path Toward Connected Robotics}, 
  year={2026},
  volume={13},
  number={10},
  pages={20398-20412},
  abstract={The convergence of Artificial Intelligence, the Internet of Things, and Robotics is no longer a futuristic vision; it is rapidly becoming the foundation of real-time, intelligent, and context-aware systems. Al enables perception and reasoning, loT provides scalable sensing and communication, and robotics delivers embodied actuation. Despite significant progress in pairwise combinations such as AloT and the Intemet of Robotic Things (IoRT), there remains a lack of unified design frameworks that fully integrate all three. This survey synthesizes the state-of-the-art across these domains, emphasizing the emerging role of Small Language Models (SLMs) at the edge and Large Language Models (LLMs) in the cloud for distributed cognition and autonomous decision-making. We propose a modular system architecture that aligns with these trends, analyze persistent gaps in interoperability and feedback control, and classify existing work by integration depth. Our review highlights how hybrid SLM-LLM systems, when coupled with loT infrastructure and robotic agents, can address challenges in real-time adaptation, scalability, and reliability. This work offers a conceptual and technical roadmap for designing next-generation Al-loT-Robotic ecosystems that are modular, interpretable, and capable of learning within dynamic environments, paving the way for the emerging paradigm of Connected Robotics and Physical Al.},
  keywords={Robots;Robot sensing systems;Artificial intelligence;Robot kinematics;Internet of Things;Cognition;Taxonomy;Surveys;Real-time systems;Sensors;AIoT;connected robotics;cyberphysical systems;distributed autonomy;edge intelligence;physical AI},
  doi={10.1109/JIOT.2026.3670191},
  ISSN={2327-4662},
  month={May},}@ARTICLE{9912325,
  author={Saha, Swapnil Sayan and Sandha, Sandeep Singh and Srivastava, Mani},
  journal={IEEE Sensors Journal}, 
  title={Machine Learning for Microcontroller-Class Hardware: A Review}, 
  year={2022},
  volume={22},
  number={22},
  pages={21362-21390},
  abstract={The advancements in machine learning (ML) opened a new opportunity to bring intelligence to the low-end Internet-of-Things (IoT) nodes, such as microcontrollers. Conventional ML deployment has high memory and computes footprint hindering their direct deployment on ultraresource-constrained microcontrollers. This article highlights the unique requirements of enabling onboard ML for microcontroller-class devices. Researchers use a specialized model development workflow for resource-limited applications to ensure that the compute and latency budget is within the device limits while still maintaining the desired performance. We characterize a closed-loop widely applicable workflow of ML model development for microcontroller-class devices and show that several classes of applications adopt a specific instance of it. We present both qualitative and numerical insights into different stages of model development by showcasing several use cases. Finally, we identify the open research challenges and unsolved questions demanding careful considerations moving forward.},
  keywords={Microcontrollers;Sensors;Data models;Hardware;Random access memory;Mathematical models;Computational modeling;Feature projection;Internet of Things;machine learning (ML);microcontrollers;model compression;neural architecture search (NAS);neural networks;optimization;sensors;TinyML},
  doi={10.1109/JSEN.2022.3210773},
  ISSN={1558-1748},
  month={Nov},}@ARTICLE{10022047,
  author={Jain, Vikram and Giraldo, Sebastian and Roose, Jaro De and Mei, Linyan and Boons, Bert and Verhelst, Marian},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={TinyVers: A Tiny Versatile System-on-Chip With State-Retentive eMRAM for ML Inference at the Extreme Edge}, 
  year={2023},
  volume={58},
  number={8},
  pages={2360-2371},
  abstract={Extreme edge devices or Internet-of-Things (IoT) nodes require both ultra-low power (ULP) always-on (AON) processing as well as the ability to do on-demand sampling and processing. Moreover, support for IoT applications, such as voice recognition, machine monitoring, and so on, requires the ability to execute a wide range of machine learning (ML) workloads. This brings challenges in hardware (HW) design to build flexible processors operating in ULP regime. This article presents TinyVers, a tiny versatile ULP ML system-on-chip (SoC) to enable enhanced intelligence at the extreme edge. TinyVers exploits dataflow reconfiguration to enable multi-modal support and aggressive on-chip power management for duty cycling to enable smart sensing applications. The SoC combines an reduced instruction set computer-V (RISC-V) host processor, a 17-tera operations per second per watt (TOPS/W) dataflow reconfigurable ML accelerator, a 1.7- $\mu \text{W}$  deep sleep wake-up controller (WuC), and an embedded magnetoresistive random access memory (eMRAM) for boot code and ML parameter retention. The SoC can perform up to 17.6 giga operations per second (GOPS) while achieving a power consumption range from 1.7  $\mu \text{W}$  to 20 mW. Multiple ML workloads aimed for diverse applications are mapped on the SoC to showcase its flexibility and efficiency. All the models achieve 1–2 TOPS/W of energy efficiency with a power consumption below 230  $\mu \text{W}$  in continuous operation. In a duty-cycling use case for machine monitoring, this power is reduced to below 10  $\mu \text{W}$ .},
  keywords={Hardware;Kernel;Memory management;Convolution;Task analysis;System-on-chip;Support vector machines;Extreme edge;machine learning (ML) accelerators;system-on-chip (SoC);tinyML;ultralow power (ULP)},
  doi={10.1109/JSSC.2023.3236566},
  ISSN={1558-173X},
  month={Aug},}@ARTICLE{10955720,
  author={Abou El Houda, Zakaria and Moudoud, Hajar and Brik, Bouziane},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={When Federated Learning Meets Knowledge Distillation to Secure Consumer Edge Network}, 
  year={2025},
  volume={71},
  number={2},
  pages={7192-7200},
  abstract={Consumer networks face several security challenges due to the distributed nature of edge devices and the sensitive data they handle. Federated Learning (FL) presents a promising paradigm for collaborative model training in distributed environments. However, its implementation in edge consumer networks raises concerns about model heterogeneity, communication efficiency, and reverse engineering attacks. To address these issues, in this paper, we introduce SKDFL, a novel framework that leverages Knowledge Distillation (KD) and Secure Multi-Party Computation (SMPC) techniques to enhance communication efficiency while preserving data privacy in edge consumer networks. Through the use of KD, the distilled knowledge is transmitted between devices, significantly reducing communication overhead. Additionally, we incorporate lightweight encryption mechanisms to protect soft-labels from reverse engineering attacks using SMPC. We evaluate our proposed framework using two public datasets and demonstrate its efficiency in reducing communication costs, achieving up to a 92.4% reduction compared to conventional FL methods. Moreover, SKDFL achieves high performances in terms of accuracy and F1-score in both binary and multi-class classification while preserving the privacy of clients. Our obtained results show the potential of SKDFL to address the challenges of communication efficiency and data privacy in FL for edge consumer networks, paving the way for secure and efficient collaborative learning in consumer networks.},
  keywords={Computational modeling;Security;Federated learning;Data models;Training;Knowledge engineering;Predictive models;Data privacy;Accuracy;Performance evaluation;TinyML;federated learning;knowledge distillation;edge consumer network},
  doi={10.1109/TCE.2025.3559004},
  ISSN={1558-4127},
  month={May},}@INPROCEEDINGS{10580468,
  author={Wu, Gang and Chen, Yanming and Zhang, Yiwen},
  booktitle={2024 27th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={MicroENet: An Efficient Network for MCUs with Low Model Parameters and Peak Memory}, 
  year={2024},
  volume={},
  number={},
  pages={790-795},
  abstract={Machine learning (ML) is increasingly vital for IoT applications and Industry 4.0. Compared to uploading data to the cloud for ML inference. Utilizing ML for local low-power IoT device analysis can conserve energy and ensure data privacy by avoiding cloud uploads. However, the inference of convolutional neural networks (CNNs) usually requires large intermediate activation maps and involves substantial parameters. Most IoT devices have only <320KB SRAM and <2MB Flash. To address these resource constraints, this paper proposes a novel model MicroENet with only hundreds of KB peak memory and parameters. Firstly, the memory bottleneck lies in the first few blocks of the CNNs so that we reduce the output channels of the first layer of the model and employ efficient downsampling in the second layer to decrease the image size quickly, bypassing the large activation layer. Then, the enhanced attention depthwise blocks (MCU-Blocks) are proposed, which have high parametric efficiency. Based on these blocks, we develop a tiny architecture with an ImageNet accuracy of 63.9%. Impressively, this result is achieved using only 245KB peak memory and 0.96 million parameters. In the visual wake word experiment, the size of our model is further reduced and achieves 89.64% accuracy with 28KB peak memory. Finally, MicroENet is deployed on the STM32F746 microcontroller for the image classification task. The experimental results show that our model outperforms others with similar peak memory and parameters.},
  keywords={Performance evaluation;Visualization;Accuracy;Microcontrollers;Memory management;Random access memory;Product design;Industry 4.0;IoT;CNNs;tinyML;deep learning},
  doi={10.1109/CSCWD61410.2024.10580468},
  ISSN={2768-1904},
  month={May},}@ARTICLE{11318000,
  author={Ouyang, Nuonan and Shatte, Adrian and Lu, Zhigang and Chen, Chao and Xiang, Wei},
  journal={IEEE Internet of Things Journal}, 
  title={Artificial Intelligence in Mitigating Security Threats for Lightweight IoT Devices: A Survey of Technologies, Protocols, and Future Challenges}, 
  year={2026},
  volume={13},
  number={7},
  pages={14096-14111},
  abstract={Lightweight Internet of Things (IoT) devices—microcontroller-class nodes with less than 512-kB RAM, sub-100-MHz clocks, and low-power radios [Bluetooth low energy (BLE), Zigbee, LoRa, and narrowband IoT (NB-IoT)]—are now widely deployed in settings, where traditional security stacks are infeasible. This survey examines how artificial intelligence (AI) can harden such constrained platforms against device-, network-, and application-layer threats, including spoofing, routing manipulation, DDoS, malware, and advanced persistent threats (APTs). We: 1) formalize a lightweight envelope that bounds feasible defenses in terms of RAM, CPU, bandwidth, and energy; 2) consolidate protocol-side risks across BLE, Zigbee, and LoRaWAN; and 3) review deployable AI techniques through a deployment-first lens that separates training [edge, cloud, and federated learning (FL)] from on-device inference. Distinct from prior surveys, we provide resource-annotated comparisons that report accuracy alongside model size, peak RAM, latency, and estimated energy per inference, showing how pruning, posttraining quantization, distillation, and feature narrowing shift feasibility on microcontroller unit (MCU) targets. Covered methods include compact classifiers [linear models, trees, and support vector machine (SVM)], quantized TinyCNN/TinyRNN, and graph-based intrusion detection (IDS), reinforcement learning (RL) for adaptive rate limiting and channel selection, and privacy-preserving FL with update compression. We conclude with a pragmatic agenda—energy-adaptive inference, low-power wide-area network (LPWAN)-aware scheduling and FL, robustness to poisoning and evasion, and reproducible benchmarks that couple accuracy with size/latency/energy on real hardware—aimed at making AI-based security practical at scale for lightweight IoT deployments.},
  keywords={Internet of Things;Security;Artificial intelligence;Surveys;Computational modeling;Accuracy;Random access memory;Protocols;Bandwidth;Adaptation models;Energy efficiency;Internet of Things (IoT);intrusion detection (IDS);lightweight devices;low-power wide-area network (LPWAN) (LoRaWAN/Bluetooth low energy (BLE)/Zigbee);security;TinyML;training versus inference},
  doi={10.1109/JIOT.2025.3649316},
  ISSN={2327-4662},
  month={April},}@INPROCEEDINGS{11517953,
  author={R, Kashmeera and Krishnan, Prabhakar and N. N., Hari and Subramanian N, Sethu and Jain, Kurunandan},
  booktitle={2026 International Conference on Smart Electronic Devices and Intelligent Systems (ICSEDIS)}, 
  title={Replay-Enhanced Adaptive Hybrid Intrusion Detection (REA-HID) for IoT Edge Gateways}, 
  year={2026},
  volume={},
  number={},
  pages={965-970},
  abstract={The deployment of Internet of Things (IoT) devices via edge gateways has become commonplace and has also opened the door for all sorts of security breaches; particularly, adversaries can now execute low-and-slow, timing-aware-attacks that are mimicking normal telemetry very closely even to the point of being undetectable by static intrusion detection systems (IDS). It must be said that previous studies have shown lighter model installations on Raspberry Pi-class gateways, but temporal realism, concept drift, and reproducibility issues remain. The proposed REA–HID system (Replay-Enhanced Adaptive Hybrid Intrusion Detection), an IDS that uses a light-weight model, features both deterministic and synthetic flow generators that produce benign telemetry and parametrically defined timing aware adversarial flows. The system implements an auditable Page Hinkley drift detector which uses replay buffer gated retraining to achieve secure system adaptation while combining a supervised MLP classifier with an OR-fusion system that merges reconstruction-based anomaly signals. The float16 TFLite model achieves an F1-score of 0.9792 for hybrid detection and 0.0417 for false positives on a controlled synthetic low-and-slow benchmark which tests the model on the prescribed hardware. The NF-BoT-IoT-v2 dataset undergoes zero-shot evaluation which shows major feature-distribution divergence proving the requirement for drift-aware adaptation. The system provides all components with deterministic manifests and drift logs which enable researchers to reproduce tests.},
  keywords={Internet of Things;Modeling;Timing;Testing;Signal detection;Intrusion detection;Manuals;Fluid flow;Machine learning;Bot (Internet);IoT Security;Intrusion Detection;Adaptive IDS;TinyML;Concept Drift;Page-Hinkley Test;Replay Buffer},
  doi={10.1109/ICSEDIS68157.2026.11517953},
  ISSN={},
  month={April},}@INPROCEEDINGS{11569550,
  author={Elumalai, Dinesh Kumar and Rajan, Ramya},
  booktitle={2026 IEEE World AI IoT Congress (AIIoT)}, 
  title={MPS Tensor Compression for Foundation Model Deployment on TinyIoT Edge Devices}, 
  year={2026},
  volume={},
  number={},
  pages={0239-0244},
  abstract={An industrial microcontroller running predictive maintenance firmware typically carries 64–512KB of SRAM and a milliwatt power budget—constraints that have changed little in a decade, while the foundation models that would benefit the deployment have grown by several orders of magnitude. Even a compact quantized transformer commonly demands 400–500KB at runtime, leaving no headroom for the sensor drivers and communication stacks that share the same hardware. This paper introduces MPS-TinyFM, a post-training compression framework that applies Matrix Product State (MPS) decomposition to foundation model weight tensors. MPS-TinyFM works by exposing the low-rank structure that trained weight matrices already carry: each matrix is reshaped into a higher-order tensor and factored into a chain of compact factor tensors, with bond dimensions assigned per layer through a calibration-driven sensitivity procedure we call Layer-Sensitivity Bond Dimension Allocation (LSBA). Inference runs directly on the factor chain— no weight reconstruction ever occurs—so peak SRAM scales with bond dimension rather than with the original matrix dimensions. Evaluated on encoder-only and time-series transformer architectures across three foundation models and three MCU-class platforms (STM32H743, ESP32-S3, GD32VF103), MPS-TinyFM achieves 44–63× compression, retains 93.8–96.4% of task accuracy, and runs within 19–142ms per inference at 1.4–4.7mJ. Peak runtime SRAM stays at 389–412KB—100–123KB below the 512KB ceiling—compared to 486KB or more for every quantization baseline evaluated.},
  keywords={Modeling;Quantization (signal);Printing;Training;SRAM chips;Matrices;Bonding;Tensors;Timing;Transformers;Matrix Product State;Tensor Decomposition;Foundation Models;TinyML;Edge IoT;Model Compression;Microcontroller Inference;Bond Dimension Allocation},
  doi={10.1109/AIIoT68874.2026.11569550},
  ISSN={},
  month={May},}@INPROCEEDINGS{11478840,
  author={M, Vadivelan and J, Padmaja and R, Bhuvaneswari and N, Sajini Navab},
  booktitle={2026 Twelfth International Conference on Bio Signals, Images, and Instrumentation (ICBSII)}, 
  title={Embedded AI System Continuous Surveillance for Neurofibromatosis Using Wearable Bioimpedance and Nerve Signal Sensors}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Neurofibromatosis is a progressive neurological disorder that requires continuous observation to detect subtle changes in nerve and tissue characteristics at an early stage. The risks of neurofibromatosis range from cosmetic and functional impairments to potential malignant transformation of tumors, emphasizing the importance of timely diagnosis and intervention. Early identification of neurofibromatosis-related changes is crucial to prevent long-term complications and improve patient quality of life. This work proposes a wearable and non-invasive monitoring approach that focuses on tracking physiological variations over time and interpreting these patterns to assess potential risk levels. The proposed approach emphasizes intelligent signal interpretation and real-time assessment to support early abnormality identification without revealing underlying implementation details. Clinically meaningful outputs are provided to assist healthcare professionals in long-term monitoring and timely intervention, while prioritizing portability, patient comfort, and practical usability in everyday clinical environments.},
