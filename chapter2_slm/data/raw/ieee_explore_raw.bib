  author={Goud, Aman and Loonkar, Shweta and Desai, Karishma},
  booktitle={2026 Contemporary Computing Innovations Conference (CCIC)}, 
  title={A Trade-Off Aware Analysis of Lightweight Neural Networks for IoT Sensor Data Processing}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents a comprehensive overview of IoT architecture and provides an in-depth comparison of Light Weight neural networks over traditional networks performance metrics in a resource constrained environment and addressing the critical gap in standardized evaluation of performance metrics which can be used to make decision which architecture would work better over the other. The research evaluates energy consumption, memory, latency and accuracy across many different IoT architectures using LNNs and classical methods, employing a unified standard evaluation framework. An in-depth analysis of existing literature identified key limitations, leading to the development of a robust evaluation framework validated through 81 purposively selected participants belonging to engineering discipline using PLS-SEM. Cronbach's internal consistency confirmed the reliability while Fornell-Larcker validated the discriminant validity. In comparison to conventional statistical methods, experimental data show that lightweight neural networks reduce inference latency by 18-25% and increase accuracy by $6-10 {\%}$. Trade-off efficiency and evaluation consistency have a strong positive association ($\beta=0.71, p<0.05$) ($\beta=0.71, p<0.05$) according to structural model analysis, and discriminant validity is verified by HTMT values below 0.85. Overall, the findings demonstrate the efficacy of lightweight neural networks in conjunction with a uniform scoring system for effective and comprehensible. The survey findings confirmed that the LNNs offer greater performance over classical network and suggested a comprehensive framework which can be used as guidance for engineers to choose models with real hardware constraints.},
  keywords={Microcontrollers;Filtering;Microprocessors;Central Processing Unit;Filters;Communication systems;Industrial Internet of Things;Internet of Things;Internet;Software defined networking;IOT sensor data;TinyML;Model pruning;PLS-Sem Model},
  doi={10.1109/CCIC68129.2026.11486132},
  ISSN={},
