  author={Jarwar, Muhammad Aslam and Khowaja, Sunder Ali and Dev, Kapal and Adhikari, Mainak and Hakak, Saqib},
  journal={IEEE Internet of Things Journal}, 
  title={NEAT: A Resilient Deep Representational Learning for Fault Detection Using Acoustic Signals in IIoT Environment}, 
  year={2023},
  volume={10},
  number={4},
  pages={2864-2871},
  abstract={Fault diagnostics involving the Internet-of-Things (IoT) sensors and edge devices is a challenging task due to their limited energy and computational capabilities. Another challenge concerning IoT sensors or devices is the incursion of noise when used in an industrial environment. The noisy samples affect the decision support system that could lead to financial and operational losses. This article proposes a noisy encoder using artificial intelligence of things (NEAT) architecture for fault diagnosis in IoT edge devices. NEAT combines autoencoders and Inception module to co-train the clean and noisy samples for solving the said problem. Experimental results on benchmark data sets reveal that the NEAT architecture is noise resilient in comparison to the existing works. Furthermore, we also show that the NEAT architecture has lightweight characteristics as it yields a lower number of parameters, weight storage, training, and testing times that support its real-life applicability in an Industrial IoT environment.},
  keywords={Acoustics;Feature extraction;Industrial Internet of Things;Fault diagnosis;Vibrations;Sensors;Data models;Deep learning;fault diagnosis and maintenance;Industrial Internet of Things (IIoT);intelligence of things;noisy encoders;representational learning},
  doi={10.1109/JIOT.2021.3109668},
  ISSN={2327-4662},
  month={Feb},}@INPROCEEDINGS{9978320,
  author={Tabrizchi, Sepehr and Angizi, Shaahin and Roohi, Arman},
  booktitle={2022 IEEE 40th International Conference on Computer Design (ICCD)}, 
  title={TizBin: A Low-Power Image Sensor with Event and Object Detection Using Efficient Processing-in-Pixel Schemes}, 
  year={2022},
  volume={},
  number={},
  pages={770-777},
  abstract={In the Artificial Intelligence of Things (AIoT) era, always-on intelligent and self-powered visual perception systems have gained considerable attention and are widely used. Thus, this paper proposes TizBin, a low-power processing in-sensor scheme with event and object detection capabilities to eliminate power costs of data conversion and transmission and enable data-intensive neural network tasks. Once the moving object is detected, TizBin architecture switches to the high-power object detection mode to capture the image. TizBin offers several unique features, such as analog convolutions enabling low-precision ternary weight neural networks (TWNN) to mitigate the overhead of analog buffer and analog-to-digital converters. Moreover, TizBin exploits non-volatile magnetic RAMs to store NN’s weights, remarkably reducing static power consumption. Our circuit-to-application co-simulation results for TWNNs demonstrate minor accuracy degradation on various image datasets, while TizBin achieves a frame rate of 1000 and efficiency of ∼1.83 TOp/s/W.},
  keywords={Power demand;Magnetic resonance imaging;Random access memory;Object detection;Computer architecture;Internet of Things;Artificial intelligence},
  doi={10.1109/ICCD56317.2022.00117},
  ISSN={2576-6996},
  month={Oct},}@ARTICLE{9662379,
  author={Lin, Tzu-Heng and Zhang, Xin-Ru and Chen, Chia-Pan and Chen, Jia-Huei and Chen, Hung-Hsuan},
  journal={IEEE Sensors Journal}, 
  title={Learning to Identify Malfunctioning Sensors in a Large-Scale Sensor Network}, 
  year={2022},
  volume={22},
  number={3},
  pages={2582-2590},
  abstract={This paper proposes a two-stage methodology to discover malfunctioning sensors in an air quality sensor network. The two-stage methodology consists of a supervised learner to predict the future PM2.5 values of each sensor and a detector that leverages the result of the previous stage to detect the malfunctioning sensors. Consequently, even if each sensor’s health status (i.e., normal or malfunctioning) is unavailable, we can still apply powerful supervised learners to this task. We conduct experiments on a nationwide air quality sensor network that includes 10,000+ sensors and utilize periodic maintenance records on some of these sensors as the ground truth of their health status. Experimental results show that this two-stage methodology can effectively discover problematic sensors. As maintaining a large-scale sensor network is laborious, the methodology can dramatically reduce the human resource required for regular inspection.},
  keywords={Sensors;Monitoring;Temperature sensors;Optical sensors;Pollution measurement;Sensor phenomena and characterization;Atmospheric measurements;Auto inspection;IoT;AIoT;PM25;sensor network;anomaly detection},
  doi={10.1109/JSEN.2021.3138250},
  ISSN={1558-1748},
  month={Feb},}@INPROCEEDINGS{11485903,
  author={M, Vivek Kumar and D, Santhosh and E, Sanjay and S, Sanjai. M and G, Sivaprakash},
  booktitle={2026 Contemporary Computing Innovations Conference (CCIC)}, 
  title={Ai-Iot Based Predictive Failure Detection System for Industrial Carding Machine Using web Application}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The high-speed carding machines in textile mills require constant monitoring to avoid unforeseen breakdowns and productivity losses. This system initializes the ESP32 with temperature, vibration, gas, and infrared sensors in order to start data gathering. The sensors continuously read the machine's characteristics before sending the collected data to the cloud. An AI model examines this data to identify unusual patterns using trained datasets. If unusual conditions are detected, the system predicts machine failure. The online application allows operators to view machine health statistics, alarms, and real-time status. If no flaws are discovered, the system automatically keeps checking. This approach reduces downtime, ensures safe and effective machine operation, and enables early failure prediction.},
  keywords={Feeds;Microcontrollers;Microprocessors;Circuits;Circuits and systems;Diodes;Oscillators;Contacts;Light emitting diodes;Internet of Things;Predictive Maintenance;AIoT;Carding Machine;Anomaly Detection;Condition Monitoring},
  doi={10.1109/CCIC68129.2026.11485903},
  ISSN={},
  month={Feb},}@ARTICLE{11311349,
  author={Chen, Ching-Han and Chang, Chih-Hao and Peng, Chih-Wei and Lan, Guan-Wei},
  journal={IEEE Internet of Things Magazine}, 
  title={Enabling AI-Driven Real-Time Communication and Computation With DDS for IoT-Assisted Home Care}, 
  year={2026},
  volume={9},
  number={2},
  pages={41-48},
  abstract={As aging populations drive demand for smart home–based care, edge-enabled IoT systems must provide real-time responsiveness, reliability, and on-device intelligence. However, Message Queuing Telemetry Transport (MQTT) and the Constrained Application Protocol (CoAP) often fall short for high-frequency, multimodal, AI-driven workloads. We present a practical framework that uses the Data Distribution Service (DDS) as the backbone for scalable, low-latency, and resilient Artificial Intelligence of Things (AIoT) deployments. The design supports dynamic node discovery, automated Quality of Service (QoS) tuning, and containerized rollout across heterogeneous edge devices. It integrates AI-based video and audio analytics to detect critical events in real time, while a brokerless DDS model reduces latency and removes single points of failure. We provide implementation steps and lessons learned from a replicable gateway–sensor architecture. In experiments across four image-delivery scenarios (single- and multi-device), DDS sustained higher throughput and packet rate than MQTT and avoided the 14% packet loss observed for MQTT under multi-device transmission. These results indicate that DDS is an efficient and robust foundation for AI-powered home-care edge networks.},
  keywords={Artificial intelligence;Internet of Things;Real-time systems;Logic gates;Quality of service;Reliability;Image edge detection;Protocols;Peer-to-peer computing;Videos;Older adults;Smart homes;Assistive technologies},
  doi={10.1109/MIOT.2025.3637839},
  ISSN={2576-3199},
  month={March},}@INPROCEEDINGS{10987746,
  author={Taweewat, Pat and Suwan-ngam, Warachart and Songsuwankit, Kanoknuch and Konghuayrob, Poom},
  booktitle={2025 13th International Electrical Engineering Congress (iEECON)}, 
  title={Low-Cost System for Investigating a Small Motor Fault Classification Based on Current Signal}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This research presents low-cost system for motor fault classification. This system uses a microcontroller with built-in ADC and communication capability. The two purposes of this article are to investigate the quality of the system for data acquisition and capability of the system for detecting early motor faults both by microcontroller on the system and personal computer. The embedded software on the system is designed to record current signals from a current sensor, compute FFT-based features and classify the fault based on tinyML method. Data communication between the system and the personal computer can be done by both serial port and TCP socket over Wi-Fi. The performances of the system and the personal computer are compared by the experiment as well as the quality of data recorded from the built-in ADC and a digital oscilloscope. The broken rotor bar and bearing fault in a 2.2kW induction motor are investigated. The classifier used in the experiment is a small feed forward neural network which can be implemented on both the proposed low-cost system and the personal computer. Although the recorded electrical current data by built-in ADC is contaminated with noise, the fault classification on the personal computer yield accuracy up to 90%.},
  keywords={Accuracy;Microcontrollers;Fault detection;Neural networks;Data acquisition;Noise;Oscilloscopes;Microcomputers;Motors;Wireless fidelity;Motor faults;Neural network;Low-cost DAQ;FFT feature;Microcontroller},
  doi={10.1109/iEECON64081.2025.10987746},
  ISSN={},
  month={March},}@ARTICLE{10816213,
  author={Pi, Rendong and Yu, Xiang},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  title={Uncertainty Estimation for Sound Source Localization With Deep Learning}, 
  year={2025},
  volume={74},
  number={},
  pages={1-12},
  abstract={While significant progress has been made in the field of sound source localization (SSL), the confidence and robustness of the localization results still remain low. Conducting uncertainty analysis can effectively alleviate this problem since it provides a measure of the confidence level in the SSL results. In this work, we propose a novel framework for SSL that not only delivers the state-of-the-art localization performance, but also provides reliable uncertainty estimations. Our framework leverages a novel backbone architecture integrating a multihead self-attention module to effectively capture spatial features through a self-attention mechanism. Additionally, our approach incorporates subjective theory to associate predictions obtained from the neural network with a Dirichlet distribution. This allows us to model the overall uncertainty by parameterizing the class probabilities of the positions of the sound source. To comprehensively evaluate the performance of the proposed method, extensive experiments were conducted using both simulated and real-world datasets. The results show that the proposed method can improve the SSL accuracy (ACC) and enhance the neural network’s reliability, even out-of-distribution samples can be handled effectively. The obtained accurate sound source positions and uncertainty estimations can be utilized in downstream audio-related tasks, such as enhancing the ACC and reliability of sound event detection by incorporating uncertainty. This integration can assist robots in making more informed decisions by fusing information from multiple sources. Our code is available at https://github.com/Devin-Pi/uncertainty-estimation-for-ssl.},
  keywords={Uncertainty;Estimation;Location awareness;Reliability;Neural networks;Accuracy;Robustness;Bayes methods;Spectrogram;Deep learning;Attention mechanism;deep learning;moving sound source localization (SSL);subjective logic (SL) theory;uncertainty estimation},
  doi={10.1109/TIM.2024.3522632},
  ISSN={1557-9662},
  month={},}@ARTICLE{10731708,
  author={Cao, Jie and Kurniawan, Ernest and Boonkajay, Amnart and Pappas, Nikolaos and Sun, Sumei and Popovski, Petar},
  journal={IEEE Transactions on Communications}, 
  title={Goal-Oriented Communication, Estimation, and Control Over Bidirectional Wireless Links}, 
  year={2025},
  volume={73},
  number={5},
  pages={3031-3045},
  abstract={We consider a wireless networked control system (WNCS) with imperfect bidirectional links for real-time applications such as smart grids. To maintain the stability of WNCS, captured by the probability that plant state violates preset values, at minimal cost, heterogeneous physical processes are monitored by multiple sensors. This status information, such as dynamic plant state and Markov Process-based context information, is then received/estimated by the controller for remote control. However, scheduling multiple sensors and designing the controller with limited resources is challenging due to their coupling, delay, and transmission loss. We formulate a Constrained Markov Decision Problem (CMDP) to minimize violation probability with cost constraints. We reveal the relationship between the goal and different updating actions by analyzing the significance of information that incorporates goal-related usefulness and contextual importance. Subsequently, a goal-oriented deterministic scheduling policy is proposed. Two sensing-assisted control strategies and a control-aware estimation policy are proposed to improve the violation probability-cost tradeoff, integrated with the scheduling policy to form a goal-oriented co-design framework. Additionally, we explore retransmission in downlink transmission and qualitatively analyze its preference scenario. Simulation results demonstrate that the proposed goal-oriented co-design policy outperforms previous work in simultaneously reducing violation probability and cost.},
  keywords={Sensors;Costs;Wireless communication;Estimation;Job shop scheduling;Semantics;Robot sensing systems;Real-time systems;Event detection;Delays;Goal-oriented communications;wireless networked control systems;age of information},
  doi={10.1109/TCOMM.2024.3485572},
  ISSN={1558-0857},
  month={May},}@INPROCEEDINGS{11253980,
  author={S, Akshaya B and P, Aswiga D and S, Kaarthik kumaran T and S, Abinaya N},
  booktitle={2025 3rd International Conference on Intelligent Cyber Physical Systems and Internet of Things (ICoICI)}, 
  title={Data-Driven Approach for Water Quality Monitoring in Aquaculture using IoT}, 
  year={2025},
  volume={},
  number={},
  pages={1500-1505},
  abstract={India’s aquaculture sector, expanding at an annual growth rate of 6–7%, plays a vital role in food security and economy. However, large-scale farming and intensive aquaculture practices have led to the decline in the water quality and increase in the aquatic diseases, making water quality management a critical challenge. A data-driven IoT-based framework is proposed to monitor and manage key parameters of pond water in real-time. The system integrates Arduino UNO, Raspberry Pi, sensors, and a webcam to measure temperature, pH, and turbidity. Temperature and pH data are collected using temperature and pH sensors through Arduino, while the Raspberry Pi processes the data and performs image-based turbidity analysis using Laplacian variance techniques. The collected data is transmitted to the ThingSpeak cloud platform, enabling remote monitoring. A fuzzy logic-based decision-making model evaluates deviations from optimal ranges 26– 33°C for temperature, 7.5–8.5 for pH, and turbidity thresholds based on image variance. When a deviation is detected in the processed data, the system automatically activates and notifies the user through email alerts (SMTP). This data-driven approach, integrating IoT, cloud computing, and intelligent decision-making, enhances aquaculture sustainability by ensuring early risk detection, reducing manual intervention, and optimizing resource utilization. The proposed system demonstrates the potential of AIoT-driven smart aquaculture, paving the way for scalable, cost-effective, and environmentally sustainable fish farming practices.},
  keywords={Temperature sensors;Temperature measurement;Fuzzy logic;Temperature distribution;Cloud computing;Decision making;Turbidity;Sensors;Internet of Things;Aquaculture;Aquaculture;Fuzzy Logic;IoT (Internet of Things);Raspberry Pi},
  doi={10.1109/ICoICI65217.2025.11253980},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11472277,
  author={Rouibah, Nassir and Bouttout, Abdelouahab and Haddad, Sofiane and Benghanem, Mohamed and Oukaci, Soumia and Limam, Amel and Boulaiche, Ammar},
  booktitle={2025 5th International Conference on Electrical, Computer and Energy Technologies (ICECET)}, 
  title={Advanced Smart PV System Integrating Internet Of Things, Artificial Intelligence, And Cybersecurity Approaches}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents a secure Artificial Intelligence of Things (SAIoT) framework, emphasizing the advancement of smart photovoltaic (PV) systems through the integration of IoT, AI, and cybersecurity technologies. A smart prototype has been developed for the remote monitoring and anomaly detection of PV systems using an IoT solution, which has undergone experimental validation. The monitored parameters include both environmental and electrical data. Furthermore, the prototype features a web interface that enables users to monitor and control all parameters generated by their installation at any time and from any location. By leveraging an AI solution, the Generative Pre-trained Transformer (ChatGPT) architecture exhibits exceptional capabilities in forecasting and data analysis. We have integrated the ChatGPT architecture into our website to facilitate database access, data analysis, and the generation of system status reports. The website and database are secured with a Secure Sockets Layer (SSL) certificate, ensuring encrypted communication between users and the server. In addition, advanced security filters have been implemented to provide robust protection against potential threats, thereby enhancing overall user safety.},
  keywords={Filtering;Filters;Choppers (circuits);Voltage multipliers;Circuits;Circuits and systems;Switching circuits;Capacitors;Diodes;Communication systems;Photovoltaic Systems;Artificial intelligence;cybersecurity;Internet of thing},
  doi={10.1109/ICECET63943.2025.11472277},
  ISSN={},
  month={July},}@INPROCEEDINGS{11232996,
  author={Sihman Bharattej. R, Rana Veer Samara and Aich, Mrinmoy and Alzaidi, Ahmad and G, Raghu. and Patel, Krunal},
  booktitle={2025 International Conference on Intelligent Communication Networks and Computational Techniques (ICICNCT)}, 
  title={Edge-Optimized LSTM Framework for Blockchain-Enabled Supply Chain Monitoring}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In recent years, the integration of blockchain and Internet of Things (IoT) technology has led to supply chains incorporating transparency to gain a competitive advantage. However, most systems explore blockchain-enabled architectures in a cloud atmosphere, which leads to latency and scalability problems. To address this, the proposed BlockchainEnabled Supply Chain Monitoring Framework using Edge Computing and Long Short-Term Memory (LSTM) model optimized with TinyML Initially for collected IoT data, including radio frequency ID (RFID), Global Positioning System (GPS), and environmental sensors utilized to monitor the environment. First, preprocessed the edge nodes through normalization to ensure a clean and reliable input. Further, the LSTM model is instituted to capture the dependencies related to the time series data for accurate delay determination and anomaly detection, while the model is trained in a federated learning method, which separates the LSTM model from local people to enhance authentication. Optimization was achieved through structured weight pruning to remove unnecessary neurons and through post-training 8-bit quantization. The prediction and notifications were then recorded using the blockchain via a smart contract. Experimental results on the demonstrate that EC-LSTM-TinyML achieving higher accuracy (98.87%), precision (98.67%), recall (97.87%), and F1score (97.89%) when compared with existing model Gated Recurrent Unit- Multi-Head Attention (GRU-MHA).},
  keywords={Accuracy;Computational modeling;Image edge detection;Supply chains;Data models;Blockchains;Internet of Things;Long short term memory;Monitoring;Global Positioning System;supply chain monitoring;edge computing;normalization;internet of things},
  doi={10.1109/ICICNCT66124.2025.11232996},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11496838,
  author={Durgam, Prashanth and Mondal, Molay and Sankar Laxmi Narayana, Bankuru Gowri and Nandi, Subrata and Bhattacharjee, Sanghita and Saha, Sujoy},
  booktitle={2026 IEEE International Conference on AI Engineering and Innovations (AIEI)}, 
  title={AirWise: LLM-Powered Smart Air Quality Monitoring and Automated Appliance Control}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Indoor air quality (IAQ) critically affects occupant health, comfort, and energy efficiency in smart homes. Most current IAQ solutions focus on pollutant detection and visualization, offering limited support for adaptive, user-specific appliance control. This paper presents AirWise, a large language model (LLM)-based framework that integrates real-time indoor and outdoor environmental data with user profiles, including health conditions, comfort preferences, and appliance availability, to provide personalized, context-aware control recommendations. AirWise leverages the Environmental Monitoring Device (EMD) on the iAirGuard platform, which ensures high-quality input by denoising sensor data and using TinyML-based fault detection. The LLM functions as a high-level decision engine, dynamically adjusting AC mode, fan speed, and window/door states, balancing pollutant mitigation, comfort, and energy efficiency. The framework was evaluated in a real smart home testbed under severe pollution conditions. During experiments with an AC equipped with a filter, indoor PM2.5 and PM10 AQI dropped from 6 (Severe) to 2 (Satisfactory) within 50 minutes. LLM inference consumed less than 5% of system tokens, demonstrating real-time applicability. AirWise offers a scalable, adaptive, and energy-aware solution for personalized IAQ management.},
  keywords={Feedback;Filtering;Filters;Circuits;Circuits and systems;Internet of Things;Communication systems;Protocols;Internet;Feedback loop;Indoor air quality (IAQ);Smart homes;Large language models (LLMs);TinyML;IoT sensing;Automated appliance control;Energy-efficient personalized comfort},
  doi={10.1109/AIEI69164.2026.11496838},
  ISSN={},
  month={March},}@INBOOK{11197121,
  author={Byabazaire, John and Tirana, Joana and Chouliaras, Andreas and Koutsos, Vlasis and Aslanidis, Theodoros and Panagiotidis, Ioannis and Chatzopoulos, Dimitris},
  booktitle={Internet of Things A to Z: Technologies and Applications}, 
  title={Deep Learning and the Internet of Things}, 
  year={2026},
  volume={},
  number={},
  pages={193-228},
  abstract={Summary <p>The Internet of Things (IoT) represents a paradigm shift from traditional computing by enabling physical things to communicate over the Internet. IoT devices, from sensors to wearables, produce unprecedented amounts of data that allow better and faster decision&#x2010;making through analytics. As a result, this has led to innovations in many domains. Due to the enormous volume of data generated, several challenges require advanced techniques such as deep learning (DL). Additionally, as IoT devices collect personal data, concerns about data privacy are rising. Edge intelligence processes data nearer to its source, mitigating latency and bandwidth problems and ensuring data privacy. Moreover, TinyML overcomes the limitations of DL deployment to low&#x2010;power IoT devices. This chapter explores the integration of DL and IoT to push intelligence closer to data sources, the deployment of DL capable of running on low&#x2010;powered devices using TinyML, and how digital twins and the metaverse are being leveraged to create virtual environments within the IoT context.</p>},
  keywords={Internet of Things;Data models;Computer architecture;Feature extraction;Deep learning;Computational modeling;Biological system modeling;Training;Adaptation models;Technological innovation},
  doi={10.1002/9781394280490.ch8},
  ISSN={},
  publisher={IEEE},
  isbn={9781394280483},
  url={https://ieeexplore.ieee.org/document/11197121},}@INBOOK{11197111,
  author={Samaraweera, Chathumi and Bhattarai, Adarsha and Peng, Dongming and Liu, Yutong and Sharif, Hamid},
  booktitle={Internet of Things A to Z: Technologies and Applications}, 
  title={Artificial Intelligence and the Internet of Things}, 
  year={2026},
  volume={},
  number={},
  pages={159-192},
  abstract={Summary <p>The integration of artificial intelligence (AI) and the Internet of Things (IoT), referred to as AIoT, represents a significant advancement in modern technology. The collaboration between these two technologies fundamentally transforms how devices connect to each other and how information is processed, communicated, and acted upon in cyber&#x2010;physical systems. This chapter first provides a comprehensive understanding of major AI categories and their subcategories. Next, the use of these main AI categories in IoT domains is discussed. Furthermore, we explore AI&#x2010;based applications across various software and hardware aspects of IoT. While bringing tremendous advantages, the integration of AI with IoT also incurs significant challenges. This chapter covers the main challenges in the integration of AI with IoT, including data privacy, security, and ethical considerations. Ultimately, through discussions on these key advances related to AIoT technologies, we aim to explore this technology integration to offer a comprehensive understanding of its potential and effects.</p>},
  keywords={Artificial intelligence;Internet of Things;Supervised learning;Training;Machine learning algorithms;Data models;Virtual assistants;Prediction algorithms;Numerical models;Generative AI},
  doi={10.1002/9781394280490.ch7},
  ISSN={},
  publisher={IEEE},
  isbn={9781394280483},
  url={https://ieeexplore.ieee.org/document/11197111},}@INBOOK{11460292,
  author={Singh, Brijendra Pratap and Kumar, Vimal and Chaturvedi, Rajnish and Mishra, Sandeep and Dwivedi, Vijay and Kumar, Naveen and Adhikary, Dibya Ranjan Das},
  booktitle={Biochip Design and Health Informatics Using IoT and SDN}, 
  title={Fundamentals of IoT and Advancements: Architectures and Protocols}, 
  year={2026},
  volume={},
  number={},
  pages={105-118},
  abstract={Summary <p>Biochips and Internet of Things (IoT) are an essential element in modern Cloud and artificial intelligence (AI)&#x2010;driven technology. Biochips, sensors, and embedded systems are connected to the Internet and undergo collection of data, processing of the collected data, and communication with servers. IoT devices are used for real&#x2010;time monitoring in healthcare, industrial manufacturing, and security. IoT devices are implemented and connected to the network using a three&#x2010;layer architecture: physical layer (sensor, actuator, edge device, etc.), network layer, and application layer. IoT devices are also connected to the cloud having cloud&#x2010;based architecture. Then, protocols, such as LoWPAN, Zigbee, Bluetooth Low Energy, and Z&#x2010;Wave are used for communication. Due to low computational power of IoT devices, security is a challenge for IoT device communication. AI is integrated with IoT to make AIoT (AI&#x2010;based IoT), making it smart and efficient. AIoT architecture is then integrated with AI at each layer. This chapter elucidates about advancements of architecture and protocols of IoT devices related to AI and security.</p>},
  keywords={Telemetry;Aerospace and electronic systems;Optical waveguides;Optical fibers;Antennas;Broadcasting;Broadcast technology;Filtering;Microprocessors;Filters},
  doi={10.1002/9781394360796.ch7},
  ISSN={},
  publisher={IEEE},
  isbn={9781394360789},
  url={https://ieeexplore.ieee.org/document/11460292},}@INPROCEEDINGS{9427638,
  author={Pau, Danilo and Lattuada, Marco and Loro, Francesco and De Vita, Antonio and Domenico Licciardo, Gian},
  booktitle={2021 IEEE International Conference on Consumer Electronics (ICCE)}, 
  title={Comparing Industry Frameworks with Deeply Quantized Neural Networks on Microcontrollers}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={Differently to the common belief, the industry quest for ultra-low-power neural networks is just at the beginning. Examples are the efforts carried by open communities such as TinyML and TinyMLPerf currently focusing on deep learning frameworks for Machine Learning (ML) and associated applications targeting micro-controllers (MCUs). However little attention has been put on deep learning frameworks and applications to enable ultra-low precision ML. These are enabling technologies to target uW hardware implementations. This work aims to compare two Deep Learning frameworks with support to deep quantization, QKeras and Larq, that abstract Tensorflow and Keras frameworks. Currently, Tensorflow is one of the most used deep learning tools by the research and industry communities aimed at deploying ML on the field. Two applications are presented with associated deeply quantized neural networks: Human Activity Recognition (HAR) exploiting a Hybrid Binary Neural Network (HBN) and Anomaly Detection for Industry 4.0 based on a Hybrid Binary AutoEncoder (HBAE). The pros and cons of the frameworks will be discussed during their usage on those applications. Results show an accuracy of up to 98.6% for the HBN and a PSNR up to 111.2 for the HBAE. The inference time has also been measured on different ARM-based architecture.},
  keywords={Deep learning;Industries;Quantization (signal);Network topology;Microcontrollers;Neural networks;Tools;machine learning;deeply quantized neural networks;ultra-low power;deep learning frameworks},
  doi={10.1109/ICCE50685.2021.9427638},
  ISSN={2158-4001},
  month={Jan},}@INPROCEEDINGS{11167845,
  author={Karibandi, Venkata Sai Lakshmi Harika and Jyothi, V and Miriyala, Sriram Rishmith and Mallisetti, Rohan Siddarth and Kanchipati, Chandra Venkata Koushik and Kollabathula, Ratan},
  booktitle={2025 3rd International Conference on Sustainable Computing and Data Communication Systems (ICSCDS)}, 
  title={CyberDome: Cloud based Intrusion Detection and Mitigation}, 
  year={2025},
  volume={},
  number={},
  pages={29-34},
  abstract={The current Internet of Things (IoT) security systems are unable to keep up with the pace of increasing things and the complexity of their structure, resulting in need for scalable, robust and contemporary systems capable of real-time security. The proposed system conceives a combination of cloud-based Intrusion Detection System (IDS) along with a mitigation module. The cloud based IDS comprises of machine learning model (XGBoost) with F1-scores ranging from 0.995 to 1.0, capable of classifying the network traffic logs and invoking the mitigation module on anomaly detection. Mitigation module based on Software Defined Networks (SDN) can mitigate threats using open flow rules taking up tasks like dynamic flow control, network segmentation and device quarantine on demand by IDS. The mitigation module is also a cloud-based component, with the term SDN as a Service, which possess the capability to manage multiple large complex networks while maintaining the network agility, security and scalability under heavy traffic loads. Machine learning model deployed in the cloud, XGBoost is a lightweight model adept to generalizing to unseen data cleverly avoiding overfitting by Incorporating regularization techniques. When number of networks are scaled, among the plausible solutions, the cloud based solution proves to be cost effective while maintaining a prominent performance compared to edge computing or TinyML-based solutions with reduced management overhead along with easy and centralized maintenance.},
  keywords={Cloud computing;Prevention and mitigation;Computational modeling;Intrusion detection;Telecommunication traffic;Real-time systems;Security;Internet of Things;Software defined networking;Load modeling;Cloud;Machine Learning;SDN;Mitigation module;Intrusion detection;Network;Network traffic;IoT devices;Autonomous security system;XGBoost;dynamic flow control},
  doi={10.1109/ICSCDS65426.2025.11167845},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11381311,
  author={Regula, Thirupathi and Al-Hoqani, Warda and Kiran Kumar, S Gouri and Cherian, Sunitha},
  booktitle={2025 1st International Conference on Data Science and Geoinformatics (ICDSG)}, 
  title={AI-IoT-Based Federated Edge and Digital Twin Framework for Real-Time Climate-Resilient Hazard Forecasting}, 
  year={2025},
  volume={},
  number={},
  pages={151-156},
  abstract={Landslides and sandstorms pose significant risks to infrastructure and human safety across arid regions such as Oman and the wider GCC, where rapid environmental changes intensify hazard frequency and impact. This paper presents an Artificial Intelligence and Internet of Things (AI–IoT)–based Federated Edge and Digital Twin Framework designed for real-time landslide and sandstorm forecasting with climate-resilient early warning. The proposed architecture integrates Federated Edge Intelligence, TinyML-powered edge nodes, and Digital Twin modeling to enable decentralized, privacy-preserving, and low-latency hazard prediction. A network of heterogeneous sensors—including LiDAR, hyperspectral particulate sensors, MEMS accelerometers, and soil-moisture probes—collects continuous geotechnical and atmospheric data from high-risk zones. Edge nodes perform on-site anomaly detection and transmit aggregated insights to a cloud-based Digital Twin, which fuses satellite SAR imagery, geospatial models, and real-time sensor data to simulate terrain dynamics and environmental stress responses. The system employs LoRaWAN and 5G URLLC for reliable long-range and ultra-low-latency communication, while wearable haptic alert devices ensure localized and multilingual notifications even in connectivity-challenged areas. A reinforcement learning–driven alert prioritization engine minimizes false alarms and enhances situational accuracy. By combining AI-driven sensing, federated learning, immersive geospatial visualization, and adaptive early-warning mechanisms, the framework advances disaster readiness, safeguards human life and infrastructure, and aligns with sustainable climate adaptation goals for arid and semi-arid ecosystems. The framework was validated through simulation and field datasets demonstrating 94.8% accuracy and sub-3-second latency, with containerized scalability and federated privacy protection ensuring real-world deployability.},
  keywords={Payloads;Telemetry;Sentinel-1;Aerospace and electronic systems;Earth Observing System;Space technology;MODIS;Military aircraft;Feeds;Antennas;edge artificial intelligence (edge-ai);federated learning;digital twin;sandstorm prediction;landslide early warning},
  doi={10.1109/ICDSG67714.2025.11381311},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11496613,
  author={Mohan, B and Ramalakshmi, K and Mahalakshmi, S and Sulthana, M Parveen and Vickneswari, P and Varsha, M Vijaya},
  booktitle={2026 1st International Electronics & Packaging Technologies Conference: Bridging Skills & Innovation for India’s Industry (EPT India)}, 
  title={Intelligent IoT Framework for Real-Time Solar PV and EV Battery Parameter Analysis}, 
  year={2026},
  volume={},
  number={},
  pages={174-179},
  abstract={The efficient operation of solar photovoltaic (PV) modules and electric vehicle (EV) batteries depends on continuous condition monitoring to ensure performance reliability and early anomaly detection. This paper presents an IoT-enabled real-time monitoring system that acquires and analyzes voltage, temperature, and irradiance parameters using an ESP32 microcontroller. The sensing framework integrates a DS18B20 digital temperature sensor, an LDRbased irradiance sensor, and calibrated voltage-divider networks for safe measurement of PV and battery voltages. A regulated SMPS-buck converter power stage ensures stable operation of the sensing units and controller. The ESP32 processes, calibrates, and organizes the acquired data and transmits it wirelessly to the cloud. A fully interactive web dashboard developed using HTML, CSS, and JavaScript provides real-time visualization of system parameters, trend plots, and automatically generated performance summaries. Experimental validation confirms stable readings, accurate sensing, and seamless data synchronization under varying environmental and load conditions. The proposed IoT platform offers a low-cost, scalable solution for continuous monitoring of solar and EV battery systems, with future scope for integrating TinyML-based edge analytics to enable predictive diagnostics.},
  keywords={Sensor systems;Aerospace and electronic systems;System-on-chip;Circuits;Microcontrollers;Microprocessors;Filtering;Circuits and systems;Application specific integrated circuits;Filters;IoT;ESP32;solar photovoltaic monitoring;EV battery management;firebase real-time database;wireless sensor network;energy monitoring system;temperature sensing;cloud dashboard;smart energy management},
  doi={10.1109/EPDMC67535.2026.11496613},
  ISSN={},
  month={March},}@INPROCEEDINGS{9767380,
  author={Ancilotto, Alberto and Paissan, Francesco and Farella, Elisabetta},
  booktitle={2022 IEEE International Conference on Pervasive Computing and Communications Workshops and other Affiliated Events (PerCom Workshops)}, 
  title={On the Role of Smart Vision Sensors in Energy-Efficient Computer Vision at the Edge}, 
  year={2022},
  volume={},
  number={},
  pages={497-502},
  abstract={The increasing focus of the research community towards lightweight and small footprint neural network models is closing the gap between inference performance in cluster-scale models and tiny devices. In the recent past, researchers have shown how it is possible to achieve state-of-the-art performance in different domains (e.g. sound event detection, object detection, image classification) with small footprints and low computational cost architectures. However, these studies lack a comprehensive analysis of the input space used (e.g. for images) and present the results on standard RGB benchmarks. In this manuscript, we investigate the role of smart vision sensors (SVSs) in deep learning-based object detection pipelines. In particular, we combine the motion bitmaps with standard color spaces representations (namely, RGB, YUV, and grayscale) and show how SVSs can be used optimally for an IoT end-node. In conclusion, we report that, overall, the best-performing input space is grayscale augmented with the motion bitmap. These results are promising for real-world applications since many SVSs provide both image formats at low power consumption.},
  keywords={Performance evaluation;Computer vision;Conferences;Computational modeling;Pipelines;Object detection;Vision sensors;smart vision sensors;edge computing;tinyML;embedded computer vision},
  doi={10.1109/PerComWorkshops53856.2022.9767380},
  ISSN={},
  month={March},}@ARTICLE{11039194,
  author={Barra, Silvio and Cimmino, Lucia and Loia, Vincenzo and Nappi, Michele and Polsinelli, Matteo},
  journal={IEEE Internet of Things Journal}, 
  title={Autonomous Driving: Integration of Segmentation and Depth Camera in a Curriculum Learning Approach}, 
  year={2025},
  volume={12},
  number={17},
  pages={35237-35248},
  abstract={Autonomous driving (AD) entails vehicles that can perceive their surroundings and navigate without human intervention. This involves utilising a combination of sensors and algorithms to recognize obstacles, interpret traffic signals, and make driving decisions. While AD holds promise for transforming transportation by enhancing safety, reducing congestion, minimising pollution, and optimising efficiency, it poses technical challenges also. This work extends a novel approach to building an autonomous vehicle agent using deep reinforcement learning (DRL) with proximal policy optimisation (PPO) to navigate urban environments simulated by the CAR learning to act (CARLA) Simulator. The agent aims to maintain lane integrity and avoid collisions, even in adverse weather conditions. The proposed architecture integrates a 180-degree environmental view and various multimodal data inputs (RGB, segmentation, and depth camera inputs), extensively tested through experimentation. Notably, the integration of segmentation and depth data results in a 13% reduction in the collision rate, with the proposed agent achieving a total reward of 2510. This approach demonstrates significant progress over the previous framework, showcasing improved obstacle detection and collision avoidance accuracy. Moreover, these findings contribute to ongoing autonomous vehicle research, offering insights into effective strategies for developing robust and dependable driving agents capable of navigating urban environments and interacting with road infrastructure, contributing to advancements in Augmented Intelligence of Things (AIoT)-enabled AD.},
  keywords={Autonomous vehicles;Cameras;Sensors;Training;Internet of Things;Roads;Artificial intelligence;Meteorology;Deep reinforcement learning;Complexity theory;Autonomous driving (AD);curriculum learning (CL);deep reinforcement learning (DRL);object segmentation;proximal policy optimisation (PPO)},
  doi={10.1109/JIOT.2025.3579862},
  ISSN={2327-4662},
  month={Sep.},}@INPROCEEDINGS{9550920,
  author={Cabacungan, Paul M. and Oppus, Carlos M. and Cabacungan, Nerissa G. and Mamaradlo, John Paul A. and Santiago, Paul Ryan A. and Mercado, Neil Angelo M. and Faustino, E. Vincent S. and Tangonan, Gregory L.},
  booktitle={2021 IEEE Region 10 Symposium (TENSYMP)}, 
  title={Design and Development of A-vent: A Low-Cost Ventilator with Cost-Effective Mobile Cloud Caching and Embedded Machine Learning}, 
  year={2021},
  volume={},
  number={},
  pages={1-8},
  abstract={We designed and developed a low-cost mechanical ventilator prototype that meets the government's minimum viable standards. We substituted alternative off-the-shelf food-grade for the medical-grade parts and improvised some components for our prototype. We cleaned the air from the oxygen tanks and compressors before going to the lung test bag. We designed a solar-powered battery system that can run electronic components for a fail-safe operation. We demonstrated how the AIC Near Cloud system can store air flow rate and air pressure data which were generated during the prototype's operation. We used Embedded Machine Learning in sensors and data processing by using flow and pressure sensors to provide accumulated data that can be utilized in training the machine learning software. The patient-ventilator asynchrony detection model was tested using data generated from the emulated ventilator waveform events that mimic the patient-ventilator asynchrony. A different compression pattern was applied to the test lung and results showed the training, validation, and model testing that yielded 98.7%, 99.1%, and 97.18 percent accuracy, respectively. Having demonstrated that the Tiny ML can be trained to detect anomalies from several data points, we realized the feasibility of detecting ventilator patient vibration anomaly, and unusual acoustic signatures, among others, for future works.},
  keywords={Training;Vibrations;Ventilators;Buildings;Prototypes;Lung;Machine learning;Ventilator;COVID-19;Breathing Device;Hospital Informatics;Critical Care;Internet of Medical Things;Near Cloud},
  doi={10.1109/TENSYMP52854.2021.9550920},
  ISSN={2642-6102},
  month={Aug},}@INPROCEEDINGS{9629420,
  author={Ooko, Samson Otieno and Mukanyiligira, Didacienne and Munyampundu, Jean Pierre and Nsenga, Jimmy},
  booktitle={2021 International Conference on Computing and Communications Applications and Technologies (I3CAT)}, 
  title={Synthetic Exhaled Breath Data-Based Edge AI Model for the Prediction of Chronic Obstructive Pulmonary Disease}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={Diseases that affect the respiratory system are one of the main causes of death across the globe. There is a need for a personalized, easy to use and convenient mechanism to self-detect a potentially contagious disease, thus limiting the spread of infections. The integration of Artificial Intelligence (AI) and Internet of Things (IoT) provides a great opportunity to bring detection and monitoring of respiratory diseases at home. However, the development of efficient AI models has been hindered by the lack of datasets for the targeted biomarkers, with privacy concerns limiting open data access and sharing. Starting from an existing small dataset of COPD, this study leverages the emerging synthetic data technology to artificially augment its size to have adequate data for training a TinyML model for predicting COPD using a Neural Network model, thus improving the inference accuracy of portable noninvasive self-diagnostic kits for respiratory disease. An online platform, Mostly AI is used to synthetically enhance data, the platform uses deep neural networks with inbuilt mechanisms that retain valuable information while providing a good as a real anonymous dataset. Next, the Keras Neural Network is used to train the edge AI models. The performance of the model was evaluated and the results show that when the same training parameters were applied, the model trained from synthetic data performed with an accuracy almost similar to that based on real open datasets. The use of synthetic data will complement the few breaths that are collected in healthcare facilities. This will enable the training of efficient AI models for respiratory diseases.},
  keywords={Training;Data privacy;Limiting;Pulmonary diseases;Biological system modeling;Neural networks;Predictive models;Synthetic Data;Edge AI;Exhaled Breath;smart health;COPD},
  doi={10.1109/I3CAT53310.2021.9629420},
  ISSN={},
  month={Sep.},}@ARTICLE{10566887,
  author={Jiang, Nan and Gu, Weihao and Li, Lang and Zhou, Fengqi and Qiu, Sen and Zhou, Tianqing and Chen, Honglong},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={TFD: Trust-Based Fraud Detection in SIoT With Graph Convolutional Networks}, 
  year={2025},
  volume={71},
  number={1},
  pages={1897-1908},
  abstract={With the rapid development of Artificial Intelligence (AI) technology, its application in areas such as Social Internet of Things (SIoT) and e-commerce has become increasingly widespread. However, there are many uncertainties and potential risks in the widespread deployment of AIoT, and miscreants take advantage of these vulnerabilities to commit fraud on SIoT, which raises serious public concerns about security and privacy. Our work is dedicated to distinguishing fraudsters from consumers through fraud. Given the superior ability of Graph Neural Networks (GNN) in modeling network environments, it has become an important tool in the field of fraud detection. In this work, we propose a fraud detection method based on potential trust between users in SIoT, which combines the graph structure of SIoT with pairwise trust relationships between users. Specifically, we construct an end-to-end framework that utilizes Graph Convolutional Networks (GCNs) to learn and mine potential trust patterns in different social relationships. Further, a trust-aware neighborhood difference aggregation method is introduced by us to significantly distinguish normal consumers from fraudsters. To cope with the class imbalance problem, we employ an imbalance-aware loss function for optimization. Extensive experiments on two datasets confirm that our model is very effective compared to existing techniques.},
  keywords={Fraud;Consumer electronics;Social Internet of Things;Security;Feature extraction;Convolutional neural networks;Symbols;Data privacy;Trust;SIoT;fraud detection;graph inconsistency;privacy preserving},
  doi={10.1109/TCE.2024.3417471},
  ISSN={1558-4127},
  month={Feb},}@ARTICLE{11023847,
  author={Iodice, Gian Marco and Furtner, Wolfgang},
  journal={IEEE Design & Test}, 
  title={Edge AI—An Industry View}, 
  year={2025},
  volume={42},
  number={5},
  pages={27-34},
  abstract={Editor’s notes: This keynote article offers an industrial viewpoint of Edge AI, emphasizing the convergence of machine learning and embedded systems for intelligent, low-power applications. The authors identify the critical role of microcontrollers and neural processing units in enabling local machine learning execution under severe resource constraints, illustrating the technical aspects and real-world relevance of such systems. With a focus on practical use cases and emerging application domains, this keynote article explains the practical implications of TinyML. —Theocharis Theocharides, University of Cyprus, Cyprus —Marian Verhelst, KU Leuven, Belgium —Vijay Janapa Reddy, Harvard University, USA —Evgeni Gousev, Qualcomm, USA},
  keywords={Edge AI;Microcontrollers;Real-time systems;Monitoring;Medical services;Hardware;Biological system modeling;Training;Software development management;Security},
  doi={10.1109/MDAT.2025.3576338},
  ISSN={2168-2364},
  month={Oct},}@INPROCEEDINGS{10508926,
  author={Vaddeboina, Mounika and Kaja, Endri and Yilmazer, Alper and Ghosh, Uttal and Ecker, Wolfgang},
  booktitle={2024 27th International Symposium on Design & Diagnostics of Electronic Circuits & Systems (DDECS)}, 
  title={PaGoRi:A Scalable Parallel Golomb-Rice Decoder}, 
  year={2024},
  volume={},
  number={},
  pages={67-72},
  abstract={Deep Neural Networks (DNNs) have created opportunities to address real-world issues and expand the application of Artificial Intelligence (AI). Despite significant accuracy enhancements, DNNs pose a challenge when deployed on resource-limited edge devices commonly used in Internet of Things (IoT) applications. Inference execution of the DNNs requires accessing millions of parameters responsible for most energy consumption. Compression of weights is one possible solution, but most of the existing hardware decompression units could be more efficient in terms of power, area, and energy. This paper presents a scalable version of a hardware-efficient Parallel Golomb-Rice decoder (PaGoRi). The decoder has been integrated with an industry-strength Neural Network (NN) accelerator and evaluated with three TinyML benchmarks. The PaGoRi decoder achieves optimal trade-offs between power consumption and throughput, supporting decoding capacities of four and eight weights, consuming 0.43 mW and 0.79 mW of power, respectively, while achieving a throughput of 888 MBps and 1.3 GBps, respectively.},
  keywords={Power demand;Artificial neural networks;Benchmark testing;Throughput;Hardware;Energy efficiency;Decoding;Deep Neural Networks;Internet-of-Things;Neural Network accelerators;Golomb-Rice coding;Parallel decoders},
  doi={10.1109/DDECS60919.2024.10508926},
  ISSN={2473-2117},
  month={April},}@INPROCEEDINGS{11307903,
  author={K, Surya and Samhith, K and H S, Monish Kumar and M, Shanmugasundaram},
  booktitle={2025 Innovations in Power and Advanced Computing Technologies (i-PACT)}, 
  title={Watt Watcher: An RTOS-Powered Energy Meter}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents the design and implementation of a real-time energy monitoring system built around the ESP32 microcontroller and the FreeRTOS real-time operating system. With growing demands for accurate, responsive, and networked energy metering in smart homes and microgrids, the need for deterministic and modular embedded solutions has become critical. The proposed system employs the ZMPT101B voltage sensor and SCT-013 current transformer to acquire analog signals, which are digitized through the ADS1115 16-bit ADC for high-resolution sampling. FreeRTOS plays a pivotal role in orchestrating multiple parallel tasks-voltage and current acquisition, RMS computation, OLED visualization, and Blynk-based IoT communication-by leveraging features such as task prioritization, core pinning, queues, semaphores, and software timers. Through structured multitasking and resource isolation, FreeRTOS ensures minimal jitter, reliable data integrity, and real-time responsiveness across all processes. High-priority tasks like ADC sampling are protected from delays caused by Wi-Fi communication or display rendering, which are offloaded to lower-priority threads. This design enables the system to perform continuous real-time monitoring without blocking or data loss, even under fluctuating workloads. Experimental results validate the accuracy, efficiency, and robustness of the RTOS-powered system, demonstrating consistent energy tracking over time and seamless cloud synchronization via Blynk. Furthermore, the RTOS-centric approach provides a scalable foundation for future extensions such as TinyML-based edge analytics, blockchain integration, and energy-aware task scheduling for self-powered IoT applications. The outcomes highlight the indispensable role of RTOS in advancing next-generation, intelligent, and decentralized energy monitoring solutions.},
  keywords={Technological innovation;Accuracy;Processor scheduling;Transformer cores;Multitasking;Real-time systems;Internet of Things;Synchronization;Monitoring;Wireless fidelity;FreeRTOS;ESP32;real-time energy monitoring;SCT-013;ZMPT101B;ADS1115;multitasking;IoT;Blynk;RTOS scheduling;embedded systems;smart grid;real-time data acquisition},
  doi={10.1109/i-PACT65952.2025.11307903},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11365150,
  author={Leong, Wai Yie},
  booktitle={2025 RIVF International Conference on Computing and Communication Technologies (RIVF)}, 
  title={Edge Computing Framework for Remote Healthcare Communication in Orang Asli Villages}, 
  year={2025},
  volume={},
  number={},
  pages={249-254},
  abstract={Remote indigenous communities such as the Orang Asli in Peninsular Malaysia face significant challenges in accessing equitable healthcare services. Geographic isolation, poor internet coverage, limited medical facilities, and cultural barriers contribute to systemic healthcare inequalities. This study proposes a comprehensive Edge Computing Framework for Remote Healthcare Communication tailored for the Orang Asli, leveraging low-latency edge infrastructure, AI-enhanced diagnostics, and resilient mesh communication networks to bridge digital and medical divides. The proposed framework integrates edge servers with community health posts, mobile medical units, and local IoT-based wearable devices to enable real-time physiological monitoring, offline-first telemedicine, and intelligent diagnostics-without reliance on continuous internet access. Through simulation (using NS-3 and MATLAB) and pilot field tests in the villages of Pos Lenjang (Pahang) and Kampung Sungai Perah (Perak), the system is evaluated across critical metrics such as latency, data availability, energy consumption, and diagnostic accuracy under constrained connectivity scenarios. Empirical results demonstrate that edge-enhanced systems reduce communication latency by over 68 %, improve diagnostic inference time by 75 %, and enable secure and reliable health data capture with minimal infrastructure. Moreover, a modular architecture with LoRabased sensor gateways, 5G/4G fallbacks, and intelligent prioritization algorithms ensures reliable delivery of urgent medical events. This study also emphasizes the socio-technical dimensions of deployment, including the digital literacy gap, ethical handling of indigenous health data, and the importance of culturally aligned UI/UX for healthcare workers and patients. Policy recommendations focus on integrating the edge framework with Malaysia's national MyHealth and MyDigital blueprints, Universal Service Provision (USP) funds, and the expansion of AIoT rural healthcare zones.},
  keywords={Telemedicine;Medical services;Real-time systems;Reliability;Servers;Artificial intelligence;Wearable devices;Medical diagnostic imaging;Monitoring;Edge computing;Artificial intelligence;edge computing;healthcare communications},
  doi={10.1109/RIVF68649.2025.11365150},
  ISSN={2473-0130},
  month={Dec},}@INPROCEEDINGS{11548349,
  author={Regula, Thirupathi and Al-Hoqani, Warda and Kumar, S Gouri Kiran and Cherian, Sunitha},
  booktitle={2025 International Conference on Intelligent & Innovative Practices in Engineering & Management (IIPEM)}, 
  title={Federated Edge-AI and Digital Twin-Enabled IoT Framework for Real-Time Landslide Prediction and Multi-Modal Early Warning Systems in Arid and Mountainous Regions}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Landslides represent a major environmental hazard in arid and mountainous regions, often triggered by sudden rainfall, seismic activity, or soil instability. Traditional centralized monitoring systems are limited by latency, bandwidth, and data privacy concerns, especially in remote terrains with poor connectivity. This research proposes a Federated Edge-AI and Digital Twin–enabled IoT framework that integrates multi-source environmental sensing, edge intelligence, and federated learning to enable real-time landslide prediction and multi-modal early warning dissemination. The proposed framework includes a combination of geotechnical and climatic sensors such as MEMS-based accelerometers, soil dielectric probes, and rainfall detectors connected via LoRaWAN and 6G URLLC links. These sensors are connected by LoRaWAN and 6G URLLC links. Each edge node does inference based on TinyML and takes part in privacy-preserving federated learning to work together to make the model more accurate without sharing raw data. The cloud layer has a digital twin of the monitored terrain that is constantly updated through multi-source data fusion (sensor streams, satellite SAR imagery, and meteorological inputs) to simulate ground movement and predict areas that are likely to slide. The framework includes deep reinforcement learning, which leads to prioritizing alerts, making sure they are as accurate as possible by minimizing false positives while ensuring high responsiveness. The system sends alerts through a variety of channels, such as mobile notifications, tactile wearables, and public alerts that are only available in certain areas. This keeps people more aware of what's going on around them, helps them make better predictions, and supports long-term disaster resilience strategies that are in line with UN SDG 11 and SDG 13. Experimental validation and simulations show that it performs better, has less latency, and works well in a variety of terrain conditions.},
  keywords={Modeling;Internet of Things;Federated learning;Digital twins;Timing;Edge AI;Landslides;Real-time systems;Image sensors;Printing;Edge Artificial Intelligence (Edge-AI);Federated Learning;Digital Twin;Internet of Things (IoT);Landslide Prediction;Multi-Source Data Fusion;Early Warning Systems;Climate Resilience},
  doi={10.1109/IIPEM65914.2025.11548349},
  ISSN={},
  month={Nov},}@ARTICLE{11192193,
  author={Fjodorov, Aleksei and Ulp, Sander and Laadung, Taavi and Kuusik, Alar and Mahtab Alam, Muhammad},
  journal={IEEE Sensors Journal}, 
  title={Accurate Indirect 3-D Localization of Markerless Industrial Products}, 
  year={2025},
  volume={25},
  number={21},
  pages={40370-40383},
  abstract={This article proposes a novel method for the indirect, automatic, real-time, and 3-D tracking of industrial products. The motivation behind the proposed method is to fully avoid the direct product marking with active or passive tags. This method combines the tracked forklift position and heading data with the real-time fork elevation to obtain a complete 3-D location of the transported product. This work also proposes a fusion algorithm for automatic payload pck-up and Drop-down event Detection (A-PDD). It is based on the fusion of the fork elevation and occupancy sensors, used for the automatic recognition of the forklift behavior patterns during the payload pickup or drop-down events. This work experimentally validates the performance of the proposed markerless indirect tracking method in an operating industrial production site. The proposed method was able to indirectly track two industrial products with below 30-cm absolute and repeatability errors. The experimental comparison of the proposed indirect tracking method with the traditional direct product localization approach has shown a major advantage of the proposed method in terms of product positioning stability, reliability, and quality, along with approximately four times higher product positioning accuracy. The proposed indirect tracking method offers high scalability, significantly increased cost and energy efficiency, and reduced maintenance requirements in comparison with the direct tracking methods. It is expected to be widely applicable to different industrial machinery and material handling equipment (MHE), from forklifts and various lifters to cranes.},
  keywords={Sensors;Location awareness;Real-time systems;Pallets;Accuracy;Payloads;Intelligent sensors;Transportation;Sensor fusion;Scalability;Indirect tracking;industrial product positioning;inertial measurement unit (IMU);intelligent warehousing;sensor fusion;ultrasonic distance sensor;ultrawideband (UWB);wire encoder},
  doi={10.1109/JSEN.2025.3614998},
  ISSN={1558-1748},
  month={Nov},}@INPROCEEDINGS{11598054,
  author={Amro, Oswa M. and Darabkh, Khalid A.},
  booktitle={2026 IEEE International Black Seas Conference on Communications and Networking (BlackSeaCom)}, 
  title={From Air-Gap Covert Channels to 6G THz-ISAC Remote Vibrometry: A Survey and Vibration-Aware Physical Layer Defense Framework}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={In the upcoming 6G, Wireless communication is associated with high-resolution environmental sensing, in an architecture termed "Integrated Sensing and Communication (ISAC)". While it allows the system to use the spectrum efficiently, it turns the nodes into high-precision sensing devices, enabling them to observe microscopic hardware dynamics. Hence, all physical phenomena used to extract data from close proximity, in the fields of side and covert channels, can now be remotely observed via terahertz (THz) reflections. Such physical phenomena have been studied intensively for the past few decades, with the objective of exploiting data from air-gapped systems (i.e., isolated from the internet or other networks outside the perimeter). This paper bridges classical air-gap covert channel research to the 6G ISAC architecture, specifically THz sensing, to highlight their ability to serve as remote vibrometers that leak hardware vibrations correlated with the nodes’ CPU functions. We study the information-theoretic leakage model that links vibration amplitude to channel capacity and highlight that shorter wavelengths exponentially increase the risk of data extraction. We identify critical gaps in existing vibration-aware protections and in out-of-band (OOB) coordination by providing a survey of physical-layer security techniques. To address these gaps, we propose a security framework, termed "vibe-secure," to protect devices from leaking informative vibrations by performing self-sensing and using TinyML-based anomaly detection with stochastic blinding. They can also generate secret keys with robust OOB synchronization. The suggested framework shifts the security of terminals from pure cryptography to physically defined privacy-based security.},
  keywords={Air gaps;Hardware;Integrated sensing and communication;Security;Vibrations;Modeling;Manuals;Surveys;Aluminum;Computers;6G;Integrated Sensing and Communication (ISAC);Physical Layer Security (PLS);Side Channels;Covert Channels;Long-Range (LoRa) Communication;air-gapped systems},
  doi={10.1109/BlackSeaCom69760.2026.11598054},
  ISSN={2687-9808},
  month={June},}@ARTICLE{11456632,
  author={Sodhro, Ali Hassan and Ngo, Hien Quoc and Aguiar, Rui Luis and Donta, Praveen Kumar and Huang, Huawei and Razavi, Sara Modarres},
  journal={IEEE Wireless Communications}, 
  title={Guest Editorial: SPECIAL ISSUE ON TinyML for Edge-Driven 6G Networks}, 
  year={2026},
  volume={33},
  number={2},
  pages={13-15},
  abstract={},
  keywords={Special issues and sections;6G mobile communication;Tiny machine learning;Machine learning;Edge computing;Artificial intelligence},
  doi={10.1109/MWC.2026.3661786},
  ISSN={1558-0687},
  month={April},}@ARTICLE{9663263,
  author={},
  journal={Big Data Mining and Analytics}, 
  title={Call for papers: Special issue on privacy-preserving data mining for artificial intelligence of things}, 
  year={2022},
  volume={5},
  number={1},
  pages={80-80},
  abstract={Artificial Intelligence of Things (AIoT) is experiencing unimaginable fast booming with the popularization of end devices and advanced machine learning and data processing techniques. An increasing volume of data is being collected every single second to enable Artificial Intelligence (AI) on the Internet of Things (IoT). The explosion of data brings significant benefits to various intelligent industries to provide predictive services and research institutes to advance human knowledge in data-intensive fields. To make the best use of the collected data, various data mining techniques have been deployed to extract data patterns. In classic scenarios, the data collected from IoT devices is directly sent to cloud servers for processing using diverse methods such as training machine learning models. However, the network between cloud servers and massive end devices may not be stable due to irregular bursts of traffic, weather, etc. Therefore, autonomous data mining that is self-organized by a group of local devices to maintain ongoing and robust AI services plays a growing important role for critical IoT infrastructures. Privacy issues become more concerning in this scenario. The data transmitted via autonomous networks are publicly accessible by all internal participants, which increases the risk of exposure. Besides, data mining techniques may reveal sensitive information from the collected data. Various attacks, such as inference attacks, are emerging and evolving to breach sensitive data due to its great financial benefits. Motivated by this, it is essential to devise novel privacy-preserving autonomous data mining solutions for AIoT. In this Special Issue, we aim to gather state-of-art advances in privacy-preserving data mining and autonomous data processing solutions for AIoT. Topics include, but are not limited to, the following: • Privacy-preserving federated learning for AIoT • Differentially private machine learning for AIoT • Personalized privacy-preserving data mining • Decentralized machine learning paradigms for autonomous data mining using blockchain • AI-enhanced edge data mining for AIoT • AI and blockchain empowered privacy-preserving big data analytics for AIoT • Anomaly detection and inference attack defense for AIoT • Privacy protection measurement metrics • Zero trust architectures for privacy protection management • Privacy protection data mining and analysis via blockchain-enabled digital twin.},
  keywords={},
  doi={10.26599/BDMA.2021.9020026},
  ISSN={2097-406X},
  month={March},}
