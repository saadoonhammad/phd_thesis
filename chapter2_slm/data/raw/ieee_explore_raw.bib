  title={An Embedded Tinyml Framework for Real-Time Anomaly Detection in Bluetooth Low Energy Wearable Devices}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The behavioral properties have been found to be more efficient in detecting Bluetooth intrusion compared to the traditional protocol-signature-based approaches. To record such behaviors, controlled Bluetooth Low Energy (BLE) attack scenarios such as advertisement flooding, repeated connections, GATT write abuse, and pairing request flooding were systematically generated and a dataset of about 29,000 BLE communication samples was obtained under both benign and adversarial conditions. An efficient machine-learning model was then trained using this data and tailored to be used on resource-limited hardware. Due to the constraints of the IoT devices, TensorFlow Lite on Microcontrollers was used and INT8 post-training quantization was implemented to decrease the size of the model without affecting real-time performance. The model was applied to ESP32-class microcontrollers and evaluated for the accuracy of detection, inference latency, memory footprint, and power usage. To increase the reliability and security of the systems further, firmware signing was introduced to eliminate any unauthorized changes and encrypted logging was also implemented to protect sensitive information.},
  keywords={Performance evaluation;Quantization (signal);Trade agreements;Tiny machine learning;Intrusion detection;Real-time systems;Internet of Things;Floods;Bluetooth Low Energy;Wearable devices;Bluetooth Low Energy (BLE);TinyML;Intrusion Detection System;ESP32;TensorFlow Lite Micro;INT8 Quantization},
  doi={10.1109/IDCIoT67589.2026.11455827},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10796700,
  author={Gaurav, Akshat and Gupta, Brij B. and Tai Chui, Kwok},
  booktitle={2024 4th International Conference on Electrical, Computer, Communications and Mechatronics Engineering (ICECCME)}, 
  title={Edge-Based DDoS Attack Detection in AIoT Using a Hybrid CNN and Logistic Regression Approach}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={This study presented an edge-based anomaly detection model for AIoT environments using hybrid CNN and Logistic Regression. The model has been evaluated against KDD dataset, and it can be found that it can differentiate DDoSlDoS attack traffic from normal traffic with 94 % accuracy. In addition, it can be noted that the developed model demonstrates the level of performance, which can be considered as satisfactory, since it has the precision of 0.94, the recall of 0.94, and f1-score of 0.94. Thus, it can be stated that the developed edge-based anomaly detection model can be successfully implemented for ensuring the real-time network security and detecting, and preventing the anomalies in the various smart home applications based on its high potential.},
  keywords={Logistic regression;Mechatronics;Image edge detection;Scalability;Computational modeling;Smart homes;Network security;Denial-of-service attack;Real-time systems;Anomaly detection;CNN;AIoT;LR;Deep Learning;Edge Computing},
