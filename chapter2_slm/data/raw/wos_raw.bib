DOI = {10.1109/TSUSC.2024.3386667},
ISSN = {2377-3782},
Keywords = {Adaptation models; Internet of Things; Data models; Anomaly detection;
   Error analysis; Training; Random forests; Concept drift;
   interpretability; anomaly detection; IoT},
Author-Email = {xulj@sdas.org
   zhaodw@sdas.org
   lixin@sdas.org},
Times-Cited = {15},
Unique-ID = {WOS:001375683800008},
}

@inproceedings{ WOS:001708857700018,
Author = {Jones, Jefferson Parker and van Kempen, Philipp and
   Mueller-Gritschneder, Daniel},
