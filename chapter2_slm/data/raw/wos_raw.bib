ISSN = {1999-5903},
Keywords = {internet of things; artificial intelligence; artificial internet of
   things; security systems; smart home; smart building; edge computing;
   machine learning},
Keywords-Plus = {GENERATIVE ARTIFICIAL-INTELLIGENCE; DIGITAL TWIN; MONITORING SYSTEMS;
