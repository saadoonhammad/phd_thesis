}

@article{ WOS:001649757400001,
Author = {Pirbhulal, Sandeep and Muzammal, Muhammad and Abie, Habtamu},
Title = {Enabling Secure Edge Intelligence: TinyML-Based Threat Detection in 5G
   and Future Networks},
Journal = {IEEE WIRELESS COMMUNICATIONS},
Year = {2026},
Volume = {33},
Number = {2},
Pages = {32-39},
Month = {APR},
Abstract = {The evolution of 5G networks toward 6G presents an opportunity to shift
   from centralized security to decentralized, intelligent, and autonomous
   security. While 5G introduces decentralization through software-based
   virtualization and edge computing, it also exposes network
   infrastructure to a new and dynamic threat landscape that still relies
   largely on static, centrally deployed threat detection. This work
   proposes a lightweight anomaly detection framework based on Tiny Machine
   Learning (TinyML), specifically designed to address the latency, memory,
   and energy constraints of 5G edge devices. Using promising model
   compression techniques, including integer quantization and pruning, we
   demonstrate that highly optimized models can run entirely on-device
   without relying on cloud infrastructure. Our experiments using a
   real-world 5G dataset demonstrate that the quantized TinyDenseNet
   achieves over 99\% detection accuracy while keeping the model size below
   30 KB and inference latency under 11 ms. By embedding intelligent
   detection at the network edge, this approach presents self-defending,
   ultra-reliable, and context-aware infrastructures for future 6G
   networks. The proposed approach focuses on next-generation networks, in
   which decentralized, low-power, and privacy-preserving security
   mechanisms will be essential.},
Type = {Article},
Language = {English},
Affiliation = {Pirbhulal, S (Corresponding Author), Norwegian Comp Ctr, Dept Appl Res ICT DART, N-0314 Oslo, Norway.
   Pirbhulal, Sandeep; Abie, Habtamu, Norwegian Comp Ctr, Dept Appl Res ICT DART, N-0314 Oslo, Norway.
   Muzammal, Muhammad, Northumbria Univ, Sch Comp Sci, Newcastle Upon Tyne NE1 8ST, England.},
DOI = {10.1109/MWC.2025.3641534},
EarlyAccessDate = {DEC 2025},
ISSN = {1536-1284},
EISSN = {1558-0687},
Keywords = {5G mobile communication; Image edge detection; Tiny machine learning;
   Anomaly detection; 6G mobile communication; Feature extraction;
   Computational modeling; Real-time systems; Threat assessment;
   Quantization (signal); 5G; 6G; TinyML; security; anomalies; energy
   efficiency; edge intelligence; future networks; threat detection},
Times-Cited = {0},
Unique-ID = {WOS:001649757400001},
}

