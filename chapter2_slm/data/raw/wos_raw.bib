   Anidjar, Or Haim, Ariel Univ, Dept Comp Software \& Engn, Kiryat HaMada 3, IL-40700 Ariel, Israel.},
DOI = {10.1016/j.mlwa.2025.100755},
EarlyAccessDate = {JAN 2025},
