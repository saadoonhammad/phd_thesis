   management},
Keywords-Plus = {ENERGY MANAGEMENT-SYSTEM; DISTRIBUTED GENERATION; FAULT-DETECTION;
   NEURAL-NETWORK; LOAD; CLASSIFICATION; CHALLENGES; LOCATION; ATTACKS},
