@inproceedings{ WOS:001339362100048,
Author = {Ru, Hongyuan and Chen, Jiaxiang and Sun, Zexu and Tai, Shuo and Zhao,
   Wei and Kumar, Roshan},
Book-Group-Author = {IEEE},
Title = {A Wood Anomaly Detection System Based on Electrical Resistivity
   Tomography and Tiny Machine Learning},
Booktitle = {2024 CONTROL INSTRUMENTATION SYSTEM CONFERENCE, CISCON 2024},
Year = {2024},
Note = {Control Instrumentation System Conference (CISCON) - Guiding Tomorrow -
   Emerging Trends in Control, Instrumentation, and Systems Engineering,
   Manipal, INDIA, AUG 02-03, 2024},
Abstract = {This paper aims to investigate the detection of internal voids or decay
   anomalies in wood using Electrical Resistivity Tomography (ERT) and Tiny
   Machine Learning (TinyML). It proposes an anomaly detection method
   suitable for large-scale target detection, aiming to achieve multi-tree
   detection and automated detection of targets. The ERT tree detection
   model is simulated using COMSOL and MATLAB software. Based on the
   obtained boundary voltage data, a machine learning model is generated
   using NanoEdge AI Studio to simulate the detection of internal anomalies
   in trees. Finally, control circuits and control programs are designed,
   and the machine learning model is deployed on STM32G4 series
   microcontrollers. In the simulation detection using NanoEdge AI, 15 sets
   of anomalies are detected out of 16 sets of data for the multi-cavity
   model. The tree anomaly detection method based on Electrical Resistivity
   Tomography and Tiny Machine Learning can effectively detect anomalies in
   trees. TinyML conserves embedded system resources during multi-target
   detection, enabling low power consumption and real-time processing.},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Ru, HY (Corresponding Author), Henan Univ, Miami Coll, Kaifeng, Peoples R China.
   Ru, Hongyuan; Chen, Jiaxiang; Sun, Zexu; Zhao, Wei; Kumar, Roshan, Henan Univ, Miami Coll, Kaifeng, Peoples R China.
