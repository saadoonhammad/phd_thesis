}

@article{ WOS:001778702100001,
Author = {Chen, Yueyuan and Xu, Ziheng and Pan, Huiming and Lin, Jianping and Zhu,
   Kezhe and Shull, Peter B.},
Title = {Fast, optimized human activity recognition via wrist accelerometry that
   excludes anomalous activities},
Journal = {BIOMEDICAL SIGNAL PROCESSING AND CONTROL},
Year = {2026},
Volume = {123},
Number = {B},
Month = {SEP 1},
Abstract = {Human Activity Recognition (HAR) is crucial to assess and promote
   exercise to improve human health. However, approaches that rely on a
   single classifier are often inaccurate in real-life situations because
   of unexpected anomalous movements and activities, which are often
   misclassified into predefined activity categories. In addition,
   commercial wearable devices often have far less memory and processing
   power than lab-based desktop computers, making accurate real-time HAR
   challenging in practice. We thus propose a fast, optimized Tiny Machine
   Learning approach for HAR based on a novel Quadratic Discriminant
   Analysis model that employs score confidence interval-based automated
   anomaly exclusion for wrist-worn accelerometry. Fiftyfour subjects
   performed five primary movement activities (cycling, elliptical
   training, running, walking, and playing basketball) and a subset of 30
   subjects performed an additional 10 anomalous movements (eating with a
   fork, eating with chopsticks, grabbing objects, typing, moving a mouse,
   drinking water, brushing teeth, rolling on a bed, wrist rotations, and
   random hand movements). The proposed model showed 89.8\% primary
   activity classification accuracy and 89.1\% anomaly detection accuracy.
   It also showed 82.3\% primary activity classification accuracy and
   85.3\% anomaly detection accuracy on the public mHealth dataset. To the
   best of our knowledge, this is the first study to integrate primary
   activity classification and anomaly detection into a single model based
   on wrist-worn accelerometry. It supports fast, real-time, and accurate
   HAR, while minimizing memory consumption and computational demands. This
   approach provides robust, evidence-based insights into exercise
   duration, frequency, and composition, potentially enhancing health and
   fitness monitoring and facilitating chronic disease prevention.},
Type = {Article},
Language = {English},
Affiliation = {Shull, PB (Corresponding Author), Shanghai Jiao Tong Univ, Sch Mech Engn, State Key Lab Mech Syst \& Vibrat, Shanghai 200240, Peoples R China.
   Chen, Yueyuan; Xu, Ziheng; Pan, Huiming; Lin, Jianping; Zhu, Kezhe; Shull, Peter B., Shanghai Jiao Tong Univ, Sch Mech Engn, State Key Lab Mech Syst \& Vibrat, Shanghai 200240, Peoples R China.},
