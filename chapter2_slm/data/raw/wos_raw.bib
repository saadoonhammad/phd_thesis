Keywords = {artificial intelligence of things; bidirectional long short-term memory;
   convolution neural networks; failure analysis; firefighting pumps;
   improved particle swarm optimization},
Keywords-Plus = {FAULT-DIAGNOSIS; ROTATING MACHINERY; OPTIMIZATION; ALGORITHMS; ART},
Author-Email = {thanhphuong@ntu.edu.vn},
Times-Cited = {0},
Unique-ID = {WOS:001759209600001},
}

