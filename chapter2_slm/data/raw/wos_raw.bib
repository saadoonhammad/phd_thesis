   Li, Guojun; Zhou, Zhiguang, Hangzhou Dianzi Univ, Sch Media \& Design, Big Data Visualizat \& Human Comp Collaborat Intell, Hangzhou 310018, Peoples R China.},
DOI = {10.3390/en17215369},
