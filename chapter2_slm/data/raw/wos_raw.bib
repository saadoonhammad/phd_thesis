Keywords = {aviation health monitoring systems; foundation models; federated
   learning; Artificial Intelligence of Things; predictive maintenance;
   aircraft safety; machine learning in aviation; cognitive computing},
Author-Email = {kiv@tsi.lv},
Times-Cited = {6},
