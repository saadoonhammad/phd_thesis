   Iskandaryan, Ditsuhi, Bellvitge Biomed Res Inst IDIBELL, ONCOBELL Program, Colorectal Canc Grp, Avinguda Gran Via LHospitalet 199, Barcelona 08908, Spain.},
DOI = {10.1016/j.iot.2023.100848},
EarlyAccessDate = {JUL 2023},
Article-Number = {100848},
ISSN = {2543-1536},
EISSN = {2542-6605},
Keywords = {TinyML; Artificial Intelligence of Things; Anomaly detection;
   Environmental noise; Microcontroller},
Keywords-Plus = {SENSORIZED PLATFORM; IOT; EDGE; THINGS; INTERNET; NETWORK; DESIGN},
Author-Email = {hammad@uji.es
