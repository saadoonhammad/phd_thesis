@article{ WOS:001550811000003,
Author = {Hussain, Adnan and Khan, Noman and Khan, Zulfiqar Ahmad and Yar, Hikmat
   and Baik, Sung Wook},
Title = {Edge-assisted framework for instant anomaly detection and cloud-based
   anomaly recognition in smart surveillance},
Journal = {ENGINEERING APPLICATIONS OF ARTIFICIAL INTELLIGENCE},
Year = {2025},
Volume = {160},
Number = {B},
Month = {NOV 23},
Abstract = {Anomaly detection in surveillance systems, identifying events such as
   fighting, shooting, or vandalism, remains challenging due to limited
   anomalous occurrences impacting model generalization and accuracy.
   Additionally, the significant variability in anomalies compared to
   normal actions complicates precise detection. Current state-of-the-art
   methods typically process all frames captured by surveillance cameras
   using resource-intensive, centralized systems, resulting in high
   computational costs and network bandwidth usage unsuitable for realtime,
   edge-based Artificial Intelligence of Things environments. Moreover,
   unclear anomaly definitions and computationally demanding real-time
   analyses hinder effective monitoring. To address these challenges, we
   propose an efficient Artificial Intelligence of Things-based anomaly
   detection framework employing a twophase approach. Initially, a
   lightweight neural architecture search network classifies events as
   normal or anomalous directly on edge devices. When an anomaly is
   detected, the edge device alerts relevant authorities and transmits the
   relevant video frames to the cloud for further evaluation. In the second
   phase, a next-generation convolutional neural network extracts spatial
   features, refined by Spatial Attention Modules and further processed
   using a transformer-based multi-head attention network to capture
   contextual relationships. A Multi-Scale Feature module then classifies
   the anomalies into specific types. Extensive experiments conducted on
   the University of Central Florida Crime, Large-scale Anomaly
   Detection-2000, and Real-world Fighting-2000 datasets demonstrate that
   our method achieves accuracy of 53.60\%, 80.02\%, and 94.05\%, with
   improvements of 1.8\%, 1.2\%, and 0.8\%, respectively. Moreover, we
   report area under the curve scores of 0.76, 0.98, and 0.98 for all
   datasets, highlighting the method's effectiveness and robustness in
   enhancing anomaly detection and recognition across various datasets.},
Type = {Article},
Language = {English},
Affiliation = {Hussain, A; Baik, SW (Corresponding Author), Sejong Univ, Seoul 143747, South Korea.
   Khan, N (Corresponding Author), Yonsei Univ, Seoul, South Korea.
   Hussain, Adnan; Yar, Hikmat; Baik, Sung Wook, Sejong Univ, Seoul 143747, South Korea.
   Khan, Noman, Yonsei Univ, Seoul, South Korea.
   Khan, Zulfiqar Ahmad, Umea Univ, Dept Comp Sci, Umea, Sweden.},
DOI = {10.1016/j.engappai.2025.111936},
EarlyAccessDate = {AUG 2025},
Article-Number = {111936},
ISSN = {0952-1976},
EISSN = {1873-6769},
Keywords = {Surveillance videos; Sequential learning; Anomaly detection; Attention
   mechanism; Anomaly recognition; Smart surveillance system},
Keywords-Plus = {LIGHTWEIGHT; NOISE},
Author-Email = {Adnanhussain@sju.ac.kr
   noman0869@sju.ac.kr
   sbaik@sejong.ac.kr},
Times-Cited = {9},
Unique-ID = {WOS:001550811000003},
}

@article{ WOS:001708229700001,
Author = {Wu, Haotian and Zhang, Jiwei and Feng, Minxi and Dai, Minghui and
   Mohiuddin, Samra and Bashir, Ali Kashif and Mumtaz, Shahid and Pei,
   Jiaming},
Title = {Swarm Smarts: Enabling Real-Time Self-Healing With TinyML at the Edge},
Journal = {IEEE COMMUNICATIONS STANDARDS MAGAZINE},
Year = {2026},
Month = {2026 MAR 6},
Abstract = {Edge devices in 6G wireless networks are driving unprecedented levels of
   intelligence and autonomy, where billions of interconnected nodes
   collaboratively sense, learn, and adapt in real time. However, the
   coexistence of massive device heterogeneity, stringent resource
   constraints, and highly dynamic operational environments critically
   affects the stability and timeliness of decentralized model training and
   network management. The key challenge lies in achieving adaptive and
   reliable intelligence at the extreme edge, where computation, energy,
   and connectivity are fundamentally limited. To address this challenge,
   we propose a TinyML-driven self-healing framework that embeds
   lightweight learning agents into edge devices, enabling on-device
   analytics for local anomaly detection, adaptive self-recovery, and
   swarm-inspired collaboration for knowledge diffusion. Through model
   quantization and context-aware adaptation, TinyML effectively mitigates
   the impact of device heterogeneity by tailoring models to local
   capabilities, overcomes resource constraints via ultra-low-power
   inference, and sustains robustness under dynamic environments through
   distributed swarm coordination. A 6G-oriented smart factory case study
   demonstrates that, under these challenging conditions, our framework
   significantly improves fault detection latency, recovery speed, and
   communication efficiency compared with centralized solutions. Future
   work will focus on standardizing the TinyML-based self-healing
   architecture and defining interoperability interfaces to support
   large-scale deployment of resilient and autonomous Zero-Touch 6G
   Networks.},
Type = {Article; Early Access},
Language = {English},
Affiliation = {Pei, JM (Corresponding Author), Univ Sydney, Sch Comp Sci, Sydney, NSW 2006, Australia.
