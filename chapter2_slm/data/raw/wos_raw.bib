@article{ WOS:001788997300035,
Author = {Wang, Tianjing and Huang, Sunhua and Zhang, Zhijun and Huang, Zuliang
   and Zheng, Zuqing and Dong, Zhao Yang},
Title = {Risk-Aware AIoT-Based Fault Detection for Power Line Monitoring in
   Consumer Energy Systems},
Journal = {IEEE TRANSACTIONS ON CONSUMER ELECTRONICS},
Year = {2026},
Volume = {72},
Number = {2},
Pages = {4018-4028},
Month = {MAY},
Abstract = {Reliable power line monitoring is critical for consumer energy systems
   that increasingly depend on distributed sensors, smart terminals, and
   IoT-enabled edge devices. In practical deployments, fault detection
   performance is often affected by changing operating conditions, noisy
   measurements, and unreliable prediction confidence. This paper proposes
   a risk-aware AIoT-based fault detection framework that integrates
   multi-domain signal representation, uncertainty-aware inference, and
   confidence-adaptive decision making. High-frequency waveform signals are
   analyzed across time, frequency, and wavelet domains to capture
   complementary fault characteristics, and are adaptively fused to
   preserve localized and nonstationary patterns. Instead of producing
   deterministic outputs, a Dirichlet-based Prior Network is employed to
   jointly estimate fault probability and predictive uncertainty. These
   quantities are combined into a scalar risk score that enables a
   three-outcome decision strategy, allowing the system to issue alarms,
   defer uncertain cases, or identify normal operation. Experiments on a
   real-world power line dataset show that the proposed approach maintains
   stable detection performance and well-calibrated confidence under
   distribution shift. The results demonstrate that incorporating
   uncertainty-aware inference and risk-adaptive decision logic improves
   the reliability of AI-enabled monitoring systems, making the framework
   suitable for IoT-driven consumer energy applications.},
Type = {Article},
Language = {English},
Affiliation = {Dong, ZY (Corresponding Author), City Univ Hong Kong, Dept Elect Engn, Hong Kong, Peoples R China.
   Wang, Tianjing; Huang, Sunhua; Zhang, Zhijun; Huang, Zuliang; Zheng, Zuqing; Dong, Zhao Yang, City Univ Hong Kong, Dept Elect Engn, Hong Kong, Peoples R China.
   Wang, Tianjing; Huang, Sunhua; Zhang, Zhijun; Huang, Zuliang; Zheng, Zuqing; Dong, Zhao Yang, City Univ Hong Kong, Shenzhen Res Inst, Shenzhen 518057, Peoples R China.},
DOI = {10.1109/TCE.2026.3680386},
