   Grzymkowski, Lukasz; Stefanski, Tomasz P., Gdansk Univ Technol, Fac Elect Telecommun \& Informat, PL-80233 Gdansk, Poland.},
DOI = {10.3390/electronics15071508},
EarlyAccessDate = {APR 2026},
