Keywords = {TinyML; On-Board Training; IDS; Security; Intrusion Detection; MCU;
   Microcontroller},
Keywords-Plus = {ANOMALY DETECTION},
Author-Email = {fpfusco@unisa.it
   grimoli@unisa.it
   mficco@unisa.it},
