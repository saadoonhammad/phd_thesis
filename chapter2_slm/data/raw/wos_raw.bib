}

@article{ WOS:001669260200002,
Author = {Toe, Elisee and Jaafar, Fehmi and Charles Andre Ferrier, Laurent},
Title = {Securing LoRaWAN in the AIoT Era: A Systematic Mapping Study and an
   MITRE-Based Threat Matrix},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2026},
Volume = {13},
Number = {3},
Pages = {3827-3849},
Month = {FEB 1},
Abstract = {The rapid expansion of the Internet of Things (IoT) has established
   long-range wide-area network (LoRaWAN) as a leading low-power,
   long-range communication protocol across critical domains such as smart
   cities, agriculture, and healthcare. However, its minimalist design and
   reliance on unlicensed spectrum expose vulnerabilities across the entire
   protocol stack from physical-layer jamming to medium access control
   (MAC)-layer spoofing and application-layer firmware attacks.
   Concurrently, the rise of the Artificial Intelligence of Things (AIoT)
   introduces opportunities to reinforce LoRaWAN security via
   decentralized, intelligent, and adaptive mechanisms. This article
   presents a systematic mapping study of 81 peer-reviewed publications
   (2020-2025), conducted using a Preferred Reporting Items for Systematic
   Reviews and Meta-Analyses (PRISMA)-based methodology. Our objectives are
   to: 1) identify key trends and research directions in LoRaWAN security;
   2) propose an MITRE ATT\&CK-inspired taxonomy tailored to the LoRaWAN
   stack; 3) analyze AIoT-based security contributions; and 4) highlight
   unresolved challenges and future perspectives. Our findings indicate
   that 62\% of documented cyberattacks target the MAC layer, exploiting
   vulnerabilities such as static keys and weak integrity checks. AI-driven
   techniques, including radio frequency fingerprinting (RFF) {[}97\%
   accuracy using convolutional neural networks (CNNs)], federated learning
   for anomaly detection, and blockchain-based key management-show promise
   but raise concerns about scalability and deployment on constrained
   devices. We introduce the first MITRE ATT\&CK-LoRaWAN matrix, detailing
   18 attack techniques {[}e.g., energy depletion and rogue gateways (GWs)]
   and associated countermeasures, including postquantum Kyber-1024
   encryption. Finally, we discuss major technical, methodological, and
   interoperability challenges and suggest actionable research directions
   toward secure, AI-native, and resilient LoRaWAN infrastructures.},
Type = {Article},
Language = {English},
Affiliation = {Toe, E (Corresponding Author), Univ Quebec Chicoutimi, Saguenay, PQ G7H 2B1, Canada.
   Toe, Elisee; Jaafar, Fehmi, Univ Quebec Chicoutimi, Saguenay, PQ G7H 2B1, Canada.
   Charles Andre Ferrier, Laurent, Cegep Sept Iles, Sept Iles, PQ G4R 5B7, Canada.},
DOI = {10.1109/JIOT.2025.3633940},
ISSN = {2327-4662},
Keywords = {Internet of Things; LoRaWAN; Artificial intelligence; Security; Network
   servers; Servers; Logic gates; Cloud computing; Taxonomy; Systematics;
   Artificial Intelligence of Things (AIoT); Internet of Things (IoT)
   security; long-range wide-area network (LoRaWAN); MITRE ATT\&CK;
   postquantum cryptography; Preferred Reporting Items for Systematic
   Reviews and Meta-Analyses (PRISMA)},
Keywords-Plus = {AUTHENTICATION},
Author-Email = {elisee.toe1@uqac.ca
   fehmi.jaafar@uqac.ca
   laurent.ferrier@cegepsi.ca},
Times-Cited = {0},
Unique-ID = {WOS:001669260200002},
}

@article{ WOS:001537179300001,
Author = {Sharma, Ankita and Rani, Shalli},
Title = {Redesigning Transportation Cyber-Physical Systems: Enhancing
   Connectivity and Bolstering Security Using TinyML},
Journal = {IEEE TRANSACTIONS ON INTELLIGENT TRANSPORTATION SYSTEMS},
Year = {2025},
Month = {2025 JUL 22},
Abstract = {The rapid evolution of Transportation Cyber-Physical Systems (TCPS)
   necessitates secure, efficient, and real-time data processing
   capabilities to support autonomous and intelligent transportation
   networks. However, existing machine learning-based security frameworks
   face significant challenges, including limited computational resources,
   data scarcity for model training, and evolving cybersecurity threats. To
   address these challenges, we propose a novel TinyML-driven security
   framework optimized for resource-constrained IoT edge devices within
   TCPS. Our approach integrates Few-shot Transfer Learning to enhance
   model adaptability and improve anomaly detection accuracy, even with
   limited labeled data. The core of our framework is DenseCapsNet, a
   hybrid deep learning model that combines DenseNet (for efficient feature
   propagation) and Capsule Networks (for hierarchical spatial feature
   representation), significantly improving cyber threat detection while
   preserving computational efficiency. Additionally, we incorporate
   adversarial training and privacy-preserving techniques to enhance
   resilience against sophisticated cyber threats, ensuring secure data
   transmission and model robustness. The proposed framework leverages
   6G-enabled ultra-reliable low-latency communication (URLLC) to
   facilitate secure, real-time data exchange across autonomous vehicle
   networks, overcoming latency and connectivity constraints. Extensive
   experiments demonstrate that our TinyML-optimized DenseCapsNet model
   achieves 99.72\% accuracy, 99.7\% F1-score, and 99.4\% recall,
   significantly outperforming state-of-the-art models such as GoogleNet,
   HybridNet, and MobileResNet in TCPS security applications. By bridging
   the gap between efficiency, security, and real-time adaptability, our
   work contributes a highly scalable, energy-efficient, and
   privacy-preserving AI solution tailored for next-generation intelligent
   transportation systems, addressing critical security and computational
   constraints in real-world TCPS environments.},
Type = {Article; Early Access},
Language = {English},
Affiliation = {Rani, S (Corresponding Author), Chitkara Univ, Inst Engn \& Technol, Rajpura 140401, Punjab, India.
   Sharma, Ankita; Rani, Shalli, Chitkara Univ, Inst Engn \& Technol, Rajpura 140401, Punjab, India.},
DOI = {10.1109/TITS.2025.3589570},
EarlyAccessDate = {JUL 2025},
ISSN = {1524-9050},
EISSN = {1558-0016},
Keywords = {Security; Computational modeling; 6G mobile communication; Real-time
   systems; Tiny machine learning; Data models; Training; Anomaly
   detection; Adaptation models; Accuracy; TCPS; security; TinyML; 6G},
Author-Email = {sharma.ankita@chitkara.edu.in
