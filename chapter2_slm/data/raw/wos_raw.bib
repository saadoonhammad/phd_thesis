   Susto, Gian Antonio, Univ Padua, Human Inspired Technol Res Ctr, Via Luigi Luzzatti 4, I-35121 Padua, Italy.},
DOI = {10.1016/j.ins.2022.07.129},
EarlyAccessDate = {AUG 2022},
ISSN = {0020-0255},
EISSN = {1872-6291},
Keywords = {Anomaly detection; Decision support systems; Isolation forest; Outlier
   detection; TinyML; Weakly supervised},
Keywords-Plus = {SUPPORT},
