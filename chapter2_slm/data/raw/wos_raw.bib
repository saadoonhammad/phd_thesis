ISBN = {979-8-3503-6124-7; 979-8-3503-6123-0},
Keywords = {ANN; TinyML; Embedded AI; Edge AI; Autoencoder; Domain-Shift; Anomaly
   Detection; Domain Adaptation; Semi-Supervised; Few-Shot},
Author-Email = {johannes.kuehnel@ims.fraunhofer.de},
Times-Cited = {1},
