@inproceedings{ WOS:000821801200109,
Author = {Ancilotto, Alberto and Paissan, Francesco and Farella, Elisabetta},
Book-Group-Author = {IEEE},
Title = {On the Role of Smart Vision Sensors in Energy-Efficient Computer Vision
   at the Edge},
Booktitle = {2022 IEEE INTERNATIONAL CONFERENCE ON PERVASIVE COMPUTING AND
   COMMUNICATIONS WORKSHOPS AND OTHER AFFILIATED EVENTS (PERCOM WORKSHOPS)},
Year = {2022},
Note = {20th IEEE International Conference on Pervasive Computing and
   Communications (IEEE PerCom), ELECTR NETWORK, MAR 21-25, 2022},
Abstract = {The increasing focus of the research community towards lightweight and
   small footprint neural network models is closing the gap between
   inference performance in cluster-scale models and tiny devices. In the
   recent past, researchers have shown how it is possible to achieve
   state-of-the-art performance in different domains (e.g. sound event
   detection, object detection, image classification) with small footprints
   and low computational cost architectures. However, these studies lack a
   comprehensive analysis of the input space used (e.g. for images) and
   present the results on standard RGB benchmarks. In this manuscript, we
   investigate the role of smart vision sensors (SVSs) in deep
   learning-based object detection pipelines. In particular, we combine the
   motion bitmaps with standard color spaces representations (namely, RGB,
   YUV, and grayscale) and show how SVSs can be used optimally for an IoT
   end-node. In conclusion, we report that, overall, the best-performing
   input space is grayscale augmented with the motion bitmap. These results
   are promising for real-world applications since many SVSs provide both
   image formats at low power consumption.},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Ancilotto, A (Corresponding Author), Fdn Bruno Kessler FBK, Digital Soc Ctr, E3DA Unit, Trento, Italy.
   Ancilotto, Alberto; Paissan, Francesco; Farella, Elisabetta, Fdn Bruno Kessler FBK, Digital Soc Ctr, E3DA Unit, Trento, Italy.},
DOI = {10.1109/PerComWorkshops53856.2022.9767380},
ISBN = {978-1-6654-1647-4},
Keywords = {smart vision sensors; edge computing; tinyML; embedded computer vision},
Keywords-Plus = {BINARY IMAGES; PIXEL},
Author-Email = {aancilotto@fbk.eu
   fpaissan@fbk.eu
   efarella@fbk.eu},
Times-Cited = {5},
