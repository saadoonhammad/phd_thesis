@article{ WOS:000862548500006,
Author = {Yan, Tijin and Zhou, Tong and Zhan, Yufeng and Xia, Yuanqing},
Title = {TFDPM: Attack detection for cyber-physical systems with diffusion
   probabilistic models},
Journal = {KNOWLEDGE-BASED SYSTEMS},
Year = {2022},
Volume = {255},
Month = {NOV 14},
Abstract = {With the development of AIoT, data-driven attack detection methods for
   cyber-physical systems (CPSs) have attracted lots of attention. However,
   existing methods usually adopt tractable distributions to approximate
   data distributions, which are unsuitable for complex systems. Besides,
   the correlation of the data in different channels does not attract
   sufficient attention. To address these issues, we use energy-based
   generative models, which are less restrictive in functional forms of the
   data distribution. In addition, graph neural networks are used to
   explicitly model the correlation of the data in different channels. In
   this paper, a general framework called Temporal pattern and Feature
   pattern-based Diffusion Probabilistic Model (TFDPM) is proposed for
   attack detection tasks in CPSs. Temporal pattern and feature pattern are
   simultaneously extracted given the historical data at first. To obtain
   predicted values, extracted features are sent to a conditional diffusion
   probabilistic model. Attacks are detected based on the difference
   between predicted values and observed values. In addition, to realize
   real-time detection, a conditional noise scheduling network is proposed
   to accelerate the prediction process. Experimental results show that the
   performance of TFDPM is up to about 4\% higher than the existing
   state-of-the-art method. The noise scheduling network increases the
   detection speed up to 3 times without reducing the performance of TFDPM.
   (c) 2022 Elsevier B.V. All rights reserved.},
Type = {Article},
Language = {English},
Affiliation = {Xia, YQ (Corresponding Author), Beijing Inst Technol, Sch Automat, Key Lab Intelligent Control Decis Complex Syst, Beijing 100081, Peoples R China.
   Yan, Tijin; Zhou, Tong; Zhan, Yufeng; Xia, Yuanqing, Beijing Inst Technol, Sch Automat, Key Lab Intelligent Control Decis Complex Syst, Beijing 100081, Peoples R China.},
DOI = {10.1016/j.knosys.2022.109743},
EarlyAccessDate = {SEP 2022},
Article-Number = {109743},
ISSN = {0950-7051},
EISSN = {1872-7409},
Keywords = {Attack detection; Cyber-physical systems; Energy -based models; Graph
   neural networks},
Keywords-Plus = {ANOMALY DETECTION; TIME},
Author-Email = {yantijin@bit.edu.cn
   3120210962@bit.edu.cn
   yu-feng.zhan@bit.edu.cn
   xia\_yuanqing@bit.edu.cn},
Times-Cited = {10},
Unique-ID = {WOS:000862548500006},
}

@inproceedings{ WOS:001710648700476,
Author = {Ragusa, Edoardo and Zonzini, Federica and De Marchi, Luca and Gastaldo,
   Paolo},
Book-Group-Author = {IEEE},
Title = {The impact of Sensing Parameters on Vibration Anomaly Detection Using
   Tiny DNNs},
Booktitle = {2025 INTERNATIONAL JOINT CONFERENCE ON NEURAL NETWORKS (IJCNN)},
Series = {IEEE International Joint Conference on Neural Networks (IJCNN)},
Year = {2025},
Note = {2025 International Joint Conference on Neural Networks-IJCNN, Rome,
   ITALY, JUN 30-JUL 05, 2025},
Abstract = {Smart sensors with extreme-edge data processing capabilities allow to
   optimize the energy budget of current Structural Health Monitoring (SHM)
   systems. Moving inference and Deep Neural Networks (DNNs) directly to
   the sensing unit can bypass the constraints due to data transmission,
   but it has to be properly balanced against the expenditure due to data
   sampling, which might easily become the main source of energy
   consumption when the duty cycling is not chosen appropriately. Finding
   the optimal sampling time and frequency is a non trivial task because it
   depends on the peculiarities of the target facility, the surrounding
   environment, and the highly non-linear behavior of DNNs. This paper
   presents a fully decentralized scheme for vibration damage detection
   where each sensor can predict the health status of the structure; a tiny
   Convolutional Neural Network (CNN) hosted on the node is entitled to
   autonomously process the measurements and to complete the inference. As
   a further contribution, an empirical study proves the major role played
   by the sampling parameters on the performance of the networks.
   Experiments on the Z24 bridge benchmark show that the small-size CNN can
   achieve classification scores comparable with state-of-the-art models
   while i) avoiding data transmission and ii) improving the energy budget
   if the optimal sensing parameters are chosen. These findings are
   obtained after deploying the sought CNN model on a wireless
   accelerometer sensor based on an STM32L496 processor. Results show that,
   by properly tuning the sampling parameters (length of the acquisition
   window and sampling frequency), one can reach the best trade-off between
   classification performances (accuracy above 96\%) and energy consumption
   (less than 40mJ/h).},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Ragusa, E (Corresponding Author), Univ Genoa, DITEN, I-16145 Genoa, Italy.
   Ragusa, Edoardo; Gastaldo, Paolo, Univ Genoa, DITEN, I-16145 Genoa, Italy.
   Zonzini, Federica; De Marchi, Luca, Univ Bologna, DEI ARCES, I-40136 Bologna, Italy.},
DOI = {10.1109/IJCNN64981.2025.11228464},
ISSN = {2161-4393},
ISBN = {979-8-3315-1043-5; 979-8-3315-1042-8},
Keywords = {Smart sensors; TinyML; Structural Health Monitoring; extreme-edge data
   processing},
Author-Email = {edoardo.ragusa@unige.it
   federica.zonzini@unibo.it
   l.demarchi@unibo.it
   paolo.gastaldo@unige.it},
Times-Cited = {0},
Unique-ID = {WOS:001710648700476},
}

@article{ WOS:001612536200002,
Author = {Lai, Yi-Chung and Huang, Chih-Wei and Wu, Tsung-Yuan and Weng, Yu-Ting
   and Wang, Ting-Yuan and Huang, Chang-Wen and Chiang, Chung-Ping and
   Wang, Jung-Hua},
Title = {AIoT platform integrated with smart breeding and omics cloud database
   for Taiwan tilapia},
Journal = {JOURNAL OF AGRICULTURE AND FOOD RESEARCH},
Year = {2025},
Volume = {24},
Month = {DEC},
Abstract = {The ongoing depletion of marine fishery products has heightened the
   importance of aquaculture, with farming tilapia emerging as a key
   substitute for protein sources. Conventional breeding approaches for
   Taiwan tilapia are often protracted in duration and susceptible to
   genetic deterioration. To address these challenges, we propose a
   multi-year research project that aims to build a platform integrated
   with a smart breeding system and an omics cloud. State-of-the-art
   artificial intelligence (AI) models and high-throughput IoT are employed
   to offer promising solutions. Global advancements in selective breeding
   further highlight the significance of this work in sustaining Taiwan's
   tilapia industry. Funded by Taiwan's Ministry of Agriculture, the
   research focuses on exploring genotype-phenotype relationships to pave
   the way for more efficient breeding procedures and, ultimately, optimal
   breeding strategies. This paper reports the first-year results of
   phenotype work. Novel algorithms are developed to integrate with the AI
   models, enabling real-time monitoring of fish behavior and environmental
   parameters, thereby facilitating selective breeding procedures. Key
   findings include: (1) for fish aged 1-3 months, YOLO11s achieved 0.802
   of mAP(@50) and 0.9316 of mAP(@50) for body detection; (2) for 3-5
   months fish, YOLOv12n outperformed others with 0.767 of mAP(@50); (3)
   for anomaly behavior recognition, F1-score and precision rate reached 97
   \% and 99 \%, respectively; and (4) size measurement using stereo vision
   yielded an error rate of 3.42 \%. All computing tasks, including object
   detection, behavior recognition, and size measurement, can be performed
   on the Jetson Xavier series, enabling cost-effective edge computing for
   on-site aquaculture applications.},
Type = {Article},
Language = {English},
Affiliation = {Wang, JH (Corresponding Author), Natl Taiwan Ocean Univ, Dept Elect Engn, Keelung 20224, Taiwan.
   Lai, Yi-Chung; Huang, Chih-Wei; Wu, Tsung-Yuan; Weng, Yu-Ting; Wang, Jung-Hua, Natl Taiwan Ocean Univ, Dept Elect Engn, Keelung 20224, Taiwan.
   Wang, Ting-Yuan, Ind Technol Res Inst ITRI, Hsinchu 310401, Taiwan.
   Huang, Chang-Wen; Chiang, Chung-Ping, Natl Taiwan Ocean Univ, Dept Aquaculture, Keelung 20224, Taiwan.
   Huang, Chang-Wen, Natl Taiwan Ocean Univ, Ctr Excellence Oceans, Keelung 20224, Taiwan.
   Wang, Jung-Hua, Natl Taiwan Ocean Univ, AI Res Ctr, Keelung 20224, Taiwan.},
DOI = {10.1016/j.jafr.2025.102490},
EarlyAccessDate = {OCT 2025},
