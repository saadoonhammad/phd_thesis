@article{ WOS:001811667800001,
Author = {Jiang, Wen-Dong and Chang, Chih-Yung and Kuai, Ssu-Chi and Roy, Diptendu
   Sinha},
Title = {DecoVAD: Divide-and-Conquer Multimodal Learning for Video Anomaly
   Detection},
Journal = {IEEE TRANSACTIONS ON SYSTEMS MAN CYBERNETICS-SYSTEMS},
Year = {2026},
Month = {2026 JUL 3},
Abstract = {Video anomaly detection (VAD) under weak supervision is pivotal for
   intelligent security and urban governance, yet existing solutions depend
   on tightly coupled vision-language pipelines, resulting in heavy
   computation, semantic ambiguity, and limited deployability on edge
   devices. In practical surveillance settings, this task should be treated
   not only as a recognition problem but also as a system-level modeling
   and decision problem. This article presents DecoVAD, a
   branch-specialized multimodal surveillance framework that assigns
   low-cost visual screening and explicit semantic reasoning to different
   but coordinated processing streams. The implicit branch encodes
   complementary scene context and action dynamics, followed by a
   distance-based temporal aggregator that substitutes quadratic
   dot-product attention with linear-complexity kernels. The explicit
   branch invokes YOLO-World to detect objects, actions, and attributes,
   and it converts these primitives into transactional data; a parallel
   tree-based miner uncovers high-confidence association rules that are
   aligned with CLIP embeddings to drive finegrained localization. The
   branches are coordinated through shared visual embeddings and a
   learnable late-fusion gate. This architecture markedly reduces network
   depth, FLOPs, and memory footprint while mitigating prompt-induced bias
   toward long-tail behaviors. Experiments on XD-Violence and UCF-Crime
   show that DecoVAD matches or surpasses state-ofthe-art performance while
   boosting inference speed and resource efficiency by up to 3 \& times;.
   Ablation studies confirm that rule-driven semantics enhance robustness
   in complex social scenes, and branchwise optimization facilitates rapid
   deployment on resource-constrained edge devices. The code is available
   at https://github.com/7WD1/DecoVAD. The appendix provides additional
   discussion and details.},
Type = {Article; Early Access},
Language = {English},
Affiliation = {Chang, CY (Corresponding Author), Tamkang Univ, Dept Comp Sci \& Informat Engn, New Taipei 25137, Taiwan.
   Jiang, Wen-Dong, Ningbo Univ, Sch Artificial Intelligence, Ningbo 315211, Peoples R China.
   Chang, Chih-Yung, Tamkang Univ, Dept Comp Sci \& Informat Engn, New Taipei 25137, Taiwan.
   Kuai, Ssu-Chi, Natl Taipei Univ Business, Dept Informat Management, Taipei 100025, Taiwan.
   Roy, Diptendu Sinha, Natl Inst Technol, Dept Comp Sci \& Engn, Shillong 793003, India.},
DOI = {10.1109/TSMC.2026.3706520},
EarlyAccessDate = {JUL 2026},
