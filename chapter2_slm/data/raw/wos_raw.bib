   Iskandaryan, Ditsuhi, Inst Recerca Biomed Bellvitge IDIBELL, ONCOBELL Program, Colorectal Canc Grp, Avinguda Gran via lHosp 199, Barcelona 08908, Spain.},
DOI = {10.1016/j.iot.2024.101063},
EarlyAccessDate = {JAN 2024},
Article-Number = {101063},
ISSN = {2543-1536},
EISSN = {2542-6605},
