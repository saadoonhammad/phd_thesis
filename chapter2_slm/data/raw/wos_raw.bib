   Sun, Muyi, Beijing Univ Posts \& Telecommun, Sch Artificial Intelligence, Beijing 100876, Peoples R China.},
DOI = {10.1109/TCSS.2025.3613939},
EarlyAccessDate = {NOV 2025},
ISSN = {2329-924X},
Keywords = {Transformers; Anomaly detection; Computational modeling; Edge computing;
   Accuracy; Optical fiber sensors; Image edge detection; Attention
   mechanisms; Resource management; Optimization; collaborative learning;
   cyber-physical-social system (CPSS); distributed fiber-optic
   intelligence; transformer},
