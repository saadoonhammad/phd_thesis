@article{ WOS:001756839500034,
Author = {Peng, Tsui and Lin, Ching-Huang and Wei, Yu-Chih and Chen, Bo-Chang and
   Yeh, Jen-Yu},
Title = {Low-Overhead Passive Resilience Monitoring for AIoT Gateways: End-to-End
   Anomaly Detection via eBPF Timing Traces and Autoencoders},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {61753-61771},
Abstract = {Modern AIoT services are vulnerable to complex, cross-domain failures
   spanning wireless sensor networks, edge AI inference, and cloud
   reporting. Conventional monitoring typically relies on isolated
   single-node metrics that lack an integrated end-to-end perspective, or
   on exhaustive active probing that incurs prohibitive resource overhead.
   To address this gap, this paper presents a lightweight, gateway-centric
   resilience-monitoring framework that provides comprehensive end-to-end
   observability purely at the edge. By hooking into kernel-level TCP state
   transitions via Linux eBPF, the proposed system decouples
   network-induced delays from application computational bottlenecks. We
   reconstruct fine-grained discrete latency segments-including
   device-to-gateway transmission (T-de), IoT service execution (T-is), AI
   inference (T-ai ), and cloud reporting ( T-ec)-completely eliminating
   injected measurement traffic. Based on these non-intrusive metrics, we
   design a hybrid detection architecture: i) protocol-oriented static
   thresholds for immediate, interpretable localization of hard outages,
   and ii) a window-based behavioral layer integrating Autoencoders (AE)
   and Cumulative Sum (CUSUM) to handle subtle concept drifts and coupled
   performance degradations. Extensive evaluations on a physical AIoT
   testbed demonstrate that the framework localizes failures with minimal
   CPU overhead (less than 1\%). Furthermore, the learning-based layer
   successfully captures the elusive performance fluctuations arising from
   the dynamic interplay between network conditions and edge computing
   workloads. Ultimately, this approach facilitates a paradigm shift from
   reactive failure handling to proactive early warning and autonomous
   anomaly detection, offering a highly deployable foundation for robust
   AIoT operations.},
Type = {Article},
Language = {English},
Affiliation = {Peng, T (Corresponding Author), Natl Taipei Univ Technol, Dept Informat \& Finance Management, Taipei 10608, Taiwan.
   Peng, Tsui; Lin, Ching-Huang; Wei, Yu-Chih, Natl Taipei Univ Technol, Dept Informat \& Finance Management, Taipei 10608, Taiwan.
   Chen, Bo-Chang; Yeh, Jen-Yu, Natl Taipei Univ Technol, Informat Secur Program, Taipei 10608, Taiwan.},
DOI = {10.1109/ACCESS.2026.3685156},
ISSN = {2169-3536},
Keywords = {Payloads; Telemetry; Aerospace and electronic systems; Military
   aircraft; Space technology; Feeds; Central Processing Unit; Filtering;
   Filters; Electronic circuits; AIoT gateway; anomaly detection;
   autoencoder; extended Berkeley packet filter (eBPF); operational
   resilience; passive monitoring},
Keywords-Plus = {EDGE; NETWORK},
Author-Email = {johnpeng@mail.ntut.edu.tw},
Times-Cited = {0},
Unique-ID = {WOS:001756839500034},
}

@inproceedings{ WOS:001414402200010,
Author = {Neto, Almir and Gomes, Luis and Vale, Zita},
Book-Group-Author = {IEEE},
Title = {Virtual sensor for door opening detection and anomaly detection using
   machine learning},
Booktitle = {2024 22ND INTERNATIONAL CONFERENCE ON INTELLIGENT SYSTEMS APPLICATIONS
   TO POWER SYSTEMS, ISAP 2024},
Year = {2024},
Note = {22nd International Conference on Intelligent Systems Applications to
   Power Systems, HUNGARY, SEP 16-19, 2024},
Abstract = {Currently, several studies are being developed using machine Learning
   with the aim of replacing real sensors with virtual sensors. One of the
   biggest challenges is obtaining quality data to enable the system
   modeling. This article proposes the replacement of a light dependent
   resistor sensor, applied to a refrigerator, which detects whether the
   door is open or closed and an anomaly test when the door is forgotten
   open for too long. The use of tiny machine learning is applied to ESP32
   to enable the use of regression and classification models to detect the
   door opening and anomaly. The tested metrics for the regression were the
   root mean squared error. The comparative results between the virtual and
   real sensors are satisfactory with an accuracy of 99.59\% for
   classification and a root mean squared error value of 0.01 for
