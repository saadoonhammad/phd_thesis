Keywords = {Feeds; High frequency; Internet of Things; Communication systems;
   Internet; Radio frequency; Network topology; Protocols; Zigbee; Fuses;
   Fault diagnosis; power line; risk-aware decision; predictive confidence;
   uncertainty-aware inference},
