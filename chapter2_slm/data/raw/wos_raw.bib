   Zhou, Peng; Fan, Haitao, Nano Core Co Ltd, Hangzhou 311200, Peoples R China.
   Tan, Zhichao, Zhejiang Univ, Coll Informat Sci \& Elect Engn, Hangzhou 310058, Peoples R China.},
DOI = {10.1109/JSSC.2021.3113257},
ISSN = {0018-9200},
EISSN = {1558-173X},
Keywords = {Always-on wake-up chip; artificial intelligence Internet of Things
   (AIoT); asynchronous; convolutional neural network (CNN); event-driven
   architecture; level-crossing (LC) analog-to-digital converter (ADC);
   random sparse event (RSE); reconfigurable; temporal-domain feature
   extraction},
Keywords-Plus = {LEVEL-CROSSING ADC; FRONT-END; CHIP; DESIGN; COMPARATOR; PROCESSOR;
   CLOCK},
Author-Email = {yele@pku.edu.cn},
Times-Cited = {38},
