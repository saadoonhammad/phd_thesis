Language = {English},
Affiliation = {Li, Y (Corresponding Author), Jilin Agr Sci \& Technol Univ, 77 Hanlin Rd, Jilin, Jilin, Peoples R China.
   Li, Yan; Zhang, Xiaochen, Jilin Agr Sci \& Technol Univ, 77 Hanlin Rd, Jilin, Jilin, Peoples R China.
