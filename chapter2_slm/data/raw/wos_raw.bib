DOI = {10.1109/RAICS61201.2024.10690105},
ISBN = {979-8-3503-8169-6; 979-8-3503-8168-9},
Keywords = {TinyML; Edge Impulse; PMSM; SVPWM; FOC; MATLAB; SIMULINK},
